# Read for every destination, before .kamal/secrets.<site>; committed, so it
# only ever names variables, never values.

# The install's plugins (builder.secrets in config/deploy.yml). Empty installs
# none; Kamal needs it defined either way.
CMS_PLUGINS=$CMS_PLUGINS

# The site's theme (builder.secrets; bin/fetch-theme): a git URL, with a
# token for a private one. Empty, the site is headless.
CMS_THEME=$CMS_THEME
