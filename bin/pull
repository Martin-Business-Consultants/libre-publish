#!/usr/bin/env ruby
# frozen_string_literal: true

# A live site's content and media on this machine, to build its theme
# against real data (docs/local-development.md). Fetches the site's backup
# through its API (Tools › Backup, which takes tools:use), keeps it in
# tmp/pulls/, and puts it in place of this development install's data
# (bin/rails cms:pull, LocalPull): webhooks, deploys and IndexNow off, the
# site's address this machine's, and local@localhost / password1234 to sign
# in with. The live site is only read.
#
#   bin/pull production                 # a cms CLI profile: ~/.config/cms/production.env
#   bin/pull --url https://site.example --token TOKEN
#   bin/pull production --without-people   # no accounts, form submissions or tokens but yours
#   bin/pull --file tmp/pulls/site.tar.gz  # a backup you already have
require "fileutils"
require "net/http"
require "optparse"
require "uri"

APP_ROOT = File.expand_path("..", __dir__)
options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: bin/pull [PROFILE] [--url URL --token TOKEN] [--without-people] [--file BACKUP]"
  parser.on("--url URL", "The site's address") { options[:url] = it }
  parser.on("--token TOKEN", "An API token whose role can use Tools") { options[:token] = it }
  parser.on("--file PATH", "Use a backup already downloaded") { options[:file] = it }
  parser.on("--without-people", "Leave out accounts, form submissions and tokens") { options[:without_people] = true }
end.parse!

def profile(name)
  path = File.expand_path("~/.config/cms/#{name}.env")
  abort "No profile #{name} (#{path}). Sign in with the cms CLI, or give --url and --token." unless File.file?(path)

  File.read(path).lines.to_h { it.sub(/\Aexport\s+/, "").strip.split("=", 2) }.transform_values { it.to_s.delete_prefix('"').delete_suffix('"') }
end

archive = options[:file]
unless archive
  settings = ARGV.first ? profile(ARGV.first) : {}
  url = (options[:url] || settings["CMS_URL"]).to_s.chomp("/")
  token = options[:token] || settings["USER_AGENT_TOKEN"] || settings["CMS_TOKEN"]
  abort "Which site? Give a profile, or --url and --token." if url.empty? || token.to_s.empty?

  FileUtils.mkdir_p(File.join(APP_ROOT, "tmp/pulls"))
  archive = File.join(APP_ROOT, "tmp/pulls", "#{URI(url).host}-#{Time.now.strftime("%Y%m%d-%H%M%S")}.tar.gz")
  uri = URI("#{url}/api/tools/backup")
  puts "Fetching #{uri.host}'s backup…"
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", read_timeout: 600) do |http|
    request = Net::HTTP::Post.new(uri, "Authorization" => "Bearer #{token}", "Accept" => "application/gzip")
    http.request(request) do |response|
      unless response.is_a?(Net::HTTPSuccess)
        abort "#{uri.host} answered #{response.code}: #{response.body.to_s[0, 300]}" \
              "#{" (the token's role needs tools:use)" if response.code == "403"}"
      end
      File.open(archive, "wb") { |file| response.read_body { file.write(it) } }
    end
  end
  puts "Saved #{File.size(archive) / 1024} KB to #{archive.delete_prefix("#{APP_ROOT}/")}"
end

env = {"WITHOUT_PEOPLE" => (options[:without_people] ? "1" : nil)}
exec(env, File.join(APP_ROOT, "bin/rails"), "cms:pull[#{File.expand_path(archive)}]")
