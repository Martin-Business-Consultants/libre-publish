#!/usr/bin/env ruby
# frozen_string_literal: true

# Clones an install's plugins into plugins/ for the Docker build, before
# bundling (docs/plugins.md). A Kamal install, whatever runs it, clones the
# repository fresh for every deploy, so plugins installed with
# `plugins:install` would not survive it; this list is how they do.
#
# Every install gets the default plugins (config/default_plugins.yml), plus
# what the CMS_PLUGINS builder secret lists: git URLs, each optionally with
# #<tag, branch or commit>, separated by spaces, commas or newlines. `-name` leaves a
# default out (to go without it, or swap in another), "none" installs
# nothing at all, defaults included, and "default" stands for the defaults
# alone, for a host that won't keep an empty secret. A secret
# rather than a build arg so a private plugin's URL can carry a token without
# it landing in the image.
#
#   CMS_PLUGINS="https://github.com/org/cms-seo#v1.2.0 https://x-access-token:TOKEN@github.com/org/private-plugin"
#   CMS_PLUGINS="-forms https://github.com/org/better-forms"
#   bin/fetch-plugins                    # reads CMS_PLUGINS, or /run/secrets/CMS_PLUGINS in a build
#   bin/fetch-plugins --list "url#ref"   # the same, from the argument
require "fileutils"
require "yaml"

APP_ROOT = File.expand_path("..", __dir__)
SECRET_FILE = "/run/secrets/CMS_PLUGINS"

def plugin_list
  if ARGV.first == "--list"
    ARGV[1].to_s
  elsif File.exist?(SECRET_FILE)
    File.read(SECRET_FILE)
  else
    ENV["CMS_PLUGINS"].to_s
  end
end

# The URL without its credentials, for the log.
def redact(url) = url.sub(%r{//[^/@]+@}, "//")

listed = plugin_list.split(/[\s,]+/).reject(&:empty?)
defaults = listed.include?("none") ? {} : (YAML.safe_load_file(File.join(APP_ROOT, "config/default_plugins.yml")) || {})
left_out = listed.filter_map { it.delete_prefix("-") if it.start_with?("-") }
# [directory name, url#ref]: the defaults not left out, then the listed ones.
entries = defaults.except(*left_out).to_a +
  listed.reject { %w[none default].include?(it) || it.start_with?("-") }.map { [File.basename(it.split("#", 2).first.sub(/\.git\z/, "")), it] }
if entries.empty?
  puts "No plugins to fetch."
  exit
end

entries.each do |name, entry|
  url, ref = entry.split("#", 2)
  abort "Can't tell a plugin name from #{redact(url)}." if name.empty? || name.start_with?(".")
  directory = File.join(APP_ROOT, "plugins", name)
  abort "Two plugins named #{name} in CMS_PLUGINS." if File.exist?(directory)

  puts "Fetching #{name} from #{redact(url)}#{" at #{ref}" if ref}"
  # The URL may carry a token, so git's own output (which can echo it) is kept out of the build log.
  quiet = {err: File::NULL, out: File::NULL}
  cloned = if ref&.match?(/\A\h{40}\z/)
    # A commit (how default_plugins.yml pins the defaults): fetched alone.
    system("git", "init", "--quiet", directory, **quiet) &&
      system("git", "-C", directory, "fetch", "--quiet", "--depth", "1", url, ref, **quiet) &&
      system("git", "-C", directory, "checkout", "--quiet", "FETCH_HEAD", **quiet)
  else
    system("git", "clone", "--quiet", "--depth", "1", *(["--branch", ref] if ref), url, directory, **quiet)
  end
  abort "Couldn't clone #{redact(url)}#{" at #{ref}" if ref}: check the URL, the ref and, for a private repository, its token." unless cloned
  # No history, and no remote URL holding a token, in the image.
  FileUtils.rm_rf File.join(directory, ".git")
  abort "#{name} isn't a CMS plugin: no gemspec at its top level." if Dir.glob(File.join(directory, "*.gemspec")).empty?
end
