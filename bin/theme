#!/usr/bin/env ruby
# frozen_string_literal: true

# Working on a theme from its own repository, beside this checkout
# (docs/local-development.md). A linked theme is loaded from where it is, so
# saving a template or the stylesheet shows on the next page load.
#
#   bin/theme new acme              # a theme from the starter, in ../acme-theme, linked
#   bin/theme link ../acme-theme    # load a theme you have, from where it is
#   bin/theme unlink acme           # back to the one the install had, if any
#   bin/theme list
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
THEMES = File.join(APP_ROOT, "themes")
ASIDE = File.join(APP_ROOT, "tmp/themes-aside")
STARTER = "https://github.com/Martin-Business-Consultants/libre-publish-theme-starter"

def name_of(path)
  gemspec = Dir.glob(File.join(path, "*.gemspec")).first or abort "#{path} isn't a theme: no gemspec at its top level."
  File.basename(gemspec, ".gemspec")
end

def link(path)
  path = File.expand_path(path)
  abort "No directory #{path}." unless File.directory?(path)
  name = name_of(path)
  target = File.join(THEMES, name)
  if File.symlink?(target)
    File.unlink(target)
  elsif File.exist?(target)
    FileUtils.mkdir_p(ASIDE)
    File.rename(target, File.join(ASIDE, name))
    puts "Moved the install's own themes/#{name} aside (bin/theme unlink #{name} puts it back)."
  end
  File.symlink(path, target)
  puts "Linked themes/#{name} → #{path}"
  switch_to(name)
  puts "Restart bin/dev once to load it; after that, templates and CSS reload as you save."
end

# The linked theme draws the site: it's switched on and any other off, as
# Plugins › Themes would (in this development database only).
def switch_to(name)
  script = <<~RUBY
    Website.themes.each_key { |key| Cms::Plugins.switch!(key, on: key == #{name.inspect}) if Cms::Plugins.manifests.key?(key.to_sym) }
    puts "Drawing the site: #{name}" + (Website.themes.size > 1 ? " (switched the others off)" : "")
  RUBY
  system(File.join(APP_ROOT, "bin/rails"), "runner", script, err: File::NULL) or
    puts "Switch #{name} on in Plugins › Themes (and others off) once bin/dev is up."
end

def unlink(name)
  target = File.join(THEMES, name)
  abort "themes/#{name} isn't linked." unless File.symlink?(target)
  File.unlink(target)
  aside = File.join(ASIDE, name)
  File.rename(aside, target) if File.exist?(aside)
  remaining = Dir.children(THEMES).select { File.directory?(File.join(THEMES, it)) && !it.start_with?(".") }
  switch_to(remaining.first) if remaining.any?
  puts "Unlinked #{name}#{" and put the install's own back" if File.exist?(target)}. Restart bin/dev."
end

def create(name, directory)
  abort "A theme's name is lowercase letters, digits and underscores, starting with a letter." unless name.match?(/\A[a-z][a-z0-9_]*\z/)
  directory = File.expand_path(directory || File.join(APP_ROOT, "..", "#{name.tr("_", "-")}-theme"))
  abort "#{directory} is already there." if File.exist?(directory)

  system("git", "clone", "--quiet", "--depth", "1", STARTER, directory, exception: true)
  FileUtils.rm_rf(File.join(directory, ".git"))
  constant = name.split("_").map(&:capitalize).join
  title = name.split("_").map(&:capitalize).join(" ")
  Dir.glob(File.join(directory, "**", "*starter*")).sort_by { -it.length }.each do |path|
    File.rename(path, File.join(File.dirname(path), File.basename(path).gsub("starter", name)))
  end
  Dir.glob(File.join(directory, "**", "*")).select { File.file?(it) }.each do |path|
    text = File.read(path)
    replaced = text.gsub("Starter::", "#{constant}::").gsub("module Starter", "module #{constant}")
      .gsub('name: "Starter"', "name: \"#{title}\"").gsub("starter", name)
    File.write(path, replaced) if replaced != text
  end
  system("git", "-C", directory, "init", "--quiet", "-b", "main", exception: true)
  puts "Made the #{name} theme in #{directory}, from the starter."
  link(directory)
end

def list
  Dir.children(THEMES).sort.each do |entry|
    path = File.join(THEMES, entry)
    next unless File.directory?(path)

    puts File.symlink?(path) ? "#{entry}  → #{File.readlink(path)}" : "#{entry}  (the install's)"
  end
end

case ARGV.shift
when "new" then create(ARGV[0].to_s, ARGV[1])
when "link" then link(ARGV.fetch(0) { abort "Usage: bin/theme link PATH" })
when "unlink" then unlink(ARGV.fetch(0) { abort "Usage: bin/theme unlink NAME" })
when "list", nil then list
else abort "Usage: bin/theme new NAME | link PATH | unlink NAME | list"
end
