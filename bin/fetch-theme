#!/usr/bin/env ruby
# frozen_string_literal: true

# Clones an install's theme into themes/ for the Docker build, before
# bundling (docs/themes.md), as bin/fetch-plugins does plugins. A theme is
# usually a site's own work, kept in a private repository, so it comes from
# the CMS_THEME builder secret: one git URL, optionally with #<tag, branch or
# commit>, and a token in the URL for a private one. Unset, the install is
# headless and nothing is fetched.
#
#   CMS_THEME="https://x-access-token:TOKEN@github.com/org/acme-theme#v1.0.0"
#   bin/fetch-theme                   # reads CMS_THEME, or /run/secrets/CMS_THEME in a build
#   bin/fetch-theme --url "url#ref"   # the same, from the argument
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
SECRET_FILE = "/run/secrets/CMS_THEME"

def redact(url) = url.sub(%r{//[^/@]+@}, "//")

entry = if ARGV.first == "--url" then ARGV[1].to_s
elsif File.exist?(SECRET_FILE) then File.read(SECRET_FILE)
else ENV["CMS_THEME"].to_s
end.strip

if entry.empty?
  puts "No theme to fetch: the site is headless."
  exit
end

url, ref = entry.split("#", 2)
unless url.match?(%r{\A(https://|git@|ssh://|file://|/)})
  abort "CMS_THEME is #{redact(url).inspect}, which isn't a git URL. Give the theme repository's URL, with a token " \
    "that can read it for a private one, and a tag or commit:\n" \
    "  CMS_THEME=\"https://x-access-token:TOKEN@github.com/org/acme-theme#v1.0.0\""
end
name = File.basename(url.sub(/\.git\z/, "")).delete_suffix("-theme")
abort "Can't tell a theme name from #{redact(url)}." if name.empty? || name.start_with?(".")
directory = File.join(APP_ROOT, "themes", name)
abort "themes/#{name} is already there." if File.exist?(directory)

puts "Fetching the #{name} theme from #{redact(url)}#{" at #{ref}" if ref}"
# The URL may carry a token, so git's own output (which can echo it) is kept out of the build log.
quiet = {err: File::NULL, out: File::NULL}
cloned = if ref&.match?(/\A\h{40}\z/)
  system("git", "init", "--quiet", directory, **quiet) &&
    system("git", "-C", directory, "fetch", "--quiet", "--depth", "1", url, ref, **quiet) &&
    system("git", "-C", directory, "checkout", "--quiet", "FETCH_HEAD", **quiet)
else
  system("git", "clone", "--quiet", "--depth", "1", *(["--branch", ref] if ref), url, directory, **quiet)
end
abort "Couldn't clone #{redact(url)}#{" at #{ref}" if ref}: check the URL, the ref and, for a private repository, its token." unless cloned
# No history, and no remote URL holding a token, in the image.
FileUtils.rm_rf File.join(directory, ".git")
abort "#{name} isn't a theme: no gemspec at its top level." if Dir.glob(File.join(directory, "*.gemspec")).empty?
