#!/bin/bash -e
# Checks a release bundle (the Dockerfile's `bundle` stage, as a tar) runs on
# the Ruby it carries, whatever Ruby starts it: boots it inside an older Ruby
# image, the way an install that updated in place runs it
# (bin/docker-entrypoint), migrates a fresh database and asks which Ruby
# answered. It also has Herb read a template's Ruby through Prism: a default
# gem in the Ruby's standard library must not shadow the bundle's copy.
# Used by .github/workflows/release.yml; needs Docker.
#
#   bin/check-bundle bundle.tar [host image, default ruby:3.4-slim-trixie]
tar_file="$(realpath "$1")"
host="${2:-ruby:3.4-slim-trixie}"
dir="$(mktemp -d)"
trap 'rm -rf "$dir" || true' EXIT

mkdir -p "$dir/app" "$dir/data"
tar -xf "$tar_file" -C "$dir/app"
cat > "$dir/data/check.rb" <<'RUBY'
require "herb"
read = 0
walk = ->(node) do
  if node.respond_to?(:deserialized_prism_node) then node.deserialized_prism_node; read += 1 end
  node.child_nodes.compact.each { walk.(it) } if node.respond_to?(:child_nodes)
end
walk.(Herb.parse("<% if open %><p>x</p><% end %><%= link_to 'a', b %>", prism_nodes: true, analyze: true).value)
abort "Herb read no Ruby through Prism" if read.zero?
puts "Prism #{Prism::VERSION}: Herb read #{read} Ruby nodes; plugins: #{Cms::Plugins.manifests.keys.sort.join(", ")}"
puts [RUBY_VERSION, RbConfig.ruby, Cms::VERSION].join(" ")
RUBY
want="$(sed -n 's/^ARG RUBY_VERSION=//p' Dockerfile)"

# The system packages the image's base stage installs (the Media plugin loads
# libvips as the app boots), then the bundle as the entrypoint runs it.
output="$(docker run --rm -v "$dir/app:/app" -v "$dir/data:/data" -w /app \
  -e RAILS_ENV=production -e BUNDLE_PATH=/app/bundle -e BUNDLE_DEPLOYMENT=1 -e BUNDLE_WITHOUT=development:test \
  -e SECRET_KEY_BASE_DUMMY=1 -e CMS_DATA_DIR=/data -e CMS_RUNTIME=docker \
  "$host" bash -c 'apt-get update -qq && apt-get install --no-install-recommends -y -qq libvips sqlite3 >/dev/null &&
    ./bin/rails db:prepare >/dev/null && ./bin/rails runner /data/check.rb' 2>&1)" || { echo "$output"; exit 1; }
echo "$output"

line="$(echo "$output" | tail -1)"
case "$line" in
  "$want /app/ruby/bin/ruby "*) echo "The bundle runs on its own Ruby $want inside $host." ;;
  *) echo "::error::Expected Ruby $want from /app/ruby, got: $line"; exit 1 ;;
esac
