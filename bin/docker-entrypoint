#!/bin/bash -e

# Databases, uploads, plugins and releases stay where they are whichever
# release runs: an absolute data directory, so a release in it finds them too.
image="${CMS_IMAGE_ROOT:-/rails}" # where the image holds the app (a spec points it elsewhere)
export CMS_DATA_DIR="$(realpath -m "${CMS_DATA_DIR:-$image/storage}")"
image_bundle_path="$BUNDLE_PATH"

# An install that updated itself (Settings › Updates, Upgrade::InPlace) keeps
# the release in its data volume and runs it, until an image at least as new
# is deployed.
current="$CMS_DATA_DIR/releases/current"
release=""
if [ -f "$current/VERSION" ] && ruby -e 'exit Gem::Version.new(File.read(ARGV[0]).strip) > Gem::Version.new(File.read(ARGV[1]).strip)' "$current/VERSION" "$image/VERSION"; then
  release="$(readlink -f "$current")"
  cd "$release"
  export BUNDLE_PATH="$PWD/bundle"
  echo "Running CMS $(cat VERSION) from $PWD (the image holds $(cat "$image/VERSION"))"
fi

# The release that runs, as a symlink (releases/live) Puma runs from: an
# update without downtime points it at the next release and Puma's workers
# restart onto it one at a time (config/puma.rb, Upgrade::InPlace).
point_live() {
  mkdir -p "$CMS_DATA_DIR/releases"
  ln -sfn "$1" "$CMS_DATA_DIR/releases/.live.next"
  mv -T "$CMS_DATA_DIR/releases/.live.next" "$CMS_DATA_DIR/releases/live"
}
export CMS_IMAGE_ROOT="$image" CMS_IMAGE_BUNDLE_PATH="$image_bundle_path"

# Back up the data directory when this release has migrations to run
# (cms:backup_if_pending; a plain restart takes none), and create or migrate
# the database. A fresh data directory gets the site's starter content and no
# demo (db/seeds.rb).
prepare() {
  ./bin/rails cms:backup_if_pending && ./bin/rails db:prepare
}

serving=""
if { [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; } || [ "${@: -1:1}" == "./bin/web" ]; then
  serving=1
fi

if [ -n "$serving" ]; then
  if [ -n "$release" ]; then
    log="$CMS_DATA_DIR/releases/.prepare.log"
    set +e
    prepare 2>&1 | tee "$log"
    status="${PIPESTATUS[0]}"
    set -e
    if [ "$status" -ne 0 ]; then
      # A release this install updated to that won't start goes back to the
      # image's own, rather than a container that never comes up. Why is kept
      # beside it, for Settings › Updates (Upgrade::InPlace#check).
      failed="$CMS_DATA_DIR/releases/$(basename "$release").failed"
      tail -n 40 "$log" > "$failed"
      rm -f "$current"
      echo "CMS $(cat VERSION) didn't start; going back to the image's $(cat "$image/VERSION"). Why: $failed"
      cd "$image"
      export BUNDLE_PATH="$image_bundle_path"
      prepare
    fi
  else
    prepare
  fi
fi

# The web server runs from releases/live, whichever release that is.
if [ -n "$serving" ]; then
  point_live "$(pwd -P)"
  export CMS_APP_DIR="$CMS_DATA_DIR/releases/live"
  cd "$CMS_APP_DIR"
fi

exec "${@}"
