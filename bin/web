#!/usr/bin/env ruby
# frozen_string_literal: true

# The web server: Puma itself, with config/puma.rb, rather than `rails
# server`, which loads the app before Puma starts and so can't restart its
# workers one at a time onto new code (lib/puma/plugin/cms_restart.rb). The
# Docker image runs it behind Thruster (Dockerfile).
require_relative "../config/bundled_ruby"
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
ARGV.unshift("-C", File.expand_path("../config/puma.rb", __dir__)) unless ARGV.include?("-C")
load Gem.bin_path("puma", "puma")
