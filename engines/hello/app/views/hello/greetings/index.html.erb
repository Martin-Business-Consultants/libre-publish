<% @page_title = "Greetings" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<section class="panel panel--padded fields measure--lg">

  <% if Current.user.can?("hello:write") %>
    <%= render "layouts/shared/errors", record: @greeting %>
    <%= form_with model: @greeting, url: hello_greetings_path, scope: :greeting, class: "row" do |form| %>
      <%= form.text_field :message, class: "grow", maxlength: 200, aria: { label: "Greeting" } %>
      <button type="submit" class="btn btn--primary">Say it</button>
    <% end %>
  <% end %>

  <% if @greetings.any? %>
    <ul class="divided">
      <% @greetings.each do |greeting| %>
        <%# herb:key greeting.id %>
        <li id="<%= dom_id(greeting) %>" class="hello-greeting" data-filter-target="item">
          <%= greeting.message %>
          <span class="no-shrink text-small text-muted"><%= time_ago_tag greeting.created_at %></span>
        </li>
      <% end %>
    </ul>
    <%= pagination_nav @pagination %>
  <% else %>
    <p class="empty-state">Nobody has said hello yet.</p>
  <% end %>
</section>
