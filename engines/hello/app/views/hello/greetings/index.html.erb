<% @page_title = "Greetings" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%# A plugin's screen, drawn with the admin's kit (Runwell UI, STYLE.md): a ui-card holding a
    form (ui-field, ui-input, ui-button) and a list. What's Hello's alone, the greetings' list,
    is a hello-* class in the plugin's own stylesheet (hello/hello.css), drawn with the kit's
    tokens. %>
<section class="ui-card measure--lg">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Say hello</h2>
    <p class="ui-card__description">Greetings, newest first. The API serves them at /api/hello/greetings.</p>
  </header>

  <% if Current.user.can?("hello:write") %>
    <div class="ui-card__content">
      <%= render "layouts/shared/errors", record: @greeting %>
      <%= form_with model: @greeting, url: hello_greetings_path, scope: :greeting, class: "hello-form" do |form| %>
        <div class="ui-field">
          <%= form.label :message, "Greeting", class: "visually-hidden" %>
          <%= form.text_field :message, class: "ui-input", maxlength: 200, placeholder: "Hello, world" %>
        </div>
        <button type="submit" class="ui-button">Say it</button>
      <% end %>
    </div>
  <% end %>

  <div class="ui-card__content">
    <% if @greetings.any? %>
      <ul class="hello-greetings">
        <% @greetings.each do |greeting| %>
          <%# herb:key greeting.id %>
          <li id="<%= dom_id(greeting) %>" class="hello-greeting" data-filter-target="item">
            <span class="hello-greeting__message"><%= greeting.message %></span>
            <span class="hello-greeting__time"><%= time_ago_tag greeting.created_at %></span>
          </li>
        <% end %>
      </ul>
      <%= pagination_nav @pagination %>
    <% else %>
      <div class="ui-empty">
        <div class="ui-empty__media"><%= icon_tag "reaction" %></div>
        <h3 class="ui-empty__title">No greetings yet</h3>
        <p class="ui-empty__description">Nobody has said hello yet.</p>
      </div>
    <% end %>
  </div>
</section>
