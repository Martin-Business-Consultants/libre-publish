<%# locals: () %>
<%# A dashboard slot: rendered by the core's plugin_slots(:dashboard) while the plugin is on. %>
<section class="panel panel--padded stack stack--sm">
  <h2 class="heading">Greetings</h2>
  <% latest = Hello::Greeting.newest_first.first %>
  <p class="text-body"><%= latest ? latest.message : "Nobody has said hello yet." %></p>
  <% if Current.user&.can?("hello:read") %>
    <%= link_to "All greetings", hello_greetings_path, class: "link" %>
  <% end %>
</section>
