<%# locals: () %>
<%# A dashboard slot: rendered by the core's plugin_slots(:dashboard) while the plugin is on.
    A ui-card, as the dashboard's own cards are. %>
<% latest = Hello::Greeting.newest_first.first %>
<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Greetings</h2>
    <p class="ui-card__description">The latest from the Hello plugin.</p>
    <% if Current.user&.can?("hello:read") %>
      <div class="ui-card__action">
        <%= link_to "All greetings", hello_greetings_path, class: "ui-button ui-button--outline ui-button--sm" %>
      </div>
    <% end %>
  </header>
  <div class="ui-card__content">
    <p class="hello-greeting__message"><%= latest ? latest.message : "Nobody has said hello yet." %></p>
  </div>
</section>
