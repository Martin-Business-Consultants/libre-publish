<%# locals: () %>
<%# A dashboard slot: rendered by the core's plugin_slots(:dashboard) while the plugin is on. %>
<section class="<%= ui(:panel, "space-y-2 p-5") %>">
  <h2 class="<%= ui(:heading) %>">Greetings</h2>
  <% latest = Hello::Greeting.newest_first.first %>
  <p class="text-sm text-gray-700"><%= latest ? latest.message : "Nobody has said hello yet." %></p>
  <% if Current.user&.can?("hello:read") %>
    <%= link_to "All greetings", hello_greetings_path, class: ui(:link, "text-sm") %>
  <% end %>
</section>
