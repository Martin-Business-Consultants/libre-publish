<% @page_title = "Hello" %>

<%= render "layouts/shared/page_header", title: "Hello" %>

<section class="panel panel--padded fields measure--lg">
  <p class="text-muted">A plugin's settings page. Pages published since the plugin was switched on: <%= @settings["pages_published"].to_i %>.</p>

  <%= form_with url: hello_settings_path, method: :patch, scope: :settings, class: "fields" do |form| %>
    <%= settings_field "Default greeting", hint: "What the Greetings form starts with." do %>
      <%= form.text_field :default_message, value: @settings["default_message"], maxlength: 200 %>
    <% end %>
    <div><button type="submit" class="btn btn--primary">Save</button></div>
  <% end %>
</section>
