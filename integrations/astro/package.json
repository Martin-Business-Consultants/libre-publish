{
  "name": "@libre-publish/astro",
  "version": "0.1.0",
  "description": "Build an Astro site on libre-publish (the Rails CMS), held to its delivery API's recorded contract: schema-locked typed content loaders, live collections, generated types, blocks with a component for every block type, rich text, images, SEO, sitemap, redirects, cache purges and build reports",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-Business-Consultants/libre-publish.git",
    "directory": "integrations/astro"
  },
  "keywords": ["astro-integration", "withastro", "cms", "headless-cms", "libre-publish", "cloudflare"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./rich-text": { "types": "./dist/rich-text.d.ts", "default": "./dist/rich-text.js" },
    "./loaders": { "types": "./dist/loaders.d.ts", "default": "./dist/loaders.js" },
    "./live": { "types": "./dist/live.d.ts", "default": "./dist/live.js" },
    "./schema": { "types": "./dist/schema/zod.d.ts", "default": "./dist/schema/zod.js" },
    "./runtime/*": { "types": "./dist/runtime/*.d.ts", "default": "./dist/runtime/*.js" },
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src/components", "bin"],
  "bin": { "libre-publish-astro": "./bin/libre-publish-astro.mjs" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "markdown-it": "^15.0.2" },
  "peerDependencies": { "astro": "^7.0.0" },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "astro": "^7.4.0",
    "typescript": "^5.9.0"
  }
}
