<%# locals: (global:, open: false) %>
<%# The New global sheet: a name, a slug, and optionally a description and
    an icon; its fields come after, on the schema. It opens by itself at
    /globals/new (the menus link there) and when a submit came back with
    errors. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="btn" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New global</span>
    <kbd class="wide-only">N</kbd>
  </button>
  <dialog class="dialog dialog--sheet" data-dialog-target="dialog" aria-label="New global" closedby="any">
    <h2 class="heading heading--lg">New global</h2>
    <%= render "layouts/shared/errors", record: global %>
    <%= form_with model: global, url: globals_path, class: "fields", data: { controller: "slug", slug_separator_value: "_" } do |form| %>
      <label class="field">
        <span class="label">Name</span>
        <%= form.text_field :name, placeholder: "General", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
      </label>
      <label class="field">
        <span class="label">Slug</span>
        <%= form.text_field :slug, class: "text-mono", placeholder: "general", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="help">How the site and the API name it. It can’t change later.</span>
      </label>
      <label class="field">
        <span class="label">Description <span class="label__note">(optional)</span></span>
        <%= form.text_area :description, rows: 2 %>
      </label>
      <label class="field">
        <span class="label">Icon <span class="label__note">(optional)</span></span>
        <%= form.text_field :icon, placeholder: "Globe", autocomplete: "off" %>
      </label>
      <div class="dialog__actions">
        <button type="button" class="btn" data-action="dialog#close">Cancel</button>
        <%= form.button "Create global", class: "btn btn--primary" %>
      </div>
    <% end %>
  </dialog>
</div>
