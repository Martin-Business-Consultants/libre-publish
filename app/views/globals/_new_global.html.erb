<%# locals: (global:, open: false) %>
<%# The New global sheet: a name, a slug, and optionally a description and
    an icon; its fields come after, on the schema. It opens by itself at
    /globals/new (the menus link there) and when a submit came back with
    errors. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="btn btn--secondary" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New global</span>
    <kbd>N</kbd>
  </button>
  <dialog class="dialog sheet" data-dialog-target="dialog" aria-label="New global" closedby="any">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title">New global</h2>
        <%= icon_button "close", label: "Close", data: { action: "dialog#close" } %>
      </header>
      <%= render "layouts/shared/errors", record: global %>
      <%= form_with model: global, url: globals_path, class: "stack", data: { controller: "slug", slug_separator_value: "_" } do |form| %>
        <label class="field">
          <span class="field__label">Name</span>
          <%= form.text_field :name, placeholder: "General", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
        </label>
        <label class="field">
          <span class="field__label">Slug</span>
          <%= form.text_field :slug, class: "mono", placeholder: "general", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
          <span class="field__hint">How the site and the API name it. It can’t change later.</span>
        </label>
        <label class="field">
          <span class="field__label">Description <span class="faint">(optional)</span></span>
          <%= form.text_area :description, rows: 2 %>
        </label>
        <label class="field">
          <span class="field__label">Icon <span class="faint">(optional)</span></span>
          <%= form.text_field :icon, placeholder: "Globe", autocomplete: "off" %>
        </label>
        <div class="dialog__actions">
          <button type="button" class="btn btn--ghost" data-action="dialog#close">Cancel</button>
          <%= form.button "Create global", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
