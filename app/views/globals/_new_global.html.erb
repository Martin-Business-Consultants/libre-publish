<%# locals: (global:, open: false) %>
<%# The New global sheet: a name, a slug, and optionally a description and
    an icon; its fields come after, on the schema. It opens by itself at
    /globals/new (the menus link there) and when a submit came back with
    errors. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="ui-button ui-button--outline" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New global</span>
    <kbd class="wide-only">N</kbd>
  </button>
  <dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-label="New global" closedby="any">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title">New global</h2>
      <p class="ui-dialog__description">Content the whole site shares, such as its navigation or footer. Its fields come after, on its schema.</p>
    </header>
    <%= render "layouts/shared/errors", record: global %>
    <%= form_with model: global, url: globals_path, class: "ui-fieldset", data: { controller: "slug", slug_separator_value: "_" } do |form| %>
      <label class="ui-field">
        <span class="ui-label">Name</span>
        <%= form.text_field :name, placeholder: "General", autocomplete: "off", autofocus: true, data: { slug_target: "source", action: "slug#fill" }, class: "ui-input" %>
      </label>
      <label class="ui-field">
        <span class="ui-label">Slug</span>
        <%= form.text_field :slug, class: "ui-input text-mono", placeholder: "general", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="ui-field__description">How the site and the API name it. It can’t change later.</span>
      </label>
      <label class="ui-field">
        <span class="ui-label">Description <span class="text-muted">(optional)</span></span>
        <%= form.text_area :description, rows: 2, class: "ui-textarea" %>
      </label>
      <label class="ui-field">
        <span class="ui-label">Icon <span class="text-muted">(optional)</span></span>
        <%= form.text_field :icon, placeholder: "Globe", autocomplete: "off", class: "ui-input" %>
      </label>
      <footer class="ui-dialog__footer">
        <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
        <%= form.button "Create global", class: "ui-button" %>
      </footer>
    <% end %>
  </dialog>
</div>
