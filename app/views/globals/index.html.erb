<% @page_title = "Globals" %>
<% can_write = Current.user.can?("globals:write") %>
<% can_delete = Current.user.can?("globals:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "globals/new_global", global: @new_global || Global.new, open: @new_global.present? %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% selectable = can_delete && @globals.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_actions", id: "globals_bulk", noun: "global", deletion_path: (globals_bulk_deletions_path if can_delete && @globals.any?) %>

  <%= render "ui/data_table", id: "globals",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:slug, "Slug"), ui_column(:fields, "Fields", align: :end),
                   ui_column(:updated, "Updated") ],
        rows: @globals, row: "globals/row", as: :global, pagination: @pagination,
        selectable: selectable, actions: true, row_locals: { can_write: can_write, can_delete: can_delete },
        empty: search_term ? "No globals match." : "No globals yet.", empty_link: ([ "Show all", globals_path ] if search_term) %>
</div>
