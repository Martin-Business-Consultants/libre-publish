<% @page_title = "Globals" %>
<% can_write = Current.user.can?("globals:write") %>
<% can_delete = Current.user.can?("globals:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "globals/new_global", global: @new_global || Global.new, open: @new_global.present? %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% if can_delete && @globals.any? %>
  <%= render "layouts/shared/bulk_actions", id: "globals_bulk", noun: "global", deletion_path: globals_bulk_deletions_path %>
<% end %>

<section class="card overflow-x-auto" data-controller="select-all">
  <table class="data-table table">
    <thead>
      <tr class="table-row">
        <% if can_delete %>
          <th class="table-head data-table__check"><% if @globals.any? %><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"><% end %></th>
        <% end %>
        <th class="table-head">Name</th>
        <th class="table-head">Slug</th>
        <th class="table-head text-right">Fields</th>
        <th class="table-head">Updated</th>
      </tr>
    </thead>
    <tbody>
      <% @globals.each do |global| %>
        <%# herb:key global.id %>
        <tr id="<%= dom_id(global) %>" class="table-row hover:bg-muted" data-filter-target="item">
          <% if can_delete %>
            <td class="table-cell data-table__check"><input type="checkbox" data-select-all-target="box" data-action="select-all#sync" name="slugs[]" value="<%= global.slug %>" form="globals_bulk" aria-label="Select <%= global.name %>"></td>
          <% end %>
          <td class="table-cell">
            <%= link_to global.name, (can_write ? edit_global_path(global.slug) : global_schema_path(global.slug)), class: "font-medium text-foreground hover:underline" %>
            <% if global.description.present? %>
              <div class="text-xs text-muted-foreground"><%= global.description %></div>
            <% end %>
            <%= render "layouts/shared/row_links",
                  links: [ ([ "Edit", edit_global_path(global.slug) ] if can_write), ([ "Schema", global_schema_path(global.slug) ] if can_write) ].compact,
                  delete_path: (global_path(global.slug) if can_delete), delete_name: global.name, delete_label: "Trash",
                  delete_message: "It goes to the trash, where it can be restored." %>
          </td>
          <td class="table-cell"><span class="font-mono text-xs text-muted-foreground"><%= global.slug %></span></td>
          <td class="table-cell text-right tabular-nums"><%= global.fields.size %></td>
          <td class="table-cell"><span class="whitespace-nowrap text-xs text-muted-foreground"><%= time_ago_tag global.updated_at %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No globals yet.", columns: can_delete ? 5 : 4) if @globals.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
