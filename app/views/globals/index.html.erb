<% @page_title = "Globals" %>
<% can_write = Current.user.can?("globals:write") %>
<% can_delete = Current.user.can?("globals:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "globals/new_global", global: @new_global || Global.new, open: @new_global.present? %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, actions: false %>

<%= render "layouts/shared/bulk_actions", id: "globals_bulk", noun: "global", deletion_path: (globals_bulk_deletions_path if can_delete && @globals.any?) %>

<section class="table-wrap" data-controller="select-all">
  <table class="table data-table">
    <thead>
      <tr>
        <% if can_delete %>
          <th class="data-table__check"><% if @globals.any? %><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"><% end %></th>
        <% end %>
        <th>Name</th>
        <th>Slug</th>
        <th class="data-table__num">Fields</th>
        <th>Updated</th>
        <th class="data-table__actions-header"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @globals.each do |global| %>
        <%# herb:key global.id %>
        <tr id="<%= dom_id(global) %>" data-filter-target="item">
          <% if can_delete %>
            <td class="data-table__check"><input type="checkbox" data-select-all-target="box" data-keys="x" data-action="select-all#sync" name="slugs[]" value="<%= global.slug %>" form="globals_bulk" aria-label="Select <%= global.name %>"></td>
          <% end %>
          <td>
            <%= link_to global.name, (can_write ? edit_global_path(global.slug) : global_schema_path(global.slug)), class: "row-link" %>
            <% if global.description.present? %>
              <div class="small muted"><%= global.description %></div>
            <% end %>
          </td>
          <td><span class="mono small muted"><%= global.slug %></span></td>
          <td class="data-table__num"><%= global.fields.size %></td>
          <td><span class="nowrap small muted"><%= time_ago_tag global.updated_at %></span></td>
          <%= render "layouts/shared/row_actions", name: global.name,
                edit_path: (edit_global_path(global.slug) if can_write),
                links: [ ([ "Schema", global_schema_path(global.slug) ] if can_write) ].compact,
                delete_path: (global_path(global.slug) if can_delete), delete_name: global.name, delete_label: "Trash",
                delete_message: "It goes to the trash, where it can be restored." %>
        </tr>
      <% end %>
      <%= table_empty_row("No globals yet.", columns: can_delete ? 6 : 5) if @globals.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
