<% @page_title = "Revision" %>
<%= parent_page "Revisions", global_versions_path(@global.slug) %>
<% content_for :page_actions do %>
  <%= link_to "All revisions", global_versions_path(@global.slug), class: ui(:button) %>
<% end %>
<%= render "layouts/shared/page_header", title: "Compare a revision of “" + @global.name + "”" %>
<section class="<%= ui(:panel, "mt-4 flex flex-col gap-5 p-6 text-left") %>">
  <%= render "versions/comparison", version: @version, restore_path: global_version_restoration_path(@global.slug, @version),
        can_restore: Current.user.can?("globals:write") && Current.user.can?("globals:publish") &&
          (@global.slug != Global::SCRIPTS_SLUG || Current.user.can?("globals:scripts")) %>
</section>
