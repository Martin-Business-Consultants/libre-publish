<% @page_title = "Schema: " + @global.name %>
<%= parent_page "Globals", globals_path %>

<% content_for :page_actions do %>
  <%= link_to "Edit its content", edit_global_path(@global.slug), class: "btn" %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<%= render "layouts/shared/errors", record: @global %>
<%= form_with url: global_schema_path(@global.slug), method: :patch, class: "stack stack--lg" do %>
  <%= render "schemas/editor", fields: @global.fields, scope: "global", field_types: Global::FIELD_TYPES,
        collection_slugs: Collection.order(:slug).pluck(:slug) %>
  <div>
    <button type="submit" class="btn btn--primary">Save schema</button>
  </div>
<% end %>
