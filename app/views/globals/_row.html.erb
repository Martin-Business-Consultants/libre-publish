<%# locals: (global:, can_write:, can_delete:) %>
<%# One global in the globals data table (globals/index): its name and what it's for, opening
    it, its slug, how many fields, when it changed, and its actions (Edit, Schema, Trash). %>
<tr id="<%= dom_id(global) %>" data-filter-target="item">
  <% if can_delete %>
    <%= ui_select_cell global.slug, label: "Select #{global.name}", form: "globals_bulk", name: "slugs[]" %>
  <% end %>
  <td data-column="name">
    <%= link_to global.name, (can_write ? edit_global_path(global.slug) : global_schema_path(global.slug)), class: "ui-table__row-link" %>
    <% if global.description.present? %>
      <div class="text-small text-muted"><%= global.description %></div>
    <% end %>
  </td>
  <td data-column="slug"><span class="text-mono text-small text-muted"><%= global.slug %></span></td>
  <td data-column="fields" class="ui-table__numeric"><%= global.fields.size %></td>
  <td data-column="updated"><span class="nowrap text-muted"><%= time_ago_tag global.updated_at %></span></td>
  <td class="ui-table__numeric">
    <%= render "ui/row_actions", id: dom_id(global), name: global.name,
          links: [ ([ "Edit", edit_global_path(global.slug) ] if can_write), ([ "Schema", global_schema_path(global.slug) ] if can_write) ].compact,
          delete_path: (global_path(global.slug) if can_delete), delete_label: "Move to trash",
          delete_message: "It goes to the trash, where it can be restored." %>
  </td>
</tr>
