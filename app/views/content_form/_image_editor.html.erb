<%# The preview's image editor (image-editor controller): an image a block
    uses, cropped (free, as it is, or to a shape), turned, flipped, and its
    brightness, contrast and saturation changed, then saved as a copy
    (file_manager/assets/image_edits) that the block's field takes. Opened by
    the preview's "Crop & edit" (website-preview). %>
<dialog class="ui-dialog image-editor"
        aria-label="Edit image" data-controller="image-editor"
        data-image-editor-source-url-value="<%= file_manager_asset_image_edit_path(asset_id: "ASSET_ID") %>"
        data-action="image-editor:open@window->image-editor#open">
  <header class="image-editor__header">
    <h2 class="ui-dialog__title" data-image-editor-target="title">Edit image</h2>
    <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#close">Cancel</button>
  </header>

  <div class="image-editor__body">
    <div class="image-editor__stage" data-image-editor-target="stage">
      <canvas class="image-editor__canvas" data-image-editor-target="canvas"></canvas>
      <div class="image-editor__crop" data-image-editor-target="crop" data-action="pointerdown->image-editor#grab">
        <span class="image-editor__handle" data-corner="nw"></span>
        <span class="image-editor__handle" data-corner="ne"></span>
        <span class="image-editor__handle" data-corner="sw"></span>
        <span class="image-editor__handle" data-corner="se"></span>
      </div>
      <p class="image-editor__loading" data-image-editor-target="loading">Loading…</p>
    </div>

    <div class="image-editor__tools">
      <section class="image-editor__group">
        <h3 class="ui-label">Crop</h3>
        <div class="image-editor__chips">
          <% [["Free", ""], ["Original", "original"], ["1:1", "1"], ["4:3", "1.3333"], ["3:2", "1.5"], ["16:9", "1.7778"], ["3:4", "0.75"]].each do |chip_label, ratio| %>
            <%# herb:key chip_label %>
            <button type="button" class="ui-button ui-button--outline ui-button--sm" data-ratio="<%= ratio %>" data-image-editor-target="ratio" data-action="image-editor#aspect"><%= chip_label %></button>
          <% end %>
        </div>
      </section>
      <section class="image-editor__group">
        <h3 class="ui-label">Turn and flip</h3>
        <div class="image-editor__chips">
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#rotateLeft" title="Turn left">⟲ Left</button>
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#rotateRight" title="Turn right">⟳ Right</button>
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#flipX">⇋ Flip across</button>
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#flipY">⇵ Flip over</button>
        </div>
      </section>
      <section class="image-editor__group">
        <h3 class="ui-label">Adjust</h3>
        <% [["Brightness", "brightness"], ["Contrast", "contrast"], ["Saturation", "saturation"]].each do |adjust_label, key| %>
          <%# herb:key key %>
          <label class="image-editor__slider">
            <span class="image-editor__slider-label"><span><%= adjust_label %></span><output data-image-editor-target="output" data-key="<%= key %>">0</output></span>
            <input type="range" min="-100" max="100" step="1" value="0" data-key="<%= key %>" data-image-editor-target="slider" data-action="input->image-editor#adjust">
          </label>
        <% end %>
      </section>
      <div class="image-editor__footer">
        <p class="ui-field__description">Saved as a copy beside the original, so anywhere else the original is used stays as it is.</p>
        <p class="ui-field__error" data-image-editor-target="error" hidden></p>
        <div class="image-editor__actions">
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="image-editor#reset">Reset</button>
          <button type="button" class="ui-button ui-button--sm" data-image-editor-target="saveButton" data-action="image-editor#save">Use this image</button>
        </div>
      </div>
    </div>
  </div>
</dialog>
