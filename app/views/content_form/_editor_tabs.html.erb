<%# locals: (record:, kind:) %>
<%# An editor's tabs: Edit (the form, yielded); SEO, for a record that has
    it — the form's own SEO panel (content_form/seo), so it saves with the
    rest; and JSON, the record as the API hands it to the site
    (api_previews#show, loaded when the tab is first opened). A record not
    saved yet has only the form. %>
<% seo = record.respond_to?(:seo) %>
<% tab_classes = "editor-tabs__tab -mb-px inline-flex items-center gap-1.5 border-b-2 px-3 pb-2.5 pt-1 text-sm font-medium" %>
<% if record.persisted? %>
  <div data-controller="tabs">
    <nav class="mb-6 flex gap-1 overflow-x-auto border-b border-gray-200" role="tablist" aria-label="View">
      <a href="#edit" role="tab" class="<%= tab_classes %>" data-tab="edit" data-tabs-target="tab" data-action="tabs#select">Edit</a>
      <% if seo %>
        <a href="#seo" role="tab" class="<%= tab_classes %>" data-tab="seo" data-tabs-target="tab" data-action="tabs#select">
          <%= icon_tag "search", class: "size-4" %>
          <span>SEO</span>
        </a>
      <% end %>
      <a href="#json" role="tab" class="<%= tab_classes %>" data-tab="json" data-tabs-target="tab" data-action="tabs#select">
        <%= icon_tag "code", class: "size-4" %>
        <span>JSON</span>
      </a>
    </nav>
    <div data-tab="<%= seo ? "edit seo" : "edit" %>" data-tabs-target="panel">
      <%= yield %>
    </div>
    <section class="<%= ui(:panel, "p-6") %>" data-tab="json" data-tabs-target="panel" hidden>
      <turbo-frame id="api_preview" src="<%= api_preview_path(kind, record.id) %>" loading="lazy">
        <p class="text-sm text-gray-500">Loading…</p>
      </turbo-frame>
    </section>
  </div>
<% else %>
  <%= yield %>
<% end %>
