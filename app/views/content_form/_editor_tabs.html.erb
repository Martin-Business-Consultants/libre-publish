<%# locals: (record:, kind:) %>
<%# An editor's tabs: Edit (the form, yielded); SEO, for a record that has
    it — the form's own SEO panel (content_form/seo), so it saves with the
    rest; and JSON, the record as the API hands it to the site
    (api_previews#show, loaded when the tab is first opened); and Preview,
    the page as the theme draws it with what's in the form now, saved or not
    (website_preview), when the install has a theme that draws it. A record
    not saved yet has only the form. %>
<% seo = record.respond_to?(:seo) %>
<%# The JSON a frontend gets: only while this record is served over the API (Serving). %>
<% json = Serving.record?(record) %>
<% preview = kind.in?(%w[page entry]) && Website.enabled? %>
<% tab_classes = "editor-tabs__tab -mb-px inline-flex items-center gap-1.5 border-b-2 px-3 pb-2.5 pt-1 text-sm font-medium" %>
<% if record.persisted? %>
  <%= tag.div data: { controller: ["tabs", ("website-preview" if preview)].compact.join(" "), action: ("tabs:shown->website-preview#shown" if preview),
        website_preview_form_value: ("#{kind}_form" if preview) } do %>
    <nav class="mb-6 flex gap-1 overflow-x-auto border-b border-border" role="tablist" aria-label="View">
      <a href="#edit" role="tab" class="<%= tab_classes %>" data-tab="edit" data-tabs-target="tab" data-action="tabs#select">Edit</a>
      <% if seo %>
        <a href="#seo" role="tab" class="<%= tab_classes %>" data-tab="seo" data-tabs-target="tab" data-action="tabs#select">
          <%= icon_tag "search", class: "size-4" %>
          <span>SEO</span>
        </a>
      <% end %>
      <% if json then %>
        <a href="#json" role="tab" class="<%= tab_classes %>" data-tab="json" data-tabs-target="tab" data-action="tabs#select">
          <%= icon_tag "code", class: "size-4" %>
          <span>JSON</span>
        </a>
      <% end %>
      <% if preview %>
        <a href="#preview" role="tab" class="<%= tab_classes %>" data-tab="preview" data-tabs-target="tab" data-action="tabs#select">
          <%= icon_tag "eye", class: "size-4" %>
          <span>Preview</span>
        </a>
      <% end %>
    </nav>
    <div data-tab="<%= seo ? "edit seo" : "edit" %>" data-tabs-target="panel">
      <%= yield %>
    </div>
    <% if json then %>
      <section class="card p-6" data-tab="json" data-tabs-target="panel" hidden>
        <turbo-frame id="api_preview" src="<%= api_preview_path(kind, record.id) %>" loading="lazy">
          <p class="text-sm text-muted-foreground">Loading…</p>
        </turbo-frame>
      </section>
    <% end %>
    <% if preview %>
      <section class="space-y-3" data-tab="preview" data-tabs-target="panel" hidden>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-sm text-muted-foreground">The website with what’s in the form now. Click text outlined on hover to change it there, then Save (or ⌘S). Nothing is saved until you do.</p>
          <div class="flex gap-2">
            <button type="button" class="btn" data-size="sm" data-website-preview-target="save" data-action="website-preview#save" disabled>Save</button>
            <button type="button" class="btn" data-variant="outline" data-size="sm" data-action="website-preview#refresh">Refresh</button>
            <button type="button" class="btn" data-variant="outline" data-size="sm" data-action="website-preview#openTab">Open in a new tab</button>
          </div>
        </div>
        <iframe name="website-preview-<%= record.id %>" class="website-preview__frame" title="Preview" data-website-preview-target="frame"></iframe>
        <% if MediaLibrary.available? && Current.user.can?("assets:write") %>
          <%= render "content_form/image_editor" %>
        <% end %>
      </section>
    <% end %>
  <% end %>
<% else %>
  <%= yield %>
<% end %>
