<%# locals: (record:, kind:) %>
<%# An editor's tabs: Edit (the form, yielded); SEO, for a record that has
    it — the form's own SEO panel (content_form/seo), so it saves with the
    rest; and JSON, the record as the API hands it to the site
    (api_previews#show, loaded when the tab is first opened); and Preview,
    the page as the theme draws it with what's in the form now, saved or not
    (website_preview), when the install has a theme that draws it. A record
    not saved yet has only the form. %>
<% seo = record.respond_to?(:seo) %>
<%# The JSON a frontend gets: only while this record is served over the API (Serving). %>
<% json = Serving.record?(record) %>
<% preview = kind.in?(%w[page entry]) && Website.enabled? %>
<% if record.persisted? %>
  <%= tag.div data: { controller: ["tabs", ("website-preview" if preview)].compact.join(" "), action: ("tabs:shown->website-preview#shown" if preview),
        website_preview_form_value: ("#{kind}_form" if preview) } do %>
    <% tabs = capture do %>
      <nav class="editor-tabs" role="tablist" aria-label="View">
        <a href="#edit" role="tab" class="editor-tabs__tab" data-tab="edit" data-tabs-target="tab" data-action="tabs#select">Edit</a>
        <% if seo %>
          <a href="#seo" role="tab" class="editor-tabs__tab" data-tab="seo" data-tabs-target="tab" data-action="tabs#select">
            <%= icon_tag "search" %>
            <span>SEO</span>
          </a>
        <% end %>
        <% if json then %>
          <a href="#json" role="tab" class="editor-tabs__tab" data-tab="json" data-tabs-target="tab" data-action="tabs#select">
            <%= icon_tag "code" %>
            <span>JSON</span>
          </a>
        <% end %>
        <% if preview %>
          <a href="#preview" role="tab" class="editor-tabs__tab" data-tab="preview" data-tabs-target="tab" data-action="tabs#select">
            <%= icon_tag "eye" %>
            <span>Preview</span>
          </a>
        <% end %>
      </nav>
    <% end %>
    <%= render "layouts/shared/editor_bar", tabs: tabs %>
    <div data-tab="<%= seo ? "edit seo" : "edit" %>" data-tabs-target="panel">
      <%= yield %>
    </div>
    <% if json then %>
      <section class="panel panel--padded" data-tab="json" data-tabs-target="panel" hidden>
        <turbo-frame id="api_preview" src="<%= api_preview_path(kind, record.id) %>" loading="lazy">
          <p class="text-muted">Loading…</p>
        </turbo-frame>
      </section>
    <% end %>
    <% if preview %>
      <section class="stack stack--md" data-tab="preview" data-tabs-target="panel" hidden>
        <div class="cluster cluster--between">
          <p class="text-muted">The website with what’s in the form now. Click text outlined on hover to change it there, then Save (or ⌘S). Nothing is saved until you do.</p>
          <div class="row">
            <button type="button" class="btn btn--primary btn--sm" data-website-preview-target="save" data-action="website-preview#save" disabled>Save</button>
            <button type="button" class="btn btn--sm" data-action="website-preview#refresh">Refresh</button>
            <button type="button" class="btn btn--sm" data-action="website-preview#openTab">Open in a new tab</button>
          </div>
        </div>
        <iframe name="website-preview-<%= record.id %>" class="website-preview__frame" title="Preview" data-website-preview-target="frame"></iframe>
        <% if MediaLibrary.available? && Current.user.can?("assets:write") %>
          <%= render "content_form/image_editor" %>
        <% end %>
      </section>
    <% end %>
  <% end %>
<% else %>
  <%= render "layouts/shared/editor_bar" %>
  <%= yield %>
<% end %>
