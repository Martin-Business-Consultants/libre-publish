<%# locals: (scope:, item:, refs:, title: nil) %>
<li class="content-list__item" data-sortable-list-target="item">
  <span class="drag-handle" title="Drag to reorder" data-action="mousedown->sortable-list#grab touchstart->sortable-list#grab">⠿</span>
  <% if refs %>
    <%= hidden_field_tag scope.name, item, id: nil %>
    <span class="content-list__ref">
      <span class="content-list__title"><%= title.presence || item %></span>
      <span class="content-list__slug"><%= item %></span>
    </span>
  <% else %>
    <%= text_field_tag scope.name, (item == "__VALUE__" ? nil : item), id: nil, class: "ui-input", autocomplete: "off", aria: { label: "Item" } %>
  <% end %>
  <%= render "content_form/row_moves", noun: "item" %>
</li>
