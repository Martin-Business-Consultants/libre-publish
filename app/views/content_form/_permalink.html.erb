<%# locals: (record:, form:, hint:, required: nil) %>
<%# A record's slug and the address it gives, at the top of its editor's
    sidebar (permalinks always sit in the sidebar): the slug field, then the
    public address once it's saved. %>
<% url = record.persisted? ? record.public_url : nil %>
<label class="ui-field">
  <span class="ui-label">Slug</span>
  <%= form.text_field :slug, required: required, class: "ui-input text-mono", placeholder: "lowercase-with-dashes", autocomplete: "off", spellcheck: false,
        data: { slug_target: "slug", action: "slug#take" } %>
  <span class="ui-field__description"><%= hint %></span>
</label>
<% if url.present? %>
  <div class="ui-field">
    <span class="ui-label">Permalink</span>
    <%= external_link url, url, link_class: "link truncate" %>
  </div>
<% end %>
