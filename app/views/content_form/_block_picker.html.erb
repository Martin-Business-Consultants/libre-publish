<%# locals: (allowed_types: nil) %>
<%# The block types a list may add, grouped by category, with the "/"-style
    filter. Picking one asks the server for its row (sortable-list#insert). %>
<dialog class="dialog dialog--lg content-picker" data-sortable-list-target="picker"
        aria-label="Add a block">
  <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title">Add a block</h2>
      <%= icon_button "close", label: "Close", data: { action: "sortable-list#closePicker" } %>
    </header>
    <input type="search" placeholder="Filter block types…" autocomplete="off" aria-label="Filter block types"
           data-action="input->sortable-list#filterPicker">
    <div class="content-picker__groups">
      <% content_block_type_groups(allowed_types).each do |category, types| %>
        <%# herb:key category %>
        <section class="stack stack--sm">
          <h3 class="small strong muted"><%= category %></h3>
          <%= render "content_form/picker_types", types: types %>
        </section>
      <% end %>
      <% patterns = allowed_types.nil? ? BlockPattern.ordered.to_a : [] %>
      <% if patterns.any? %>
        <section class="stack stack--sm">
          <h3 class="small strong muted">Patterns</h3>
          <ul class="grid-2">
            <% patterns.each do |pattern| %>
              <%# herb:key pattern.slug %>
              <li data-picker-text="<%= [ "pattern", pattern.slug, pattern.name, pattern.description ].compact.join(" ").downcase %>">
                <button type="button" class="picker-option"
                        data-type="pattern:<%= pattern.slug %>" data-action="sortable-list#insert">
                  <span class="picker-option__name"><%= pattern.name %><span class="faint"><%= pattern.synced? ? "synced" : "copy" %></span></span>
                  <% if pattern.description.present? %>
                    <span class="small muted"><%= pattern.description %></span>
                  <% end %>
                </button>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
      <% deprecated = content_deprecated_block_types(allowed_types) %>
      <% if deprecated.any? %>
        <details class="content-picker__deprecated stack stack--sm">
          <summary class="small strong muted">Deprecated (<%= deprecated.size %>)</summary>
          <p class="field__hint">Kept for content that already uses them. They're still added like any other, but a newer type usually does the same job.</p>
          <%= render "content_form/picker_types", types: deprecated %>
        </details>
      <% end %>
    </div>
  </div>
</dialog>
