<%# locals: (field:, item:, scope:, depth:, index: nil) %>
<% summary = content_summary(item, field["of"]) %>
<li class="content-item" data-sortable-list-target="item">
  <%= content_tag :details, class: "content-row", open: index.nil? do %>
    <summary class="content-row__header">
      <span class="drag-handle" title="Drag to reorder" data-action="mousedown->sortable-list#grab touchstart->sortable-list#grab">⠿</span>
      <%= icon_tag "caret-down", class: "content-row__toggle" %>
      <span class="content-row__name grow">
        <% if summary %>
          <%= summary %>
        <% else %>
          <span class="text-muted">Item <%= index ? index + 1 : "" %></span>
        <% end %>
      </span>
      <%= render "content_form/row_moves", noun: "item" %>
    </summary>
    <div class="content-row__body">
      <%= hidden_field_tag scope[ContentForm::ORIGINAL].name, (item.is_a?(Hash) && item.any? ? item.to_json : nil), id: nil %>
      <%= render "content_form/fields", fields: field["of"], values: item, scope: scope, depth: depth + 1 %>
    </div>
  <% end %>
</li>
