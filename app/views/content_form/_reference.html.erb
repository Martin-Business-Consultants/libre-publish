<%# locals: (reference:) %>
<%# How the API and the `cms` CLI name this record, with a copy button. %>
<div class="reference">
  <span class="reference__text">
    <span class="small muted">Reference</span>
    <code class="truncate small"><%= reference %></code>
  </span>
  <%= copy_button reference, label: "Copy the reference", icon_only: true %>
</div>
