<%# locals: (reference:) %>
<%# How the API and the `cms` CLI name this record, with a copy button. %>
<div class="reference">
  <span class="reference__text">
    <span class="reference__label">Reference</span>
    <code><%= reference %></code>
  </span>
  <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm" title="Copy the reference"
          data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= reference %>"
          data-copy-to-clipboard-success-class="ui-button--secondary" data-action="copy-to-clipboard#copy">
    <%= icon_tag "copy-paste" %>
    <span class="visually-hidden">Copy the reference</span>
  </button>
</div>
