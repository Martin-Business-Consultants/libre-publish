<%# locals: (noun:, duplicate: nil, add_below: nil) %>
<%# The move / duplicate / remove buttons of a list row. `:prevent` keeps a
    click in a <summary> from also opening or closing the row. %>

<span class="flex shrink-0 items-center">
  <button type="button" class="btn" data-variant="ghost" data-size="icon" title="Move up" data-action="sortable-list#moveUp:prevent">
    <%= icon_tag "arrow-up", class: "size-4" %>
    <span class="sr-only">Move <%= noun %> up</span>
  </button>
  <button type="button" class="btn" data-variant="ghost" data-size="icon" title="Move down" data-action="sortable-list#moveDown:prevent">
    <%= icon_tag "arrow-up", class: "size-4 rotate-180" %>
    <span class="sr-only">Move <%= noun %> down</span>
  </button>
  <span class="hidden sm:flex">
    <% if add_below %>
      <button type="button" class="btn" data-variant="ghost" data-size="icon" title="Add a block below" data-action="sortable-list#openPicker:prevent">
        <%= icon_tag "add", class: "size-4" %>
        <span class="sr-only">Add a block below</span>
      </button>
    <% end %>
    <% if duplicate %>
      <button type="button" class="btn" data-variant="ghost" data-size="icon" title="Duplicate" data-action="sortable-list#duplicate:prevent">
        <%= icon_tag "copy-paste", class: "size-4" %>
        <span class="sr-only">Duplicate <%= noun %></span>
      </button>
    <% end %>
  </span>
  <button type="button" class="btn text-muted-foreground hover:bg-red-50 hover:text-red-700" data-variant="ghost" data-size="icon" title="Remove" data-action="sortable-list#remove:prevent">
    <%= icon_tag "trash", class: "size-4" %>
    <span class="sr-only">Remove <%= noun %></span>
  </button>
</span>
