<%# locals: (noun:, duplicate: nil, add_below: nil) %>
<%# The move / duplicate / remove buttons of a list row. `:prevent` keeps a
    click in a <summary> from also opening or closing the row. %>
<% move_classes = "btn btn--plain btn--icon" %>
<span class="row-moves">
  <button type="button" class="<%= move_classes %>" title="Move up" data-action="sortable-list#moveUp:prevent">
    <%= icon_tag "arrow-up" %>
    <span class="visually-hidden">Move <%= noun %> up</span>
  </button>
  <button type="button" class="<%= move_classes %>" title="Move down" data-action="sortable-list#moveDown:prevent">
    <%= icon_tag "arrow-up", class: "row-moves__down" %>
    <span class="visually-hidden">Move <%= noun %> down</span>
  </button>
  <span class="row-moves__extra">
    <% if add_below %>
      <button type="button" class="<%= move_classes %>" title="Add a block below" data-action="sortable-list#openPicker:prevent">
        <%= icon_tag "add" %>
        <span class="visually-hidden">Add a block below</span>
      </button>
    <% end %>
    <% if duplicate %>
      <button type="button" class="<%= move_classes %>" title="Duplicate" data-action="sortable-list#duplicate:prevent">
        <%= icon_tag "copy-paste" %>
        <span class="visually-hidden">Duplicate <%= noun %></span>
      </button>
    <% end %>
  </span>
  <button type="button" class="btn btn--plain btn--icon row-moves__remove" title="Remove" data-action="sortable-list#remove:prevent">
    <%= icon_tag "trash" %>
    <span class="visually-hidden">Remove <%= noun %></span>
  </button>
</span>
