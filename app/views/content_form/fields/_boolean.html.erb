<%# locals: (field:, value:, scope:) %>
<label class="checkbox" for="<%= scope.dom_id %>">
  <%= hidden_field_tag scope.name, "0", id: nil %>
  <%= check_box_tag scope.name, "1", value == true || value == "true", id: scope.dom_id %>
  <span class="strong"><%= content_field_label(field) %></span>
</label>
