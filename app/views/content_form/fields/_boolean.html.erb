<%# locals: (field:, value:, scope:) %>
<label class="flex items-center gap-2 text-sm" for="<%= scope.dom_id %>">
  <%= hidden_field_tag scope.name, "0", id: nil %>
  <%= check_box_tag scope.name, "1", value == true || value == "true", id: scope.dom_id %>
  <span class="font-medium text-gray-900"><%= content_field_label(field) %></span>
</label>
