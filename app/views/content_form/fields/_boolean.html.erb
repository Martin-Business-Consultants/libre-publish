<%# locals: (field:, value:, scope:) %>
<label class="ui-field ui-field--inline" for="<%= scope.dom_id %>">
  <%= hidden_field_tag scope.name, "0", id: nil %>
  <%= check_box_tag scope.name, "1", value == true || value == "true", id: scope.dom_id, class: "ui-checkbox" %>
  <span class="ui-label"><%= content_field_label(field) %></span>
</label>
