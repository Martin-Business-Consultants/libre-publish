<%# locals: (field:, value:, scope:) %>
<%# An asset id. With a media library (MediaLibrary), chosen in its picker,
    which the library renders once a page in the content_form slot and which
    answers an "asset-picker:picked" event; without one, typed by hand. %>
<% asset = content_asset(value) %>
<%= render "content_form/label", field: field, for_id: (scope.dom_id unless MediaLibrary.available?) %>
<% if MediaLibrary.available? %>
  <div class="content-asset" data-controller="asset-field" data-asset-field-id-value="<%= scope.dom_id %>">
    <%= hidden_field_tag scope.name, value, id: scope.dom_id, data: { asset_field_target: "input" } %>
    <div class="content-asset__preview" data-asset-field-target="preview">
      <% if asset %>
        <%= media_thumbnail asset, size: 160 %>
      <% end %>
    </div>
    <div class="content-asset__info">
      <span class="content-asset__name" data-asset-field-target="name">
        <% if asset %>
          <%= asset.title %>
        <% elsif value.present? %>
          Asset <%= value %> (missing)
        <% else %>
          No file chosen
        <% end %>
      </span>
      <div class="row">
        <button type="button" class="btn btn--sm" data-action="asset-field#choose">Choose…</button>
        <button type="button" class="btn btn--plain btn--sm" data-action="asset-field#clear">Clear</button>
      </div>
    </div>
  </div>
<% else %>
  <%= text_field_tag scope.name, value, id: scope.dom_id, class: "text-mono", placeholder: "Asset id", autocomplete: "off" %>
  <span class="help">No media library is installed, so give the asset’s id.</span>
<% end %>
