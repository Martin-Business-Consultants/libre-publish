<%# locals: (field:, value:, scope:) %>
<%# Markdown, stored as typed. Write is a plain monospace textarea; Preview
    draws it on the server (markdown_editor_controller). A value an earlier
    rich-text editor saved as HTML shows as it is, and is kept unless edited. %>
<%= render "content_form/label", field: field, for_id: scope.dom_id %>
<div class="flex flex-col gap-2" data-controller="markdown-editor" data-markdown-editor-url-value="<%= markdown_preview_path %>">
  <div class="flex gap-1" role="tablist">
    <button type="button" class="markdown-editor__tab rounded-md px-2.5 py-1 text-xs font-medium" role="tab" aria-selected="true" data-markdown-editor-target="writeTab" data-action="markdown-editor#write">Write</button>
    <button type="button" class="markdown-editor__tab rounded-md px-2.5 py-1 text-xs font-medium" role="tab" aria-selected="false" data-markdown-editor-target="previewTab" data-action="markdown-editor#preview">Preview</button>
  </div>
  <%= text_area_tag scope.name, value, id: scope.dom_id, rows: 10, class: "w-full font-mono leading-relaxed", spellcheck: true, data: { markdown_editor_target: "input" } %>
  <div class="min-h-40 rounded-md border border-gray-200 px-4 py-3" data-markdown-editor-target="output" hidden></div>
</div>
