<%# locals: (types:) %>
<%# The block types a picker offers, one button each (sortable-list#insert);
    the filter matches each item's data-picker-text. %>
<ul class="grid grid--2 grid--sm">
  <% types.each do |block_type| %>
    <%# herb:key block_type.slug %>
    <li data-picker-text="<%= [ block_type.slug, block_type.label, block_type.description ].compact.join(" ").downcase %>">
      <button type="button" class="picker-option" data-type="<%= block_type.slug %>"
              data-action="sortable-list#insert">
        <span class="picker-option__name"><%= block_type.label.presence || block_type.slug %></span>
        <% if block_type.description.present? %>
          <span class="text-small text-muted"><%= block_type.description %></span>
        <% end %>
      </button>
    </li>
  <% end %>
</ul>
