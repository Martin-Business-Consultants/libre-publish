<%# locals: (preview:) %>
<%# A record as its site gets it: where to fetch it, how, and the JSON that
    comes back. This CMS is headless — it keeps content and serves it as this;
    the site (the Astro app) renders it. %>
<% url = request.base_url + preview.path %>
<div class="stack stack--lg">
  <p class="ui-card__description">
    This is exactly what the site receives for this record, as last saved. The CMS never renders it: the site fetches this JSON and draws it with its own components.
    <%= link_to "How frontends work with the CMS", developers_path, class: "link", data: { turbo_frame: "_top" } %>
  </p>

  <div class="ui-field">
    <span class="ui-label">Endpoint</span>
    <div class="row">
      <code class="api-json__code grow">GET <%= url %></code>
      <%= copy_button url %>
    </div>
  </div>

  <details open>
    <summary class="ui-label api-json__summary">Fetch it</summary>
    <pre class="api-json__code api-json__fetch"><%= api_json_cli_call(preview.path) %>   # the cms CLI, or the same tool over MCP</pre>
    <pre class="api-json__code api-json__fetch">curl -H "Authorization: Bearer $CMS_API_TOKEN" "<%= url %>"</pre>
    <pre class="api-json__code api-json__fetch">// In an Astro site with @librepublish/astro: published content only
// (Astro.locals.cms on a page rendered on demand, or createClient from /client)
<%= api_json_client_call(preview.path) %></pre>
  </details>

  <div class="ui-field">
    <div class="row row--between row--base">
      <span class="ui-label">Response</span>
      <%= copy_button preview.json %>
    </div>
    <pre class="api-json__code api-json__body"><code><%= preview.json %></code></pre>
  </div>
</div>
