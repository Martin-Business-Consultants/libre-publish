<% @page_title = "Two-factor verification" %>

<div class="auth-panel">
  <section class="ui-card">
    <header class="ui-card__header auth-panel__header">
      <h1 class="ui-card__title auth-panel__title">Two-factor verification</h1>
      <p class="ui-card__description">Enter the 6-digit code from your authenticator, or one of your single-use recovery codes.</p>
    </header>

    <div class="ui-card__content">
      <%= form_with url: sessions_challenge_path, class: "ui-fieldset", data: { controller: "form" } do |form| %>
        <div class="ui-field">
          <%= form.label :code, "Code", class: "ui-label" %>
          <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "text", class: "ui-input one-time-code", placeholder: "000000" %>
          <p class="ui-field__description">Recovery codes are 16 characters; codes from an authenticator are 6 digits.</p>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Verify</button>
      <% end %>
    </div>
  </section>

  <p class="auth-panel__note">
    <%= link_to "Cancel and sign in as someone else", sign_in_path, class: "auth-panel__link" %>
  </p>
</div>
