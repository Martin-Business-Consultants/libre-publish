<% @page_title = "Two-factor verification" %>

<div class="stack stack--lg">
  <div class="card">
    <div class="card__head">
      <h1 class="public-card__title">Two-factor verification</h1>
      <p class="card__hint">Enter the 6-digit code from your authenticator, or one of your single-use recovery codes.</p>
    </div>

    <%= form_with url: sessions_challenge_path, data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="field__label">Code</span>
        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "text", class: "one-time-code", placeholder: "000000" %>
        <span class="field__hint">Recovery codes are 16 characters; codes from an authenticator are 6 digits.</span>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Verify</span>
        <%= icon_tag "arrow-right" %>
      </button>
    <% end %>
  </div>

  <p class="public-aside">
    <%= link_to "Cancel and sign in as someone else", sign_in_path %>
  </p>
</div>
