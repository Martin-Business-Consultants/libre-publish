<% @page_title = "Two-factor verification" %>

<div class="measure--sm measure--centered stack stack--lg">
  <div class="panel panel--padded stack stack--lg">
    <div class="stack stack--xs">
      <h1 class="title">Two-factor verification</h1>
      <p class="text-muted">Enter the 6-digit code from your authenticator, or one of your single-use recovery codes.</p>
    </div>

    <%= form_with url: sessions_challenge_path, class: "fields", data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="label">Code</span>
        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "text", class: "one-time-code", placeholder: "000000" %>
        <span class="help">Recovery codes are 16 characters; codes from an authenticator are 6 digits.</span>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Verify</span>
        <%= icon_tag "arrow-right", class: "icon--sm" %>
      </button>
    <% end %>
  </div>

  <p class="text-center text-muted">
    <%= link_to "Cancel and sign in as someone else", sign_in_path, class: "link" %>
  </p>
</div>
