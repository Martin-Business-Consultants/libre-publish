<% @page_title = "Log in" %>

<div class="mx-auto w-full max-w-sm">
  <div class="<%= ui(:panel, "p-6") %>">
    <div class="mb-6 space-y-1.5">
      <h1 class="text-xl font-semibold tracking-tight text-gray-900">Log in to your account</h1>
      <p class="text-sm text-gray-500">Enter your email and password below to log in.</p>
    </div>

    <%= form_with url: sign_in_path, class: "space-y-5", data: { controller: "form" } do |form| %>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Email address</span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "w-full", placeholder: "email@example.com", value: params[:email] %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="flex items-center justify-between gap-3">
          <span class="<%= ui(:label) %>">Password</span>
          <%= link_to "Forgot password?", new_identity_password_reset_path, class: ui(:link, "text-xs") %>
        </span>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full", placeholder: "Password" %>
      </label>

      <button type="submit" class="<%= ui(:button, :primary, "w-full") %>" data-form-target="submit">
        <span>Log in</span>
        <%= icon_tag "arrow-right", class: "size-4" %>
      </button>
    <% end %>
  </div>

  <% unless User.exists? %>
    <p class="mt-6 text-center text-sm text-gray-500">
      New install? <%= link_to "Create the owner account", sign_up_path, class: ui(:link) %>
    </p>
  <% end %>
</div>
