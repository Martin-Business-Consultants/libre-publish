<% @page_title = "Log in" %>

<div class="measure--sm measure--centered stack stack--lg">
  <div class="panel panel--padded stack stack--lg">
    <div class="stack stack--xs">
      <h1 class="title"><%= tx("Log in to your account") %></h1>
      <p class="text-muted"><%= tx("Enter your email and password below to log in.") %></p>
    </div>

    <%= form_with url: sign_in_path, class: "fields", data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="label"><%= tx("Email address") %></span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "email@example.com", value: params[:email] %>
      </label>

      <label class="field">
        <span class="row row--between row--md">
          <span class="label"><%= tx("Password") %></span>
          <%= link_to tx("Forgot password?"), new_identity_password_reset_path, class: "link text-small" %>
        </span>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: tx("Password") %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span><%= tx("Log in") %></span>
        <%= icon_tag "arrow-right", class: "icon--sm" %>
      </button>
    <% end %>
  </div>

  <% unless User.exists? %>
    <p class="text-center text-muted">
      <%= tx("New install?") %> <%= link_to tx("Create the owner account"), sign_up_path, class: "link" %>
    </p>
  <% end %>
</div>
