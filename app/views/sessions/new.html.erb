<% @page_title = "Log in" %>

<div class="mx-auto w-full max-w-sm">
  <div class="card p-6">
    <div class="mb-6 space-y-1.5">
      <h1 class="text-xl font-semibold tracking-tight text-foreground"><%= tx("Log in to your account") %></h1>
      <p class="text-sm text-muted-foreground"><%= tx("Enter your email and password below to log in.") %></p>
    </div>

    <%= form_with url: sign_in_path, class: "space-y-5", data: { controller: "form" } do |form| %>
      <label class="flex flex-col gap-1.5">
        <span class="label"><%= tx("Email address") %></span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "w-full", placeholder: "email@example.com", value: params[:email] %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="flex items-center justify-between gap-3">
          <span class="label"><%= tx("Password") %></span>
          <%= link_to tx("Forgot password?"), new_identity_password_reset_path, class: "font-medium text-primary underline underline-offset-2 text-xs" %>
        </span>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full", placeholder: tx("Password") %>
      </label>

      <button type="submit" class="btn w-full" data-form-target="submit">
        <span><%= tx("Log in") %></span>
        <%= icon_tag "arrow-right", class: "size-4" %>
      </button>
    <% end %>
  </div>

  <% unless User.exists? %>
    <p class="mt-6 text-center text-sm text-muted-foreground">
      <%= tx("New install?") %> <%= link_to tx("Create the owner account"), sign_up_path, class: "font-medium text-primary underline underline-offset-2" %>
    </p>
  <% end %>
</div>
