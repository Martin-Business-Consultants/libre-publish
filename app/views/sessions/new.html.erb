<% @page_title = "Log in" %>

<div class="stack stack--lg">
  <div class="card">
    <div class="card__head">
      <h1 class="public-card__title"><%= tx("Log in to your account") %></h1>
      <p class="card__hint"><%= tx("Enter your email and password below to log in.") %></p>
    </div>

    <%= form_with url: sign_in_path, data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="field__label"><%= tx("Email address") %></span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "email@example.com", value: params[:email] %>
      </label>

      <label class="field">
        <span class="row row--between">
          <span class="field__label"><%= tx("Password") %></span>
          <%= link_to tx("Forgot password?"), new_identity_password_reset_path, class: "small" %>
        </span>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: tx("Password") %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span><%= tx("Log in") %></span>
        <%= icon_tag "arrow-right" %>
      </button>
    <% end %>
  </div>

  <% unless User.exists? %>
    <p class="public-aside">
      <%= tx("New install?") %> <%= link_to tx("Create the owner account"), sign_up_path %>
    </p>
  <% end %>
</div>
