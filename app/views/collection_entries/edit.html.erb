<% @page_title = @entry.title.presence || @collection.name.singularize %>
<%= parent_page @collection.name, collection_entries_path(@collection.slug) %>

<% content_for :page_actions do %>
  <% if Current.user.can?("entries:write") %>
    <%= link_to "Add New", new_collection_entry_path(@collection.slug), class: "ui-button ui-button--outline" %>
  <% end %>
<% end %>
<%= render "layouts/shared/errors", record: @entry %>
<%= render layout: "content_form/editor_tabs", locals: { record: @entry, kind: "entry" } do %>
  <%= render "collection_entries/form", collection: @collection, entry: @entry, invalid_json: @invalid_json %>
<% end %>
