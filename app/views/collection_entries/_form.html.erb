<%# locals: (collection:, entry:, invalid_json: nil) %>
<%# An entry's editor, laid out like WordPress's: its name, then its fields,
    blocks (when the collection has them) and body (the Edit tab) or its SEO
    (the SEO tab) in the main column;
    the Publish box, Entry Attributes (slug and permalink, locale, the
    collection's sidebar fields) and taxonomy down the side. %>
<% sidebar_fields = collection.fields.select { it["sidebar"] } %>
<% main_fields = collection.fields.reject { it["sidebar"] } %>
<% fm_scope = content_scope("entry")["frontmatter"] %>
<% trash = entry.persisted? && Current.user.can?("entries:delete") %>
<%= form_with model: entry, url: (entry.persisted? ? collection_entry_path(collection.slug, entry.slug) : collection_entries_path(collection.slug)),
      scope: :entry, id: "entry_form", class: "editor", data: { controller: "form slug", action: "keydown.esc->form#cancel", slug_locked_value: entry.persisted? } do |form| %>
  <%= form.hidden_field :lock_version %>
  <div class="editor__main">
    <div>
      <label class="visually-hidden" for="entry_title">Name</label>
      <%= form.text_field :title, required: true, class: "title-input", placeholder: "Add title", data: { slug_target: "source", action: "slug#fill" }, autofocus: entry.new_record? %>
    </div>

    <%= tag.div class: "stack stack--lg", data: ({ tab: "edit", tabs_target: "panel" } if entry.persisted?) do %>
    <% if main_fields.any? %>
      <%= postbox "entry-fields", "Fields" do %>
        <%= render "content_form/fields", fields: main_fields, values: entry.frontmatter, scope: fm_scope, depth: 1 %>
      <% end %>
    <% end %>

    <% if collection.enable_blocks? %>
      <section class="panel">
        <h2 class="heading editor__section-title">Blocks</h2>
        <div class="editor__section-body">
          <%= render "content_form/blocks", blocks: entry.blocks, scope: content_scope("entry")["blocks"], depth: 1, record: entry %>
        </div>
        <p class="panel__footer"><%= editor_status_line(entry) %></p>
      </section>
    <% end %>

    <section class="panel">
      <h2 class="heading editor__section-title">Body</h2>
      <div class="editor__section-body">
        <%= render "content_form/fields/rich_text", field: { "name" => "body_markdown", "label" => "Body" }, value: entry.body_markdown,
              scope: content_scope("entry")["body_markdown"], markdown: true %>
      </div>
      <% unless collection.enable_blocks? %>
        <p class="panel__footer"><%= editor_status_line(entry) %></p>
      <% end %>
    </section>
    <% end %>

    <%= render "content_form/seo", record: entry, scope: "entry", invalid_json: invalid_json %>
  </div>

  <aside class="editor__aside">
    <%= render "content_form/publish_box", record: entry, form: form, scope: "entry", prefix: "entries", statuses: CollectionEntry::STATUSES.sort,
          trash_name: "this entry", trash_path: (collection_entry_path(collection.slug, entry.slug) if trash), trash_form: ("entry_trash_form" if trash) %>
    <%= plugin_slots(:content_aside, record: entry) if entry.persisted? %>

    <%= postbox "entry-attributes", "Entry Attributes" do %>
      <%= render "content_form/permalink", record: entry, form: form, hint: "Made from the name when blank." %>
      <label class="field">
        <span class="label">Locale</span>
        <%= form.text_field :locale, required: true, placeholder: "en", autocomplete: "off" %>
      </label>
      <% if sidebar_fields.any? %>
        <%= render "content_form/fields", fields: sidebar_fields, values: entry.frontmatter, scope: fm_scope, depth: 1 %>
      <% end %>
      <% if entry.persisted? %>
        <%= render "content_form/reference", reference: collection.slug + "/" + entry.slug %>
      <% end %>
    <% end %>

    <% if entry.category_pool || entry.tag_pool %>
      <%= postbox "entry-taxonomy", "Categories & Tags" do %>
        <%= render "content_form/taxonomy", record: entry, scope: "entry" %>
      <% end %>
    <% end %>
  </aside>

  <%= link_to "Cancel and go back", collection_entries_path(collection.slug), data: { form_target: "cancel" }, hidden: true %>
<% end %>
<% if trash %>
  <%= render "layouts/shared/delete_form", id: "entry_trash_form", path: collection_entry_path(collection.slug, entry.slug) %>
<% end %>
<%= plugin_slots(:content_form) %>
<%= render "content_form/postbox_state" %>
