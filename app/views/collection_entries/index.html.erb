<% @page_title = @collection.name %>
<%= parent_page "Collections", collections_path %>
<% can_write = Current.user.can?("entries:write") %>
<% can_publish = Current.user.can?("entries:publish") %>
<% can_delete = Current.user.can?("entries:delete") %>
<% ticks = can_publish || can_delete %>
<% filtered = @status || search_term %>

<% content_for :page_actions do %>
  <% if @collection.build_board? %>
    <%= link_to "Build", build_collection_entries_path(@collection.slug), class: "ui-button ui-button--outline" %>
  <% end %>
  <% if Current.user.can?("collections:write") %>
    <%= link_to "Schema", collection_schema_path(@collection.slug), class: "ui-button ui-button--outline" %>
  <% end %>
  <% if can_write %>
    <%= render "layouts/shared/new_link", text: "New entry", path: new_collection_entry_path(@collection.slug) %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, icon: @collection.admin_icon %>

<div class="list-filters">
  <%= render "layouts/shared/status_links", param: :status, current: @status.to_s,
        options: [ [ "All", nil, @status_counts.values.sum ] ] + CollectionEntry::STATUSES.filter_map { |status| [ status.humanize, status, @status_counts[status] ] if @status_counts[status].to_i.positive? } %>
</div>

<% selectable = ticks && @entries.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_actions", id: "entries_bulk", noun: "entry",
        status_path: (collection_entries_bulk_status_changes_path(@collection.slug) if can_publish), statuses: CollectionEntry::STATUSES,
        deletion_path: (collection_entries_bulk_deletions_path(@collection.slug) if can_delete) %>

  <%= render "ui/data_table", id: "entries",
        columns: [ ui_column(:title, "Title", hideable: false), ui_column(:slug, "Slug"), ui_column(:status, "Status") ] +
                 @flag_fields.map { |field| ui_column("flag_#{field["name"]}", field_label_text(field)) } +
                 [ ui_column(:updated, "Updated") ],
        rows: @entries, row: "collection_entries/row", as: :entry, pagination: @pagination,
        selectable: selectable, actions: true,
        row_locals: { collection: @collection, flag_fields: @flag_fields, ticks: ticks, can_write: can_write, can_delete: can_delete },
        empty: @status ? "No #{@status} entries." : (search_term ? "No entries match." : "No entries yet."),
        empty_link: ([ "Show all", collection_entries_path(@collection.slug) ] if filtered) %>
</div>
