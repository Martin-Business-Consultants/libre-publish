<%# locals: (fields:, prefix:, field_types:, collection_slugs:, block_slugs: nil) %>
<div class="schema-list stack stack--md" data-prefix="<%= prefix %>">
  <ol class="schema-list__fields stack stack--sm">
    <% Array(fields).each_with_index do |field, index| %>
      <%# herb:key index %>
      <%= render "schemas/field", field: field, prefix: prefix, key: "f" + index.to_s,
            field_types: field_types, collection_slugs: collection_slugs, block_slugs: block_slugs %>
    <% end %>
  </ol>
  <div>
    <button type="button" class="btn btn--sm" data-action="schema-editor#add">
      <%= icon_tag "add" %>
      <span>Add field</span>
    </button>
  </div>
</div>
