<%# locals: (field:, prefix:, key:, field_types:, collection_slugs:, block_slugs: nil) %>
<% name = prefix + "[" + key + "]" %>
<li class="schema-field" data-schema-editor-target="row">
  <div class="schema-field__main">
    <label class="schema-field__control schema-field__control--grow">
      <span class="schema-field__label">Name</span>
      <%= text_field_tag name + "[name]", field["name"], id: nil, class: "text-mono", placeholder: "title",
            autocomplete: "off", spellcheck: false, pattern: "[a-z][a-z0-9_]*",
            title: "Lowercase letters, digits and underscores, starting with a letter", data: { schema_editor_target: "name" } %>
    </label>
    <label class="schema-field__control schema-field__control--grow">
      <span class="schema-field__label">Label</span>
      <%= text_field_tag name + "[label]", field["label"], id: nil, placeholder: "Title", autocomplete: "off" %>
    </label>
    <label class="schema-field__control schema-field__control--grow">
      <span class="schema-field__label">Type</span>
      <%= select_tag name + "[type]", options_for_select(field_type_options(field_types), field["type"]),
            id: nil, class: "schema-field__type" %>
    </label>
    <label class="choice nowrap schema-field__required">
      <%= check_box_tag name + "[required]", "1", field["required"] == true, id: nil %>
      <span>Required</span>
    </label>
    <div class="row row--2xs row--end">
      <button type="button" class="btn btn--plain btn--icon" title="Move up" data-action="schema-editor#moveUp">
        <%= icon_tag "arrow-up" %>
        <span class="visually-hidden">Move up</span>
      </button>
      <button type="button" class="btn btn--plain btn--icon" title="Move down" data-action="schema-editor#moveDown">
        <%= icon_tag "arrow-up", class: "schema-field__down" %>
        <span class="visually-hidden">Move down</span>
      </button>
      <button type="button" class="btn btn--plain btn--icon schema-field__remove" title="Remove this field" data-action="schema-editor#remove">
        <%= icon_tag "trash" %>
        <span class="visually-hidden">Remove this field</span>
      </button>
    </div>
  </div>

  <label class="schema-field__setting" data-for="select">
    <span class="schema-field__label">Choices, one per line</span>
    <%= text_area_tag name + "[options]", SchemaFields.options_text(field), id: nil, rows: 3 %>
  </label>

  <label class="schema-field__setting" data-for="reference">
    <span class="schema-field__label">Pick from collection</span>
    <%= select_tag name + "[of_collection]", options_for_select(reference_collection_options(collection_slugs, field["of_collection"]), field["of_collection"]),
          include_blank: "Any collection", id: nil, class: "schema-field__collection" %>
  </label>

  <% if block_slugs %>
    <fieldset class="schema-field__setting" data-for="blocks">
      <legend class="schema-field__label">Allowed blocks (none ticked means any)</legend>
      <div class="cluster cluster--base">
        <% block_slugs.each do |slug| %>
          <%# herb:key slug %>
          <label class="choice nowrap">
            <%= check_box_tag name + "[allowed_types][]", slug, Array(field["allowed_types"]).include?(slug), id: nil %>
            <span class="text-mono text-small"><%= slug %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <div class="schema-field__setting schema-field__nested" data-for="nested">
    <span class="schema-field__label">Sub-fields</span>
    <%= render "schemas/list", fields: field["of"], prefix: name + "[of]", field_types: field_types,
          collection_slugs: collection_slugs, block_slugs: block_slugs %>
  </div>

  <details>
    <summary class="schema-field__more">More settings</summary>
    <div class="grid grid--2 grid--md schema-field__more-settings">
      <label class="schema-field__control">
        <span class="schema-field__label">Help text</span>
        <%= text_field_tag name + "[help]", field["help"], id: nil %>
      </label>
      <label class="schema-field__control">
        <span class="schema-field__label">Tab</span>
        <%= text_field_tag name + "[tab]", field["tab"], id: nil, placeholder: "Group fields under a tab" %>
      </label>
      <label class="choice nowrap">
        <%= check_box_tag name + "[sidebar]", "1", field["sidebar"] == true, id: nil %>
        <span>Show in the sidebar</span>
      </label>
      <label class="schema-field__control">
        <span class="schema-field__label">Show only if (JSON)</span>
        <%= text_field_tag name + "[show_if]", SchemaFields.show_if_text(field), id: nil, class: "text-mono",
              placeholder: "{\"field\": \"kind\", \"equals\": \"event\"}", spellcheck: false %>
      </label>
    </div>
  </details>

  <%= hidden_field_tag name + "[extra]", SchemaFields.extra_json(field), id: nil %>
</li>
