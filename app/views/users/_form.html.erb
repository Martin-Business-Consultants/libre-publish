<%# locals: (user:) %>
<%# A person's account, laid out like the editors: their name as the title,
    then how they sign in (email and password) in the wider column; their
    role (and what it lets them do), whether their email is verified, when
    they were added and last seen, and saving (or removing them) in the
    narrower one. %>
<% seen = user.persisted? ? user.sessions.maximum(:last_seen_at) : nil %>
<% removable = user.persisted? && Current.user.can?("users:delete") && user != Current.user %>
<%= render "layouts/shared/errors", record: user %>

<%= form_with model: user, id: "user_form", class: "record-form with-sidebar with-sidebar--sticky",
      data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <div>
    <div>
      <label class="visually-hidden" for="user_name">Name</label>
      <%= form.text_field :name, required: true, class: "title-input", autofocus: user.new_record?, autocomplete: "off", placeholder: "Full name" %>
    </div>

    <%= postbox "user-account", "Signing in" do %>
      <div class="fields">
        <%= settings_field "Email", hint: "They sign in with it, and get the workspace's emails at it." do %>
          <%= form.email_field :email, required: true, autocomplete: "off", placeholder: "email@example.com" %>
        <% end %>
        <div class="grid grid--2 fields-grid">
          <%= settings_field (user.new_record? ? "Password" : "New password") do %>
            <%= form.password_field :password, required: user.new_record?, autocomplete: "new-password",
                  placeholder: user.new_record? ? "At least 8 characters" : "Leave blank to keep it" %>
          <% end %>
          <%= settings_field "Confirm password" do %>
            <%= form.password_field :password_confirmation, required: user.new_record?, autocomplete: "new-password" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <aside>
    <% settings = capture do %>
      <div class="fields">
        <%= settings_field "Role" do %>
          <%= form.select :role_id, Role.ordered.map { |role| [role.name, role.id] }, { include_blank: "No role" } %>
        <% end %>
        <% if user.role&.description.present? %>
          <p class="text-small text-muted"><%= user.role.description %></p>
        <% end %>
        <label class="choice">
          <%= form.check_box :verified %>
          <span>Email is verified</span>
        </label>
      </div>
    <% end %>
    <%= render "layouts/shared/save_box", key: "user-save", title: (user.new_record? ? "Add user" : "Save"),
          button: (user.new_record? ? "Add user" : "Save changes"),
          lines: (user.persisted? ? [ [ "calendar", "Added", time_ago_tag(user.created_at) ], [ "history", "Last seen", (seen ? time_ago_tag(seen) : "never") ] ] : nil), extra: settings,
          trash_name: user.name, trash_path: (user_path(user) if removable), trash_form: ("user_delete_form" if removable),
          trash_message: "They can no longer sign in to this workspace." %>
    <%= link_to "Cancel and go back", users_path, data: { form_target: "cancel" }, hidden: true %>
  </aside>
<% end %>
<% if removable %>
  <%= render "layouts/shared/delete_form", id: "user_delete_form", path: user_path(user) %>
<% end %>
<%= render "content_form/postbox_state" %>
