<% @page_title = "Users" %>
<% can_write = Current.user.can?("users:write") %>
<% can_delete = Current.user.can?("users:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "layouts/shared/new_link", text: "New user", path: new_user_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% selectable = can_delete && @users.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_deletion", id: "users_bulk_deletion", path: (users_bulk_deletions_path if can_delete), noun: "user",
        message: "They can no longer sign in. Your own account is never included." %>

  <%= render "ui/data_table", id: "users",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:role, "Role"), ui_column(:verified, "Email"),
                   ui_column(:two_factor, "2FA") ],
        rows: @users, row: "users/row", as: :user, pagination: @pagination, selectable: selectable, actions: true,
        row_locals: { can_write: can_write, can_delete: can_delete },
        empty: search_term ? "No users match." : "No users yet.", empty_link: ([ "Show all", users_path ] if search_term) %>
</div>
