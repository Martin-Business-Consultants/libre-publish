<%# locals: (versions:, pagination:, show_path:) %>
<%# A record's saved versions, newest first. show_path: a lambda from a version
    to its page. %>
<section class="table-wrap">
  <table class="table data-table">
    <thead>
      <tr>
        <th>Saved</th>
        <th>By</th>
        <th>Differs from now</th>
        <th class="data-table__actions-header"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% versions.each do |version| %>
        <%# herb:key version.id %>
        <% changed = version.changes_from_current[:fields].map { it[:key] } %>
        <tr id="<%= dom_id(version) %>" data-filter-target="item">
          <td>
            <%= link_to show_path.call(version), class: "row-link" do %>
              <%= site_time_tag version.created_at %>
            <% end %>
          </td>
          <td><span class="muted"><%= version.author&.name.presence || version.author&.email || "—" %></span></td>
          <td>
            <% if changed.empty? %>
              <span class="muted">Same as now</span>
            <% else %>
              <%= changed.map(&:humanize).to_sentence %>
            <% end %>
          </td>
          <%= render "layouts/shared/row_actions", links: [ [ "Compare", show_path.call(version) ] ] %>
        </tr>
      <% end %>
      <%= table_empty_row("No saved versions yet. One is kept each time the content changes.", columns: 4) if versions.none? %>
    </tbody>
  </table>
</section>

<%= pagination_nav pagination %>
