<%# locals: (field:) %>
<section class="version-field">
  <h3 class="heading heading--sm"><code><%= field[:key] %></code></h3>
  <% case field[:kind] %>
  <% when "text" %>
    <div class="diff-pair">
      <%= render "versions/value", text: field[:before], tone: "del" %>
      <%= render "versions/value", text: field[:after], tone: "add" %>
    </div>
  <% when "lines" %>
    <div class="diff-lines">
      <% field[:lines].each_with_index do |line, index| %>
        <%# herb:key index %>
        <% if line[:op] == "skip" %>
          <div class="diff-lines__line" data-op="skip">… <%= pluralize(line[:count], "unchanged line") %></div>
        <% else %>
          <div class="diff-lines__line" data-op="<%= line[:op] %>"><%= diff_line_marker(line[:op]) %> <%= line[:text] %></div>
        <% end %>
      <% end %>
    </div>
  <% when "object" %>
    <%= render "versions/entries", entries: field[:entries] %>
  <% else %>
    <% touched = field[:blocks].reject { |block| block[:op] == "unchanged" } %>
    <% if touched.empty? %>
      <span class="text-small text-muted">No blocks changed.</span>
    <% end %>
    <% field[:blocks].each_with_index do |block, index| %>
      <%# herb:key index %>
      <% if block[:op] == "unchanged" %>
        <div class="text-small text-muted"><%= block[:index] + 1 %>. <%= block[:type] %>: unchanged</div>
      <% else %>
        <div class="diff-block" data-op="<%= block[:op] %>">
          <span class="text-ink">
            <strong class="text-medium"><%= block[:index] + 1 %>. <%= block[:type] || "block" %></strong>
            <span class="text-muted"><%= block[:op].tr("_", " ") %></span>
            <% if block[:from_index].is_a?(Integer) && block[:from_index] != block[:index] %>
              <span class="text-small text-muted">moved from position <%= block[:from_index] + 1 %></span>
            <% end %>
          </span>
          <% if block[:fields].any? %>
            <%= render "versions/entries", entries: block[:fields] %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>
