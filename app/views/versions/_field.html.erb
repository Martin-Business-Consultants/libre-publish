<%# locals: (field:) %>
<section class="flex flex-col gap-2 border-t border-gray-200 pt-5 text-left">
  <h3 class="text-sm font-semibold text-gray-900"><code><%= field[:key] %></code></h3>
  <% case field[:kind] %>
  <% when "text" %>
    <div class="grid gap-2 sm:grid-cols-2">
      <%= render "versions/value", text: field[:before], tone: "del" %>
      <%= render "versions/value", text: field[:after], tone: "add" %>
    </div>
  <% when "lines" %>
    <div class="overflow-hidden rounded-md border border-gray-200 font-mono text-xs">
      <% field[:lines].each_with_index do |line, index| %>
        <%# herb:key index %>
        <% if line[:op] == "skip" %>
          <div class="bg-gray-50 px-3 py-0.5 text-gray-500">… <%= pluralize(line[:count], "unchanged line") %></div>
        <% else %>
          <div class="<%= class_names("whitespace-pre-wrap break-words px-3 py-0.5", line[:op].to_s == "add" ? "bg-green-50 text-green-800" : (line[:op].to_s == "del" ? "bg-red-50 text-red-800" : "text-gray-700")) %>"><%= diff_line_marker(line[:op]) %> <%= line[:text] %></div>
        <% end %>
      <% end %>
    </div>
  <% when "object" %>
    <%= render "versions/entries", entries: field[:entries] %>
  <% else %>
    <% touched = field[:blocks].reject { |block| block[:op] == "unchanged" } %>
    <% if touched.empty? %>
      <span class="text-xs text-gray-500">No blocks changed.</span>
    <% end %>
    <% field[:blocks].each_with_index do |block, index| %>
      <%# herb:key index %>
      <% if block[:op] == "unchanged" %>
        <div class="text-xs text-gray-500"><%= block[:index] + 1 %>. <%= block[:type] %>: unchanged</div>
      <% else %>
        <div class="<%= class_names("flex flex-col gap-2 rounded-lg border p-3", block[:op] == "added" ? "border-green-200 bg-green-50" : (block[:op] == "removed" ? "border-red-200 bg-red-50" : "border-gray-200 bg-white")) %>">
          <span class="text-sm text-gray-900">
            <strong class="font-medium"><%= block[:index] + 1 %>. <%= block[:type] || "block" %></strong>
            <span class="text-gray-500"><%= block[:op].tr("_", " ") %></span>
            <% if block[:from_index].is_a?(Integer) && block[:from_index] != block[:index] %>
              <span class="text-xs text-gray-500">moved from position <%= block[:from_index] + 1 %></span>
            <% end %>
          </span>
          <% if block[:fields].any? %>
            <%= render "versions/entries", entries: block[:fields] %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>
