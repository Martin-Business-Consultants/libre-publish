<%# locals: (version:, restore_path:, can_restore:) %>
<%# What restoring a version would change: the record as it is now, and what
    the version would bring back. %>
<% diff = version.changes_from_current %>
<p>
  Saved <%= site_time_tag version.created_at %><% if version.author %> by <strong><%= version.author.name.presence || version.author.email %></strong><% end %>.
  <% if diff[:fields].empty? %>
    It matches the content as it is now.
  <% else %>
    Below, “before” is the content now and “after” is this version.
  <% end %>
</p>

<%= render partial: "versions/field", collection: diff[:fields], as: :field %>

<% if can_restore && diff[:fields].any? %>
  <%= form_with url: restore_path, class: "version-restore" do %>
    <button type="submit" class="btn btn--primary">Restore this version</button>
  <% end %>
<% end %>
