<% @page_title = "Schema: " + @collection.name %>
<%= parent_page @collection.name, collection_entries_path(@collection.slug) %>
<% settings = @collection.build_settings %>
<% booleans = @collection.fields.select { it["type"] == "boolean" } %>
<% card_candidates = @collection.fields.select { Collection::BUILD_INLINE_TYPES.include?(it["type"]) && it["name"] != settings["field"] } %>

<% content_for :page_actions do %>
  <%= link_to "Entries", collection_entries_path(@collection.slug), class: ui(:button) %>
  <% if @collection.build_board? %>
    <%= link_to "Build", build_collection_entries_path(@collection.slug), class: ui(:button) %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<%= render "layouts/shared/errors", record: @collection %>

<% panel_classes = "flex flex-col gap-4 p-5" %>
<% check_classes = "flex items-center gap-2 text-sm text-gray-700" %>
<div class="flex flex-col gap-6 lg:flex-row lg:items-start">
  <%= form_with url: collection_schema_path(@collection.slug), method: :patch, id: "collection_schema", class: "flex min-w-0 flex-1 flex-col gap-6" do %>
    <%= render "schemas/editor", fields: @collection.fields, scope: "collection", field_types: Collection::FIELD_TYPES,
          collection_slugs: Collection.where.not(id: @collection.id).order(:slug).pluck(:slug) %>
    <div>
      <button type="submit" class="<%= ui(:button, :primary) %>">Save schema</button>
    </div>
  <% end %>

  <aside class="flex shrink-0 flex-col gap-4 text-left lg:w-80">
    <section class="<%= ui(:panel, panel_classes) %>">
      <h2 class="<%= ui(:heading) %>">Blocks</h2>
      <label class="<%= check_classes %>">
        <%= hidden_field_tag "collection[enable_blocks]", "0", id: nil, form: "collection_schema" %>
        <%= check_box_tag "collection[enable_blocks]", "1", @collection.enable_blocks, id: nil, form: "collection_schema" %>
        <span>Compose each entry from the block library, like pages</span>
      </label>
    </section>

    <section class="<%= ui(:panel, panel_classes) %>">
      <h2 class="<%= ui(:heading) %>">Build board</h2>
      <p class="<%= ui(:help) %>">Two columns standing for one yes/no field; dragging a card across is the edit. Fields added above can be picked once the schema is saved.</p>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Column field</span>
        <%= select_tag "collection[build_config][field]", options_for_select(booleans.map { [ field_label_text(it), it["name"] ] }, settings["field"]),
              include_blank: "No board", id: nil, class: "w-full", form: "collection_schema" %>
      </label>
      <div class="flex gap-3">
        <label class="flex min-w-0 flex-1 flex-col gap-1.5">
          <span class="<%= ui(:label) %>">Left column</span>
          <%= text_field_tag "collection[build_config][off_label]", settings["off_label"], id: nil, class: "w-full", placeholder: "Off", form: "collection_schema" %>
        </label>
        <label class="flex min-w-0 flex-1 flex-col gap-1.5">
          <span class="<%= ui(:label) %>">Right column</span>
          <%= text_field_tag "collection[build_config][on_label]", settings["on_label"], id: nil, class: "w-full", placeholder: "On", form: "collection_schema" %>
        </label>
      </div>
      <fieldset class="flex flex-col gap-2">
        <legend class="<%= ui(:label, "mb-2") %>">The right column also</legend>
        <label class="<%= check_classes %>">
          <%= hidden_field_tag "collection[build_config][also_publish]", "0", id: nil, form: "collection_schema" %>
          <%= check_box_tag "collection[build_config][also_publish]", "1", settings["also_publish"].present?, id: nil, form: "collection_schema" %>
          <span>publishes the entry (and the left returns it to draft)</span>
        </label>
        <% booleans.reject { it["name"] == settings["field"] }.each do |field| %>
          <%# herb:key field["name"] %>
          <label class="<%= check_classes %>">
            <%= check_box_tag "collection[build_config][also_fields][]", field["name"], Array(settings["also_fields"]).include?(field["name"]), id: nil, form: "collection_schema" %>
            <span>turns on <%= field_label_text(field) %></span>
          </label>
        <% end %>
      </fieldset>
      <% if card_candidates.any? %>
        <fieldset class="flex flex-col gap-2">
          <legend class="<%= ui(:label, "mb-2") %>">Edit on the card</legend>
          <% card_candidates.each do |field| %>
            <%# herb:key field["name"] %>
            <label class="<%= check_classes %>">
              <%= check_box_tag "collection[build_config][card_fields][]", field["name"], Array(settings["card_fields"]).include?(field["name"]), id: nil, form: "collection_schema" %>
              <span><%= field_label_text(field) %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
    </section>

    <details class="<%= ui(:panel, "p-5") %>">
      <summary class="<%= ui(:heading) %>">Notifications</summary>
      <div class="mt-4 flex flex-col gap-4">
        <fieldset class="flex flex-col gap-2">
          <legend class="<%= ui(:label, "mb-2") %>">Email on</legend>
          <%= hidden_field_tag "collection[notification_events][]", "", id: nil, form: "collection_schema" %>
          <% Collection::NOTIFICATION_EVENTS.each do |event| %>
            <%# herb:key event %>
            <label class="<%= check_classes %>">
              <%= check_box_tag "collection[notification_events][]", event, Array(@collection.notification_events).include?(event), id: nil, form: "collection_schema" %>
              <span><%= event.delete_prefix("entry.").humanize %></span>
            </label>
          <% end %>
        </fieldset>
        <label class="flex flex-col gap-1.5">
          <span class="<%= ui(:label) %>">Send to</span>
          <%= text_area_tag "collection[notification_emails]", @collection.notification_emails, id: nil, rows: 2, class: "w-full",
                placeholder: "alice@example.com, bob@example.com", form: "collection_schema" %>
          <span class="<%= ui(:help) %>">Comma- or newline-separated. Saved with the schema.</span>
        </label>
      </div>
    </details>

    <section class="<%= ui(:panel, panel_classes) %>">
      <h2 class="<%= ui(:heading) %>">Name and icon</h2>
      <%= form_with model: @collection, url: collection_path(@collection.slug), method: :patch, class: "flex flex-col gap-3" do |form| %>
        <%= form.text_field :name, class: "w-full", autocomplete: "off", aria: { label: "Name" } %>
        <div class="flex items-center gap-2">
          <%= icon_tag @collection.admin_icon, class: "size-5 text-gray-500" %>
          <%= form.select :icon, Collection::Iconic.options, { include_blank: "No icon (stack)" }, class: "min-w-0 flex-1", aria: { label: "Icon" } %>
        </div>
        <div><%= form.button "Save", class: ui(:button, :small) %></div>
      <% end %>
      <p class="<%= ui(:help) %>">Slug: <span class="font-mono"><%= @collection.slug %></span></p>
    </section>
  </aside>
</div>
