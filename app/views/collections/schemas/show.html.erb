<% @page_title = "Schema: " + @collection.name %>
<%= parent_page @collection.name, collection_entries_path(@collection.slug) %>
<% settings = @collection.build_settings %>
<% booleans = @collection.fields.select { it["type"] == "boolean" } %>
<% card_candidates = @collection.fields.select { Collection::BUILD_INLINE_TYPES.include?(it["type"]) && it["name"] != settings["field"] } %>

<% content_for :page_actions do %>
  <%= link_to "Entries", collection_entries_path(@collection.slug), class: "btn btn--secondary" %>
  <% if @collection.build_board? %>
    <%= link_to "Build", build_collection_entries_path(@collection.slug), class: "btn btn--secondary" %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<%= render "layouts/shared/errors", record: @collection %>

<div class="with-aside">
  <%= form_with url: collection_schema_path(@collection.slug), method: :patch, id: "collection_schema", class: "with-aside__main" do %>
    <%= render "schemas/editor", fields: @collection.fields, scope: "collection", field_types: Collection::FIELD_TYPES,
          collection_slugs: Collection.where.not(id: @collection.id).order(:slug).pluck(:slug) %>
    <div>
      <button type="submit" class="btn btn--primary">Save schema</button>
    </div>
  <% end %>

  <aside class="with-aside__aside">
    <section class="card">
      <h2 class="card__title">Blocks</h2>
      <label class="checkbox">
        <%= hidden_field_tag "collection[enable_blocks]", "0", id: nil, form: "collection_schema" %>
        <%= check_box_tag "collection[enable_blocks]", "1", @collection.enable_blocks, id: nil, form: "collection_schema" %>
        <span>Compose each entry from the block library, like pages</span>
      </label>
      <label class="checkbox">
        <%= hidden_field_tag "collection[routable]", "0", id: nil, form: "collection_schema" %>
        <%= check_box_tag "collection[routable]", "1", @collection.routable, id: nil, form: "collection_schema" %>
        <span>Entries have their own page</span>
      </label>
      <p class="card__hint">Off for data that blocks list, like testimonials: those entries stay out of the sitemap, and a frontend needs no template for them.</p>
    </section>

    <section class="card">
      <h2 class="card__title">Build board</h2>
      <p class="field__hint">Two columns standing for one yes/no field; dragging a card across is the edit. Fields added above can be picked once the schema is saved.</p>
      <label class="field">
        <span class="field__label">Column field</span>
        <%= select_tag "collection[build_config][field]", options_for_select(booleans.map { [ field_label_text(it), it["name"] ] }, settings["field"]),
              include_blank: "No board", id: nil, form: "collection_schema" %>
      </label>
      <div class="row">
        <label class="field grow">
          <span class="field__label">Left column</span>
          <%= text_field_tag "collection[build_config][off_label]", settings["off_label"], id: nil, placeholder: "Off", form: "collection_schema" %>
        </label>
        <label class="field grow">
          <span class="field__label">Right column</span>
          <%= text_field_tag "collection[build_config][on_label]", settings["on_label"], id: nil, placeholder: "On", form: "collection_schema" %>
        </label>
      </div>
      <fieldset class="stack stack--sm">
        <legend>The right column also</legend>
        <label class="checkbox">
          <%= hidden_field_tag "collection[build_config][also_publish]", "0", id: nil, form: "collection_schema" %>
          <%= check_box_tag "collection[build_config][also_publish]", "1", settings["also_publish"].present?, id: nil, form: "collection_schema" %>
          <span>publishes the entry (and the left returns it to draft)</span>
        </label>
        <% booleans.reject { it["name"] == settings["field"] }.each do |field| %>
          <%# herb:key field["name"] %>
          <label class="checkbox">
            <%= check_box_tag "collection[build_config][also_fields][]", field["name"], Array(settings["also_fields"]).include?(field["name"]), id: nil, form: "collection_schema" %>
            <span>turns on <%= field_label_text(field) %></span>
          </label>
        <% end %>
      </fieldset>
      <% if card_candidates.any? %>
        <fieldset class="stack stack--sm">
          <legend>Edit on the card</legend>
          <% card_candidates.each do |field| %>
            <%# herb:key field["name"] %>
            <label class="checkbox">
              <%= check_box_tag "collection[build_config][card_fields][]", field["name"], Array(settings["card_fields"]).include?(field["name"]), id: nil, form: "collection_schema" %>
              <span><%= field_label_text(field) %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
    </section>

    <details class="card card--fold">
      <summary class="card__fold-summary">Notifications <%= icon_tag "chevron", class: "fold__chevron" %></summary>
      <div class="stack">
        <fieldset class="stack stack--sm">
          <legend>Email on</legend>
          <%= hidden_field_tag "collection[notification_events][]", "", id: nil, form: "collection_schema" %>
          <% Collection::NOTIFICATION_EVENTS.each do |event| %>
            <%# herb:key event %>
            <label class="checkbox">
              <%= check_box_tag "collection[notification_events][]", event, Array(@collection.notification_events).include?(event), id: nil, form: "collection_schema" %>
              <span><%= event.delete_prefix("entry.").humanize %></span>
            </label>
          <% end %>
        </fieldset>
        <label class="field">
          <span class="field__label">Send to</span>
          <%= text_area_tag "collection[notification_emails]", @collection.notification_emails, id: nil, rows: 2,
                placeholder: "alice@example.com, bob@example.com", form: "collection_schema" %>
          <span class="field__hint">Comma- or newline-separated. Saved with the schema.</span>
        </label>
      </div>
    </details>

    <section class="card">
      <h2 class="card__title">Name and icon</h2>
      <%= form_with model: @collection, url: collection_path(@collection.slug), method: :patch, class: "stack stack--md" do |form| %>
        <%= form.text_field :name, autocomplete: "off", aria: { label: "Name" } %>
        <div class="row">
          <%= icon_tag @collection.admin_icon, class: "icon--md muted" %>
          <%= form.select :icon, Collection::Iconic.options, { include_blank: "No icon (stack)" }, class: "grow", aria: { label: "Icon" } %>
        </div>
        <% if Serving.mode == "website_api" then %>
          <%# Website + API (Serving): this collection's entries as JSON too, or not. %>
          <label class="checkbox">
            <%= form.check_box :api_enabled %>
            <span>Available over the API</span>
          </label>
        <% end %>
        <div><%= form.button "Save", class: "btn btn--secondary btn--sm" %></div>
      <% end %>
      <p class="field__hint">Slug: <span class="mono"><%= @collection.slug %></span></p>
    </section>
  </aside>
</div>
