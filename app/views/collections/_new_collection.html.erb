<%# locals: (collection:, open: false) %>
<%# The New collection sheet: a name, a slug, and optionally a template whose
    fields it starts with; the rest comes after, on the schema. It opens by
    itself at /collections/new (the menus link there) and when a submit came
    back with errors. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="ui-button ui-button--outline" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span>New collection</span>
  </button>
  <dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-label="New collection" closedby="any">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title">New collection</h2>
      <p class="ui-dialog__description">A kind of content with entries of its own, such as posts or products. Its fields come after, on its schema.</p>
    </header>
    <%= render "layouts/shared/errors", record: collection %>
    <%= form_with model: collection, url: collections_path, class: "ui-fieldset", data: { controller: "slug" } do |form| %>
      <label class="ui-field">
        <span class="ui-label">Name</span>
        <%= form.text_field :name, placeholder: "Posts", autocomplete: "off", autofocus: true, data: { slug_target: "source", action: "slug#fill" }, class: "ui-input" %>
      </label>
      <label class="ui-field">
        <span class="ui-label">Slug</span>
        <%= form.text_field :slug, class: "ui-input text-mono", placeholder: "posts", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="ui-field__description">How the site and the API name it. It can’t change later. A template fills both in when left blank.</span>
      </label>

      <fieldset class="ui-fieldset">
        <legend class="ui-label">Start from</legend>
        <div class="ui-radio-group">
          <label class="ui-field ui-field--inline ui-field--card">
            <%= radio_button_tag :template, "", params[:template].blank?, id: nil, class: "ui-radio" %>
            <span class="ui-label">No fields yet</span>
            <span class="ui-field__description">I’ll define them myself.</span>
          </label>
          <% Collection::TEMPLATES.each do |template| %>
            <%# herb:key template["key"] %>
            <label class="ui-field ui-field--inline ui-field--card">
              <%= radio_button_tag :template, template["key"], params[:template] == template["key"], id: nil, class: "ui-radio" %>
              <span class="ui-label"><%= template["name"] %></span>
              <span class="ui-field__description"><%= template["description"] %> · <%= pluralize(template["fields"].size, "field") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <footer class="ui-dialog__footer">
        <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
        <%= form.button "Create collection", class: "ui-button" %>
      </footer>
    <% end %>
  </dialog>
</div>
