<%# locals: (collection:, open: false) %>
<%# The New collection sheet: a name, a slug, and optionally a template whose
    fields it starts with; the rest comes after, on the schema. It opens by
    itself at /collections/new (the menus link there) and when a submit came
    back with errors. %>
<div class="dialog-wrap" data-controller="rune-dialog" data-rune-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->rune-dialog#close:stop">
  <button type="button" class="btn btn--secondary" data-keys="n" data-action="rune-dialog#open">
    <%= icon_tag "add" %>
    <span>New collection</span>
  </button>
  <dialog class="dialog sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="New collection" closedby="any">
    <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title">New collection</h2>
      <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
    </header>
    <%= render "layouts/shared/errors", record: collection %>
    <%= form_with model: collection, url: collections_path, class: "dialog__body", data: { controller: "slug" } do |form| %>
      <label class="field">
        <span class="field__label">Name</span>
        <%= form.text_field :name, placeholder: "Posts", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
      </label>
      <label class="field">
        <span class="field__label">Slug</span>
        <%= form.text_field :slug, class: "mono", placeholder: "posts", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="field__hint">How the site and the API name it. It can’t change later. A template fills both in when left blank.</span>
      </label>

      <fieldset class="field">
        <legend>Start from</legend>
        <div class="template-choices">
          <label class="checkbox checkbox--top template-choice">
            <%= radio_button_tag :template, "", params[:template].blank?, id: nil %>
            <span>No fields yet — I’ll define them</span>
          </label>
          <% Collection::TEMPLATES.each do |template| %>
            <%# herb:key template["key"] %>
            <label class="checkbox checkbox--top template-choice">
              <%= radio_button_tag :template, template["key"], params[:template] == template["key"], id: nil %>
              <span class="stack stack--xs">
                <strong><%= template["name"] %></strong>
                <span class="field__hint"><%= template["description"] %> · <%= pluralize(template["fields"].size, "field") %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="dialog__actions">
        <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
        <%= form.button "Create collection", class: "btn btn--primary" %>
      </div>
    <% end %>
    </div>
  </dialog>
</div>
