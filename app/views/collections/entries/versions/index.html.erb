<% @page_title = "Revisions" %>
<% edit_path = edit_collection_entry_path(@collection.slug, @entry.slug) %>
<%= parent_page @entry.title, edit_path %>
<% content_for :page_actions do %>
  <%= link_to "Back to the entry", edit_path, class: ui(:button) %>
<% end %>
<%= render "layouts/shared/page_header", title: "Revisions of “" + @entry.title.to_s + "”" %>
<%= render "versions/list", versions: @versions, pagination: @pagination,
      show_path: ->(version) { collection_entry_version_path(@collection.slug, @entry.slug, version) } %>
