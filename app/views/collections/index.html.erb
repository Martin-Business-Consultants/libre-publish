<% @page_title = "Collections" %>
<% can_write = Current.user.can?("collections:write") %>
<% can_delete = Current.user.can?("collections:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "collections/new_collection", collection: @new_collection || Collection.new, open: @new_collection.present? %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% if can_delete && @collections.any? %>
  <%= render "layouts/shared/bulk_actions", id: "collections_bulk", noun: "collection", deletion_path: collections_bulk_deletions_path,
        delete_message: "Their entries are deleted with them. This can’t be undone." %>
<% end %>

<section class="card overflow-x-auto" data-controller="select-all">
  <table class="data-table table">
    <thead>
      <tr class="table-row">
        <% if can_delete %>
          <th class="table-head data-table__check w-9"><% if @collections.any? %><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"><% end %></th>
        <% end %>
        <th class="table-head">Name</th>
        <th class="table-head">Slug</th>
        <th class="table-head text-right">Fields</th>
        <th class="table-head text-right">Entries</th>
      </tr>
    </thead>
    <tbody>
      <% @collections.each do |collection| %>
        <%# herb:key collection.id %>
        <tr id="<%= dom_id(collection) %>" class="table-row hover:bg-muted" data-filter-target="item">
          <% if can_delete %>
            <td class="table-cell data-table__check w-9"><input type="checkbox" data-select-all-target="box" data-action="select-all#sync" name="slugs[]" value="<%= collection.slug %>" form="collections_bulk" aria-label="Select <%= collection.name %>"></td>
          <% end %>
          <td class="table-cell">
            <%= link_to collection_entries_path(collection.slug), class: "inline-flex items-center gap-2 font-medium text-foreground hover:underline" do %>
              <%= icon_tag collection.admin_icon, class: "size-4 text-muted-foreground" %>
              <span><%= collection.name %></span>
            <% end %>
            <%= render "layouts/shared/row_links",
                  links: [ [ "Entries", collection_entries_path(collection.slug) ],
                           ([ "Build", build_collection_entries_path(collection.slug) ] if collection.build_board?),
                           ([ "Schema", collection_schema_path(collection.slug) ] if can_write) ].compact,
                  delete_path: (collection_path(collection.slug) if can_delete), delete_name: collection.name,
                  delete_message: "Its entries are deleted with it. This can’t be undone." %>
          </td>
          <td class="table-cell"><span class="font-mono text-xs text-muted-foreground"><%= collection.slug %></span></td>
          <td class="table-cell text-right tabular-nums"><%= collection.fields.size %></td>
          <td class="table-cell text-right tabular-nums"><%= @entry_counts.fetch(collection.id, 0) %></td>
        </tr>
      <% end %>
      <%= table_empty_row("No collections yet. Start from a template, or define the fields yourself.", columns: can_delete ? 5 : 4) if @collections.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
