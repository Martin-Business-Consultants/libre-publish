<% @page_title = "Collections" %>
<% can_write = Current.user.can?("collections:write") %>
<% can_delete = Current.user.can?("collections:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "collections/new_collection", collection: @new_collection || Collection.new, open: @new_collection.present? %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% selectable = can_delete && @collections.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_actions", id: "collections_bulk", noun: "collection", deletion_path: (collections_bulk_deletions_path if can_delete && @collections.any?),
        delete_message: "Their entries are deleted with them. This can’t be undone." %>

  <%= render "ui/data_table", id: "collections",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:slug, "Slug"), ui_column(:fields, "Fields", align: :end),
                   ui_column(:entries, "Entries", align: :end) ],
        rows: @collections, row: "collections/row", as: :collection, pagination: @pagination,
        selectable: selectable, actions: true,
        row_locals: { can_write: can_write, can_delete: can_delete, entry_counts: @entry_counts },
        empty: search_term ? "No collections match." : "No collections yet. Start from a template, or define the fields yourself.",
        empty_link: ([ "Show all", collections_path ] if search_term) %>
</div>
