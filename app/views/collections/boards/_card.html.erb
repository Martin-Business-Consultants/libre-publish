<%# locals: (collection:, entry:, column:, can_move:) %>
<%# A board card. The right-hand column's cards carry the controls the
    collection puts on them; the left only sorts. %>
<article id="<%= dom_id(entry, :card) %>" class="<%= class_names("flex flex-col gap-3 rounded-lg border border-gray-200 bg-white p-3 hover:border-gray-300", "cursor-grab" => can_move) %>"
  data-drag-and-drop-target="item" data-id="<%= entry.slug %>" data-filter-target="item" draggable="<%= can_move %>">
  <div class="flex items-start gap-2">
    <% if can_move %>
      <span class="select-none leading-5 text-gray-400" aria-hidden="true">⠿</span>
    <% end %>
    <%= link_to entry.title, edit_collection_entry_path(collection.slug, entry.slug), class: "min-w-0 flex-1 text-sm font-medium leading-5 text-gray-900 hover:underline" %>
    <% if entry.status != "published" %>
      <%= status_tag entry.status %>
    <% end %>
  </div>
  <% if column == "on" && collection.build_card_fields.any? %>
    <div class="flex flex-col gap-2 border-t border-gray-100 pt-3">
      <% collection.build_card_fields.each do |field| %>
        <%# herb:key field["name"] %>
        <%= render "collections/boards/card_field", collection: collection, entry: entry, field: field %>
      <% end %>
    </div>
  <% end %>
</article>
