<% @page_title = "Roles" %>
<% can_write = Current.user.can?("roles:write") %>
<% can_delete = Current.user.can?("roles:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "layouts/shared/new_link", text: "New role", path: new_role_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% selectable = can_delete && @roles.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_deletion", id: "roles_bulk_deletion", path: (roles_bulk_deletions_path if can_delete), noun: "role",
        message: "Users holding them are left with no role. System roles are never included." %>

  <%= render "ui/data_table", id: "roles",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:description, "Description"),
                   ui_column(:capabilities, "Capabilities", align: :end), ui_column(:users, "Users", align: :end) ],
        rows: @roles, row: "roles/row", as: :role, pagination: @pagination, selectable: selectable, actions: true,
        row_locals: { can_delete: can_delete },
        empty: search_term ? "No roles match." : "No roles yet.", empty_link: ([ "Show all", roles_path ] if search_term) %>
</div>
