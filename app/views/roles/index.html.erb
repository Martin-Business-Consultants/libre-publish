<% @page_title = "Roles" %>

<% content_for :page_actions do %>
  <% if Current.user.can?("roles:write") %>
    <%= render "layouts/shared/new_link", text: "New role", path: new_role_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, actions: false %>

<% can_delete = Current.user.can?("roles:delete") %>
<%= render "layouts/shared/bulk_actions", id: "roles_bulk_deletion", noun: "role", deletion_path: (roles_bulk_deletions_path if can_delete),
      delete_message: "Users holding them are left with no role. System roles are never included." %>

<section class="table-wrap" data-controller="select-all">
  <table class="table data-table">
    <thead>
      <tr>
        <% if can_delete %>
          <th class="data-table__check"><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"></th>
        <% end %>
        <th>Name</th>
        <th>Description</th>
        <th class="data-table__num">Capabilities</th>
        <th class="data-table__num">Users</th>
        <th class="data-table__actions-header"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <%# herb:key role.id %>
        <tr id="<%= dom_id(role) %>" data-filter-target="item">
          <% if can_delete %>
            <td class="data-table__check">
              <% unless role.system? %>
                <input type="checkbox" data-select-all-target="box" data-keys="x" data-action="select-all#sync" name="ids[]" value="<%= role.id %>" form="roles_bulk_deletion" aria-label="Select <%= role.name %>">
              <% end %>
            </td>
          <% end %>
          <td>
            <span class="row">
              <%= link_to role.name, edit_role_path(role), class: "row-link" %>
              <% if role.system? %>
                <%= status_tag "System" %>
              <% end %>
            </span>
          </td>
          <td><span class="muted"><%= role.description %></span></td>
          <td class="data-table__num"><%= role.admin? ? "All" : role.permissions.size %></td>
          <td class="data-table__num"><%= role.users.size %></td>
          <%= render "layouts/shared/row_actions", name: role.name,
                edit_path: edit_role_path(role),
                delete_path: (role_path(role) if can_delete && !role.system?),
                delete_message: "Users holding it are left with no role." %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
