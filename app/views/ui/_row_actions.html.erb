<%# locals: (id:, links: nil, buttons: nil, note: nil, name: nil, edit_path: nil, delete_path: nil, delete_name: nil, delete_message: nil, delete_label: nil) %>
<%# A data table row's actions, as shadcn's: a ⋯ button at the row's end opening a menu of
    them. links: [[label, url], …] after Edit (edit_path). buttons: [[label, url, title], …],
    actions that POST (Restore, Run). note: a line of text in place of an action that isn't
    available. delete_path: the record's delete, last and in red, confirmed in a dialog (which
    sits outside the menu, so it can open after the menu closes). id: unique on the page
    (dom_id of the record). Pass nil for what the record or the role doesn't allow. %>
<% links = ([ ([ "Edit", edit_path ] if edit_path) ] + Array(links)).compact %>
<% buttons = Array(buttons).compact %>
<% if links.any? || buttons.any? || note || delete_path %>
  <% menu_id = "#{id}_actions" %>
  <% title = "Delete " + (delete_name || name || "this") + "?" %>
  <div class="row-actions" data-controller="<%= "dialog" if delete_path %>" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
    <div data-controller="ui--popover" data-ui--popover-align-value="end">
      <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm" popovertarget="<%= menu_id %>" title="<%= tx("Actions") %>">
        <%= icon_tag "menu-dots-horizontal" %>
        <span class="visually-hidden"><%= tx("Actions for %{name}", name: name || delete_name || "this") %></span>
      </button>
      <div class="ui-menu" id="<%= menu_id %>" popover data-ui--popover-target="popover">
        <% links.each do |label, url| %>
          <%# herb:key label %>
          <%= link_to tx(label), url, class: "ui-menu__item" %>
        <% end %>
        <% buttons.each do |label, url, button_title| %>
          <%# herb:key label %>
          <%= button_to tx(label), url, class: "ui-menu__item", form_class: "contents", title: button_title %>
        <% end %>
        <% if note %>
          <div class="ui-menu__label text-muted"><%= note %></div>
        <% end %>
        <% if delete_path %>
          <% if links.any? || buttons.any? || note %>
            <hr class="ui-menu__separator">
          <% end %>
          <button type="button" class="ui-menu__item ui-menu__item--destructive" data-action="dialog#open">
            <%= icon_tag "trash" %> <span><%= tx(delete_label || "Delete") %></span>
          </button>
        <% end %>
      </div>
    </div>
    <% if delete_path %>
      <dialog class="ui-dialog" data-dialog-target="dialog" aria-label="<%= title %>">
        <header class="ui-dialog__header">
          <h2 class="ui-dialog__title"><%= title %></h2>
          <p class="ui-dialog__description"><%= delete_message || "This can’t be undone." %></p>
        </header>
        <footer class="ui-dialog__footer">
          <button type="button" class="ui-button ui-button--outline" data-action="dialog#close"><%= tx("Cancel") %></button>
          <%= button_to delete_path, method: :delete, class: "ui-button ui-button--destructive", data: { turbo_frame: "_top" } do %>
            <%= icon_tag "trash" %>
            <span><%= tx(delete_label || "Delete") %></span>
          <% end %>
        </footer>
      </dialog>
    <% end %>
  </div>
<% end %>
