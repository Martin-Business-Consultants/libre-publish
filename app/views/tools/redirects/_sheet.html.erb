<%# locals: (redirect:) %>
<%# A redirect's form in the list's sheet (the redirect_sheet frame): new, or
    one being edited with its hits. It saves across the whole page
    (turbo_frame _top): done, back to the list; refused, the list again with
    the sheet open. %>
<% deletable = redirect.persisted? && Current.user.can?("redirects:delete") %>
<turbo-frame id="redirect_sheet">
  <div class="sheet-body">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title"><%= redirect.new_record? ? "New redirect" : "Edit redirect" %></h2>
      <p class="ui-dialog__description">Send visitors from an old address to a new one.</p>
    </header>
    <%= render "layouts/shared/errors", record: redirect %>

    <%= form_with model: [:tools, redirect], class: "ui-fieldset", data: { turbo_frame: "_top" } do |form| %>
      <label class="ui-field">
        <span class="ui-label">Source path</span>
        <%= form.text_field :source_path, required: true, class: "ui-input text-mono", autofocus: true, autocomplete: "off", placeholder: "/old-page  or  /old-section/*" %>
        <span class="ui-field__description">A path on this site, with the leading slash. End it with <code class="code">/*</code> to match every path beneath it.</span>
      </label>

      <label class="ui-field">
        <span class="ui-label">Destination</span>
        <%= form.text_field :destination_url, required: true, class: "ui-input text-mono", autocomplete: "off", placeholder: "/new-page  or  https://example.com/new" %>
        <span class="ui-field__description">A path or a full URL. For a wildcard source, end it with <code class="code">/*</code> to carry the rest of the path across.</span>
      </label>

      <label class="ui-field">
        <span class="ui-label">HTTP status</span>
        <%= form.select :status_code, redirect_status_options, {}, { class: "ui-select" } %>
      </label>

      <label class="ui-field ui-field--inline ui-field--end ui-field--card">
        <%= form.check_box :active, class: "ui-switch", role: "switch" %>
        <span class="ui-label">Active</span>
        <span class="ui-field__description">Enforced on requests. Turn it off to keep the rule without applying it.</span>
      </label>

      <label class="ui-field">
        <span class="ui-label">Notes <span class="text-muted">(optional)</span></span>
        <%= form.text_area :notes, rows: 3, placeholder: "Why this redirect exists, or when it can be removed.", class: "ui-textarea" %>
      </label>

      <% if redirect.persisted? %>
        <dl class="fact-list">
          <dt>Hits</dt><dd class="text-tabular"><%= redirect.hit_count %></dd>
          <dt>Last hit</dt><dd><%= redirect.last_hit_at ? time_ago_tag(redirect.last_hit_at) : "never" %></dd>
        </dl>
      <% end %>

      <footer class="ui-dialog__footer">
        <% if deletable %>
          <span class="sheet-body__delete">
            <%= render "layouts/shared/delete_dialog", name: "this redirect", path: tools_redirect_path(redirect), trigger_text: "Delete",
                  form: "redirect_delete_form", message: "Anyone visiting " + redirect.source_path_was.to_s + " will get a 404 instead." %>
          </span>
        <% end %>
        <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
        <%= form.button (redirect.new_record? ? "Add redirect" : "Save changes"), class: "ui-button" %>
      </footer>
    <% end %>
    <% if deletable %>
      <%= render "layouts/shared/delete_form", id: "redirect_delete_form", path: tools_redirect_path(redirect) %>
    <% end %>
  </div>
</turbo-frame>
