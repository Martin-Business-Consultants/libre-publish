<%# locals: (redirect:) %>
<%# A redirect's form in the list's sheet (the redirect_sheet frame): new, or
    one being edited with its hits. It saves across the whole page
    (turbo_frame _top): done, back to the list; refused, the list again with
    the sheet open. %>
<turbo-frame id="redirect_sheet">
  <div class="stack">
    <header class="dialog__header">
      <h2 class="dialog__title"><%= redirect.new_record? ? "New redirect" : "Edit redirect" %></h2>
      <%= icon_button "close", label: "Close", data: { action: "dialog#close" } %>
    </header>
    <%= render "layouts/shared/errors", record: redirect %>

    <%= form_with model: [:tools, redirect], data: { turbo_frame: "_top" } do |form| %>
      <label class="field">
        <span class="field__label">Source path</span>
        <%= form.text_field :source_path, required: true, class: "mono", autofocus: true, autocomplete: "off", placeholder: "/old-page  or  /old-section/*" %>
        <span class="field__hint">A path on this site, with the leading slash. End it with <code>/*</code> to match every path beneath it.</span>
      </label>

      <label class="field">
        <span class="field__label">Destination</span>
        <%= form.text_field :destination_url, required: true, class: "mono", autocomplete: "off", placeholder: "/new-page  or  https://example.com/new" %>
        <span class="field__hint">A path or a full URL. For a wildcard source, end it with <code>/*</code> to carry the rest of the path across.</span>
      </label>

      <label class="field">
        <span class="field__label">HTTP status</span>
        <%= form.select :status_code, redirect_status_options %>
      </label>

      <label class="checkbox checkbox--top">
        <%= form.check_box :active %>
        <span class="stack stack--xs">
          <span class="field__label">Active</span>
          <span class="field__hint">Enforced on requests. Untick to keep the rule without applying it.</span>
        </span>
      </label>

      <label class="field">
        <span class="field__label">Notes <span class="faint">(optional)</span></span>
        <%= form.text_area :notes, rows: 3, placeholder: "Why this redirect exists, or when it can be removed." %>
      </label>

      <% if redirect.persisted? %>
        <dl class="details card card--muted card--sm">
          <dt>Hits</dt><dd class="tabular"><%= redirect.hit_count %></dd>
          <dt>Last hit</dt><dd><%= redirect.last_hit_at ? time_ago_tag(redirect.last_hit_at) : "never" %></dd>
        </dl>
      <% end %>

      <div class="dialog__actions">
        <% if redirect.persisted? && Current.user.can?("redirects:delete") %>
          <span class="redirect-sheet__delete">
            <%= render "layouts/shared/delete_dialog", name: "this redirect", path: tools_redirect_path(redirect), trigger_text: "Delete",
                  message: "Anyone visiting " + redirect.source_path_was.to_s + " will get a 404 instead." %>
          </span>
        <% end %>
        <button type="button" class="btn btn--ghost" data-action="dialog#close">Cancel</button>
        <%= form.button (redirect.new_record? ? "Add redirect" : "Save changes"), class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
