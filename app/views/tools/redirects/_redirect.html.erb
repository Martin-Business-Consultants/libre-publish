<%# locals: (redirect:, can_delete:, can_write:) %>
<%# One rule in the redirects data table (tools/redirects/index): its source, opening it in
    the sheet, where it goes, its HTTP status, whether it's enforced, its hits, and its
    actions. %>
<tr id="<%= dom_id(redirect) %>" data-filter-target="item">
  <% if can_delete %>
    <%= ui_select_cell redirect.id, label: "Select #{redirect.source_path}", form: "redirects_bulk_deletion" %>
  <% end %>
  <td data-column="source">
    <%= link_to redirect.source_path, edit_tools_redirect_path(redirect), class: "ui-table__row-link text-mono",
          data: { turbo_frame: "redirect_sheet", action: "dialog#open" } %>
  </td>
  <td data-column="destination"><span class="text-mono text-small text-muted"><%= redirect.destination_url %></span></td>
  <td data-column="status"><%= ui_badge redirect.status_code.to_s, :outline, title: Redirect::STATUS_LABELS[redirect.status_code] %></td>
  <td data-column="state"><%= status_tag redirect.active ? "Active" : "Disabled" %></td>
  <td data-column="hits" class="ui-table__numeric"><%= redirect.hit_count %></td>
  <td class="ui-table__numeric">
    <%= render "ui/row_actions", id: dom_id(redirect), name: redirect.source_path,
          edit_path: (edit_tools_redirect_path(redirect) if can_write),
          delete_path: (tools_redirect_path(redirect) if can_delete),
          delete_message: "Anyone visiting " + redirect.source_path + " will get a 404 instead." %>
  </td>
</tr>
