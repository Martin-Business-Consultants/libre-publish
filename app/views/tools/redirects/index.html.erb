<% @page_title = "Redirects" %>

<% content_for :page_actions do %>
  <% if Current.user.can?("redirects:write") %>
    <%= link_to new_tools_redirect_path, class: ui(:button), data: { keys: "n", turbo_frame: "redirect_sheet", action: "dialog#open" } do %>
      <%= icon_tag "add", class: "size-4" %>
      <span>New redirect</span>
    <% end %>
  <% end %>
<% end %>
<%# The redirects as a list table. New and Edit open in a sheet beside it
    (tools/redirects/sheet, into the redirect_sheet frame); at their own
    addresses, and when a save is refused, the list opens with it. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= @sheet_redirect.present? %>"
     data-action="keydown.esc->dialog#close:stop">
<%= render "layouts/shared/page_header", title: @page_title %>

<div class="mb-3 flex flex-wrap items-center justify-end gap-2">
  <% if Current.user.can?("redirects:write") %>
    <%= form_with url: tools_redirects_import_path, class: "contents", data: { controller: "form" } do |form| %>
      <label class="<%= ui(:button, :small, "cursor-pointer") %>" title="Import CSV">
        <span>Import CSV</span>
        <%= form.file_field :file, accept: ".csv,text/csv", hidden: true, data: { action: "change->form#submit" } %>
      </label>
    <% end %>
  <% end %>
  <%= link_to tools_redirects_export_path, class: ui(:button, :small), data: { turbo: false } do %>
    <span>Export</span>
  <% end %>
</div>

<% can_delete = Current.user.can?("redirects:delete") %>
<% if can_delete && @redirects.any? %>
  <%= render "layouts/shared/bulk_deletion", id: "redirects_bulk_deletion", path: tools_redirects_bulk_deletions_path,
        noun: "redirect", message: "These rules stop being enforced. This can’t be undone." %>
<% end %>

<section class="<%= ui(:panel, "overflow-x-auto") %>" data-controller="select-all">
  <table class="data-table <%= ui(:table) %>">
    <thead>
      <tr>
        <% if can_delete %>
          <th class="<%= ui(:th, "data-table__check w-9") %>"><% if @redirects.any? %><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"><% end %></th>
        <% end %>
        <th class="<%= ui(:th) %>">Source</th>
        <th class="<%= ui(:th) %>">Destination</th>
        <th class="<%= ui(:th) %>">Status</th>
        <th class="<%= ui(:th) %>">State</th>
        <th class="<%= ui(:th, "text-right") %>">Hits</th>
      </tr>
    </thead>
    <tbody>
      <% @redirects.each do |redirect| %>
        <%# herb:key redirect.id %>
        <%= render "tools/redirects/redirect", redirect: redirect, can_delete: can_delete %>
      <% end %>
      <%= table_empty_row("No redirects yet. Add one, or import a CSV.", columns: can_delete ? 6 : 5) if @redirects.none? %>
    </tbody>
  </table>
</section>

<%= pagination_nav @pagination %>

<dialog class="<%= ui(:sheet) %>" data-dialog-target="dialog" aria-label="Redirect" closedby="any">
  <% if @sheet_redirect %>
    <%= render "tools/redirects/sheet", redirect: @sheet_redirect %>
  <% else %>
    <turbo-frame id="redirect_sheet"><p class="text-sm text-gray-500">Loading…</p></turbo-frame>
  <% end %>
</dialog>
</div>
