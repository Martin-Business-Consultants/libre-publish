<% @page_title = "Redirects" %>
<% can_write = Current.user.can?("redirects:write") %>
<% can_delete = Current.user.can?("redirects:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= form_with url: tools_redirects_import_path, class: "contents", data: { controller: "form" } do |form| %>
      <label class="ui-button ui-button--outline" title="Import CSV">
        <span>Import CSV</span>
        <%= form.file_field :file, accept: ".csv,text/csv", hidden: true, data: { action: "change->form#submit" }, class: "ui-input" %>
      </label>
    <% end %>
  <% end %>
  <%= link_to tools_redirects_export_path, class: "ui-button ui-button--outline", data: { turbo: false } do %>
    <span>Export</span>
  <% end %>
  <% if can_write %>
    <%= link_to new_tools_redirect_path, class: "ui-button ui-button--outline", data: { keys: "n", turbo_frame: "redirect_sheet", action: "dialog#open" } do %>
      <%= icon_tag "add" %>
      <span>New redirect</span>
    <% end %>
  <% end %>
<% end %>
<%# The redirects as a data table. New and Edit open in a sheet beside it
    (tools/redirects/sheet, into the redirect_sheet frame); at their own
    addresses, and when a save is refused, the list opens with it. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= @sheet_redirect.present? %>"
     data-action="keydown.esc->dialog#close:stop">
  <%= render "layouts/shared/page_header", title: @page_title %>

  <% selectable = can_delete && @redirects.any? %>
  <div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
    <%= render "layouts/shared/bulk_deletion", id: "redirects_bulk_deletion", path: (tools_redirects_bulk_deletions_path if can_delete && @redirects.any?),
          noun: "redirect", message: "These rules stop being enforced. This can’t be undone." %>

    <%= render "ui/data_table", id: "redirects",
          columns: [ ui_column(:source, "Source", hideable: false), ui_column(:destination, "Destination"), ui_column(:status, "Status"),
                     ui_column(:state, "State"), ui_column(:hits, "Hits", align: :end) ],
          rows: @redirects, row: "tools/redirects/redirect", as: :redirect, pagination: @pagination,
          selectable: selectable, actions: true, row_locals: { can_delete: can_delete, can_write: can_write },
          empty: search_term ? "No redirects match." : "No redirects yet. Add one, or import a CSV.",
          empty_link: ([ "Show all", tools_redirects_path ] if search_term) %>
  </div>

  <dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-label="Redirect" closedby="any">
    <% if @sheet_redirect %>
      <%= render "tools/redirects/sheet", redirect: @sheet_redirect %>
    <% else %>
      <turbo-frame id="redirect_sheet"><p class="ui-dialog__description">Loading…</p></turbo-frame>
    <% end %>
  </dialog>
</div>
