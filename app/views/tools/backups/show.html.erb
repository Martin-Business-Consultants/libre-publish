<% @page_title = "Backup" %>

<%# The automatic backups as a list table; taking one now is a sheet off the
    title row: what it will hold, and the download. %>
<div class="contents" data-controller="rune-dialog" data-action="keydown.esc->rune-dialog#close:stop">
<% content_for :page_actions do %>
  <button type="button" class="btn btn--secondary" data-keys="n" data-action="rune-dialog#open">
    <%= icon_tag "package" %>
    <span>Download a backup</span>
  </button>
<% end %>
<%= render "layouts/shared/page_header", title: "Backup" %>

<% if @archives.any? %>
  <section class="table-wrap">
    <table class="table data-table">
      <thead>
        <tr>
          <th>Automatic backup</th>
          <th>Taken</th>
          <th class="data-table__num">Size</th>
          <th><span class="visually-hidden">Download</span></th>
        </tr>
      </thead>
      <tbody>
        <% @archives.each do |archive| %>
          <%# herb:key archive.name %>
          <tr id="archive_<%= archive.name.parameterize %>">
            <td class="mono"><%= archive.name %></td>
            <td><span class="nowrap small muted"><%= time_ago_tag archive.taken_at %></span></td>
            <td class="data-table__num nowrap"><%= number_to_human_size(archive.byte_size) %></td>
            <td class="tools-cell-end">
              <% if Current.user.admin? then %>
                <%= link_to "Download", tools_backup_archive_path(archive.name), class: "btn btn--secondary btn--sm", data: { turbo: false } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <div class="empty">
    No automatic backups yet. <code>bin/update</code> takes one before it migrates; the newest few are kept.
  </div>
<% end %>

<dialog class="dialog sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="Download a backup" closedby="any">
  <div class="dialog__box">
  <header class="dialog__header">
    <h2 class="dialog__title">Download a backup</h2>
    <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
  </header>
  <div class="dialog__body">
  <p>The site’s database and every uploaded file, as one .tar.gz. It will hold:</p>
  <ul class="tools-boxed-list">
    <% @contents.each do |kind, count| %>
      <%# herb:key kind %>
      <li><%= number_with_delimiter(count) %> <%= kind.to_s.humanize(capitalize: false) %></li>
    <% end %>
  </ul>
  <p class="small faint">Restoring one is done on the server — see <code>docs/install.md</code>.</p>
  <div class="dialog__actions">
    <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
    <% if Current.user.admin? then %>
      <%= button_to tools_backup_path, class: "btn btn--primary", data: { turbo: false } do %>
        <span>Download backup</span>
      <% end %>
    <% else %>
      <span class="muted">Downloading one takes an admin: it holds every account and secret.</span>
    <% end %>
  </div>
  </div>
  </div>
</dialog>
</div>
