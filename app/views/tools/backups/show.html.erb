<% @page_title = "Backup" %>

<%# The automatic backups as a list table; taking one now is a sheet off the
    title row: what it will hold, and the download. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
<% content_for :page_actions do %>
  <button type="button" class="btn" data-variant="outline" data-keys="n" data-action="dialog#open">
    <%= icon_tag "package", class: "size-4" %>
    <span>Download a backup</span>
  </button>
<% end %>
<%= render "layouts/shared/page_header", title: "Backup" %>

<% if @archives.any? %>
  <section class="card overflow-x-auto">
    <table class="data-table table">
      <thead>
        <tr class="table-row">
          <th class="table-head">Automatic backup</th>
          <th class="table-head">Taken</th>
          <th class="table-head text-right">Size</th>
          <th class="table-head"><span class="sr-only">Download</span></th>
        </tr>
      </thead>
      <tbody>
        <% @archives.each do |archive| %>
          <%# herb:key archive.name %>
          <tr id="archive_<%= archive.name.parameterize %>" class="table-row hover:bg-muted">
            <td class="table-cell font-mono text-xs"><%= archive.name %></td>
            <td class="table-cell"><span class="text-xs whitespace-nowrap text-muted-foreground"><%= time_ago_tag archive.taken_at %></span></td>
            <td class="table-cell text-right tabular-nums whitespace-nowrap"><%= number_to_human_size(archive.byte_size) %></td>
            <td class="table-cell text-right">
              <% if Current.user.admin? then %>
                <%= link_to "Download", tools_backup_archive_path(archive.name), class: "btn", data: {variant: "outline", size: "sm", turbo: false} %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <div class="card px-6 py-12 text-center text-sm text-muted-foreground">
    No automatic backups yet. <code class="rounded-sm bg-muted px-1 py-0.5 font-mono text-xs text-foreground">bin/update</code> takes one before it migrates; the newest few are kept.
  </div>
<% end %>

<dialog class="sheet gap-6 p-6 text-left" data-dialog-target="dialog" aria-label="Download a backup" closedby="any">
  <header class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold text-foreground">Download a backup</h2>
    <button type="button" class="btn" data-variant="outline" data-size="sm" data-action="dialog#close">Close</button>
  </header>
  <p class="text-sm text-foreground">The site’s database and every uploaded file, as one .tar.gz. It will hold:</p>
  <ul class="divide-y divide-border rounded-lg border border-border text-sm">
    <% @contents.each do |kind, count| %>
      <%# herb:key kind %>
      <li class="px-3 py-2 text-foreground"><%= number_with_delimiter(count) %> <%= kind.to_s.humanize(capitalize: false) %></li>
    <% end %>
  </ul>
  <p class="text-sm text-muted-foreground">Restoring one is done on the server — see <code class="font-mono text-foreground">docs/install.md</code>.</p>
  <div class="dialog__actions flex justify-end gap-2">
    <button type="button" class="btn" data-variant="outline" data-action="dialog#close">Cancel</button>
    <% if Current.user.admin? then %>
      <%= button_to tools_backup_path, class: "btn", form_class: "contents", data: { turbo: false } do %>
        <span>Download backup</span>
      <% end %>
    <% else %>
      <span class="text-sm text-muted-foreground">Downloading one takes an admin: it holds every account and secret.</span>
    <% end %>
  </div>
</dialog>
</div>
