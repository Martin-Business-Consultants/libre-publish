<% @page_title = "Backup" %>

<%# The automatic backups as a table in a card; taking one now is a sheet off the
    title row: what it will hold, and the download. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
<% content_for :page_actions do %>
  <button type="button" class="ui-button ui-button--outline" data-keys="n" data-action="dialog#open">
    <%= icon_tag "package" %>
    <span>Download a backup</span>
  </button>
<% end %>
<%= render "layouts/shared/page_header", title: "Backup" %>

<% if @archives.any? %>
  <section class="ui-card ui-card--flush" aria-labelledby="backups_title">
    <header class="ui-card__header ui-card__header--bordered">
      <h2 class="ui-card__title" id="backups_title">Automatic backups</h2>
      <p class="ui-card__description"><code class="code">bin/update</code> takes one before it migrates; the newest few are kept.</p>
    </header>
    <div class="ui-table-container">
      <table class="ui-table">
        <thead>
          <tr>
            <th>Backup</th>
            <th>Taken</th>
            <th class="ui-table__numeric">Size</th>
            <th><span class="visually-hidden">Download</span></th>
          </tr>
        </thead>
        <tbody>
          <% @archives.each do |archive| %>
            <%# herb:key archive.name %>
            <tr id="archive_<%= archive.name.parameterize %>">
              <td class="text-mono text-small"><%= archive.name %></td>
              <td><span class="nowrap text-muted"><%= time_ago_tag archive.taken_at %></span></td>
              <td class="ui-table__numeric nowrap"><%= number_to_human_size(archive.byte_size) %></td>
              <td class="ui-table__numeric">
                <% if Current.user.admin? then %>
                  <%= link_to "Download", tools_backup_archive_path(archive.name), class: "ui-button ui-button--outline ui-button--sm", data: { turbo: false } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <div class="ui-empty">
    <div class="ui-empty__media"><%= icon_tag "package" %></div>
    <div>
      <h2 class="ui-empty__title">No automatic backups yet</h2>
      <p class="ui-empty__description"><code class="code">bin/update</code> takes one before it migrates; the newest few are kept.</p>
    </div>
  </div>
<% end %>

<dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-labelledby="backup_sheet_title" closedby="any">
  <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" data-action="dialog#close" aria-label="Close"><%= icon_tag "close" %></button>
  <header class="ui-dialog__header">
    <h2 class="ui-dialog__title" id="backup_sheet_title">Download a backup</h2>
    <p class="ui-dialog__description">The site’s database and every uploaded file, as one .tar.gz. It will hold:</p>
  </header>
  <ul class="ui-item-group ui-card ui-card--flush backup-contents">
    <% @contents.each do |kind, count| %>
      <%# herb:key kind %>
      <li class="ui-item ui-item--sm">
        <div class="ui-item__content"><p class="ui-item__title"><%= number_with_delimiter(count) %> <%= kind.to_s.humanize(capitalize: false) %></p></div>
      </li>
    <% end %>
  </ul>
  <p class="ui-field__description">Restoring one is done on the server — see <code class="code">docs/install.md</code>.</p>
  <footer class="ui-dialog__footer">
    <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
    <% if Current.user.admin? then %>
      <%= button_to tools_backup_path, class: "ui-button", form_class: "contents", data: { turbo: false } do %>
        <span>Download backup</span>
      <% end %>
    <% else %>
      <span class="text-muted">Downloading one takes an admin: it holds every account and secret.</span>
    <% end %>
  </footer>
</dialog>
</div>
