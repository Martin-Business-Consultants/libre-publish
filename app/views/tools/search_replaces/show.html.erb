<% @page_title = "Search and replace" %>

<%= render "layouts/shared/page_header", title: "Search and replace",
      description: "Find a word or phrase across every page, entry and global, then change it everywhere at once." %>

<div class="stack stack--lg measure--xl">
  <%= form_with url: tools_search_replace_path, method: :get do |form| %>
    <section class="panel panel--padded stack">
      <div class="grid grid--2">
        <%= settings_field "Find" do %>
          <%= form.text_field :term, value: params[:term], required: true, minlength: SearchReplace::MIN_LENGTH, autocomplete: "off" %>
        <% end %>
        <%= settings_field "Replace with" do %>
          <%= form.text_field :replacement, value: params[:replacement], autocomplete: "off" %>
        <% end %>
      </div>
      <label class="choice text-ink">
        <%= form.check_box :case_sensitive, { checked: params[:case_sensitive] == "1" }, "1", nil %>
        <span>Match case</span>
      </label>
      <div><button type="submit" class="btn">Find</button></div>
    </section>
  <% end %>

  <% if @search.valid? %>
    <section class="panel panel--padded stack">
      <h2 class="heading">
        <%= pluralize(@matches.sum(&:count), "match") %> in <%= pluralize(@matches.size, "record") %>
      </h2>
      <% if @matches.any? %>
        <ul class="result-list">
          <% @matches.each do |match| %>
            <%# herb:key match.record.class.name + match.record.id.to_s %>
            <li class="row row--between row--md">
              <span class="grow truncate">
                <span class="text-small text-muted"><%= match.record.model_name.human %></span>
                <span class="text-medium text-ink"><%= match.record.try(:title).presence || match.record.try(:name) %></span>
              </span>
              <span class="no-shrink text-muted"><%= pluralize(match.count, "match") %></span>
            </li>
          <% end %>
        </ul>
        <% if Current.user.can?("pages:write") %>
          <%= form_with url: tools_search_replace_path, method: :post, class: "cluster cluster--md search-replace__confirm",
                data: { turbo_confirm: "Replace every match? Each record is saved, and its previous version is kept in its history." } do |form| %>
            <%= form.hidden_field :term, value: @search.term %>
            <%= form.hidden_field :replacement, value: @search.replacement %>
            <%= form.hidden_field :case_sensitive, value: params[:case_sensitive] %>
            <button type="submit" class="btn btn--primary">Replace all with “<%= @search.replacement %>”</button>
            <span class="text-small text-muted">Each record keeps its previous version in its history.</span>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
