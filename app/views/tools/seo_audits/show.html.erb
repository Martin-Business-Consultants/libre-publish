<% @page_title = "SEO audit" %>

<%= render "layouts/shared/page_header", title: "SEO audit",
      description: "What stands between the site and search engines and AI answers, most important first." %>

<div class="stack stack--lg measure--xl">
  <% if @issues.empty? %>
    <section class="panel empty-state">
      Nothing to fix: every page has its title and description, links lead somewhere, and the site says who it is.
    </section>
  <% else %>
    <% { problem: "Fix these", warning: "Worth fixing", tip: "Tips" }.each do |severity, heading| %>
      <%# herb:key severity %>
      <% found = @issues.select { |issue| issue.severity == severity } %>
      <% next if found.empty? %>
      <section class="panel panel--padded stack stack--md">
        <h2 class="heading"><%= heading %> (<%= found.size %>)</h2>
        <ul class="result-list">
          <% found.each_with_index do |issue, index| %>
            <%# herb:key index %>
            <li class="stack stack--2xs">
              <% if issue.record %>
                <%= render "tools/seo_audits/issue_link", record: issue.record %>
              <% end %>
              <span class="text-body"><%= issue.message %></span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
  <p class="text-small text-muted">See Settings › Search for AI crawlers and who the site is, and docs/seo.md for what the CMS does for search.</p>
</div>
