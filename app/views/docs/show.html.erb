<% @page_title = @guide.title %>
<%= parent_page "Docs", docs_path %>
<%= render "layouts/shared/page_header", title: @guide.title %>

<div class="with-aside">
  <div class="with-aside__main">
    <article class="card prose docs-article">
      <%= sanitize @guide.html(cms_url: request.base_url), tags: Markdown::TAGS, attributes: Markdown::ATTRIBUTES %>
    </article>
  </div>
  <aside class="with-aside__aside">
    <%= render "docs/nav", guides: @guides, current: @guide.slug %>
  </aside>
</div>
