<% @page_title = "Docs" %>
<%= render "layouts/shared/page_header", title: "Docs", icon: "help-circle" %>

<div class="with-sidebar">
  <div>
    <div class="grid grid--2">
      <% @guides.each do |guide| %>
        <%# herb:key guide.slug %>
        <%= link_to doc_path(guide.slug), class: "panel doc-card" do %>
          <strong class="heading"><%= guide.title %></strong>
          <span class="text-muted"><%= guide.summary %></span>
        <% end %>
      <% end %>
      <%= link_to site_health_docs_path, class: "panel doc-card" do %>
        <strong class="heading">Site health</strong>
        <span class="text-muted">
          The details a site needs in good order — NAP, tracking, spam protection, search. <%= @health[:passing] %> of <%= @health[:total] %> pass.
        </span>
      <% end %>
    </div>
  </div>
  <aside>
    <%= render "docs/nav", guides: @guides, current: :index %>
  </aside>
</div>
