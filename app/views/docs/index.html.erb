<% @page_title = "Docs" %>
<%= render "layouts/shared/page_header", title: "Docs", icon: "help-circle" %>

<div class="with-aside">
  <div class="with-aside__main">
    <div class="grid-2">
      <% @guides.each do |guide| %>
        <%# herb:key guide.slug %>
        <%= link_to doc_path(guide.slug), class: "doc-card" do %>
          <strong><%= guide.title %></strong>
          <span><%= guide.summary %></span>
        <% end %>
      <% end %>
      <%= link_to site_health_docs_path, class: "doc-card" do %>
        <strong>Site health</strong>
        <span>
          The details a site needs in good order — NAP, tracking, spam protection, search. <%= @health[:passing] %> of <%= @health[:total] %> pass.
        </span>
      <% end %>
    </div>
  </div>
  <aside class="with-aside__aside">
    <%= render "docs/nav", guides: @guides, current: :index %>
  </aside>
</div>
