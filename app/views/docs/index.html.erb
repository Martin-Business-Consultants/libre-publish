<% @page_title = "Docs" %>
<%= render "layouts/shared/page_header", title: "Docs", icon: "help-circle" %>

<div class="docs-layout">
  <aside class="docs-layout__nav">
    <%= render "docs/nav", guides: @guides, current: :index %>
  </aside>
  <div class="docs-layout__main">
    <div class="docs-cards">
      <% @guides.each do |guide| %>
        <%# herb:key guide.slug %>
        <%= link_to doc_path(guide.slug), class: "ui-card ui-card--sm doc-card" do %>
          <span class="ui-card__header">
            <span class="ui-card__title"><%= guide.title %></span>
            <span class="ui-card__description"><%= guide.summary %></span>
          </span>
        <% end %>
      <% end %>
      <%= link_to site_health_docs_path, class: "ui-card ui-card--sm doc-card" do %>
        <span class="ui-card__header">
          <span class="ui-card__title">Site health</span>
          <span class="ui-card__description">
            The details a site needs in good order — NAP, tracking, spam protection, search. <%= @health[:passing] %> of <%= @health[:total] %> pass.
          </span>
        </span>
      <% end %>
    </div>
  </div>
</div>
