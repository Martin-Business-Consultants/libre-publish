<%# locals: (entry:) %>
<%# One entry in the audit log's data table (audit_logs/index): when, who (and from where),
    what they did, to what, and the details it recorded. An entry has no actions: the empty
    last cell is under the Columns menu. %>
<tr id="<%= dom_id(entry) %>" data-filter-target="item">
  <td data-column="when"><span class="nowrap text-muted"><%= time_ago_tag entry.created_at %></span></td>
  <td data-column="actor">
    <div class="text-ink"><%= entry.actor_label.presence || "system" %></div>
    <% if entry.ip.present? %>
      <div class="text-mono text-small text-muted"><%= entry.ip %></div>
    <% end %>
  </td>
  <td data-column="action"><%= status_tag entry.current_action %></td>
  <td data-column="target">
    <% if entry.target_label.present? %>
      <%= audit_target_link(entry) %>
      <% if entry.target_type.present? %>
        <span class="text-small text-muted">(<%= entry.target_type %>)</span>
      <% end %>
    <% else %>
      <span class="text-muted">—</span>
    <% end %>
  </td>
  <td data-column="detail"><span class="text-mono text-small text-muted"><%= audit_metadata(entry.metadata) %></span></td>
  <td></td>
</tr>
