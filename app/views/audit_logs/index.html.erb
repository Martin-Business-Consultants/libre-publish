<% @page_title = "Audit log" %>
<% filtered = params[:actor].present? || params[:action_filter].present? || params[:from].present? || params[:to].present? %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= form_with url: audit_logs_path, method: :get, class: "ui-card ui-card--sm", data: { turbo_action: "advance" } do %>
  <div class="ui-card__content audit-filters">
    <label class="ui-field">
      <span class="ui-label">Actor</span>
      <%= text_field_tag :actor, params[:actor], placeholder: "email or name", autocomplete: "off", class: "ui-input" %>
    </label>
    <label class="ui-field">
      <span class="ui-label">Action</span>
      <%= select_tag :action_filter, options_for_select(@known_actions, params[:action_filter]), include_blank: "Any action", class: "ui-select" %>
    </label>
    <label class="ui-field">
      <span class="ui-label">From</span>
      <%= datetime_local_field_tag :from, params[:from], class: "ui-input" %>
    </label>
    <label class="ui-field">
      <span class="ui-label">To</span>
      <%= datetime_local_field_tag :to, params[:to], class: "ui-input" %>
    </label>
    <div class="row">
      <button type="submit" class="ui-button ui-button--outline">Apply</button>
      <%= link_to "Clear", audit_logs_path, class: "ui-button ui-button--ghost" %>
    </div>
  </div>
<% end %>

<div class="stack stack--md">
  <div class="list-toolbar">
    <div class="list-toolbar__search">
      <%= render "layouts/shared/list_search", placeholder: "Search actions, people and targets…" %>
    </div>
  </div>

  <%= render "ui/data_table", id: "audit_log",
        columns: [ ui_column(:when, "When"), ui_column(:actor, "Actor"), ui_column(:action, "Action", hideable: false),
                   ui_column(:target, "Target"), ui_column(:detail, "Detail") ],
        rows: @entries, row: "audit_logs/row", as: :entry, pagination: @pagination, actions: true,
        empty: "No entries match.", empty_link: ([ "Clear the filters", audit_logs_path ] if filtered || search_term) %>
</div>
