<% @page_title = "Audit log" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%# One toolbar row, as the other lists have: the action (a quick filter) and
    the dates on the left, sent as they change; the list's search on the
    right, which finds people and targets as well as actions. Each keeps the
    others' params. ?actor= still filters, for links that carry it. %>
<% filtered = %i[actor action_filter from to].any? { params[it].present? } %>
<% list_filters = capture do %>
  <%= render "layouts/shared/quick_filter", title: "Action", param: :action_filter, current: params[:action_filter].to_s,
        options: [["Any action", ""]] + @known_actions.map { [it, it] } %>
  <%= form_with url: audit_logs_path, method: :get, class: "audit-dates", aria: { label: "Dates" },
        data: { controller: "rune-autosubmit", turbo_action: "replace" } do %>
    <% request.query_parameters.slice("s", "action_filter", "actor").each do |name, value| %>
      <%# herb:key name %>
      <%= hidden_field_tag name, value, id: nil if value.is_a?(String) %>
    <% end %>
    <%= date_field_tag :from, params[:from].to_s[0, 10], aria: { label: "From" }, data: { action: "rune-autosubmit#submit" } %>
    <span class="muted">to</span>
    <%= date_field_tag :to, params[:to].to_s[0, 10], aria: { label: "To" }, data: { action: "rune-autosubmit#submit" } %>
    <noscript><button type="submit" class="btn btn--secondary btn--sm">Apply</button></noscript>
  <% end %>
  <% if filtered %>
    <%= link_to "Clear", audit_logs_path(s: params[:s].presence), class: "btn btn--ghost btn--sm" %>
  <% end %>
<% end %>
<%= render "layouts/shared/list_toolbar", filters: list_filters, placeholder: "Search actions, people and targets…" %>

<section class="table-wrap">
  <table class="table data-table">
    <thead>
      <tr>
        <th>When</th>
        <th>Actor</th>
        <th>Action</th>
        <th>Target</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each do |entry| %>
        <%# herb:key entry.id %>
        <tr id="<%= dom_id(entry) %>" data-filter-target="item">
          <td><span class="nowrap small muted"><%= time_ago_tag entry.created_at %></span></td>
          <td>
            <div><%= entry.actor_label.presence || "system" %></div>
            <% if entry.ip.present? %>
              <div class="mono small muted"><%= entry.ip %></div>
            <% end %>
          </td>
          <td><%= status_tag entry.current_action, highlight: false %></td>
          <td>
            <% if entry.target_label.present? %>
              <%= audit_target_link(entry) %>
              <% if entry.target_type.present? %>
                <span class="small muted">(<%= entry.target_type %>)</span>
              <% end %>
            <% else %>
              <span class="muted">—</span>
            <% end %>
          </td>
          <td><span class="mono small muted"><%= audit_metadata(entry.metadata) %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row((filtered || params[:s].present?) ? "No entries match." : "Nothing has happened yet.", columns: 5, link: (["Show all", audit_logs_path] if filtered || params[:s].present?)) if @entries.none? %>
    </tbody>
  </table>
</section>

<%= pagination_nav @pagination %>
