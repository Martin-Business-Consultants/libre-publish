<% @page_title = "Audit log" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= form_with url: audit_logs_path, method: :get, class: "card mb-6 flex flex-wrap items-end gap-4 p-4", data: { turbo_action: "advance" } do %>
  <label class="space-y-1.5">
    <span class="label">Actor</span>
    <%= text_field_tag :actor, params[:actor], placeholder: "email or name", autocomplete: "off" %>
  </label>
  <label class="space-y-1.5">
    <span class="label">Action</span>
    <%= select_tag :action_filter, options_for_select(@known_actions, params[:action_filter]), include_blank: "Any action" %>
  </label>
  <label class="space-y-1.5">
    <span class="label">From</span>
    <%= datetime_local_field_tag :from, params[:from] %>
  </label>
  <label class="space-y-1.5">
    <span class="label">To</span>
    <%= datetime_local_field_tag :to, params[:to] %>
  </label>
  <div class="flex gap-2">
    <button type="submit" class="btn" data-variant="outline">Apply</button>
    <%= link_to "Clear", audit_logs_path, class: "btn", data: {variant: "ghost"} %>
  </div>
<% end %>

<div class="mb-3 flex flex-wrap items-center justify-end gap-3">
  <%= render "layouts/shared/list_search", placeholder: "Search actions, people and targets…" %>
</div>

<section class="card overflow-x-auto">
  <table class="data-table table">
    <thead>
      <tr class="table-row">
        <th class="table-head">When</th>
        <th class="table-head">Actor</th>
        <th class="table-head">Action</th>
        <th class="table-head">Target</th>
        <th class="table-head">Detail</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each do |entry| %>
        <%# herb:key entry.id %>
        <tr id="<%= dom_id(entry) %>" class="table-row hover:bg-muted" data-filter-target="item">
          <td class="table-cell"><span class="text-xs whitespace-nowrap text-muted-foreground"><%= time_ago_tag entry.created_at %></span></td>
          <td class="table-cell">
            <div class="text-foreground"><%= entry.actor_label.presence || "system" %></div>
            <% if entry.ip.present? %>
              <div class="font-mono text-xs text-muted-foreground"><%= entry.ip %></div>
            <% end %>
          </td>
          <td class="table-cell"><%= status_tag entry.current_action, highlight: false %></td>
          <td class="table-cell">
            <% if entry.target_label.present? %>
              <%= audit_target_link(entry) %>
              <% if entry.target_type.present? %>
                <span class="text-xs text-muted-foreground">(<%= entry.target_type %>)</span>
              <% end %>
            <% else %>
              <span class="text-muted-foreground">—</span>
            <% end %>
          </td>
          <td class="table-cell"><span class="font-mono text-xs text-muted-foreground"><%= audit_metadata(entry.metadata) %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No entries match.", columns: 5) if @entries.none? %>
    </tbody>
  </table>
</section>

<%= pagination_nav @pagination %>
