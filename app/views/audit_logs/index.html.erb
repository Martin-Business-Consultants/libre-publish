<% @page_title = "Audit log" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= form_with url: audit_logs_path, method: :get, class: "card audit-filters", data: { turbo_action: "advance" } do %>
  <label class="field">
    <span class="field__label">Actor</span>
    <%= text_field_tag :actor, params[:actor], placeholder: "email or name", autocomplete: "off" %>
  </label>
  <label class="field">
    <span class="field__label">Action</span>
    <%= select_tag :action_filter, options_for_select(@known_actions, params[:action_filter]), include_blank: "Any action" %>
  </label>
  <label class="field">
    <span class="field__label">From</span>
    <%= datetime_local_field_tag :from, params[:from] %>
  </label>
  <label class="field">
    <span class="field__label">To</span>
    <%= datetime_local_field_tag :to, params[:to] %>
  </label>
  <div class="row">
    <button type="submit" class="btn btn--secondary">Apply</button>
    <%= link_to "Clear", audit_logs_path, class: "btn btn--ghost" %>
  </div>
<% end %>

<div class="audit-search">
  <%= render "layouts/shared/list_search", placeholder: "Search actions, people and targets…" %>
</div>

<section class="table-wrap">
  <table class="table data-table">
    <thead>
      <tr>
        <th>When</th>
        <th>Actor</th>
        <th>Action</th>
        <th>Target</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      <% @entries.each do |entry| %>
        <%# herb:key entry.id %>
        <tr id="<%= dom_id(entry) %>" data-filter-target="item">
          <td><span class="nowrap small muted"><%= time_ago_tag entry.created_at %></span></td>
          <td>
            <div><%= entry.actor_label.presence || "system" %></div>
            <% if entry.ip.present? %>
              <div class="mono small muted"><%= entry.ip %></div>
            <% end %>
          </td>
          <td><%= status_tag entry.current_action, highlight: false %></td>
          <td>
            <% if entry.target_label.present? %>
              <%= audit_target_link(entry) %>
              <% if entry.target_type.present? %>
                <span class="small muted">(<%= entry.target_type %>)</span>
              <% end %>
            <% else %>
              <span class="muted">—</span>
            <% end %>
          </td>
          <td><span class="mono small muted"><%= audit_metadata(entry.metadata) %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No entries match.", columns: 5) if @entries.none? %>
    </tbody>
  </table>
</section>

<%= pagination_nav @pagination %>
