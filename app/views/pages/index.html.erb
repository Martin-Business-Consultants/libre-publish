<% @page_title = "Pages" %>
<% can_write = Current.user.can?("pages:write") %>
<% can_publish = Current.user.can?("pages:publish") %>
<% can_delete = Current.user.can?("pages:delete") %>
<% ticks = can_publish || can_delete %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "pages/new_page", page: @new_page, templates: Page.available_templates %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<div class="list-filters">
  <%= render "layouts/shared/status_links", param: :status, current: @status.to_s,
        options: [ [ "All", nil, @status_counts.values.sum ] ] + Page::STATUSES.filter_map { |status| [ status.humanize, status, @status_counts[status] ] if @status_counts[status].to_i.positive? } %>
  <% if @locales.many? %>
    <%= render "layouts/shared/quick_filter", title: "Locale", param: :locale, current: @locale.to_s,
          options: [ [ "Any locale", "" ] ] + @locales.map { [ it, it ] } %>
  <% end %>
</div>

<div class="stack stack--md" data-controller="select-all">
  <%= render "layouts/shared/bulk_actions", id: "pages_bulk", noun: "page",
        status_path: (pages_bulk_status_changes_path if can_publish), statuses: Page::STATUSES,
        deletion_path: (pages_bulk_deletions_path if can_delete) %>

  <%= render "ui/data_table", id: "pages",
        columns: [ ui_column(:title, "Title", hideable: false), ui_column(:path, "Path"), ui_column(:status, "Status"),
                   ui_column(:locale, "Locale"), ui_column(:updated, "Updated") ],
        rows: @pages, row: "pages/row", as: :page, pagination: @pagination, selectable: ticks && @pages.any?, actions: true,
        row_locals: { ticks: ticks, can_write: can_write, can_delete: can_delete, site_url: public_site_url },
        empty: (@status || @locale) ? "No pages match." : "No pages yet. The first one is usually the home page.",
        empty_link: ([ "Show all", pages_path ] if @status || @locale) %>
</div>
