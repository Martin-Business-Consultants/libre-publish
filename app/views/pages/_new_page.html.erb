<%# locals: (page:, templates:) %>
<%# The New page sheet: a title, a slug, and optionally a template whose
    blocks the page starts with. It opens by itself when a submit came back
    with errors. %>
<% open = page.errors.any? %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="ui-button ui-button--outline" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New page</span>
    <kbd class="wide-only">N</kbd>
  </button>
  <dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-label="New page" closedby="any">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title">New page</h2>
      <p class="ui-dialog__description">It starts as a draft. You can change everything in the editor after.</p>
    </header>
    <%= render "layouts/shared/errors", record: page %>
    <%= form_with model: page, url: pages_path, scope: :page, class: "ui-fieldset", data: { controller: "slug" } do |form| %>
      <%= hidden_field_tag :from, "dialog", id: nil %>
      <%= form.hidden_field :status, value: "draft" %>
      <%= form.hidden_field :locale, value: page.locale.presence || "en" %>
      <label class="ui-field">
        <span class="ui-label">Title</span>
        <%= form.text_field :title, placeholder: "About us", autocomplete: "off", autofocus: true, data: { slug_target: "source", action: "slug#fill" }, class: "ui-input" %>
      </label>
      <label class="ui-field">
        <span class="ui-label">Slug</span>
        <%= form.text_field :slug, class: "ui-input text-mono", placeholder: "about", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="ui-field__description">Made from the title as you type it; change it to choose your own.</span>
      </label>
      <% if templates.any? %>
        <fieldset class="ui-fieldset">
          <legend class="ui-label">Start from</legend>
          <div class="ui-radio-group">
            <label class="ui-field ui-field--inline ui-field--card">
              <%= radio_button_tag :template, "", params[:template].blank?, id: nil, class: "ui-radio" %>
              <span class="ui-label">A blank page</span>
            </label>
            <% templates.each do |template| %>
              <%# herb:key template["key"] %>
              <label class="ui-field ui-field--inline ui-field--card">
                <%= radio_button_tag :template, template["key"], params[:template] == template["key"], id: nil, class: "ui-radio" %>
                <span class="ui-label"><%= template["title"] %></span>
                <span class="ui-field__description"><%= template["description"] %> · <%= pluralize(template["blocks"].size, "block") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      <footer class="ui-dialog__footer">
        <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
        <%= form.button "Create page", class: "ui-button" %>
      </footer>
    <% end %>
  </dialog>
</div>
