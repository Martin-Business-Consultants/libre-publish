<%# locals: (page:, templates:) %>
<%# The New page sheet: a title, a slug, and optionally a template whose
    blocks the page starts with. It opens by itself when a submit came back
    with errors. %>
<% open = page.errors.any? %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="btn" data-keys="n" data-action="dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New page</span>
    <kbd class="wide-only">N</kbd>
  </button>
  <dialog class="dialog dialog--sheet" data-dialog-target="dialog" aria-label="New page" closedby="any">
    <h2 class="heading heading--lg">New page</h2>
    <%= render "layouts/shared/errors", record: page %>
    <%= form_with model: page, url: pages_path, scope: :page, class: "fields", data: { controller: "slug" } do |form| %>
      <%= hidden_field_tag :from, "dialog", id: nil %>
      <%= form.hidden_field :status, value: "draft" %>
      <%= form.hidden_field :locale, value: page.locale.presence || "en" %>
      <label class="field">
        <span class="label">Title</span>
        <%= form.text_field :title, placeholder: "About us", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
      </label>
      <label class="field">
        <span class="label">Slug</span>
        <%= form.text_field :slug, class: "text-mono", placeholder: "about", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
        <span class="help">Made from the title as you type it; change it to choose your own.</span>
      </label>
      <% if templates.any? %>
        <fieldset class="stack stack--sm">
          <legend class="label">Start from</legend>
          <label class="template-choice">
            <%= radio_button_tag :template, "", params[:template].blank?, id: nil %>
            <span>A blank page</span>
          </label>
          <% templates.each do |template| %>
            <%# herb:key template["key"] %>
            <label class="template-choice">
              <%= radio_button_tag :template, template["key"], params[:template] == template["key"], id: nil %>
              <span class="stack stack--2xs">
                <strong class="text-medium text-ink"><%= template["title"] %></strong>
                <span class="help"><%= template["description"] %> · <%= pluralize(template["blocks"].size, "block") %></span>
              </span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
      <div class="dialog__actions">
        <button type="button" class="btn" data-action="dialog#close">Cancel</button>
        <%= form.button "Create page", class: "btn btn--primary" %>
      </div>
    <% end %>
  </dialog>
</div>
