<%# locals: (page:, templates:) %>
<%# The New page sheet: a title, a slug, and optionally a template whose
    blocks the page starts with. It opens by itself when a submit came back
    with errors. %>
<% open = page.errors.any? %>
<div class="contents" data-controller="rune-dialog" data-rune-dialog-auto-open-value="<%= open %>" data-action="keydown.esc->rune-dialog#close:stop">
  <button type="button" class="btn btn--secondary" data-keys="n" data-action="rune-dialog#open">
    <%= icon_tag "add" %>
    <span class="truncate">New page</span>
    <kbd>N</kbd>
  </button>
  <dialog class="dialog sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="New page" closedby="any">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title">New page</h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <%= render "layouts/shared/errors", record: page %>
      <%= form_with model: page, url: pages_path, scope: :page, class: "stack", data: { controller: "slug" } do |form| %>
        <%= hidden_field_tag :from, "dialog", id: nil %>
        <%= form.hidden_field :status, value: "draft" %>
        <%= form.hidden_field :locale, value: page.locale.presence || "en" %>
        <label class="field">
          <span class="field__label">Title</span>
          <%= form.text_field :title, placeholder: "About us", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
        </label>
        <label class="field">
          <span class="field__label">Slug</span>
          <%= form.text_field :slug, class: "mono", placeholder: "about", autocomplete: "off", spellcheck: false, data: { slug_target: "slug", action: "slug#take" } %>
          <span class="field__hint">Made from the title as you type it; change it to choose your own.</span>
        </label>
        <% if templates.any? %>
          <fieldset class="stack stack--sm">
            <legend class="field__label">Start from</legend>
            <label class="template-choice">
              <%= radio_button_tag :template, "", params[:template].blank?, id: nil %>
              <span>A blank page</span>
            </label>
            <% templates.each do |template| %>
              <%# herb:key template["key"] %>
              <label class="template-choice">
                <%= radio_button_tag :template, template["key"], params[:template] == template["key"], id: nil %>
                <span class="stack stack--xs">
                  <strong><%= template["title"] %></strong>
                  <span class="field__hint"><%= template["description"] %> · <%= pluralize(template["blocks"].size, "block") %></span>
                </span>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        <div class="dialog__actions">
          <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
          <%= form.button "Create page", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
