<%# locals: (page:, ticks:, can_write:, can_delete:, site_url:) %>
<%# One page in the pages data table (pages/index): its title indented by its depth in the
    tree and opening it, its path, status, locale and when it changed, and its actions. %>
<tr id="<%= dom_id(page) %>" data-filter-target="item">
  <% if ticks %>
    <%= ui_select_cell page.path, label: "Select #{page.title}", form: "pages_bulk", name: "slugs[]" %>
  <% end %>
  <td data-column="title">
    <span class="page-tree__title" data-depth="<%= [ page.depth.to_i, 6 ].min %>">
      <%= link_to page.title, (can_write ? edit_page_path(page.path) : page_schema_path(page.path)), class: "ui-table__row-link" %>
    </span>
  </td>
  <td data-column="path"><span class="text-mono text-small text-muted">/<%= page.path %></span></td>
  <td data-column="status"><%= status_tag page.status %></td>
  <td data-column="locale"><span class="text-muted"><%= page.locale %></span></td>
  <td data-column="updated"><span class="nowrap text-muted"><%= time_ago_tag page.updated_at %></span></td>
  <td class="ui-table__numeric">
    <%= render "ui/row_actions", id: dom_id(page),
          links: [ ([ "Edit", edit_page_path(page.path) ] if can_write), ([ "Fields", page_schema_path(page.path) ] if can_write),
                   ([ "View", site_url.chomp("/") + "/" + page.path ] if site_url && page.status == "published") ].compact,
          name: page.title, delete_path: (page_path(page.path) if can_delete), delete_label: "Move to trash",
          delete_message: "It goes to the trash, where it can be restored." %>
  </td>
</tr>
