<% @page_title = @page.title.presence || "Page" %>
<%= parent_page "Pages", pages_path %>

<% content_for :page_actions do %>
  <% if Current.user.can?("pages:write") %>
    <%= link_to "Add New", new_page_path, class: "btn btn--secondary" %>
  <% end %>
  <%= link_to "Fields", page_schema_path(@page.path), class: "btn btn--secondary", title: "The fields this page carries" %>
<% end %>
<%= render "layouts/shared/errors", record: @page %>
<%= render layout: "content_form/editor_tabs", locals: { record: @page, kind: "page" } do %>
  <%= render "pages/form", page: @page, invalid_json: @invalid_json %>
<% end %>
