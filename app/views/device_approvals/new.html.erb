<%# The browser half of `cms login`. Short, because someone is reading it with a
    terminal open beside them. %>
<% @page_title = "Connect a machine" %>
<div class="stack stack--lg measure">
  <div class="card">
    <h1 class="public-card__title"><%= @page_title %></h1>

    <% if @authorization&.pending? %>
      <% if @authorization.site? %>
        <p class="muted">
          The Astro site <strong><%= @authorization.label.presence || "a site" %></strong>
          (on <%= @authorization.hostname.presence || "a machine" %>) is asking for a read-only token of its own,
          to build from this CMS's content. It gets the Production site role, and a service token you can revoke under Settings › Service tokens.
        </p>
        <% unless @authorization.approvable_by?(Current.user) %>
          <p class="device-approval__problem">Your role can't issue service tokens. Ask someone who manages settings to approve it.</p>
        <% end %>
      <% else %>
        <p class="muted">
          <%= @authorization.hostname.presence || "A machine" %> is asking to act as you in this CMS.
          It will be able to do whatever your role allows — no more.
        </p>
      <% end %>

      <%= form_with url: connect_path, method: :post, class: "device-approval__form" do %>
        <%= hidden_field_tag :code, @authorization.user_code, id: nil %>
        <button name="decision" value="approve" class="btn btn--primary">Approve</button>
        <button name="decision" value="deny" class="btn btn--secondary">Deny</button>
      <% end %>
    <% else %>
      <p class="muted">Enter the code your terminal is showing.</p>

      <%= form_with url: connect_path, method: :get, class: "device-approval__form" do %>
        <%= text_field_tag :code, @code, placeholder: "ABCD-EFGH", autocomplete: "off", class: "device-code", autofocus: true,
              aria: { label: "Code" } %>
        <button type="submit" class="btn btn--primary">Continue</button>
      <% end %>

      <% if @code.present? %>
        <p class="device-approval__problem">
          That code has expired or doesn’t exist. Run <code>cms login</code> again.
        </p>
      <% end %>
    <% end %>
  </div>
</div>
