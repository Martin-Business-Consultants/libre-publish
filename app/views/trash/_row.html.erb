<%# locals: (entry:, can_write:) %>
<%# One trashed item in the trash's data table (trash/index), entry being [kind, record]: its
    title, opening it in the sheet, what it was, what tells it apart, when it went, and its
    actions (View, Restore, Delete permanently). %>
<% kind, record = entry %>
<% label = AuditLog.describe_target(record).to_s.presence || "Untitled " + kind %>
<tr id="trash_<%= kind %>_<%= record.id %>" data-filter-target="item">
  <td data-column="title">
    <%= link_to label, trash_item_path(kind, record.id), class: "ui-table__row-link",
          data: { turbo_frame: "trash_item", action: "dialog#open" } %>
  </td>
  <td data-column="type"><%= ui_badge Trash.labels.fetch(kind, kind.humanize).singularize, :outline %></td>
  <td data-column="details"><span class="text-mono text-small text-muted"><%= trash_detail(kind, record) %></span></td>
  <td data-column="deleted"><span class="nowrap text-muted"><%= time_ago_tag record.deleted_at %></span></td>
  <td class="ui-table__numeric">
    <%= render "ui/row_actions", id: "trash_#{kind}_#{record.id}", name: label,
          links: [ [ "View", trash_item_path(kind, record.id) ] ],
          buttons: ([ [ "Restore", trash_item_restoration_path(kind, record.id) ] ] if can_write),
          delete_path: (trash_item_path(kind, record.id) if can_write), delete_name: label,
          delete_label: "Delete permanently", delete_message: "It’s deleted for good. This can’t be undone." %>
  </td>
</tr>
