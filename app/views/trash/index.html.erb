<% @page_title = "Trash" %>
<% can_write = Current.user.can?("trash:write") %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= render "layouts/shared/status_links", param: :kind, current: @kind.to_s, options: trash_kind_links(@counts) %>

<%# The trash as a list table; picking an item opens what it was in a sheet
    (trash#show, into the trash_item frame), where it's restored or deleted. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <section class="panel panel--scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Details</th>
          <th>Deleted</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |kind, record| %>
          <%# herb:key "#{kind}-#{record.id}" %>
          <% label = AuditLog.describe_target(record).to_s.presence || "Untitled " + kind %>
          <tr id="trash_<%= kind %>_<%= record.id %>" data-filter-target="item">
            <td>
              <%= link_to label, trash_item_path(kind, record.id), class: "title-link",
                    data: { turbo_frame: "trash_item", action: "dialog#open" } %>
              <%= render "layouts/shared/row_links",
                    links: [ [ "View", trash_item_path(kind, record.id) ] ],
                    buttons: ([ [ "Restore", trash_item_restoration_path(kind, record.id) ] ] if can_write),
                    delete_path: (trash_item_path(kind, record.id) if can_write), delete_name: label,
                    delete_label: "Delete permanently", delete_message: "It’s deleted for good. This can’t be undone." %>
            </td>
            <td><%= status_tag Trash.labels.fetch(kind, kind.humanize).singularize %></td>
            <td><span class="text-mono text-small text-muted"><%= trash_detail(kind, record) %></span></td>
            <td><span class="nowrap text-small text-muted"><%= time_ago_tag record.deleted_at %></span></td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing in the trash.", columns: 4) if @entries.none? %>
      </tbody>
    </table>
  </section>
  <%= pagination_nav @pagination %>

  <dialog class="dialog dialog--sheet" data-dialog-target="dialog"
          aria-label="In the trash" closedby="any">
    <header class="dialog__header">
      <h2 class="heading heading--lg">In the trash</h2>
      <button type="button" class="btn btn--sm" data-action="dialog#close">Close</button>
    </header>
    <turbo-frame id="trash_item">
      <p class="text-muted">Loading…</p>
    </turbo-frame>
  </dialog>
</div>
