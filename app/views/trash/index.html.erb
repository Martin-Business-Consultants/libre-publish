<% @page_title = "Trash" %>
<% can_write = Current.user.can?("trash:write") %>

<%= render "layouts/shared/page_header", title: @page_title, actions: false %>
<%= render "layouts/shared/list_toolbar", search: false,
      filters: render("layouts/shared/status_links", param: :kind, current: @kind.to_s, options: trash_kind_links(@counts)) %>

<%# The trash as a list table; picking an item opens what it was in a sheet
    (trash#show, into the trash_item frame), where it's restored or deleted. %>
<div class="dialog-wrap" data-controller="rune-dialog" data-action="keydown.esc->rune-dialog#close:stop">
  <section class="table-wrap">
    <table class="table data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Details</th>
          <th>Deleted</th>
          <th class="data-table__actions-header"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |kind, record| %>
          <%# herb:key "#{kind}-#{record.id}" %>
          <% label = AuditLog.describe_target(record).to_s.presence || "Untitled " + kind %>
          <tr id="trash_<%= kind %>_<%= record.id %>" data-filter-target="item">
            <td>
              <%= link_to label, trash_item_path(kind, record.id), class: "row-link",
                    data: { turbo_frame: "trash_item", action: "rune-dialog#open" } %>
            </td>
            <td><%= status_tag Trash.labels.fetch(kind, kind.humanize).singularize %></td>
            <td><span class="mono small muted"><%= trash_detail(kind, record) %></span></td>
            <td><span class="nowrap small muted"><%= time_ago_tag record.deleted_at %></span></td>
            <%= render "layouts/shared/row_actions",
                  links: [ [ "View", trash_item_path(kind, record.id) ] ],
                  buttons: ([ [ "Restore", trash_item_restoration_path(kind, record.id) ] ] if can_write),
                  delete_path: (trash_item_path(kind, record.id) if can_write), delete_name: label, delete_label: "Delete permanently",
                  delete_message: "It’s deleted for good. This can’t be undone." %>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing in the trash.", columns: 5) if @entries.none? %>
      </tbody>
    </table>
  </section>
  <%= pagination_nav @pagination %>

  <dialog class="dialog sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop"
          aria-label="In the trash" closedby="any">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title">In the trash</h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <turbo-frame id="trash_item">
        <p class="muted">Loading…</p>
      </turbo-frame>
    </div>
  </dialog>
</div>
