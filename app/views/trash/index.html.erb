<% @page_title = "Trash" %>
<% can_write = Current.user.can?("trash:write") %>

<%= render "layouts/shared/page_header", title: @page_title %>

<div class="list-filters">
  <%= render "layouts/shared/status_links", param: :kind, current: @kind.to_s, options: trash_kind_links(@counts) %>
</div>

<%# The trash as a data table; picking an item opens what it was in a sheet
    (trash#show, into the trash_item frame), where it's restored or deleted. %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <%= render "ui/data_table", id: "trash",
        columns: [ ui_column(:title, "Title", hideable: false), ui_column(:type, "Type"), ui_column(:details, "Details"),
                   ui_column(:deleted, "Deleted") ],
        rows: @entries, row: "trash/row", as: :entry, pagination: @pagination, actions: true,
        row_locals: { can_write: can_write },
        empty: @kind ? "Nothing of this kind in the trash." : "Nothing in the trash.", empty_link: ([ "Show all", trash_path ] if @kind) %>

  <dialog class="ui-sheet app-sheet--md" data-dialog-target="dialog" aria-label="In the trash" closedby="any">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title">In the trash</h2>
      <p class="ui-dialog__description">Restore it, or delete it for good.</p>
    </header>
    <turbo-frame id="trash_item">
      <p class="ui-dialog__description">Loading…</p>
    </turbo-frame>
  </dialog>
</div>
