<%# locals: (pattern:) %>
<%= form_with model: pattern, url: (pattern.persisted? ? block_pattern_path(pattern) : block_patterns_path), scope: :block_pattern,
      id: "block_pattern_form", class: "flex flex-col gap-6 lg:flex-row lg:items-start" do |form| %>
  <div class="flex min-w-0 flex-1 flex-col gap-6">
    <%= render "layouts/shared/errors", record: pattern %>
    <div>
      <label class="sr-only" for="block_pattern_name">Name</label>
      <%= form.text_field :name, required: true, class: "w-full rounded-none border-0 border-b bg-transparent px-0 pb-3 pt-0 text-3xl font-semibold tracking-tight", placeholder: "Pattern name", autofocus: pattern.new_record? %>
    </div>
    <section class="card p-6">
      <%= render "content_form/blocks", blocks: pattern.blocks, scope: content_scope("block_pattern")["blocks"], depth: 1,
            allowed_types: BlockType.ordered.reject { |type| type.slug == "pattern" || type.deprecated }.map(&:slug) %>
    </section>
  </div>
  <aside class="flex w-full shrink-0 flex-col gap-4 lg:w-80">
    <section class="card space-y-4 p-5">
      <%= settings_field "Slug", hint: "Lowercase letters, digits and dashes. A synced pattern is placed by it." do %>
        <%= form.text_field :slug, required: true, class: "w-full", pattern: "[a-z0-9][a-z0-9-]*" %>
      <% end %>
      <%= settings_field "Description", hint: "What it’s for, shown in the block picker." do %>
        <%= form.text_area :description, rows: 3, class: "w-full" %>
      <% end %>
      <label class="flex items-start gap-2 text-sm text-foreground">
        <%= form.check_box :synced %>
        <span>
          Synced: placed as one block that always shows this pattern, so a change here changes every page using it.
          Unsynced, it’s added as a copy to change freely.
        </span>
      </label>
      <div class="flex items-center justify-between gap-2">
        <button type="submit" class="btn">Save</button>
      </div>
    </section>
    <% if pattern.persisted? && Current.user.can?("pages:delete") %>
      <%= render "layouts/shared/delete_dialog", name: pattern.name, path: block_pattern_path(pattern), trigger_text: "Delete pattern",
            message: "A page that placed it synced shows nothing in its place. Copies already added stay." %>
    <% end %>
  </aside>
<% end %>
