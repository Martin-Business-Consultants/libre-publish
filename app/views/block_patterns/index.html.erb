<% @page_title = "Patterns" %>
<% can_write = Current.user.can?("pages:write") %>
<% can_delete = Current.user.can?("pages:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "layouts/shared/new_link", text: "New pattern", path: new_block_pattern_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: "Patterns",
      description: "Sets of blocks to use again. Add one to a page from the block picker’s Patterns section." %>

<% if @patterns.any? %>
  <%= render "ui/data_table", id: "block_patterns",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:blocks, "Blocks", align: :end), ui_column(:kind, "Kind"),
                   ui_column(:updated, "Updated") ],
        rows: @patterns, row: "block_patterns/row", as: :pattern, pagination: @pagination, actions: true,
        row_locals: { can_write: can_write, can_delete: can_delete } %>
<% else %>
  <div class="ui-empty">
    <div class="ui-empty__media"><%= icon_tag "stack" %></div>
    <p class="ui-empty__title">No patterns yet</p>
    <p class="ui-empty__description">
      A pattern is a set of blocks — a call to action, a pricing table, a team section — saved to add to any page.
    </p>
    <% if can_write %>
      <%= link_to new_block_pattern_path, class: "ui-button ui-button--outline" do %>
        <%= icon_tag "add" %>
        <span>New pattern</span>
      <% end %>
    <% end %>
  </div>
<% end %>
