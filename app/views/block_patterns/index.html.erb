<% @page_title = "Patterns" %>

<% content_for :page_actions do %>
  <% if Current.user.can?("pages:write") %>
    <%= link_to "Add new", new_block_pattern_path, class: "btn btn--primary btn--sm" %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: "Patterns",
      description: "Sets of blocks to use again. Add one to a page from the block picker’s Patterns section." %>

<% if @patterns.any? %>
  <section class="panel panel--scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Blocks</th>
          <th>Kind</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        <% @patterns.each do |pattern| %>
          <%# herb:key pattern.id %>
          <tr>
            <td>
              <%= link_to pattern.name, edit_block_pattern_path(pattern), class: "title-link" %>
              <% if pattern.description.present? %>
                <div class="text-small text-muted"><%= pattern.description %></div>
              <% end %>
            </td>
            <td><%= Array(pattern.blocks).size %></td>
            <td><%= status_tag pattern.synced? ? "Synced" : "Copied" %></td>
            <td class="text-muted"><%= time_ago_tag pattern.updated_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <div class="panel empty-state">
    No patterns yet. A pattern is a set of blocks — a call to action, a pricing table, a team section — saved to add
    to any page.
  </div>
<% end %>
