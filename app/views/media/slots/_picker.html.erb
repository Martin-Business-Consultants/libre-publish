<%# locals: () %>
<%# One picker for every asset field on the page, a sheet from the right. It
    loads the library the first time it opens (a lazy frame) and hands the
    chosen asset to the field that opened it. %>
<dialog id="asset_picker_dialog" class="dialog sheet asset-picker-sheet"
        aria-label="Choose a file" data-controller="media--asset-picker" closedby="any">
  <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title">Choose a file</h2>
      <%= icon_button "close", label: "Close", data: { action: "media--asset-picker#close" } %>
    </header>
    <turbo-frame id="asset_picker" src="<%= asset_picker_path %>" loading="lazy">
      <p class="muted">Loading…</p>
    </turbo-frame>
  </div>
</dialog>
