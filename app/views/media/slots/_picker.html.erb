<%# locals: () %>
<%# One picker for every asset field on the page, a sheet from the right. It
    loads the library the first time it opens (a lazy frame) and hands the
    chosen asset to the field that opened it. %>
<dialog id="asset_picker_dialog" class="ui-sheet app-sheet--wide"
        aria-label="Choose a file" data-controller="media--asset-picker" closedby="any">
  <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" data-action="media--asset-picker#close" aria-label="Close">
    <%= icon_tag "close" %>
  </button>
  <header class="ui-dialog__header">
    <h2 class="ui-dialog__title">Choose a file</h2>
    <p class="ui-dialog__description">Pick one from the library, or upload a new one.</p>
  </header>
  <turbo-frame id="asset_picker" src="<%= asset_picker_path %>" loading="lazy">
    <p class="ui-dialog__description">Loading…</p>
  </turbo-frame>
</dialog>
