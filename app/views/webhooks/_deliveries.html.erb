<%# locals: (deliveries:, pagination: nil) %>
<section class="space-y-3">
  <h2 class="text-base font-semibold text-foreground">Recent deliveries</h2>
  <div class="card overflow-x-auto">
    <table class="table">
      <thead>
        <tr class="table-row">
          <th class="table-head">When</th>
          <th class="table-head">Event</th>
          <th class="table-head">Result</th>
          <th class="table-head text-right">Time</th>
          <th class="table-head">Error</th>
        </tr>
      </thead>
      <tbody>
        <% deliveries.each do |delivery| %>
          <%# herb:key delivery.id %>
          <tr id="<%= dom_id(delivery) %>" class="table-row hover:bg-muted">
            <td class="table-cell"><span class="text-xs whitespace-nowrap text-muted-foreground"><%= time_ago_tag delivery.created_at %></span></td>
            <td class="table-cell"><span class="font-mono text-xs"><%= delivery.event %></span></td>
            <td class="table-cell">
              <% if delivery.success %>
                <%= status_tag((delivery.response_status || "OK").to_s, highlight: true) %>
              <% else %>
                <span class="badge border-red-200 bg-red-50 text-red-700" data-variant="outline"><%= delivery.response_status || "Failed" %></span>
              <% end %>
            </td>
            <td class="table-cell text-right tabular-nums whitespace-nowrap"><%= "#{delivery.duration_ms} ms" if delivery.duration_ms %></td>
            <td class="table-cell"><span class="text-xs text-muted-foreground"><%= delivery.error %></span></td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing delivered yet.", columns: 5) if deliveries.none? %>
      </tbody>
    </table>
  </div>
  <%= pagination_nav pagination %>
</section>
