<%# locals: (deliveries:, pagination: nil) %>
<%# A webhook's recent deliveries, newest first: when, which event, how the receiver answered,
    how long it took and what went wrong (webhooks/sheet and webhooks/show). %>
<div class="stack stack--md">
  <section class="ui-card ui-card--flush">
    <header class="ui-card__header ui-card__header--bordered">
      <h2 class="ui-card__title">Recent deliveries</h2>
    </header>
    <div class="ui-table-container">
      <table class="ui-table">
        <thead>
          <tr>
            <th>When</th>
            <th>Event</th>
            <th>Result</th>
            <th class="ui-table__numeric">Time</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          <% deliveries.each do |delivery| %>
            <%# herb:key delivery.id %>
            <tr id="<%= dom_id(delivery) %>">
              <td><span class="nowrap text-muted"><%= time_ago_tag delivery.created_at %></span></td>
              <td><span class="text-mono text-small"><%= delivery.event %></span></td>
              <td>
                <% if delivery.success %>
                  <%= status_tag((delivery.response_status || "OK").to_s, highlight: true) %>
                <% else %>
                  <%= ui_badge (delivery.response_status || "Failed").to_s, :negative %>
                <% end %>
              </td>
              <td class="ui-table__numeric nowrap"><%= "#{delivery.duration_ms} ms" if delivery.duration_ms %></td>
              <td><span class="text-muted"><%= delivery.error %></span></td>
            </tr>
          <% end %>
          <%= table_empty_row("Nothing delivered yet.", columns: 5) if deliveries.none? %>
        </tbody>
      </table>
    </div>
  </section>
  <%= pagination_nav pagination %>
</div>
