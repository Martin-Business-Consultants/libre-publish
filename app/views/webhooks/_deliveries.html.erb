<%# locals: (deliveries:, pagination: nil) %>
<section class="stack stack--md">
  <h2 class="heading">Recent deliveries</h2>
  <div class="panel panel--scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Event</th>
          <th>Result</th>
          <th class="data-table__num">Time</th>
          <th>Error</th>
        </tr>
      </thead>
      <tbody>
        <% deliveries.each do |delivery| %>
          <%# herb:key delivery.id %>
          <tr id="<%= dom_id(delivery) %>">
            <td><span class="nowrap text-small text-muted"><%= time_ago_tag delivery.created_at %></span></td>
            <td><span class="text-mono text-small"><%= delivery.event %></span></td>
            <td>
              <% if delivery.success %>
                <%= status_tag((delivery.response_status || "OK").to_s, highlight: true) %>
              <% else %>
                <span class="badge badge--danger"><%= delivery.response_status || "Failed" %></span>
              <% end %>
            </td>
            <td class="data-table__num nowrap"><%= "#{delivery.duration_ms} ms" if delivery.duration_ms %></td>
            <td><span class="text-small text-muted"><%= delivery.error %></span></td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing delivered yet.", columns: 5) if deliveries.none? %>
      </tbody>
    </table>
  </div>
  <%= pagination_nav pagination %>
</section>
