<% @page_title = "Webhooks" %>

<%# The webhooks as a list table. New and Edit open in a half-width sheet
    (webhooks/sheet, into the webhook_sheet frame); at their own addresses,
    and after a save, test or rotation, the list opens with it. The sheet
    wraps the whole page, as the New button sits in the title row. %>
<% content_for :page_actions do %>
  <% if Current.user.can?("webhooks:write") %>
    <%= link_to new_webhook_path, class: "btn", data: { keys: "n", turbo_frame: "webhook_sheet", action: "dialog#open" } do %>
      <%= icon_tag "add" %>
      <span>New webhook</span>
    <% end %>
  <% end %>
<% end %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= @sheet_webhook.present? %>"
     data-action="keydown.esc->dialog#close:stop">
<%= render "layouts/shared/page_header", title: @page_title %>

<section class="panel panel--scroll">
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>URL</th>
        <th class="data-table__num">Events</th>
        <th>Health</th>
        <th>Last delivery</th>
      </tr>
    </thead>
    <tbody>
      <% @webhooks.each do |webhook| %>
        <%# herb:key webhook.id %>
        <tr id="<%= dom_id(webhook) %>" data-filter-target="item">
          <td>
            <% if Current.user.can?("webhooks:write") %>
              <%= link_to webhook.name, edit_webhook_path(webhook), class: "title-link", data: { turbo_frame: "webhook_sheet", action: "dialog#open" } %>
            <% else %>
              <%= link_to webhook.name, webhook_path(webhook), class: "title-link" %>
            <% end %>
            <%= render "layouts/shared/row_links", name: webhook.name,
                delete_path: (webhook_path(webhook) if Current.user.can?("webhooks:delete")),
                delete_message: "Its receiver stops hearing about changes. Its delivery log goes too." %>
          </td>
          <td><span class="webhooks__url truncate text-mono text-small text-muted"><%= webhook.url %></span></td>
          <td class="data-table__num" title="<%= Array(webhook.events).join(", ") %>"><%= Array(webhook.events).size %></td>
          <td><%= webhook_health(webhook) %></td>
          <td><span class="nowrap text-small text-muted"><%= time_ago_tag webhook.last_delivery_at %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No webhooks yet.", columns: 5) if @webhooks.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>

<dialog class="dialog dialog--sheet dialog--sheet-half" data-dialog-target="dialog" aria-label="Webhook" closedby="any">
  <% if @sheet_webhook %>
    <%= render "webhooks/sheet", webhook: @sheet_webhook, deliveries: @sheet_deliveries || [] %>
  <% else %>
    <turbo-frame id="webhook_sheet"><p class="text-muted">Loading…</p></turbo-frame>
  <% end %>
</dialog>
</div>
