<% @page_title = "Webhooks" %>
<% can_write = Current.user.can?("webhooks:write") %>
<% can_delete = Current.user.can?("webhooks:delete") %>

<%# The webhooks as a data table. New and Edit open in a half-width sheet
    (webhooks/sheet, into the webhook_sheet frame); at their own addresses,
    and after a save, test or rotation, the list opens with it. The sheet
    wraps the whole page, as the New button sits in the title row. %>
<% content_for :page_actions do %>
  <% if can_write %>
    <%= link_to new_webhook_path, class: "ui-button ui-button--outline", data: { keys: "n", turbo_frame: "webhook_sheet", action: "dialog#open" } do %>
      <%= icon_tag "add" %>
      <span>New webhook</span>
    <% end %>
  <% end %>
<% end %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= @sheet_webhook.present? %>"
     data-action="keydown.esc->dialog#close:stop">
  <%= render "layouts/shared/page_header", title: @page_title %>

  <%= render "ui/data_table", id: "webhooks",
        columns: [ ui_column(:name, "Name", hideable: false), ui_column(:url, "URL"), ui_column(:events, "Events", align: :end),
                   ui_column(:health, "Health"), ui_column(:last_delivery, "Last delivery") ],
        rows: @webhooks, row: "webhooks/row", as: :webhook, pagination: @pagination, actions: true,
        row_locals: { can_write: can_write, can_delete: can_delete },
        empty: "No webhooks yet. Add one to tell another service when content changes." %>

  <dialog class="ui-sheet app-sheet--wide" data-dialog-target="dialog" aria-label="Webhook" closedby="any">
    <% if @sheet_webhook %>
      <%= render "webhooks/sheet", webhook: @sheet_webhook, deliveries: @sheet_deliveries || [] %>
    <% else %>
      <turbo-frame id="webhook_sheet"><p class="ui-dialog__description">Loading…</p></turbo-frame>
    <% end %>
  </dialog>
</div>
