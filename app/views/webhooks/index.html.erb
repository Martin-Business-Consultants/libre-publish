<% @page_title = "Webhooks" %>

<%# The webhooks as a list table. New and Edit open in a half-width sheet
    (webhooks/sheet, into the webhook_sheet frame); at their own addresses,
    and after a save, test or rotation, the list opens with it. The sheet
    wraps the whole page, as the New button sits in the title row. %>
<% content_for :page_actions do %>
  <% if Current.user.can?("webhooks:write") %>
    <%= link_to new_webhook_path, class: ui(:button), data: { keys: "n", turbo_frame: "webhook_sheet", action: "dialog#open" } do %>
      <%= icon_tag "add", class: "size-4" %>
      <span>New webhook</span>
    <% end %>
  <% end %>
<% end %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-dialog-auto-open-value="<%= @sheet_webhook.present? %>"
     data-action="keydown.esc->dialog#close:stop">
<%= render "layouts/shared/page_header", title: @page_title %>

<section class="<%= ui(:panel, "overflow-x-auto") %>">
  <table class="data-table <%= ui(:table) %>">
    <thead>
      <tr>
        <th class="<%= ui(:th) %>">Name</th>
        <th class="<%= ui(:th) %>">URL</th>
        <th class="<%= ui(:th, "text-right") %>">Events</th>
        <th class="<%= ui(:th) %>">Health</th>
        <th class="<%= ui(:th) %>">Last delivery</th>
      </tr>
    </thead>
    <tbody>
      <% @webhooks.each do |webhook| %>
        <%# herb:key webhook.id %>
        <tr id="<%= dom_id(webhook) %>" class="hover:bg-gray-50" data-filter-target="item">
          <td class="<%= ui(:td) %>">
            <% if Current.user.can?("webhooks:write") %>
              <%= link_to webhook.name, edit_webhook_path(webhook), class: "font-medium text-gray-900 hover:underline", data: { turbo_frame: "webhook_sheet", action: "dialog#open" } %>
            <% else %>
              <%= link_to webhook.name, webhook_path(webhook), class: "font-medium text-gray-900 hover:underline" %>
            <% end %>
            <%= render "layouts/shared/row_links", name: webhook.name,
                delete_path: (webhook_path(webhook) if Current.user.can?("webhooks:delete")),
                delete_message: "Its receiver stops hearing about changes. Its delivery log goes too." %>
          </td>
          <td class="<%= ui(:td, "max-w-xs") %>"><span class="block truncate font-mono text-xs text-gray-500"><%= webhook.url %></span></td>
          <td class="<%= ui(:td, "text-right tabular-nums") %>" title="<%= Array(webhook.events).join(", ") %>"><%= Array(webhook.events).size %></td>
          <td class="<%= ui(:td) %>"><%= webhook_health(webhook) %></td>
          <td class="<%= ui(:td) %>"><span class="text-xs whitespace-nowrap text-gray-500"><%= time_ago_tag webhook.last_delivery_at %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No webhooks yet.", columns: 5) if @webhooks.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>

<dialog class="<%= ui(:sheet, "dialog--sheet-half") %>" data-dialog-target="dialog" aria-label="Webhook" closedby="any">
  <% if @sheet_webhook %>
    <%= render "webhooks/sheet", webhook: @sheet_webhook, deliveries: @sheet_deliveries || [] %>
  <% else %>
    <turbo-frame id="webhook_sheet"><p class="text-sm text-gray-500">Loading…</p></turbo-frame>
  <% end %>
</dialog>
</div>
