<% @page_title = "Webhooks" %>

<%# The webhooks as a list table. New and Edit open in a half-width sheet
    (webhooks/sheet, into the webhook_sheet frame); at their own addresses,
    and after a save, test or rotation, the list opens with it. The sheet
    wraps the whole page, as the New button sits in the title row. %>
<% content_for :page_actions do %>
  <% if Current.user.can?("webhooks:write") %>
    <%= link_to new_webhook_path, class: "btn btn--secondary", data: { keys: "n", turbo_frame: "webhook_sheet", action: "rune-dialog#open" } do %>
      <%= icon_tag "add" %>
      <span>New webhook</span>
    <% end %>
  <% end %>
<% end %>
<div class="dialog-wrap" data-controller="rune-dialog" data-rune-dialog-auto-open-value="<%= @sheet_webhook.present? %>"
     data-action="keydown.esc->rune-dialog#close:stop">
<%= render "layouts/shared/page_header", title: @page_title, actions: false %>
<%= render "layouts/shared/list_toolbar", search: false %>

<section class="table-wrap">
  <table class="table data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>URL</th>
        <th class="data-table__num">Events</th>
        <th>Health</th>
        <th>Last delivery</th>
        <th class="data-table__actions-header"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @webhooks.each do |webhook| %>
        <%# herb:key webhook.id %>
        <tr id="<%= dom_id(webhook) %>" data-filter-target="item">
          <td>
            <% if Current.user.can?("webhooks:write") %>
              <%= link_to webhook.name, edit_webhook_path(webhook), class: "row-link", data: { turbo_frame: "webhook_sheet", action: "rune-dialog#open" } %>
            <% else %>
              <%= link_to webhook.name, webhook_path(webhook), class: "row-link" %>
            <% end %>
          </td>
          <td><span class="webhooks__url truncate mono small muted"><%= webhook.url %></span></td>
          <td class="data-table__num" title="<%= Array(webhook.events).join(", ") %>"><%= Array(webhook.events).size %></td>
          <td><%= webhook_health(webhook) %></td>
          <td><span class="nowrap small muted"><%= time_ago_tag webhook.last_delivery_at %></span></td>
          <%= render "layouts/shared/row_actions", name: webhook.name,
                delete_path: (webhook_path(webhook) if Current.user.can?("webhooks:delete")),
                delete_message: "Its receiver stops hearing about changes. Its delivery log goes too." %>
        </tr>
      <% end %>
      <%= table_empty_row("No webhooks yet.", columns: 6) if @webhooks.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>

<dialog class="dialog sheet webhook-sheet" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop" aria-label="Webhook" closedby="any">
  <% if @sheet_webhook %>
    <%= render "webhooks/sheet", webhook: @sheet_webhook, deliveries: @sheet_deliveries || [] %>
  <% else %>
    <turbo-frame id="webhook_sheet"><div class="dialog__box"><p class="muted">Loading…</p></div></turbo-frame>
  <% end %>
</dialog>
</div>
