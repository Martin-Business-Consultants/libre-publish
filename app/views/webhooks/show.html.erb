<% @page_title = @webhook.name %>
<%= parent_page "Webhooks", webhooks_path %>

<%= render "layouts/shared/page_header", title: @page_title %>

<div class="stack stack--lg measure">
  <div class="card card--sm">
    <p class="mono webhook-url"><%= @webhook.url %></p>
    <p class="button-row muted"><%= webhook_health(@webhook) %> <span><%= Array(@webhook.events).join(", ") %></span></p>
  </div>
  <%= render "webhooks/deliveries", deliveries: @deliveries, pagination: @pagination %>
</div>
