<% @page_title = @webhook.name %>
<%= parent_page "Webhooks", webhooks_path %>

<%= render "layouts/shared/page_header", title: @page_title %>

<div class="max-w-4xl space-y-6">
  <div class="<%= ui(:panel, "space-y-2 p-5") %>">
    <p class="font-mono text-sm break-all text-gray-900"><%= @webhook.url %></p>
    <p class="flex flex-wrap items-center gap-2 text-sm text-gray-500"><%= webhook_health(@webhook) %> <span><%= Array(@webhook.events).join(", ") %></span></p>
  </div>
  <%= render "webhooks/deliveries", deliveries: @deliveries, pagination: @pagination %>
</div>
