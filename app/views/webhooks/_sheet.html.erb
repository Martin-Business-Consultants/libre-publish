<%# locals: (webhook:, deliveries: []) %>
<%# A webhook in the list's sheet (the webhook_sheet frame): new, or one
    being edited with its signing secret, a test send and its recent
    deliveries. Everything in it acts across the whole page (turbo_frame
    _top): saved, created, rotated or tested, the list comes back with the
    sheet open on it; refused, the same, with the errors. %>
<turbo-frame id="webhook_sheet">
  <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title"><%= webhook.new_record? ? "New webhook" : webhook.name_was.presence || "Webhook" %></h2>
      <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
    </header>

    <% if webhook.persisted? %>
      <div class="row">
        <%= button_to "Send a test", webhook_test_delivery_path(webhook), class: "btn btn--secondary btn--sm", data: { turbo_frame: "_top" } %>
        <% if Current.user.can?("webhooks:delete") %>
          <%= render "layouts/shared/delete_dialog", name: webhook.name_was.to_s, path: webhook_path(webhook), trigger_text: "Delete",
                message: "Its receiver stops hearing about changes. Its delivery log goes too." %>
        <% end %>
      </div>

      <section class="field">
        <span class="field__label">Signing secret</span>
        <div class="row">
          <span class="secret-field grow" data-controller="reveal">
            <input type="password" value="<%= webhook.secret %>" readonly aria-label="Signing secret" data-reveal-target="input">
            <button type="button" class="icon-button" title="Show" aria-label="Show or hide" aria-pressed="false" data-reveal-target="button" data-action="reveal#toggle">
              <%= icon_tag "eye", class: "secret-field__show" %>
              <%= icon_tag "eye-off", class: "secret-field__hide" %>
            </button>
          </span>
          <%= copy_button webhook.secret %>
          <%= render "layouts/shared/confirm_dialog", label: "Rotate", title: "Rotate the signing secret?",
                message: "Existing receivers will need the new value.", path: webhook_secret_rotation_path(webhook) %>
        </div>
        <p class="field__hint">Receivers verify deliveries with <code>HMAC_SHA256(body, secret) === request.headers["x-cms-signature"].slice(7)</code>.</p>
      </section>
    <% end %>

    <%= render "layouts/shared/errors", record: webhook %>
    <%= form_with model: webhook, class: "stack", data: { turbo_frame: "_top" } do |form| %>
      <label class="field">
        <span class="field__label">Name</span>
        <%= form.text_field :name, required: true, autofocus: webhook.new_record?, autocomplete: "off", placeholder: "Astro frontend revalidation" %>
      </label>

      <label class="field">
        <span class="field__label">URL</span>
        <%= form.url_field :url, required: true, class: "mono", autocomplete: "off", placeholder: "https://hooks.example.com/cms" %>
        <span class="field__hint">Each delivery carries an <code>X-CMS-Signature</code> header (HMAC-SHA256 over the raw body).</span>
      </label>

      <label class="checkbox checkbox--top">
        <%= form.check_box :active %>
        <span class="stack stack--xs">
          <span class="field__label">Active</span>
          <span class="field__hint">Inactive webhooks are skipped: events aren’t queued or retried.</span>
        </span>
      </label>

      <fieldset>
        <legend class="field__label webhook-events__legend">Events</legend>
        <%= hidden_field_tag "webhook[events][]", "", id: nil %>
        <div class="grid-2">
          <% webhook_event_groups.each do |group, events| %>
            <%# herb:key group %>
            <fieldset class="webhook-events__group">
              <legend class="webhook-events__group-name"><%= group %></legend>
              <% events.each do |event| %>
                <%# herb:key event %>
                <label class="checkbox">
                  <%= check_box_tag "webhook[events][]", event, Array(webhook.events).include?(event), id: "webhook_event_" + event.tr(".", "_") %>
                  <span class="mono small"><%= event %></span>
                </label>
              <% end %>
            </fieldset>
          <% end %>
        </div>
      </fieldset>

      <%# Per-event filters a plugin adds (the Forms plugin: which forms send submission.created). %>
      <%= plugin_slots(:webhook_filters, webhook: webhook) %>

      <label class="field">
        <span class="field__label">Custom headers <span class="faint">(optional)</span></span>
        <%= form.text_area :headers_text, rows: 3, class: "mono", spellcheck: false, placeholder: "Authorization: Bearer xyz" %>
        <span class="field__hint">One “Name: value” per line.</span>
      </label>

      <div class="button-row">
        <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
        <%= form.button (webhook.new_record? ? "Add webhook" : "Save changes"), class: "btn btn--primary" %>
      </div>
    <% end %>

    <% if webhook.persisted? %>
      <%= render "webhooks/deliveries", deliveries: deliveries %>
    <% end %>
  </div>
</turbo-frame>
