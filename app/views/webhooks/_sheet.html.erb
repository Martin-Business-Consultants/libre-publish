<%# locals: (webhook:, deliveries: []) %>
<%# A webhook in the list's sheet (the webhook_sheet frame): new, or one
    being edited with its signing secret, a test send and its recent
    deliveries. Everything in it acts across the whole page (turbo_frame
    _top): saved, created, rotated or tested, the list comes back with the
    sheet open on it; refused, the same, with the errors. %>
<% deletable = webhook.persisted? && Current.user.can?("webhooks:delete") %>
<turbo-frame id="webhook_sheet">
  <div class="sheet-body">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" aria-label="Close" data-action="dialog#close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title"><%= webhook.new_record? ? "New webhook" : webhook.name_was.presence || "Webhook" %></h2>
      <p class="ui-dialog__description">
        <% if webhook.new_record? %>
          Tell another service, such as the site's build, when content changes.
        <% else %>
          <span class="text-mono break-all"><%= webhook.url_was %></span>
        <% end %>
      </p>
    </header>

    <% if webhook.persisted? %>
      <section class="ui-card ui-card--sm">
        <header class="ui-card__header">
          <h3 class="ui-card__title">Signing secret</h3>
          <p class="ui-card__description">Receivers verify deliveries with it.</p>
          <div class="ui-card__action">
            <%= button_to "Send a test", webhook_test_delivery_path(webhook), class: "ui-button ui-button--outline ui-button--sm", form_class: "contents", data: { turbo_frame: "_top" } %>
          </div>
        </header>
        <div class="ui-card__content ui-field">
          <div class="row">
            <span class="secret-field grow" data-controller="reveal">
              <input class="ui-input" type="password" value="<%= webhook.secret %>" readonly autocomplete="off" aria-label="Signing secret" data-reveal-target="input">
              <button type="button" class="ui-button ui-button--ghost ui-button--icon" title="Show" aria-pressed="false" data-reveal-target="button" data-action="reveal#toggle">
                <%= icon_tag "eye", class: "secret-field__show icon--sm" %>
                <%= icon_tag "eye-off", class: "secret-field__hide icon--sm" %>
                <span class="visually-hidden">Show or hide</span>
              </button>
            </span>
            <button type="button" class="ui-button ui-button--outline" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= webhook.secret %>" data-copy-to-clipboard-success-class="ui-button--secondary" data-action="copy-to-clipboard#copy">Copy</button>
            <%= render "layouts/shared/confirm_dialog", label: "Rotate", title: "Rotate the signing secret?",
                  message: "Existing receivers will need the new value.", path: webhook_secret_rotation_path(webhook) %>
          </div>
          <p class="ui-field__description"><code class="code">HMAC_SHA256(body, secret) === request.headers["x-cms-signature"].slice(7)</code></p>
        </div>
      </section>
    <% end %>

    <%= render "layouts/shared/errors", record: webhook %>
    <%= form_with model: webhook, class: "ui-fieldset", data: { turbo_frame: "_top" } do |form| %>
      <label class="ui-field">
        <span class="ui-label">Name</span>
        <%= form.text_field :name, required: true, autofocus: webhook.new_record?, autocomplete: "off", placeholder: "Astro frontend revalidation", class: "ui-input" %>
      </label>

      <label class="ui-field">
        <span class="ui-label">URL</span>
        <%= form.url_field :url, required: true, class: "ui-input text-mono", autocomplete: "off", placeholder: "https://hooks.example.com/cms" %>
        <span class="ui-field__description">Each delivery carries an <code class="code">X-CMS-Signature</code> header (HMAC-SHA256 over the raw body).</span>
      </label>

      <label class="ui-field ui-field--inline ui-field--end ui-field--card">
        <%= form.check_box :active, class: "ui-switch", role: "switch" %>
        <span class="ui-label">Active</span>
        <span class="ui-field__description">Inactive webhooks are skipped: events aren’t queued or retried.</span>
      </label>

      <fieldset class="ui-fieldset">
        <legend class="ui-label">Events</legend>
        <%= hidden_field_tag "webhook[events][]", "", id: nil %>
        <div class="grid grid--2 grid--md">
          <% webhook_event_groups.each do |group, events| %>
            <%# herb:key group %>
            <fieldset class="webhook-events__group">
              <legend class="webhook-events__group-name"><%= group %></legend>
              <% events.each do |event| %>
                <%# herb:key event %>
                <label class="ui-field ui-field--inline">
                  <%= check_box_tag "webhook[events][]", event, Array(webhook.events).include?(event), id: "webhook_event_" + event.tr(".", "_"), class: "ui-checkbox" %>
                  <span class="text-mono text-small"><%= event %></span>
                </label>
              <% end %>
            </fieldset>
          <% end %>
        </div>
      </fieldset>

      <%# Per-event filters a plugin adds (the Forms plugin: which forms send submission.created). %>
      <%= plugin_slots(:webhook_filters, webhook: webhook) %>

      <label class="ui-field">
        <span class="ui-label">Custom headers <span class="text-muted">(optional)</span></span>
        <%= form.text_area :headers_text, rows: 3, class: "ui-textarea text-mono", spellcheck: false, placeholder: "Authorization: Bearer xyz" %>
        <span class="ui-field__description">One “Name: value” per line.</span>
      </label>

      <footer class="ui-dialog__footer">
        <% if deletable %>
          <span class="sheet-body__delete">
            <%= render "layouts/shared/delete_dialog", name: webhook.name_was.to_s, path: webhook_path(webhook), trigger_text: "Delete",
                  form: "webhook_delete_form", message: "Its receiver stops hearing about changes. Its delivery log goes too." %>
          </span>
        <% end %>
        <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
        <%= form.button (webhook.new_record? ? "Add webhook" : "Save changes"), class: "ui-button" %>
      </footer>
    <% end %>
    <% if deletable %>
      <%= render "layouts/shared/delete_form", id: "webhook_delete_form", path: webhook_path(webhook) %>
    <% end %>

    <% if webhook.persisted? %>
      <%= render "webhooks/deliveries", deliveries: deliveries %>
    <% end %>
  </div>
</turbo-frame>
