<% @page_title = "robots.txt" %>
<% can_write = Current.user.can?("settings:write") %>

<% content_for :page_actions do %>
  <%= link_to "Sitemap", sitemap_path, class: "ui-button ui-button--outline" %>
  <%= link_to "View robots.txt", "#{@base_url}/robots.txt", class: "ui-button ui-button--outline", target: "_blank", rel: "noopener" %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<div class="robots-split">
  <%= form_with url: sitemap_robots_path, method: :patch, scope: :robots do |form| %>
    <%= tag.fieldset class: "ui-card robots-form", disabled: !can_write do %>
      <header class="ui-card__header">
        <h2 class="ui-card__title">What crawlers are told</h2>
        <p class="ui-card__description">robots.txt tells search engines and AI crawlers what they may read, and where the sitemap is. The site publishes it on its next build.</p>
      </header>
      <div class="ui-card__content">
      <div class="ui-fieldset" data-controller="show-if">
        <div data-field-name="robots_mode">
          <%= settings_field "robots.txt is" do %>
            <%= form.select :robots_mode, [["Made from Settings › Search (recommended)", "generated"], ["Written here, exactly as I write it", "custom"]], { selected: @robots.custom? ? "custom" : "generated" }, { class: "ui-select" } %>
          <% end %>
        </div>
        <div class="ui-fieldset" data-show-if='{"field":"robots_mode","equals":"generated"}'>
          <p class="ui-field__description">
            Open to every search engine, AI answer engines and training crawlers let in or kept out as <%= link_to "Settings › Search", settings_search_path, class: "link" %> says
            (now: AI search <strong><%= @settings["ai_search"] == "block" ? "kept out" : "let in" %></strong>, AI training <strong><%= @settings["ai_training"] == "block" ? "kept out" : "let in" %></strong>), and the sitemap's address.
          </p>
          <%= settings_field "Extra rules", hint: "Added as written: a crawler or a path the choices don't cover." do %>
            <%= form.text_area :robots_extra, value: @settings["robots_extra"], rows: 5, class: "ui-textarea robots-form__code", placeholder: "User-agent: *\nDisallow: /thank-you\nDisallow: /search" %>
          <% end %>
        </div>
        <div class="ui-fieldset" data-show-if='{"field":"robots_mode","equals":"custom"}'>
          <%= settings_field "robots.txt", hint: "The whole file. Keep a Sitemap line, and never “Disallow: /” for every crawler unless the site should leave search." do %>
            <%= form.text_area :robots_custom, value: @settings["robots_custom"].presence || @robots.generated, rows: 18, class: "ui-textarea robots-form__code", spellcheck: false %>
          <% end %>
        </div>
      </div>
      </div>
      <% if can_write %>
        <footer class="ui-card__footer ui-card__footer--bordered">
          <button type="submit" class="ui-button">Save</button>
          <% if @robots.custom? %>
            <button type="submit" name="reset" value="1" class="ui-button ui-button--ghost" data-turbo-confirm="Go back to robots.txt made from Settings › Search? What's written here is kept for later.">Use the made one again</button>
          <% end %>
        </footer>
      <% end %>
    <% end %>
  <% end %>

  <section class="ui-card robots-preview" aria-labelledby="robots_preview_title">
    <header class="ui-card__header">
      <h2 class="ui-card__title" id="robots_preview_title">What the site publishes</h2>
      <p class="ui-card__description"><%= @robots.custom? ? "Written here" : "Made from Settings › Search" %></p>
    </header>
    <div class="ui-card__content robots-preview__body">
      <% if @warnings.any? %>
        <% @warnings.each_with_index do |warning, index| %>
          <%# herb:key index %>
          <div class="ui-alert ui-alert--warning" role="status">
            <%= icon_tag "bell-alert", class: "ui-alert__icon" %>
            <div class="ui-alert__description"><%= warning %></div>
          </div>
        <% end %>
      <% else %>
        <div class="ui-alert ui-alert--success" role="status">
          <%= icon_tag "check-circle", class: "ui-alert__icon" %>
          <p class="ui-alert__title">Nothing looks wrong.</p>
        </div>
      <% end %>
      <pre class="code-block code-block--wrap robots-preview__text"><%= @text %></pre>
      <p class="ui-field__description">At <span class="text-mono"><%= @base_url %>/robots.txt</span>. <% if Website.enabled? %>Served by this site.<% else %>A site built with the Astro integration (0.2.0 or later) takes it from <span class="text-mono">/api/v1/robots</span> on every build; one with a <span class="text-mono">public/robots.txt</span> of its own keeps that instead.<% end %></p>
    </div>
  </section>
</div>
