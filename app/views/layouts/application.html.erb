<!DOCTYPE html>
<%# The admin, as shadcn/ui's sidebar layout: the sidebar down the left (the site, New, the
    menu, plugins' actions and the signed-in person) and beside it the page as an inset sheet
    under its header (the menu toggle, the breadcrumb, search, the theme). Signed-out pages use
    layouts/public. %>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/shared/head" %>

  <body class="<%= class_names(@body_class) %>" data-controller="keyboard admin-menu">
    <a href="#main" class="ui-button app-skip-link" data-turbo="false"><%= tx("Skip to main content") %></a>
    <div id="global-container" class="app-shell" data-controller="filter">
      <% if Current.user %>
        <%= render "layouts/shared/sidebar" %>
        <%= render "layouts/shared/global_search" %>
        <%= render "layouts/shared/update_progress" %>
      <% end %>

      <div class="app-inset">
        <% if Current.user %>
          <%= render "layouts/shared/inset_header" %>
        <% end %>
        <main id="main" class="app-main">
          <%= content_for?(:content) ? yield(:content) : yield %>
        </main>
      </div>
    </div>

    <%= render "layouts/shared/flash" %>

    <footer id="footer">
      <%= yield :footer %>
    </footer>
  </body>
</html>
