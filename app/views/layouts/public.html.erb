<!DOCTYPE html>
<%# Signed-out pages: sign in, sign up, password reset. No navigation, just the site's logo. %>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/shared/head" %>

  <body class="public">
    <div id="global-container">
      <header class="public__header" id="header">
        <a href="#main" class="btn admin__skip-link" data-turbo="false">Skip to main content</a>
        <nav class="public__brand">
          <span class="public__logo"><%= render "layouts/shared/logo" %></span>
          <%= render "layouts/shared/theme_toggle" %>
        </nav>

        <%= yield :header %>
      </header>

      <%= render "layouts/shared/flash" %>

      <main id="main" class="public__main">
        <%= yield %>
      </main>
    </div>

    <footer id="footer">
      <%= yield :footer %>
    </footer>
  </body>
</html>
