<!DOCTYPE html>
<%# Signed-out pages: sign in, sign up, password reset. rune_ui's narrow
    column, under the site's logo, with no navigation. %>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/shared/head" %>

  <body class="public">
    <a href="#main" class="skip-link" data-turbo="false"><%= tx("Skip to main content") %></a>
    <div id="global-container">
      <header class="public__header" id="header">
        <span class="public__logo"><%= render "layouts/shared/logo" %></span>
        <%= render "layouts/shared/theme_toggle" %>
      </header>

      <main id="main" class="main main--narrow public__main">
        <%= render "layouts/shared/flash" %>
        <%= yield :header %>
        <%= yield %>
      </main>
    </div>

    <footer id="footer">
      <%= yield :footer %>
    </footer>
  </body>
</html>
