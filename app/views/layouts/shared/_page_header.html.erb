<%# locals: (title:, **) %>
<%# An admin page's title row, as rune_ui draws one: the title in the panel
    bar, after the page one level up (parent_page), and in the page the
    page's actions (content_for :page_actions, a New button first) at the
    right. Other locals (icon:, a plugin's description:) are taken and not
    shown. On a Settings page it goes above the page and its sidebar
    (layouts/settings) rather than where it's rendered. %>
<% title = title.is_a?(String) && !title.html_safe? ? tx(title) : title %>
<%= page_crumbs(title) %>
<% header = capture do %>
  <% if content_for?(:page_actions) %>
    <div class="page-header">
      <div class="page-header__text"></div>
      <div class="button-row"><%= content_for(:page_actions) %></div>
    </div>
  <% end %>
  <% if (cli = cli_command_hint) %>
    <p class="cli-hint">
      <span><%= tx("From the CLI or MCP:") %></span>
      <code><%= cli %></code>
      <%= copy_button cli, label: tx("Copy") %>
    </p>
  <% end %>
  <% if search_term %>
    <p>
      <%= tx("Search results for") %> “<strong><%= search_term %></strong>”
      <%= link_to tx("Clear"), url_for(request.query_parameters.except("s", "page")) %>
    </p>
  <% end %>
<% end %>
<% if settings_screen? %>
  <% content_for :settings_header, header %>
<% else %>
  <%= header %>
<% end %>
