<%# locals: (pagination:) %>
<%# Under an index table (pagination_nav), as shadcn's data table pages: which rows these are,
    then Previous, the page numbers with a gap (…) where some are skipped, and Next. The current
    page is outlined; Previous and Next are shown but off on the first and last pages, so the
    row doesn't jump. %>
<nav class="table-pagination" aria-label="<%= tx("Pages") %>">
  <p class="table-pagination__summary">
    <%= number_with_delimiter(pagination.first_row) %>–<%= number_with_delimiter(pagination.last_row) %> <%= tx("of") %> <%= number_with_delimiter(pagination.total_count) %>
  </p>
  <ul class="table-pagination__pages">
    <li>
      <% if pagination.previous_number %>
        <%= link_to pagination_path(pagination.previous_number), class: "ui-button ui-button--ghost ui-button--sm", rel: "prev" do %>
          <%= icon_tag "arrow-left" %> <%= tx("Previous") %>
        <% end %>
      <% else %>
        <span class="ui-button ui-button--ghost ui-button--sm" aria-disabled="true"><%= icon_tag "arrow-left" %> <%= tx("Previous") %></span>
      <% end %>
    </li>
    <% pagination.window.each_with_index do |number, index| %>
      <%# herb:key index %>
      <li>
        <% if number.nil? %>
          <span class="table-pagination__gap" aria-hidden="true">…</span>
        <% elsif number == pagination.number %>
          <span class="ui-button ui-button--outline ui-button--icon-sm" aria-current="page"><%= number %></span>
        <% else %>
          <%= link_to number, pagination_path(number), class: "ui-button ui-button--ghost ui-button--icon-sm", aria: { label: "Page #{number}" } %>
        <% end %>
      </li>
    <% end %>
    <li>
      <% if pagination.next_number %>
        <%= link_to pagination_path(pagination.next_number), class: "ui-button ui-button--ghost ui-button--sm", rel: "next" do %>
          <%= tx("Next") %> <%= icon_tag "arrow-right" %>
        <% end %>
      <% else %>
        <span class="ui-button ui-button--ghost ui-button--sm" aria-disabled="true"><%= tx("Next") %> <%= icon_tag "arrow-right" %></span>
      <% end %>
    </li>
  </ul>
</nav>
