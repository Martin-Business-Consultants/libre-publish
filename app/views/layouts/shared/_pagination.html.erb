<%# locals: (pagination:) %>
<%# Under an index table (pagination_nav): which rows these are, then
    « Previous, the page numbers with a gap (…) where some are skipped, and
    Next ». The current page is pressed; Previous and Next are shown but off
    on the first and last pages, so the row doesn't jump. %>
<nav class="pagination" aria-label="Pages">
  <p class="muted tabular">
    <%= number_with_delimiter(pagination.first_row) %>–<%= number_with_delimiter(pagination.last_row) %> of <%= number_with_delimiter(pagination.total_count) %>
  </p>
  <div class="pagination__pages">
    <% if pagination.previous_number %>
      <%= link_to pagination_path(pagination.previous_number), class: "btn btn--ghost btn--sm", rel: "prev" do %>
        <span aria-hidden="true">«</span> Previous
      <% end %>
    <% else %>
      <span class="btn btn--ghost btn--sm" aria-disabled="true"><span aria-hidden="true">«</span> Previous</span>
    <% end %>
    <% pagination.window.each_with_index do |number, index| %>
      <%# herb:key index %>
      <% if number.nil? %>
        <span class="pagination__gap" aria-hidden="true">…</span>
      <% elsif number == pagination.number %>
        <span class="btn btn--secondary btn--sm pagination__page" aria-current="page"><%= number %></span>
      <% else %>
        <%= link_to number, pagination_path(number), class: "btn btn--ghost btn--sm pagination__page", aria: { label: "Page #{number}" } %>
      <% end %>
    <% end %>
    <% if pagination.next_number %>
      <%= link_to pagination_path(pagination.next_number), class: "btn btn--ghost btn--sm", rel: "next" do %>
        Next <span aria-hidden="true">»</span>
      <% end %>
    <% else %>
      <span class="btn btn--ghost btn--sm" aria-disabled="true">Next <span aria-hidden="true">»</span></span>
    <% end %>
  </div>
</nav>
