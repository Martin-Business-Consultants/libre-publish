<%# locals: () %>
<%# WordPress's Screen Options, in the admin bar left of the theme toggle:
    tick which of the page's table columns show (screen_options_controller).
    The tab shows only where the page has a table with columns to choose
    from; its panel drops down from it, and closes on a click elsewhere or Esc. %>
<div class="screen-options" data-controller="screen-options" data-screen-options-screen-value="<%= controller_path %>#<%= action_name %>"
     data-action="click@window->screen-options#closeOutside keydown.esc@window->screen-options#close">
  <button type="button" class="btn btn--plain btn--sm screen-options__tab" aria-expanded="false" aria-controls="screen_options_panel" hidden
          data-screen-options-target="tab" data-action="screen-options#toggle">
    Screen options
    <%= icon_tag "caret-down", class: "icon--xs" %>
  </button>
  <div class="menu screen-options__panel" id="screen_options_panel" hidden data-screen-options-target="panel">
    <fieldset>
      <legend class="text-medium text-ink">Columns</legend>
      <div class="screen-options__choices" data-screen-options-target="choices"></div>
    </fieldset>
  </div>
</div>
