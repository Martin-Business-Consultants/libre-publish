<%# locals: () %>
<%# WordPress's Screen Options, in the admin bar left of the theme toggle:
    tick which of the page's table columns show (screen_options_controller).
    The tab shows only where the page has a table with columns to choose
    from; its panel drops down from it, and closes on a click elsewhere or Esc. %>
<div class="relative flex items-center" data-controller="screen-options" data-screen-options-screen-value="<%= controller_path %>#<%= action_name %>"
     data-action="click@window->screen-options#closeOutside keydown.esc@window->screen-options#close">
  <button type="button" class="<%= ui(:button, :plain, :small, "screen-options__tab") %>" aria-expanded="false" aria-controls="screen_options_panel" hidden
          data-screen-options-target="tab" data-action="screen-options#toggle">
    Screen options
    <%= icon_tag "caret-down", class: "size-3" %>
  </button>
  <div class="<%= ui(:menu, "absolute top-full right-0 z-50 mt-1 w-72 px-4 py-3") %>" id="screen_options_panel" hidden data-screen-options-target="panel">
    <fieldset>
      <legend class="text-sm font-medium text-gray-900">Columns</legend>
      <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-700" data-screen-options-target="choices"></div>
    </fieldset>
  </div>
</div>
