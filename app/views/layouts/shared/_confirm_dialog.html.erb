<%# locals: (label:, title:, path:, method: nil, message: nil, button: nil, negative: nil, primary: nil, trigger_class: nil, params: nil) %>
<%# A button that asks once in rune_ui's dialog before it acts (restore, purge,
    approve…). The delete-with-a-trash-icon case is layouts/shared/delete_dialog.
    The trigger is a small secondary button, red when negative; primary: the
    screen's one primary button instead, full size. trigger_class: classes
    to add to the trigger. %>
<% trigger_classes = primary ? button_classes(variant: :primary, extra: trigger_class) : button_classes(variant: (negative ? :danger : :secondary), size: :sm, extra: trigger_class) %>
<div class="dialog-wrap" data-controller="rune-dialog">
  <button type="button" class="<%= trigger_classes %>" data-action="rune-dialog#open"><%= label %></button>
  <dialog class="dialog" aria-label="<%= title %>" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title"><%= title %></h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <div class="dialog__body">
        <% if message %>
          <p class="muted"><%= message %></p>
        <% end %>
        <div class="dialog__actions">
          <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
          <%= button_to(button || label, path, method: method || :post, params: params || {}, class: button_classes(variant: (negative ? :danger : :primary)), data: { turbo_frame: "_top" }) %>
        </div>
      </div>
    </div>
  </dialog>
</div>
