<%# locals: (label:, title:, path:, method: nil, message: nil, button: nil, negative: nil, primary: nil, trigger_class: nil, params: nil) %>
<%# A button that asks once in a modal before it acts (restore, purge, approve…).
    The delete-with-a-trash-icon case is layouts/shared/delete_dialog.
    The trigger is a small secondary button, red when negative; primary: the
    screen's one primary button instead, full size. trigger_class: classes
    to add to the trigger. %>
<% trigger_classes = class_names("btn", primary ? "btn--primary" : ["btn--sm", ("btn--danger" if negative)], trigger_class) %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="<%= trigger_classes %>" data-action="dialog#open"><%= label %></button>
  <dialog class="dialog dialog--action" data-dialog-target="dialog">
    <h3 class="heading heading--lg"><%= title %></h3>
    <% if message %>
      <p class="text-body"><%= message %></p>
    <% end %>
    <div class="dialog__actions">
      <button type="button" class="btn" data-action="dialog#close">Cancel</button>
      <%= button_to(button || label, path, method: method || :post, params: params || {}, class: (negative ? "btn btn--danger" : "btn btn--primary"), data: { turbo_frame: "_top" }) %>
    </div>
  </dialog>
</div>
