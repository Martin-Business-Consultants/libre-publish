<%# locals: (id:, noun:, status_path: nil, statuses: nil, deletion_path: nil, delete_message: nil, search: nil) %>
<%# A list's toolbar, above its data table as shadcn's: the search box on the left, and on the
    right a "Bulk actions" select and Apply for the ticked rows, whose checkboxes join the form
    with form="<id>"; the chosen action says where it posts (bulk_actions_controller), and
    deleting asks first. Pass nil for an action the role doesn't grant. search: false leaves
    the search box out.

    Without JavaScript the select can't choose where the form posts, so it stays hidden (the
    controller shows it) and <noscript> offers a button per action instead, each posting to its
    own resource (formaction); Delete opens under a <details> first, so it still takes a second
    click. %>
<% message = delete_message || "They go to the trash, where they can be restored." %>
<div class="list-toolbar">
  <% unless search == false %>
    <div class="list-toolbar__search">
      <%= render "layouts/shared/list_search" %>
    </div>
  <% end %>
  <% if status_path || deletion_path %>
    <%= form_with url: status_path || deletion_path, id: id, class: "list-toolbar__bulk", data: { controller: "bulk-actions" } do %>
      <div class="row row--xs" data-bulk-actions-target="controls" hidden>
        <label class="visually-hidden" for="<%= id %>_choice"><%= tx("Bulk actions") %></label>
        <select id="<%= id %>_choice" class="ui-select ui-select--sm" data-bulk-actions-target="choice">
          <option value=""><%= tx("Bulk actions") %></option>
          <% if deletion_path %>
            <option value="delete" data-url="<%= deletion_path %>" data-confirm="true"><%= tx("Delete") %></option>
          <% end %>
          <% if status_path %>
            <% Array(statuses).each do |status| %>
              <%# herb:key status %>
              <option value="status-<%= status %>" data-url="<%= status_path %>" data-status="<%= status %>">Set to <%= status.to_s.humanize.downcase %></option>
            <% end %>
          <% end %>
        </select>
        <input type="hidden" name="status" value="" data-bulk-actions-target="status">
        <button type="button" class="ui-button ui-button--outline ui-button--sm" data-action="bulk-actions#apply"><%= tx("Apply") %></button>
      </div>
      <noscript>
        <div class="cluster">
          <% if status_path %>
            <% Array(statuses).each do |status| %>
              <%# herb:key status %>
              <button type="submit" class="ui-button ui-button--outline ui-button--sm" formaction="<%= status_path %>" name="status" value="<%= status %>">Set to <%= status.to_s.humanize.downcase %></button>
            <% end %>
          <% end %>
          <% if deletion_path %>
            <details>
              <summary class="ui-button ui-button--destructive ui-button--sm">Delete…</summary>
              <div class="cluster">
                <span><%= message %></span>
                <button type="submit" class="ui-button ui-button--destructive ui-button--sm" formaction="<%= deletion_path %>">Delete the ticked <%= noun.pluralize %></button>
              </div>
            </details>
          <% end %>
        </div>
      </noscript>
      <dialog class="ui-dialog" aria-label="Delete the ticked <%= noun.pluralize %>?" data-bulk-actions-target="dialog">
        <header class="ui-dialog__header">
          <h2 class="ui-dialog__title">Delete the ticked <%= noun.pluralize %>?</h2>
          <p class="ui-dialog__description"><%= message %></p>
        </header>
        <footer class="ui-dialog__footer">
          <button type="button" class="ui-button ui-button--outline" data-action="bulk-actions#cancel"><%= tx("Cancel") %></button>
          <button type="submit" class="ui-button ui-button--destructive">
            <%= icon_tag "trash" %>
            <span><%= tx("Delete") %></span>
          </button>
        </footer>
      </dialog>
    <% end %>
  <% end %>
</div>
