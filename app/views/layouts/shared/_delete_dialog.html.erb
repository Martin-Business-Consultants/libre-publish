<%# locals: (name:, path:, message: nil, trigger_class: nil, keys: nil, trigger_text: nil, form: nil) %>
<%# A delete: a trash button opening rune_ui's dialog that names what goes and asks once.
    trigger_text: a red text link instead of the button (a list table's row
    actions, a Publish box's Move to Trash), sized by what's around it.
    trigger_class: classes to add to the trigger.
    form: the id of a delete form rendered elsewhere (layouts/shared/delete_form),
    for a dialog that sits inside another form; a form can't nest, and a
    nested one's _method=delete would join the outer form. %>
<% title = "Delete " + name + "?" %>
<div class="dialog-wrap" data-controller="rune-dialog">
  <% if trigger_text %>
    <button type="button" class="<%= class_names("link-button link-button--danger", trigger_class) %>" title="<%= title %>" data-action="rune-dialog#open"><%= trigger_text %></button>
  <% else %>
    <button type="button" class="<%= class_names("icon-button icon-button--danger", trigger_class) %>" title="<%= title %>" aria-label="<%= title %>" data-keys="<%= keys %>" data-action="rune-dialog#open">
      <%= icon_tag "trash" %>
    </button>
  <% end %>
  <dialog class="dialog" aria-label="<%= title %>" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title"><%= title %></h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <div class="dialog__body">
        <p class="muted"><%= message || "This can’t be undone." %></p>
        <div class="dialog__actions">
          <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
          <% if form %>
            <button type="submit" form="<%= form %>" class="btn btn--danger">
              <%= icon_tag "trash" %>
              <span>Delete</span>
            </button>
          <% else %>
            <%= button_to path, method: :delete, class: "btn btn--danger", data: { turbo_frame: "_top" } do %>
              <%= icon_tag "trash" %>
              <span>Delete</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </dialog>
</div>
