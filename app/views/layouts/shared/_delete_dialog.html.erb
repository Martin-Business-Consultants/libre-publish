<%# locals: (name:, path:, message: nil, trigger_class: nil, keys: nil, trigger_text: nil, form: nil) %>
<%# Fizzy's delete: a trash button opening a modal that names what goes and asks once.
    trigger_text: a red text link instead of the button (a list table's row
    actions, a Publish box's Move to Trash), sized by what's around it.
    trigger_class: classes to add to the trigger.
    form: the id of a delete form rendered elsewhere (layouts/shared/delete_form),
    for a dialog that sits inside another form; a form can't nest, and a
    nested one's _method=delete would join the outer form. %>
<% title = "Delete " + name + "?" %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <% if trigger_text %>
    <button type="button" class="<%= class_names("delete-link", trigger_class) %>" title="<%= title %>" data-action="dialog#open"><%= trigger_text %></button>
  <% else %>
    <button type="button" class="<%= class_names("ui-button ui-button--ghost ui-button--icon-sm", trigger_class) %>" title="<%= title %>" data-keys="<%= keys %>" data-action="dialog#open">
      <%= icon_tag "trash" %>
      <span class="visually-hidden"><%= title %></span>
    </button>
  <% end %>
  <dialog class="ui-dialog" data-dialog-target="dialog" aria-label="<%= title %>">
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title"><%= title %></h2>
      <p class="ui-dialog__description"><%= message || "This can’t be undone." %></p>
    </header>
    <footer class="ui-dialog__footer">
      <button type="button" class="ui-button ui-button--outline" data-action="dialog#close">Cancel</button>
      <% if form %>
        <button type="submit" form="<%= form %>" class="ui-button ui-button--destructive">
          <%= icon_tag "trash" %>
          <span>Delete</span>
        </button>
      <% else %>
        <%= button_to path, method: :delete, class: "ui-button ui-button--destructive", data: { turbo_frame: "_top" } do %>
          <%= icon_tag "trash" %>
          <span>Delete</span>
        <% end %>
      <% end %>
    </footer>
  </dialog>
</div>
