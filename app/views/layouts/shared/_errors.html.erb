<%# locals: (record:) %>
<%# A record's validation errors, above the form that didn't save, as the kit's destructive
    alert. %>
<% if record.errors.any? %>
  <div class="ui-alert ui-alert--destructive" role="alert">
    <%= icon_tag "close-circle", class: "ui-alert__icon" %>
    <p class="ui-alert__title"><%= tx("That didn’t work:") %></p>
    <div class="ui-alert__description">
      <ul class="bullet-list">
        <% record.errors.full_messages.each do |message| %>
          <%# herb:key message %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
