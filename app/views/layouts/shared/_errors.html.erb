<%# locals: (record:) %>
<%# A record's validation errors, above the form that didn't save. %>
<% if record.errors.any? %>
  <div class="<%= ui(:notice, :red, "mb-4") %>" role="alert">
    <%= icon_tag "close-circle", class: "mt-0.5 size-4 shrink-0" %>
    <div class="space-y-1">
      <p class="font-medium">That didn’t work:</p>
      <ul class="list-disc space-y-0.5 pl-5">
        <% record.errors.full_messages.each do |message| %>
          <%# herb:key message %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
