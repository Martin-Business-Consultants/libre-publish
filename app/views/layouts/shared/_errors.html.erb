<%# locals: (record:) %>
<%# A record's validation errors, above the form that didn't save. %>
<% if record.errors.any? %>
  <div class="notice notice--danger" role="alert">
    <%= icon_tag "close-circle" %>
    <div class="stack stack--xs">
      <p class="text-medium">That didn’t work:</p>
      <ul class="bullet-list">
        <% record.errors.full_messages.each do |message| %>
          <%# herb:key message %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
