<%# locals: (text:, path:, icon: nil, key: nil) %>
<%# A title row's "Add New": a secondary button (the screen's primary action
    is on the screen itself), n by default. %>
<% icon ||= "add"
   key ||= "n" %>
<a href="<%= path %>" class="btn btn--secondary" data-keys="<%= key %>">
  <%= icon_tag icon %>
  <span class="truncate"><%= text %></span>
  <kbd><%= key.upcase %></kbd>
</a>
