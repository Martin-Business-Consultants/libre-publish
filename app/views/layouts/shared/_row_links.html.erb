<%# locals: (links: nil, buttons: nil, note: nil, name: nil, edit_path: nil, delete_path: nil, delete_name: nil, delete_message: nil, delete_label: nil, id: nil) %>
<%# A list row's actions: the kit's row actions menu (ui/_row_actions), a ⋯ button opening
    Edit, the links, the buttons and Delete. Kept for plugins' tables, which render it in a
    row's title cell; a data table renders ui/row_actions in its actions column. %>
<%= render "ui/row_actions", id: id || "row_#{SecureRandom.hex(4)}", links: links, buttons: buttons, note: note, name: name,
      edit_path: edit_path, delete_path: delete_path, delete_name: delete_name, delete_message: delete_message, delete_label: delete_label %>
