<%# locals: (links: nil, buttons: nil, note: nil, name: nil, edit_path: nil, delete_path: nil, delete_name: nil, delete_message: nil, delete_label: nil) %>
<%# A list table row's actions, under its title as WordPress shows them
    ("Edit | View | Delete"), revealed while the row is hovered or holds focus
    (.row-actions, admin.css). links: [[label, url], …] after Edit (edit_path).
    buttons: [[label, url, title], …], actions that POST (Restore, Run), drawn
    as the same links. note: a line of text in place of an action that isn't
    available. delete_path: the record's delete, confirmed in a dialog. Pass
    nil for what the record or the role doesn't allow. %>
<% links = ([ ([ "Edit", edit_path ] if edit_path) ] + Array(links)).compact %>
<% buttons = Array(buttons).compact %>
<% link_classes = "text-gray-500 hover:text-gray-900 hover:underline" %>
<% if links.any? || buttons.any? || note || delete_path %>
  <div class="row-actions mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
    <% links.each do |label, url| %>
      <%# herb:key label %>
      <%= link_to label, url, class: link_classes %>
    <% end %>
    <% buttons.each do |label, url, title| %>
      <%# herb:key label %>
      <%= button_to label, url, class: link_classes, form_class: "inline", title: title %>
    <% end %>
    <% if note %>
      <span class="text-gray-400"><%= note %></span>
    <% end %>
    <% if delete_path %>
      <%= render "layouts/shared/delete_dialog", name: delete_name || name || "this", path: delete_path, message: delete_message,
            trigger_text: delete_label || "Delete" %>
    <% end %>
  </div>
<% end %>
