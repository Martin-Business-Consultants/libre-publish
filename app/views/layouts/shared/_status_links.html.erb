<%# locals: (param:, current:, options:) %>
<%# A list's status filter as WordPress words it, "All (12) | Published (8) |
    Draft (4)", drawn as rune_ui's pill tabs, the current one raised.
    options: [[label, value, count], …], the first usually All with value
    nil. Each link swaps one query param, so filters are bookmarkable. %>
<nav class="tabs tabs--pills" aria-label="<%= tx("Status") %>">
  <% options.each do |label, value, count| %>
    <%# herb:key label %>
    <% chosen = value.to_s == current.to_s %>
    <%= link_to url_for(request.query_parameters.except("page").merge(param.to_s => value.presence).compact),
          class: "tabs__tab", aria: { current: ("page" if chosen) } do %>
      <%= label %>
      <% if count %>
        <span class="count count--quiet"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
