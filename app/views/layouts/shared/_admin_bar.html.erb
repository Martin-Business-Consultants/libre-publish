<%# locals: () %>
<%# The admin bar: the site, "+ New", the update notice, plugins' items, the
    "/" filter, search across everything, screen options, the theme and the
    signed-in person. Its menus open on hover
    and on keyboard focus (admin.css), with no JavaScript. %>
<% site_url = public_site_url %>
<% new_items = admin_new_items %>
<%# .admin-bar__item lays an item out (admin.css), so the drawer toggle can hide on wide screens. %>
<header class="<%= class_names("admin-bar", "admin-bar--dark" => Branding.current.dark_top_bar?) %>" id="header">
  <button type="button" class="admin-bar__item admin-bar__item--muted admin-bar__drawer-toggle" aria-controls="admin-menu" aria-expanded="false"
    data-admin-menu-target="drawerToggle" data-action="admin-menu#toggleDrawer">
    <%= icon_tag "menu", class: "icon--md" %>
    <span class="visually-hidden"><%= tx("Menu") %></span>
  </button>

  <div class="admin-bar__dropdown">
    <% branding = current_branding %>
    <% site_name = branding[:site_title].presence || Site.key %>
    <%= link_to dashboard_path, class: "admin-bar__item admin-bar__item--site", title: tx("Dashboard (g h)"), data: { keys: "g h" } do %>
      <% if branding[:logo_url_small].present? %>
        <%# Settings › Branding's logo, as tall as the bar and as wide as it is. %>
        <%= image_tag branding[:logo_url_small], alt: site_name, class: "admin-bar__logo" %>
      <% else %>
        <span class="admin-bar__mark"><%= icon_tag "home", class: "icon--sm" %></span>
        <span class="admin-bar__label"><%= site_name %></span>
      <% end %>
    <% end %>
    <% if site_url %>
      <ul class="menu admin-bar__menu">
        <li><%= link_to tx("View site"), site_url, class: "menu__item", target: "_blank", rel: "noopener" %></li>
      </ul>
    <% end %>
  </div>

  <% if new_items.any? %>
    <div class="admin-bar__dropdown">
      <%= link_to new_items.first.last, class: "admin-bar__item admin-bar__item--muted", title: tx("New (n)") do %>
        <%= icon_tag "add", class: "icon--sm" %>
        <span class="admin-bar__label text-medium"><%= tx("New") %></span>
      <% end %>
      <ul class="menu admin-bar__menu">
        <% new_items.each do |label, url| %>
          <%# herb:key label %>
          <li><%= link_to tx(label), url, class: "menu__item" %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if UpdateCheck.update_available? && Current.user.can?("settings:read") %>
    <%= link_to settings_updates_path, class: "admin-bar__item admin-bar__update", title: tx("A newer version is available") do %>
      <%= icon_tag "refresh", class: "icon--sm" %>
      <span class="admin-bar__label"><%= tx("Version %{version} available", version: UpdateCheck.latest_version) %></span>
    <% end %>
  <% end %>

  <% plugin_updates = UpdateCheck::Plugins.available %>
  <% if plugin_updates.any? && Current.user.admin? %>
    <%= link_to settings_plugins_path, class: "admin-bar__item admin-bar__update", title: tx("Newer plugin releases are available") do %>
      <%= icon_tag "refresh", class: "icon--sm" %>
      <span class="admin-bar__label"><%= tx(plugin_updates.size == 1 ? "1 plugin update" : "%{count} plugin updates", count: plugin_updates.size) %></span>
    <% end %>
  <% end %>

  <div class="admin-bar__plugins">
    <%= plugin_slots(:nav_actions) %>
  </div>

  <div class="admin-bar__tools">
    <% unless content_for?(:list_search) %>
      <%= render "layouts/shared/nav_filter" %>
    <% end %>
    <%# Opens the search modal (layouts/shared/global_search); a link, so it still goes to Search without it. %>
    <%= link_to search_path, class: "btn btn--plain btn--icon", title: tx("Search everything (⌘K)"), data: { global_search_open: true } do %>
      <%= icon_tag "search", class: "icon--sm" %>
      <span class="visually-hidden"><%= tx("Search everything") %></span>
    <% end %>
    <%= render "layouts/shared/screen_options" %>
    <%= render "layouts/shared/theme_toggle" %>
    <div class="admin-bar__dropdown admin-bar__dropdown--end">
      <%= link_to settings_profile_path, class: "admin-bar__item admin-bar__item--muted" do %>
        <span class="admin-bar__label"><%= tx("Howdy, %{name}", name: Current.user.name.to_s.split.first.presence || Current.user.email) %></span>
        <span class="admin-bar__avatar"><%= icon_tag "person", class: "icon--sm" %></span>
      <% end %>
      <ul class="menu admin-bar__menu">
        <li class="admin-bar__account"><%= Current.user.email %></li>
        <li><%= link_to tx("Edit profile"), settings_profile_path, class: "menu__item" %></li>
        <li><%= link_to tx("Settings"), settings_path, class: "menu__item", data: { keys: "g s" } %></li>
        <li><%= button_to tx("Sign out"), session_path(Current.session), method: :delete, class: "menu__item", form_class: "contents" %></li>
      </ul>
    </div>
  </div>
</header>
