<%# Search everything, in a modal: the admin bar's search button or ⌘K / Ctrl+K
    opens it, results come as you type (searches/_quick), the arrow keys and
    Enter pick one. Outside the bar, so a dark top bar doesn't darken it. %>
<dialog class="dialog global-search" aria-label="Search everything" closedby="any"
        data-controller="global-search" data-global-search-url-value="<%= search_path %>"
        data-action="keydown->global-search#navigate click->global-search#closeOnBackdrop">
  <div class="input-with-icon">
    <%= icon_tag "search", class: "input-with-icon__icon" %>
    <input type="search" placeholder="Search pages, entries, globals, users…" autocomplete="off" spellcheck="false"
           aria-label="Search everything" data-global-search-target="input" data-action="input->global-search#search">
  </div>
  <div class="global-search__results" data-global-search-target="results">
    <p class="empty-state">Type to find a page, entry, global, user…</p>
  </div>
</dialog>
