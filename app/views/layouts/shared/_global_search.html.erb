<%# locals: () %>
<%# Search everything, as shadcn's command dialog: the header's search button or ⌘K / Ctrl+K
    opens it, results come as you type (searches/_quick), the arrow keys and Enter pick one. %>
<dialog class="ui-dialog app-command" aria-label="<%= tx("Search everything") %>" closedby="any"
        data-controller="global-search" data-global-search-url-value="<%= search_path %>"
        data-action="keydown->global-search#navigate click->global-search#closeOnBackdrop">
  <div class="app-command__field">
    <%= icon_tag "search" %>
    <input type="search" placeholder="<%= tx("Search pages, entries, globals, users…") %>" autocomplete="off" spellcheck="false"
           aria-label="<%= tx("Search everything") %>" data-global-search-target="input" data-action="input->global-search#search">
    <%= ui_kbd "Esc" %>
  </div>
  <div class="app-command__results" data-global-search-target="results">
    <p class="app-command__empty"><%= tx("Type to find a page, entry, global, user…") %></p>
  </div>
</dialog>
