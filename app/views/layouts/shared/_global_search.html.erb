<%# Search everything, in a modal drawn as rune_ui's palette: the sidebar's
    Search or ⌘K / Ctrl+K opens it, results come as you type (searches/_quick),
    the arrow keys and Enter pick one (global-search controller). %>
<dialog class="palette" aria-label="<%= tx("Search everything") %>" closedby="any"
        data-controller="global-search" data-global-search-url-value="<%= search_path %>"
        data-action="keydown->global-search#navigate click->global-search#closeOnBackdrop">
  <div class="palette__box">
    <div class="palette__search">
      <%= icon_tag "search" %>
      <input type="search" placeholder="<%= tx("Search pages, entries, globals, users…") %>" autocomplete="off" spellcheck="false"
             aria-label="<%= tx("Search everything") %>" data-global-search-target="input" data-action="input->global-search#search">
      <kbd>esc</kbd>
    </div>
    <div class="palette__list" data-global-search-target="results">
      <p class="palette__empty"><%= tx("Type to find a page, entry, global, user…") %></p>
    </div>
  </div>
</dialog>
