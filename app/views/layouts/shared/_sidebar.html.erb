<%# locals: () %>
<%# The sidebar (rune_ui's): the site, search, the admin menu
    (NavigationHelper#admin_menu) in its groups, update notices, and the
    signed-in person with the theme toggle at the foot. Each item's submenu is
    under it, shown for the current item; the others go to their
    first link (rune_ui's sidebar_link sub:). An item's go-to chord (g p…) is
    on its link. [ or the panel bar's toggle hides the sidebar (rune-sidebar),
    and on a narrow screen it's a drawer. %>
<% branding = current_branding %>
<% site_name = branding[:site_title].presence || Site.key %>
<% site_url = public_site_url %>
<nav id="admin-menu" class="<%= class_names("sidebar", "sidebar--dark" => Branding.current.dark_top_bar?) %>" aria-label="<%= tx("Admin menu") %>">
  <div class="sidebar__top">
    <%= link_to dashboard_path, class: "sidebar__brand", title: tx("Dashboard (g h)"), data: { keys: "g h" } do %>
      <% if branding[:logo_url_small].present? %>
        <%= image_tag branding[:logo_url_small], alt: "" %>
      <% else %>
        <span class="sidebar__logo" aria-hidden="true"><%= site_name.to_s.first.upcase %></span>
      <% end %>
      <span class="sidebar__label"><%= site_name %></span>
    <% end %>
    <% if site_url %>
      <%= icon_button "external", label: tx("View site"), url: site_url, target: "_blank", rel: "noopener" %>
    <% end %>
    <%= icon_button :sidebar, label: tx("Hide the sidebar ([)"), data: { action: "rune-sidebar#toggle", keys: "[" } %>
  </div>

  <%# Opens the search modal (layouts/shared/global_search); a link, so it still goes to Search without it. %>
  <%= link_to search_path, class: "sidebar__link", title: tx("Search (s)"), data: { global_search_open: true, keys: "s" } do %>
    <%= icon "search" %>
    <span class="sidebar__label"><%= tx("Search") %></span>
    <span class="sidebar__kbd">⌘K</span>
  <% end %>

  <% admin_menu.each do |group, entries| %>
    <%# herb:key group.to_s %>
    <% unless group == "Settings" %>
      <%= sidebar_section tx(group) %>
    <% end %>
    <% entries.each do |entry| %>
      <%# herb:key entry.id %>
      <% label = tx(entry.label) %>
      <%= sidebar_link label, entry.url, icon: known_icon(entry.icon), current: entry.current,
            sub: entry.submenu.map { |link| { label: tx(link.label), url: link.url, current: link.current, icon: (known_icon(link.icon) if link.icon) } },
            title: ("#{label} (#{entry.keys})" if entry.keys), data: { keys: entry.keys, menu_group: group } %>
    <% end %>
  <% end %>

  <div class="sidebar__footer">
    <% if UpdateCheck.update_available? && Current.user.can?("settings:read") %>
      <%= link_to settings_updates_path, class: "sidebar__link sidebar__link--update", title: tx("A newer version is available") do %>
        <%= icon_tag "refresh" %>
        <span class="sidebar__label"><%= tx("Version %{version} available", version: UpdateCheck.latest_version) %></span>
      <% end %>
    <% end %>
    <% plugin_updates = UpdateCheck::Plugins.available %>
    <% if plugin_updates.any? && Current.user.admin? %>
      <%= link_to settings_plugins_path, class: "sidebar__link sidebar__link--update", title: tx("Newer plugin releases are available") do %>
        <%= icon_tag "refresh" %>
        <span class="sidebar__label"><%= tx(plugin_updates.size == 1 ? "1 plugin update" : "%{count} plugin updates", count: plugin_updates.size) %></span>
      <% end %>
    <% end %>

    <div class="sidebar__account-row">
      <% person = Current.user.name.presence || Current.user.email %>
      <%= menu safe_join([avatar(person), tag.span(person, class: "sidebar__label")]), up: true, trigger_class: "sidebar__account" do %>
        <%= menu_label Current.user.email %>
        <%= menu_link tx("Edit profile"), settings_profile_path %>
        <%= menu_link tx("Settings"), settings_path, data: { keys: "g s" } %>
        <%= menu_divider %>
        <%= menu_button tx("Sign out"), session_path(Current.session), method: :delete, icon: "logout" %>
      <% end %>
      <%= render "layouts/shared/shortcuts" %>
      <%= render "layouts/shared/theme_toggle" %>
    </div>
  </div>
</nav>
