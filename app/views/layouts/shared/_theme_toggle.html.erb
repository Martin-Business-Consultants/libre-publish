<%# locals: () %>
<%# Light or dark (theme_controller): the moon shows in light, the sun in dark (shell.css). %>
<button type="button" class="icon-button" data-controller="theme" data-action="theme#toggle" title="<%= tx("Switch between light and dark") %>" aria-label="<%= tx("Switch between light and dark") %>">
  <%= icon_tag "moon", class: "theme-toggle__moon" %>
  <%= icon_tag "sun", class: "theme-toggle__sun" %>
</button>
