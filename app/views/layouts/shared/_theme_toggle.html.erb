<%# locals: () %>
<button type="button" class="ui-button ui-button--ghost ui-button--icon-sm theme-toggle" data-controller="theme" data-action="theme#toggle" title="<%= tx("Switch between light and dark") %>">
  <%= icon_tag "moon", class: "theme-toggle__moon" %>
  <%= icon_tag "sun", class: "theme-toggle__sun" %>
  <span class="visually-hidden"><%= tx("Switch between light and dark") %></span>
</button>
