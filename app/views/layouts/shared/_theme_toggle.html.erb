<%# locals: () %>
<button type="button" class="btn theme-toggle" data-variant="ghost" data-size="icon" data-controller="theme" data-action="theme#toggle" title="Switch between light and dark">
  <%= icon_tag "moon", class: "theme-toggle__moon size-4" %>
  <%= icon_tag "sun", class: "theme-toggle__sun size-4" %>
  <span class="sr-only">Switch between light and dark</span>
</button>
