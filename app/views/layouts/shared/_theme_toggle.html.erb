<%# locals: () %>
<button type="button" class="btn btn--plain btn--icon theme-toggle" data-controller="theme" data-action="theme#toggle" title="Switch between light and dark">
  <%= icon_tag "moon", class: "theme-toggle__moon icon--sm" %>
  <%= icon_tag "sun", class: "theme-toggle__sun icon--sm" %>
  <span class="visually-hidden">Switch between light and dark</span>
</button>
