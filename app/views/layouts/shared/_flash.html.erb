<%# locals: () %>
<%# The flash as toasts (shadcn's Sonner, ui-toaster), top centre over the page: a notice
    fades by itself after a few seconds (held while hovered) and is removed, an alert stays
    until it's dismissed. %>
<%= turbo_frame_tag :flash, class: "ui-toaster" do %>
  <% [ :notice, :alert ].each do |type| %>
    <%# herb:key type %>
    <% if (message = flash[type]).present? %>
      <div class="<%= class_names("ui-toast", type == :alert ? "ui-toast--error ui-toast--sticky" : nil) %>" role="<%= type == :alert ? "alert" : "status" %>" data-controller="element-removal"
           data-action="<%= "animationend->element-removal#remove" if type == :notice %>">
        <%= icon_tag(type == :alert ? "close-circle" : "check-circle") %>
        <p class="app-toast__text"><%= message %></p>
        <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm" title="<%= tx("Dismiss this notice") %>" data-action="element-removal#remove">
          <%= icon_tag "close" %>
          <span class="visually-hidden"><%= tx("Dismiss this notice") %></span>
        </button>
      </div>
    <% end %>
  <% end %>
<% end %>
