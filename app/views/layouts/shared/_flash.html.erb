<%# locals: () %>
<%# The flash as toasts, stacked at the bottom right of the screen: green for
    a notice, which fades after a few seconds (held while hovered), and red
    for an alert, which stays until it's dismissed. %>
<%= turbo_frame_tag :flash, class: "toasts" do %>
  <% [ :notice, :alert ].each do |type| %>
    <%# herb:key type %>
    <% if (message = flash[type]).present? %>
      <div class="<%= class_names("notice toast", type == :alert ? "notice--danger" : "notice--success") %>" role="<%= type == :alert ? "alert" : "status" %>" data-controller="element-removal"
           data-action="<%= "animationend->element-removal#remove" if type == :notice %>">
        <%= icon_tag(type == :alert ? "close-circle" : "check-circle") %>
        <p class="grow text-medium"><%= message %></p>
        <button type="button" class="toast__dismiss" title="Dismiss this notice" data-action="element-removal#remove">
          <%= icon_tag "close", class: "icon--sm" %>
          <span class="visually-hidden">Dismiss this notice</span>
        </button>
      </div>
    <% end %>
  <% end %>
<% end %>
