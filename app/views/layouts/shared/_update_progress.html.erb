<%# While a CMS update or a plugin or theme change runs (UpdateProgress), a
    modal over every admin page: a spinner and each one's progress, polled
    (update-progress controller) until it's done, through the restart. %>
<dialog class="dialog"
        aria-label="<%= tx("Updating") %>" data-controller="update-progress" data-update-progress-url-value="<%= update_progress_path %>"
        data-update-progress-running-value="<%= UpdateProgress.running? %>" data-action="cancel->update-progress#cancel">
  <div class="dialog__box">
    <div class="update-progress__title">
      <span class="status status--busy" aria-hidden="true" data-update-progress-target="spinner"></span>
      <h2 class="dialog__title" data-update-progress-target="heading"><%= tx("Updating…") %></h2>
    </div>
    <div class="stack" data-update-progress-target="items"></div>
    <p class="small muted" data-update-progress-target="note"><%= tx("The CMS restarts to load what’s new. This page carries on when it’s back.") %></p>
    <div class="dialog__actions" hidden data-update-progress-target="actions">
      <button type="button" class="btn btn--secondary" data-action="update-progress#close"><%= tx("Close") %></button>
    </div>
  </div>
  <template data-update-progress-target="template">
    <div class="update-progress__item">
      <div class="update-progress__line">
        <span class="truncate strong" data-field="title"></span>
        <span class="tabular muted" data-field="percent"></span>
      </div>
      <div class="update-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"><span data-field="fill"></span></div>
      <p class="small muted" data-field="step"></p>
    </div>
  </template>
</dialog>
