<%# While a CMS update or a plugin or theme change runs (UpdateProgress), a
    modal over every admin page: a spinner and each one's progress, polled
    (update-progress controller) until it's done, through the restart. %>
<dialog class="dialog update-progress"
        aria-label="Updating" data-controller="update-progress" data-update-progress-url-value="<%= update_progress_path %>"
        data-update-progress-running-value="<%= UpdateProgress.running? %>" data-action="cancel->update-progress#cancel">
  <div class="row row--md">
    <span class="update-progress__spinner" aria-hidden="true" data-update-progress-target="spinner"></span>
    <h2 class="heading heading--lg" data-update-progress-target="heading">Updating…</h2>
  </div>
  <div class="stack" data-update-progress-target="items"></div>
  <p class="text-small text-muted" data-update-progress-target="note">The CMS restarts to load what’s new. This page carries on when it’s back.</p>
  <div class="dialog__actions" hidden data-update-progress-target="actions">
    <button type="button" class="btn" data-action="update-progress#close">Close</button>
  </div>
  <template data-update-progress-target="template">
    <div class="stack stack--xs">
      <div class="row row--baseline row--between row--md">
        <span class="truncate text-medium" data-field="title"></span>
        <span class="text-tabular text-muted" data-field="percent"></span>
      </div>
      <div class="update-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"><span data-field="fill"></span></div>
      <p class="text-small text-muted" data-field="step"></p>
    </div>
  </template>
</dialog>
