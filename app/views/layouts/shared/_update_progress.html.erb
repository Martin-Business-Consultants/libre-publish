<%# While a CMS update or a plugin or theme change runs (UpdateProgress), a
    modal over every admin page: a spinner and each one's progress, polled
    (update-progress controller) until it's done, through the restart. %>
<dialog class="dialog update-progress gap-4 rounded-xl border border-gray-200 bg-white p-6 text-left text-gray-900 shadow-overlay"
        aria-label="Updating" data-controller="update-progress" data-update-progress-url-value="<%= update_progress_path %>"
        data-update-progress-running-value="<%= UpdateProgress.running? %>" data-action="cancel->update-progress#cancel">
  <div class="flex items-center gap-3">
    <span class="update-progress__spinner" aria-hidden="true" data-update-progress-target="spinner"></span>
    <h2 class="text-lg font-semibold" data-update-progress-target="heading">Updating…</h2>
  </div>
  <div class="flex flex-col gap-4" data-update-progress-target="items"></div>
  <p class="text-xs text-gray-500" data-update-progress-target="note">The CMS restarts to load what’s new. This page carries on when it’s back.</p>
  <div class="flex justify-end" hidden data-update-progress-target="actions">
    <button type="button" class="<%= ui(:button) %>" data-action="update-progress#close">Close</button>
  </div>
  <template data-update-progress-target="template">
    <div class="flex flex-col gap-1.5">
      <div class="flex items-baseline justify-between gap-3 text-sm">
        <span class="min-w-0 truncate font-medium" data-field="title"></span>
        <span class="tabular-nums text-gray-500" data-field="percent"></span>
      </div>
      <div class="update-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"><span data-field="fill"></span></div>
      <p class="text-xs text-gray-500" data-field="step"></p>
    </div>
  </template>
</dialog>
