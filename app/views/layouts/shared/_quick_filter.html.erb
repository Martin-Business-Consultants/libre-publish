<%# locals: (title:, param:, options:, current:) %>
<%# A quick filter: rune_ui's pill showing the current choice, opening a
    popover menu of the others. Each choice is a link that swaps one query
    param, so filters are bookmarkable. %>
<%= popover_menu safe_join([tag.span(options.to_h.invert.fetch(current, options.first.first)), icon_tag("caret-down")]),
      trigger_class: "pill", title: title, align: :start do %>
  <%= menu_label title %>
  <% options.each do |text, value| %>
    <%# herb:key value %>
    <%= link_to text, url_for(request.query_parameters.merge(param.to_s => value)), class: "menu__item", role: "menuitemradio",
          aria: { checked: value == current }, data: { turbo_action: "replace" } %>
  <% end %>
<% end %>
