<%# locals: (title:, param:, options:, current:) %>
<%# A quick filter, as shadcn's data table filters it: an outlined button showing the current
    choice, opening a menu of the choices with the current one checked. Each choice is a link
    that swaps one query param, so filters are bookmarkable. %>
<% menu_id = "quick_filter_#{param}" %>
<div class="quick-filter" data-controller="ui--popover">
  <button type="button" class="ui-button ui-button--outline ui-button--sm" popovertarget="<%= menu_id %>" title="<%= title %>">
    <%= icon_tag "filter" %>
    <span class="truncate"><%= options.to_h.invert.fetch(current, options.first.first) %></span>
    <%= icon_tag "caret-down" %>
  </button>
  <div class="ui-menu" id="<%= menu_id %>" popover role="menu" aria-label="<%= title %>" data-ui--popover-target="popover">
    <div class="ui-menu__label"><%= title %></div>
    <hr class="ui-menu__separator">
    <% options.each do |text, value| %>
      <%# herb:key value %>
      <%= link_to url_for(request.query_parameters.merge(param.to_s => value)), class: "ui-menu__item", role: "menuitemradio",
            aria: { checked: value == current }, data: { turbo_action: "replace" } do %>
        <span class="truncate"><%= text %></span>
      <% end %>
    <% end %>
  </div>
</div>
