<% @page_title = "Reset password" %>

<div class="mx-auto w-full max-w-sm">
  <div class="<%= ui(:panel, "p-6") %>">
    <div class="mb-6 space-y-1.5">
      <h1 class="text-xl font-semibold tracking-tight text-gray-900">Reset password</h1>
      <p class="text-sm text-gray-500">Please enter your new password below.</p>
    </div>

    <%= render "layouts/shared/errors", record: @user %>

    <%= form_with url: identity_password_reset_path, method: :patch, class: "space-y-5", data: { controller: "form" } do |form| %>
      <%= hidden_field_tag :sid, params[:sid] %>

      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Email</span>
        <input type="email" value="<%= @user.email %>" class="w-full" autocomplete="email" readonly>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Password</span>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "w-full", placeholder: "Password" %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Confirm password</span>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full", placeholder: "Confirm password" %>
      </label>

      <button type="submit" class="<%= ui(:button, :primary, "w-full") %>" data-form-target="submit">
        <span>Reset password</span>
        <%= icon_tag "arrow-right", class: "size-4" %>
      </button>
    <% end %>
  </div>
</div>
