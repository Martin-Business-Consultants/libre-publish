<% @page_title = "Reset password" %>

<div class="measure--sm measure--centered stack stack--lg">
  <div class="panel panel--padded stack stack--lg">
    <div class="stack stack--xs">
      <h1 class="title">Reset password</h1>
      <p class="text-muted">Please enter your new password below.</p>
    </div>

    <%= render "layouts/shared/errors", record: @user %>

    <%= form_with url: identity_password_reset_path, method: :patch, class: "fields", data: { controller: "form" } do |form| %>
      <%= hidden_field_tag :sid, params[:sid] %>

      <label class="field">
        <span class="label">Email</span>
        <input type="email" value="<%= @user.email %>" autocomplete="email" readonly>
      </label>

      <label class="field">
        <span class="label">Password</span>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Password" %>
      </label>

      <label class="field">
        <span class="label">Confirm password</span>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password" %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Reset password</span>
        <%= icon_tag "arrow-right", class: "icon--sm" %>
      </button>
    <% end %>
  </div>
</div>
