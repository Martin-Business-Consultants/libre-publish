<% @page_title = "Reset password" %>

<div class="auth-panel">
  <section class="ui-card">
    <header class="ui-card__header auth-panel__header">
      <h1 class="ui-card__title auth-panel__title">Reset password</h1>
      <p class="ui-card__description">Please enter your new password below.</p>
    </header>

    <div class="ui-card__content auth-panel__body">
      <%= render "layouts/shared/errors", record: @user %>

      <%= form_with url: identity_password_reset_path, method: :patch, class: "ui-fieldset", data: { controller: "form" } do |form| %>
        <%= hidden_field_tag :sid, params[:sid] %>

        <div class="ui-field">
          <label class="ui-label" for="reset_email">Email</label>
          <input class="ui-input" id="reset_email" type="email" value="<%= @user.email %>" autocomplete="email" readonly>
        </div>

        <div class="ui-field">
          <%= form.label :password, "Password", class: "ui-label" %>
          <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "ui-input" %>
        </div>

        <div class="ui-field">
          <%= form.label :password_confirmation, "Confirm password", class: "ui-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "ui-input" %>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Reset password</button>
      <% end %>
    </div>
  </section>
</div>
