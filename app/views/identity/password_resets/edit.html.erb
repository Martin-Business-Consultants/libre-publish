<% @page_title = "Reset password" %>

<div class="stack stack--lg">
  <div class="card">
    <div class="card__head">
      <h1 class="public-card__title">Reset password</h1>
      <p class="card__hint">Please enter your new password below.</p>
    </div>

    <%= render "layouts/shared/errors", record: @user %>

    <%= form_with url: identity_password_reset_path, method: :patch, data: { controller: "form" } do |form| %>
      <%= hidden_field_tag :sid, params[:sid] %>

      <label class="field">
        <span class="field__label">Email</span>
        <input type="email" value="<%= @user.email %>" autocomplete="email" readonly>
      </label>

      <label class="field">
        <span class="field__label">Password</span>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Password" %>
      </label>

      <label class="field">
        <span class="field__label">Confirm password</span>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password" %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Reset password</span>
        <%= icon_tag "arrow-right" %>
      </button>
    <% end %>
  </div>
</div>
