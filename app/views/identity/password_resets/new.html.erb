<% @page_title = "Forgot password" %>

<div class="mx-auto w-full max-w-sm">
  <div class="<%= ui(:panel, "p-6") %>">
    <div class="mb-6 space-y-1.5">
      <h1 class="text-xl font-semibold tracking-tight text-gray-900">Forgot password</h1>
      <p class="text-sm text-gray-500">Enter your email to receive a password reset link.</p>
    </div>

    <%= form_with url: identity_password_reset_path, class: "space-y-5", data: { controller: "form" } do |form| %>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Email address</span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "off", class: "w-full", placeholder: "email@example.com" %>
      </label>

      <button type="submit" class="<%= ui(:button, :primary, "w-full") %>" data-form-target="submit">
        <span>Email password reset link</span>
        <%= icon_tag "arrow-right", class: "size-4" %>
      </button>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-500">
    Or, return to <%= link_to "log in", sign_in_path, class: ui(:link) %>
  </p>
</div>
