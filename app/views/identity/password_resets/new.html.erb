<% @page_title = "Forgot password" %>

<div class="measure--sm measure--centered stack stack--lg">
  <div class="panel panel--padded stack stack--lg">
    <div class="stack stack--xs">
      <h1 class="title">Forgot password</h1>
      <p class="text-muted">Enter your email to receive a password reset link.</p>
    </div>

    <%= form_with url: identity_password_reset_path, class: "fields", data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="label">Email address</span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "off", placeholder: "email@example.com" %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Email password reset link</span>
        <%= icon_tag "arrow-right", class: "icon--sm" %>
      </button>
    <% end %>
  </div>

  <p class="text-center text-muted">
    Or, return to <%= link_to "log in", sign_in_path, class: "link" %>
  </p>
</div>
