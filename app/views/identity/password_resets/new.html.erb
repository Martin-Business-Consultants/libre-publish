<% @page_title = "Forgot password" %>

<div class="auth-panel">
  <section class="ui-card">
    <header class="ui-card__header auth-panel__header">
      <h1 class="ui-card__title auth-panel__title">Forgot password</h1>
      <p class="ui-card__description">Enter your email to receive a password reset link.</p>
    </header>

    <div class="ui-card__content">
      <%= form_with url: identity_password_reset_path, class: "ui-fieldset", data: { controller: "form" } do |form| %>
        <div class="ui-field">
          <%= form.label :email, "Email address", class: "ui-label" %>
          <%= form.email_field :email, required: true, autofocus: true, autocomplete: "off", placeholder: "email@example.com", class: "ui-input" %>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Email password reset link</button>
      <% end %>
    </div>
  </section>

  <p class="auth-panel__note">
    Or, return to <%= link_to "log in", sign_in_path, class: "auth-panel__link" %>
  </p>
</div>
