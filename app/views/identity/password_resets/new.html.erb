<% @page_title = "Forgot password" %>

<div class="stack stack--lg">
  <div class="card">
    <div class="card__head">
      <h1 class="public-card__title">Forgot password</h1>
      <p class="card__hint">Enter your email to receive a password reset link.</p>
    </div>

    <%= form_with url: identity_password_reset_path, data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="field__label">Email address</span>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "off", placeholder: "email@example.com" %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Email password reset link</span>
        <%= icon_tag "arrow-right" %>
      </button>
    <% end %>
  </div>

  <p class="public-aside">
    Or, return to <%= link_to "log in", sign_in_path %>
  </p>
</div>
