<% @page_title = "Developers" %>
<%= render "layouts/shared/page_header", title: "Developers", icon: "code" %>

<% cms_url = request.base_url %>
<div class="with-aside">
  <div class="with-aside__main">
    <%# The CMS's real surfaces, first: the admin is for doing things by hand. %>
    <div class="stack">
      <section class="card">
        <h2 class="card__title help-title"><%= icon_tag "link", class: "icon--sm" %> API</h2>
        <p>JSON over HTTP at <code>/api</code>, with a bearer token. What the site builds from, and what every other surface stands on.</p>
        <code class="code-block">curl -H "Authorization: Bearer $TOKEN" <%= cms_url %>/api/manifest</code>
        <p class="small faint">Tokens: <%= link_to "yours", settings_api_token_path %> (your role) or a <%= link_to "service token", settings_service_tokens_path %> (a site's, a job's).</p>
      </section>
      <section class="card">
        <h2 class="card__title help-title"><%= icon_tag "code", class: "icon--sm" %> CLI</h2>
        <p><code>cms</code> does everything the admin does to content, structure and operations, with next steps in every answer. Connects in your browser.</p>
        <div class="row help-command">
          <code class="code-block">curl -fsSL <%= cms_url %>/agent/install.sh | sh</code>
          <%= copy_button "curl -fsSL #{cms_url}/agent/install.sh | sh" %>
        </div>
        <p class="small faint">Then <code>cms doctor</code>, <code>cms manifest</code>, <code>cms commands --json</code>.</p>
      </section>
      <section class="card">
        <h2 class="card__title help-title"><%= icon_tag "ai", class: "icon--sm" %> MCP</h2>
        <p>The same commands as MCP tools, for Claude Code, Codex, Claude Desktop, Cursor or any MCP client, once the CLI is installed. This prints the setup for each, ready to paste.</p>
        <div class="row help-command">
          <code class="code-block">cms connect</code>
          <%= copy_button "cms connect" %>
        </div>
        <p class="small faint">Every answer comes wrapped with what to call next.</p>
      </section>
    </div>

    <% if Serving.api? then %>
    <%= postbox "developers-astro", "Connect an Astro site" do %>
      <p>Run this in the site's project (its root or its <code>src/</code>). It installs the <code>@librepublish/astro</code> integration and gets the site a read-only token of its own, approved in your browser.</p>
      <div class="row help-command">
        <code class="code-block">curl -fsSL <%= cms_url %>/frontend/install.sh | sh</code>
        <%= copy_button "curl -fsSL #{cms_url}/frontend/install.sh | sh" %>
      </div>
      <div class="prose">
        <p>Then add <code>cms()</code> to <code>astro.config</code>. From then on, every <code>astro dev</code> and <code>astro build</code>:</p>
        <ul>
          <li>loads pages, entries and globals through content collections, and types them from this CMS's schema;</li>
          <li>writes <code>AGENTS.md</code> in the site's repo: how the site works with this CMS, and the Site health checks it's held to (<%= link_to "read it", frontend_agents_md_path, target: "_blank", rel: "noopener" %>);</li>
          <li>after a build, writes <code>_redirects</code>, <code>sitemap.xml</code> and <code>robots.txt</code>, checks Site health, and reports the build here.</li>
        </ul>
      </div>
      <details class="developers__by-hand">
        <summary class="developers__by-hand-summary">Or by hand</summary>
        <div class="developers__by-hand-body stack stack--sm">
          <pre class="code-block">npm install @librepublish/astro@github:Martin-Business-Consultants/libre-cms-astro</pre>
          <pre class="code-block">// astro.config.mjs
import cms from "@librepublish/astro";
export default defineConfig({ integrations: [cms()] });</pre>
          <code class="code-block">CMS_BASE_URL=<%= cms_url %>  CMS_API_TOKEN=&lt;a service token&gt;</code>
          <p class="small faint">Forms, Media and Commerce come with it. The source: github.com/Martin-Business-Consultants/libre-cms-astro.</p>
        </div>
      </details>
    <% end %>
    <% end %>

    <%= postbox "developers-how", "How it fits together" do %>
      <ol class="developers__flow">
        <li class="card card--muted card--sm"><strong>Agents and people</strong><span class="small muted">change content through the CLI, MCP, API — or this admin</span></li>
        <li class="card card--muted card--sm"><strong>The CMS</strong><span class="small muted">stores it and serves live content as JSON at <code>/api/v1</code></span></li>
        <li class="card card--muted card--sm"><strong>Your site</strong><span class="small muted">(an Astro app) loads it at build time, or on demand on Cloudflare, and renders HTML</span></li>
        <li class="card card--muted card--sm"><strong>Visitors</strong><span class="small muted">get the site, never the CMS</span></li>
      </ol>
      <p class="muted">
        Publishing rebuilds a static site, or purges what changed from one rendered on demand (Settings › <%= link_to "Deploy", settings_deploy_path %>).
        Every page, entry and global has a <strong>JSON</strong> tab in its editor, and every screen names its <code>cms</code> command.
      </p>
    <% end %>

    <%= postbox "developers-api", "The JSON" do %>
      <p class="muted">Every read takes <code>Authorization: Bearer &lt;token&gt;</code> and answers <code>{data, meta, included}</code>, live content only.</p>
      <div class="table-wrap">
        <table class="table data-table">
          <thead><tr><th>Endpoint</th><th>What it returns</th></tr></thead>
          <tbody>
            <% DevelopersController::ENDPOINTS.each do |verb, path, what| %>
              <%# herb:key path %>
              <tr><td class="mono nowrap"><%= verb %> <%= path %></td><td><%= what %></td></tr>
            <% end %>
            <% @plugin_endpoints.each do |plugin, endpoint| %>
              <%# herb:key endpoint[:path] %>
              <tr><td class="mono nowrap"><%= endpoint[:path] %></td><td><%= endpoint[:description] %> <span class="muted">(<%= plugin %>)</span></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <aside class="with-aside__aside">
    <% if Serving.api? then %>
    <%= postbox "developers-frontend", "Your frontend" do %>
      <% if @build %>
        <p class="button-row"><%= status_tag "connected" %> Built <%= time_ago_tag @build[:built_at] %></p>
        <dl class="details details--even">
          <% if @build[:framework] %>
            <dt>Framework</dt><dd><%= [ @build[:framework], @build[:framework_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:integration] %>
            <dt>Integration</dt><dd><%= [ @build[:integration], @build[:integration_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:pages] %>
            <dt>Pages built</dt><dd><%= number_with_delimiter(@build[:pages]) %></dd>
          <% end %>
        </dl>
      <% else %>
        <div class="stack stack--xs">
          <p class="button-row"><%= status_tag "not connected" %> No build has reported yet.</p>
          <p class="small faint">A site with the Astro integration reports each build here.</p>
        </div>
      <% end %>
      <dl class="details details--even">
        <dt>Site</dt><dd><%= Frontend.site_url ? external_link(Frontend.site_url, link_class: "help-site-link") : link_to("Set it", settings_general_path) %></dd>
        <dt>Repo</dt><dd><%= Frontend.repo ? tag.span(Frontend.repo, class: "mono") : link_to("Set it", settings_github_path) %></dd>
        <dt>Rebuilds</dt><dd><%= @deploys ? "On publish" : link_to("Not set up", settings_deploy_path) %></dd>
        <dt>Service tokens</dt><dd><%= link_to @service_tokens, settings_service_tokens_path %></dd>
        <dt>Webhooks</dt><dd><%= link_to @webhooks, webhooks_path %></dd>
      </dl>
    <% end %>
    <% end %>

    <%= postbox "developers-model", "Content model" do %>
      <dl class="details details--even">
        <% @counts.each do |kind, count| %>
          <%# herb:key kind %>
          <dt><%= kind.to_s.humanize %></dt><dd class="tabular"><%= number_with_delimiter(count) %></dd>
        <% end %>
      </dl>
      <p class="small faint">Its full shape — every field and block type's JSON schema — is <code>GET /api/v1/schema</code>, which a connected site turns into its types.</p>
    <% end %>
  </aside>
</div>
<%= render "content_form/postbox_state" %>
