<% @page_title = "Developers" %>
<%= render "layouts/shared/page_header", title: "Developers", icon: "code" %>

<% cms_url = request.base_url %>
<div class="with-sidebar">
  <div>
    <%# The CMS's real surfaces, first: the admin is for doing things by hand. %>
    <div class="stack">
      <section class="panel developers__surface stack stack--md">
        <h2 class="heading row"><%= icon_tag "link", class: "icon--sm text-faint" %> API</h2>
        <p class="text-body">JSON over HTTP at <code class="code">/api</code>, with a bearer token. What the site builds from, and what every other surface stands on.</p>
        <code class="code-block code-block--wrap">curl -H "Authorization: Bearer $TOKEN" <%= cms_url %>/api/manifest</code>
        <p class="help">Tokens: <%= link_to "yours", settings_api_token_path, class: "link" %> (your role) or a <%= link_to "service token", settings_service_tokens_path, class: "link" %> (a site's, a job's).</p>
      </section>
      <section class="panel developers__surface stack stack--md">
        <h2 class="heading row"><%= icon_tag "code", class: "icon--sm text-faint" %> CLI</h2>
        <p class="text-body"><code class="code">cms</code> does everything the admin does to content, structure and operations, with next steps in every answer. Connects in your browser.</p>
        <div class="row">
          <code class="code-block code-block--wrap grow">curl -fsSL <%= cms_url %>/agent/install.sh | sh</code>
          <%= copy_button "curl -fsSL #{cms_url}/agent/install.sh | sh" %>
        </div>
        <p class="help">Then <code class="code">cms doctor</code>, <code class="code">cms manifest</code>, <code class="code">cms commands --json</code>.</p>
      </section>
      <section class="panel developers__surface stack stack--md">
        <h2 class="heading row"><%= icon_tag "ai", class: "icon--sm text-faint" %> MCP</h2>
        <p class="text-body">The same commands as MCP tools, for Claude Code, Codex, Claude Desktop, Cursor or any MCP client, once the CLI is installed. This prints the setup for each, ready to paste.</p>
        <div class="row">
          <code class="code-block code-block--wrap grow">cms connect</code>
          <%= copy_button "cms connect" %>
        </div>
        <p class="help">Every answer comes wrapped with what to call next.</p>
      </section>
    </div>

    <% if Serving.api? then %>
    <%= postbox "developers-astro", "Connect an Astro site" do %>
      <p class="text-body">Run this in the site's project (its root or its <code class="code">src/</code>). It installs the <code class="code">@librepublish/astro</code> integration and gets the site a read-only token of its own, approved in your browser.</p>
      <div class="row">
        <code class="code-block code-block--wrap grow">curl -fsSL <%= cms_url %>/frontend/install.sh | sh</code>
        <%= copy_button "curl -fsSL #{cms_url}/frontend/install.sh | sh" %>
      </div>
      <div class="prose">
        <p>Then add <code class="code">cms()</code> to <code class="code">astro.config</code>. From then on, every <code class="code">astro dev</code> and <code class="code">astro build</code>:</p>
        <ul>
          <li>loads pages, entries and globals through content collections, and types them from this CMS's schema;</li>
          <li>writes <code class="code">AGENTS.md</code> in the site's repo: how the site works with this CMS, and the Site health checks it's held to (<%= link_to "read it", frontend_agents_md_path, class: "link", target: "_blank", rel: "noopener" %>);</li>
          <li>after a build, writes <code class="code">_redirects</code>, <code class="code">sitemap.xml</code> and <code class="code">robots.txt</code>, checks Site health, and reports the build here.</li>
        </ul>
      </div>
      <details class="developers__by-hand">
        <summary class="developers__by-hand-summary">Or by hand</summary>
        <div class="developers__by-hand-body stack stack--sm">
          <pre class="code-block code-block--wrap">npm install @librepublish/astro@github:Martin-Business-Consultants/libre-cms-astro</pre>
          <pre class="code-block code-block--wrap">// astro.config.mjs
import cms from "@librepublish/astro";
export default defineConfig({ integrations: [cms()] });</pre>
          <code class="code-block code-block--wrap">CMS_BASE_URL=<%= cms_url %>  CMS_API_TOKEN=&lt;a service token&gt;</code>
          <p class="help">Forms, Media and Commerce come with it. The source: github.com/Martin-Business-Consultants/libre-cms-astro.</p>
        </div>
      </details>
    <% end %>
    <% end %>

    <%= postbox "developers-how", "How it fits together" do %>
      <ol class="grid grid--2 grid--4 grid--sm">
        <li class="well stack stack--2xs"><strong class="text-medium text-ink">Agents and people</strong><span class="text-small text-muted">change content through the CLI, MCP, API — or this admin</span></li>
        <li class="well stack stack--2xs"><strong class="text-medium text-ink">The CMS</strong><span class="text-small text-muted">stores it and serves live content as JSON at <code class="text-mono">/api/v1</code></span></li>
        <li class="well stack stack--2xs"><strong class="text-medium text-ink">Your site</strong><span class="text-small text-muted">(an Astro app) loads it at build time, or on demand on Cloudflare, and renders HTML</span></li>
        <li class="well stack stack--2xs"><strong class="text-medium text-ink">Visitors</strong><span class="text-small text-muted">get the site, never the CMS</span></li>
      </ol>
      <p class="text-muted">
        Publishing rebuilds a static site, or purges what changed from one rendered on demand (Settings › <%= link_to "Deploy", settings_deploy_path, class: "link" %>).
        Every page, entry and global has a <strong class="text-medium text-ink">JSON</strong> tab in its editor, and every screen names its <code class="code">cms</code> command.
      </p>
    <% end %>

    <%= postbox "developers-api", "The JSON" do %>
      <p class="text-muted">Every read takes <code class="code">Authorization: Bearer &lt;token&gt;</code> and answers <code class="code">{data, meta, included}</code>, live content only.</p>
      <div class="table-frame">
        <table class="data-table">
          <thead><tr><th>Endpoint</th><th>What it returns</th></tr></thead>
          <tbody>
            <% DevelopersController::ENDPOINTS.each do |verb, path, what| %>
              <%# herb:key path %>
              <tr><td class="text-mono text-small nowrap"><%= verb %> <%= path %></td><td><%= what %></td></tr>
            <% end %>
            <% @plugin_endpoints.each do |plugin, endpoint| %>
              <%# herb:key endpoint[:path] %>
              <tr><td class="text-mono text-small nowrap"><%= endpoint[:path] %></td><td><%= endpoint[:description] %> <span class="text-muted">(<%= plugin %>)</span></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <aside>
    <% if Serving.api? then %>
    <%= postbox "developers-frontend", "Your frontend" do %>
      <% if @build %>
        <p class="cluster text-body"><%= status_tag "connected" %> Built <%= time_ago_tag @build[:built_at] %></p>
        <dl class="details details--even">
          <% if @build[:framework] %>
            <dt>Framework</dt><dd><%= [ @build[:framework], @build[:framework_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:integration] %>
            <dt>Integration</dt><dd><%= [ @build[:integration], @build[:integration_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:pages] %>
            <dt>Pages built</dt><dd><%= number_with_delimiter(@build[:pages]) %></dd>
          <% end %>
        </dl>
      <% else %>
        <div class="stack stack--xs">
          <p class="cluster text-body"><%= status_tag "not connected" %> No build has reported yet.</p>
          <p class="help">A site with the Astro integration reports each build here.</p>
        </div>
      <% end %>
      <dl class="details details--even">
        <dt>Site</dt><dd class="break-all"><%= Frontend.site_url ? external_link(Frontend.site_url, link_class: "link") : link_to("Set it", settings_general_path, class: "link") %></dd>
        <dt>Repo</dt><dd class="break-all"><%= Frontend.repo ? tag.span(Frontend.repo, class: "text-mono") : link_to("Set it", settings_github_path, class: "link") %></dd>
        <dt>Rebuilds</dt><dd><%= @deploys ? "On publish" : link_to("Not set up", settings_deploy_path, class: "link") %></dd>
        <dt>Service tokens</dt><dd><%= link_to @service_tokens, settings_service_tokens_path, class: "link" %></dd>
        <dt>Webhooks</dt><dd><%= link_to @webhooks, webhooks_path, class: "link" %></dd>
      </dl>
    <% end %>
    <% end %>

    <%= postbox "developers-model", "Content model" do %>
      <dl class="details details--even">
        <% @counts.each do |kind, count| %>
          <%# herb:key kind %>
          <dt><%= kind.to_s.humanize %></dt><dd class="text-tabular"><%= number_with_delimiter(count) %></dd>
        <% end %>
      </dl>
      <p class="help">Its full shape — every field and block type's JSON schema — is <code class="code">GET /api/v1/schema</code>, which a connected site turns into its types.</p>
    <% end %>
  </aside>
</div>
<%= render "content_form/postbox_state" %>
