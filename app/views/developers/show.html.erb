<% @page_title = "Developers" %>
<%= render "layouts/shared/page_header", title: "Developers", icon: "code" %>

<% cms_url = request.base_url %>
<% code_classes = "block rounded-lg border border-border bg-muted px-3 py-2 font-mono text-xs leading-relaxed whitespace-pre-wrap break-all text-foreground" %>
<% inline_code_classes = "rounded-sm bg-muted px-1 py-0.5 font-mono text-xs text-foreground" %>
<% facts_classes = "grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm" %>
<div class="grid items-start gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%# The CMS's real surfaces, first: the admin is for doing things by hand. %>
    <div class="grid gap-4">
      <section class="card space-y-3 p-5">
        <h2 class="text-base font-semibold text-foreground flex items-center gap-2"><%= icon_tag "link", class: "size-4 text-muted-foreground" %> API</h2>
        <p class="text-sm text-foreground">JSON over HTTP at <code class="<%= inline_code_classes %>">/api</code>, with a bearer token. What the site builds from, and what every other surface stands on.</p>
        <code class="<%= code_classes %>">curl -H "Authorization: Bearer $TOKEN" <%= cms_url %>/api/manifest</code>
        <p class="text-sm text-muted-foreground">Tokens: <%= link_to "yours", settings_api_token_path, class: "font-medium text-primary underline underline-offset-2" %> (your role) or a <%= link_to "service token", settings_service_tokens_path, class: "font-medium text-primary underline underline-offset-2" %> (a site's, a job's).</p>
      </section>
      <section class="card space-y-3 p-5">
        <h2 class="text-base font-semibold text-foreground flex items-center gap-2"><%= icon_tag "code", class: "size-4 text-muted-foreground" %> CLI</h2>
        <p class="text-sm text-foreground"><code class="<%= inline_code_classes %>">cms</code> does everything the admin does to content, structure and operations, with next steps in every answer. Connects in your browser.</p>
        <div class="flex items-center gap-2">
          <code class="<%= code_classes %> min-w-0 flex-1">curl -fsSL <%= cms_url %>/agent/install.sh | sh</code>
          <%= copy_button "curl -fsSL #{cms_url}/agent/install.sh | sh" %>
        </div>
        <p class="text-sm text-muted-foreground">Then <code class="<%= inline_code_classes %>">cms doctor</code>, <code class="<%= inline_code_classes %>">cms manifest</code>, <code class="<%= inline_code_classes %>">cms commands --json</code>.</p>
      </section>
      <section class="card space-y-3 p-5">
        <h2 class="text-base font-semibold text-foreground flex items-center gap-2"><%= icon_tag "ai", class: "size-4 text-muted-foreground" %> MCP</h2>
        <p class="text-sm text-foreground">The same commands as MCP tools, for Claude Code or any MCP client, once the CLI is installed.</p>
        <div class="flex items-center gap-2">
          <code class="<%= code_classes %> min-w-0 flex-1">claude mcp add cms -- cms mcp</code>
          <%= copy_button "claude mcp add cms -- cms mcp" %>
        </div>
        <p class="text-sm text-muted-foreground">Every answer comes wrapped with what to call next.</p>
      </section>
    </div>

    <% if Serving.api? then %>
    <%= postbox "developers-astro", "Connect an Astro site" do %>
      <p class="text-foreground">Run this in the site's project (its root or its <code class="<%= inline_code_classes %>">src/</code>). It installs the <code class="<%= inline_code_classes %>">@librepublish/astro</code> integration and gets the site a read-only token of its own, approved in your browser.</p>
      <div class="flex items-center gap-2">
        <code class="<%= code_classes %> min-w-0 flex-1">curl -fsSL <%= cms_url %>/frontend/install.sh | sh</code>
        <%= copy_button "curl -fsSL #{cms_url}/frontend/install.sh | sh" %>
      </div>
      <div class="space-y-2">
        <p class="text-foreground">Then add <code class="<%= inline_code_classes %>">cms()</code> to <code class="<%= inline_code_classes %>">astro.config</code>. From then on, every <code class="<%= inline_code_classes %>">astro dev</code> and <code class="<%= inline_code_classes %>">astro build</code>:</p>
        <ul class="list-disc space-y-1 pl-5 text-foreground">
          <li>loads pages, entries and globals through content collections, and types them from this CMS's schema;</li>
          <li>writes <code class="<%= inline_code_classes %>">AGENTS.md</code> in the site's repo: how the site works with this CMS, and the Site health checks it's held to (<%= link_to "read it", frontend_agents_md_path, class: "font-medium text-primary underline underline-offset-2", target: "_blank", rel: "noopener" %>);</li>
          <li>after a build, writes <code class="<%= inline_code_classes %>">_redirects</code>, <code class="<%= inline_code_classes %>">sitemap.xml</code> and <code class="<%= inline_code_classes %>">robots.txt</code>, checks Site health, and reports the build here.</li>
        </ul>
      </div>
      <details class="rounded-lg border border-border">
        <summary class="cursor-pointer px-3 py-2 text-sm font-medium text-foreground">Or by hand</summary>
        <div class="space-y-2 border-t border-border p-3">
          <pre class="<%= code_classes %>">npm install @librepublish/astro@github:Martin-Business-Consultants/libre-cms-astro</pre>
          <pre class="<%= code_classes %>">// astro.config.mjs
import cms from "@librepublish/astro";
export default defineConfig({ integrations: [cms()] });</pre>
          <code class="<%= code_classes %>">CMS_BASE_URL=<%= cms_url %>  CMS_API_TOKEN=&lt;a service token&gt;</code>
          <p class="text-sm text-muted-foreground">Forms, Media and Commerce come with it. The source: github.com/Martin-Business-Consultants/libre-cms-astro.</p>
        </div>
      </details>
    <% end %>
    <% end %>

    <%= postbox "developers-how", "How it fits together" do %>
      <ol class="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
        <li class="flex flex-col gap-0.5 rounded-lg bg-muted p-3"><strong class="font-medium text-foreground">Agents and people</strong><span class="text-xs text-muted-foreground">change content through the CLI, MCP, API — or this admin</span></li>
        <li class="flex flex-col gap-0.5 rounded-lg bg-muted p-3"><strong class="font-medium text-foreground">The CMS</strong><span class="text-xs text-muted-foreground">stores it and serves live content as JSON at <code class="font-mono">/api/v1</code></span></li>
        <li class="flex flex-col gap-0.5 rounded-lg bg-muted p-3"><strong class="font-medium text-foreground">Your site</strong><span class="text-xs text-muted-foreground">(an Astro app) loads it at build time, or on demand on Cloudflare, and renders HTML</span></li>
        <li class="flex flex-col gap-0.5 rounded-lg bg-muted p-3"><strong class="font-medium text-foreground">Visitors</strong><span class="text-xs text-muted-foreground">get the site, never the CMS</span></li>
      </ol>
      <p class="text-muted-foreground">
        Publishing rebuilds a static site, or purges what changed from one rendered on demand (Settings › <%= link_to "Deploy", settings_deploy_path, class: "font-medium text-primary underline underline-offset-2" %>).
        Every page, entry and global has a <strong class="font-medium text-foreground">JSON</strong> tab in its editor, and every screen names its <code class="<%= inline_code_classes %>">cms</code> command.
      </p>
    <% end %>

    <%= postbox "developers-api", "The JSON" do %>
      <p class="text-muted-foreground">Every read takes <code class="<%= inline_code_classes %>">Authorization: Bearer &lt;token&gt;</code> and answers <code class="<%= inline_code_classes %>">{data, meta, included}</code>, live content only.</p>
      <div class="overflow-x-auto rounded-lg border border-border">
        <table class="table">
          <thead><tr class="table-row"><th class="table-head">Endpoint</th><th class="table-head">What it returns</th></tr></thead>
          <tbody>
            <% DevelopersController::ENDPOINTS.each do |verb, path, what| %>
              <%# herb:key path %>
              <tr class="table-row hover:bg-muted"><td class="table-cell font-mono text-xs whitespace-nowrap"><%= verb %> <%= path %></td><td class="table-cell"><%= what %></td></tr>
            <% end %>
            <% @plugin_endpoints.each do |plugin, endpoint| %>
              <%# herb:key endpoint[:path] %>
              <tr class="table-row hover:bg-muted"><td class="table-cell font-mono text-xs whitespace-nowrap"><%= endpoint[:path] %></td><td class="table-cell"><%= endpoint[:description] %> <span class="text-muted-foreground">(<%= plugin %>)</span></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <aside class="space-y-6">
    <% if Serving.api? then %>
    <%= postbox "developers-frontend", "Your frontend" do %>
      <% if @build %>
        <p class="flex flex-wrap items-center gap-2 text-foreground"><%= status_tag "connected" %> Built <%= time_ago_tag @build[:built_at] %></p>
        <dl class="<%= facts_classes %>">
          <% if @build[:framework] %>
            <dt class="text-muted-foreground">Framework</dt><dd class="text-foreground"><%= [ @build[:framework], @build[:framework_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:integration] %>
            <dt class="text-muted-foreground">Integration</dt><dd class="text-foreground"><%= [ @build[:integration], @build[:integration_version] ].compact.join(" ") %></dd>
          <% end %>
          <% if @build[:pages] %>
            <dt class="text-muted-foreground">Pages built</dt><dd class="text-foreground"><%= number_with_delimiter(@build[:pages]) %></dd>
          <% end %>
        </dl>
      <% else %>
        <div class="space-y-1.5">
          <p class="flex flex-wrap items-center gap-2 text-foreground"><%= status_tag "not connected" %> No build has reported yet.</p>
          <p class="text-sm text-muted-foreground">A site with the Astro integration reports each build here.</p>
        </div>
      <% end %>
      <dl class="<%= facts_classes %>">
        <dt class="text-muted-foreground">Site</dt><dd class="min-w-0 break-all text-foreground"><%= Frontend.site_url ? external_link(Frontend.site_url, link_class: "font-medium text-primary underline underline-offset-2") : link_to("Set it", settings_general_path, class: "font-medium text-primary underline underline-offset-2") %></dd>
        <dt class="text-muted-foreground">Repo</dt><dd class="min-w-0 break-all text-foreground"><%= Frontend.repo ? tag.span(Frontend.repo, class: "font-mono") : link_to("Set it", settings_github_path, class: "font-medium text-primary underline underline-offset-2") %></dd>
        <dt class="text-muted-foreground">Rebuilds</dt><dd class="text-foreground"><%= @deploys ? "On publish" : link_to("Not set up", settings_deploy_path, class: "font-medium text-primary underline underline-offset-2") %></dd>
        <dt class="text-muted-foreground">Service tokens</dt><dd><%= link_to @service_tokens, settings_service_tokens_path, class: "font-medium text-primary underline underline-offset-2" %></dd>
        <dt class="text-muted-foreground">Webhooks</dt><dd><%= link_to @webhooks, webhooks_path, class: "font-medium text-primary underline underline-offset-2" %></dd>
      </dl>
    <% end %>
    <% end %>

    <%= postbox "developers-model", "Content model" do %>
      <dl class="<%= facts_classes %>">
        <% @counts.each do |kind, count| %>
          <%# herb:key kind %>
          <dt class="text-muted-foreground"><%= kind.to_s.humanize %></dt><dd class="text-foreground tabular-nums"><%= number_with_delimiter(count) %></dd>
        <% end %>
      </dl>
      <p class="text-sm text-muted-foreground">Its full shape — every field and block type's JSON schema — is <code class="font-mono">GET /api/v1/schema</code>, which a connected site turns into its types.</p>
    <% end %>
  </aside>
</div>
<%= render "content_form/postbox_state" %>
