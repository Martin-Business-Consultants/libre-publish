<% @page_title = @asset.title %>
<%= parent_page "Media Library", file_manager_path %>

<%= render "layouts/shared/page_header", title: "Attachment details" %>

<%# The details alone, at the file's own address; picked in the library, the
    same frame loads into its sheet instead. %>
<section class="ui-card measure--lg">
  <div class="ui-card__content">
    <turbo-frame id="asset_details">
      <%= render "file_manager/assets/details", asset: @asset, folders: @folders %>
    </turbo-frame>
  </div>
</section>
