<%# locals: (asset:, folders:) %>
<%# A file's details, as WordPress's Attachment details: the picture, what
    the file is, its title, alt text, caption, description and folder, and
    where the site uses it. In the library's sheet (the asset_details frame)
    and on the file's own page. %>
<% can_write = Current.user.can?("assets:write") %>
<% usages = asset.referencing_records %>
<div class="media-details">
  <% if flash[:notice].present? && turbo_frame_request? %>
    <div class="ui-alert ui-alert--success" role="status">
      <%= icon_tag "check-circle", class: "ui-alert__icon" %>
      <p class="ui-alert__title"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <div class="media-details__preview">
    <% if asset.image? %>
      <%= image_tag(asset.variantable? && ApplicationHelper.variants_supported? ? asset.thumb_url(1024) : asset.url, alt: asset.alt.to_s) %>
    <% else %>
      <%= icon_tag "attachment", class: "icon--xl" %>
    <% end %>
  </div>

  <dl class="fact-list">
    <dt>Uploaded</dt><dd><%= time_ago_tag asset.created_at %></dd>
    <dt>File name</dt><dd class="text-mono text-small"><%= asset.filename %></dd>
    <dt>File type</dt><dd><%= asset.content_type %></dd>
    <dt>File size</dt><dd><%= number_to_human_size(asset.byte_size) %><% if asset.optimized? then %> <span class="text-muted">(optimized from <%= number_to_human_size(asset.original_file.byte_size) %>)</span><% end %></dd>
    <% if asset.file.metadata["width"] %>
      <dt>Dimensions</dt><dd><%= asset.file.metadata["width"] %> × <%= asset.file.metadata["height"] %> pixels</dd>
    <% end %>
  </dl>

  <div class="media-details__actions">
    <button type="button" class="ui-button ui-button--outline ui-button--sm" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= asset.url %>"
      data-copy-to-clipboard-success-class="ui-button--secondary" data-action="copy-to-clipboard#copy">
      <%= icon_tag "copy-paste" %>
      <span>Copy URL</span>
    </button>
    <%= link_to rails_blob_path(asset.file, disposition: "attachment"), class: "ui-button ui-button--outline ui-button--sm", data: { turbo: false } do %>
      <span>Download</span>
    <% end %>
    <% if can_write && asset.optimized? %>
      <%= button_to "Restore original", file_manager_asset_restoration_path(asset), class: "ui-button ui-button--outline ui-button--sm",
            title: "Put back the " + asset.original_file.filename.to_s + " (" + number_to_human_size(asset.original_file.byte_size) + ") the Image Optimizer replaced",
            form: { data: { turbo_confirm: "Put the original " + asset.original_file.filename.to_s + " back in place of this WebP?" } } %>
    <% end %>
    <% if Current.user.can?("assets:delete") %>
      <%= render "layouts/shared/delete_dialog", name: asset.title, path: file_manager_asset_path(asset),
            message: "It goes to the trash, where it can be restored.", trigger_text: "Move to trash", trigger_class: "push-end" %>
    <% end %>
  </div>

  <hr class="ui-separator">

  <%= render "layouts/shared/errors", record: asset %>
  <%= form_with model: asset, url: file_manager_asset_path(asset), scope: :asset do |form| %>
    <%= tag.fieldset class: "ui-fieldset", disabled: !can_write do %>
      <div class="ui-field">
        <%= form.label :alt, "Alternative text", class: "ui-label" %>
        <%= form.text_area :alt, rows: 2, placeholder: "What the image shows, for people who can’t see it.", class: "ui-textarea" %>
        <p class="ui-field__description">Read aloud by screen readers, and shown when the image can’t load. Leave it empty if the image is purely decorative.</p>
      </div>
      <div class="ui-field">
        <%= form.label :name, "Title", class: "ui-label" %>
        <%= form.text_field :name, placeholder: asset.filename, autocomplete: "off", class: "ui-input" %>
      </div>
      <div class="ui-field">
        <%= form.label :caption, "Caption", class: "ui-label" %>
        <%= form.text_area :caption, rows: 2, class: "ui-textarea" %>
        <p class="ui-field__description">Shown with it on the site, where the site shows captions.</p>
      </div>
      <div class="ui-field">
        <%= form.label :description, "Description", class: "ui-label" %>
        <%= form.text_area :description, rows: 3, class: "ui-textarea" %>
      </div>
      <div class="ui-field">
        <%= form.label :folder, "Folder", class: "ui-label" %>
        <%= form.select :folder, options_for_select([["Top level", "/"]] + folders.map { [it, it] }, asset.folder), {}, { class: "ui-select" } %>
      </div>
      <% if can_write %>
        <div>
          <%= form.button "Save", class: "ui-button" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <hr class="ui-separator">

  <section class="media-details__usages">
    <h3 class="ui-card__title">Used in</h3>
    <% if usages.any? %>
      <ul class="ui-item-group">
        <% usages.each do |record| %>
          <%# herb:key record.class.name + record.id.to_s %>
          <li class="ui-item ui-item--sm">
            <div class="ui-item__content">
              <p class="ui-item__title"><%= link_to record.try(:title).presence || record.try(:slug) || record.class.name, admin_record_path(record), class: "link", data: { turbo_frame: "_top" } %></p>
              <p class="ui-item__description"><%= record.class.model_name.human %></p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="ui-card__description">Nothing on the site uses it yet.</p>
    <% end %>
  </section>
</div>
