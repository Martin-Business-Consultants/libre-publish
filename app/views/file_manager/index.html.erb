<% @page_title = "Media Library" %>
<% can_write = Current.user.can?("assets:write") %>
<% can_delete = Current.user.can?("assets:delete") %>
<% ticks = can_write || can_delete %>
<% upload_folder = @folder || "/" %>
<% upload_place = upload_folder == "/" ? "the top level" : upload_folder %>

<% if can_write %>
  <% content_for :page_actions do %>
    <%= render "file_manager/image_optimizer" %>
    <%= render "file_manager/uploads", folder: upload_folder %>
  <% end %>
<% end %>
<% drop_data = can_write ? { controller: "media--file-drop", action: "dragenter->media--file-drop#enter dragover->media--file-drop#over dragleave->media--file-drop#leave drop->media--file-drop#drop" } : {} %>
<%= tag.div class: "file-drop stack", data: drop_data do %>
<%= render "layouts/shared/page_header", title: "Media Library", description: "Every file the site uses: images, documents and the rest, in folders." %>

<% if can_write %>
  <div class="file-drop__overlay" data-media--file-drop-target="overlay" hidden>
    <p class="file-drop__message">Drop files to upload them into <strong><%= upload_place %></strong>, or onto a folder.</p>
  </div>
  <div class="ui-alert ui-alert--warning" role="status" data-media--file-drop-target="message" hidden></div>
  <%# The drop zone, always there, as Payload's and WordPress's uploaders are;
      a drop anywhere on the page works too. Focused when "+ New › Media" led
      here. %>
  <section class="media-upload-zone" aria-label="Upload files" data-drop-folder="<%= upload_folder %>">
    <span class="media-upload-zone__icon">
      <%= icon_tag "picture-add" %>
    </span>
    <div class="media-upload-zone__text">
      <p class="media-upload-zone__title">Drop files to upload</p>
      <p class="media-upload-zone__description">Into <%= upload_place %>. A zip of images, dropped on its own, is unpacked.</p>
    </div>
    <%= tag.button "Select files", type: "button", class: "ui-button ui-button--outline ui-button--sm", autofocus: params[:upload].present?, data: { action: "media--file-drop#choose" } %>
  </section>
<% end %>

<%# The library, as Payload's media collection lays it out: one toolbar (search,
    the filters, Bulk select, grid or list), then every file as a square, or a
    list. Picking one opens its details in a sheet (file_manager/assets#show,
    into the asset_details frame). Bulk select turns the squares into ticks. %>
<div class="media-library" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <div class="media-toolbar">
    <%= form_with url: file_manager_path, method: :get, class: "media-toolbar__search ui-input-group", data: { turbo_action: "replace" } do |form| %>
      <%= form.hidden_field :view, value: @view, id: nil %>
      <%= form.hidden_field :kind, value: @kind, id: nil if @kind %>
      <%= form.hidden_field :month, value: @month, id: nil if @month %>
      <%= form.hidden_field :folder, value: @folder, id: nil if @folder %>
      <label for="media_search" class="visually-hidden">Search</label>
      <span class="ui-input-group__addon"><%= icon_tag "search" %></span>
      <%= form.search_field :q, value: @query, id: "media_search", placeholder: "Search by name…", autocomplete: "off", class: "ui-input" %>
    <% end %>

    <%= form_with url: file_manager_path, method: :get, class: "media-toolbar__filters", data: { controller: "form", turbo_action: "replace" } do %>
      <%= hidden_field_tag :view, @view, id: nil %>
      <%= hidden_field_tag :q, @query, id: nil if @query.present? %>
      <%= select_tag :kind, options_for_select([ [ "All media items", "" ] ] + Asset::Filterable::KINDS.map { |key, label| [ label, key ] }, @kind),
            id: nil, aria: { label: "Kind of file" }, data: { action: "change->form#submit" }, class: "ui-select" %>
      <%= select_tag :month, options_for_select([ [ "All dates", "" ] ] + @months.map { [ Date.strptime(it, "%Y-%m").strftime("%B %Y"), it ] }, @month),
            id: nil, aria: { label: "Month added" }, data: { action: "change->form#submit" }, class: "ui-select" %>
      <%= select_tag :folder, options_for_select([ [ "All folders", "" ], [ "Top level", "/" ] ] + @folders.map { [ it, it ] }, @folder),
            id: nil, aria: { label: "Folder" }, data: { action: "change->form#submit" }, class: "ui-select" %>
    <% end %>

    <div class="media-toolbar__end">
      <% if @view == "cards" && @assets.any? && ticks %>
        <label class="ui-button ui-button--outline">
          <input type="checkbox" class="visually-hidden" data-media-bulk>
          <%= icon_tag "check-circle" %>
          <span class="media-toolbar__bulk-on">Bulk select</span>
          <span class="media-toolbar__bulk-off">Cancel</span>
        </label>
      <% end %>

      <%# Grid or list, keeping the other filters; V switches. %>
      <nav class="ui-tabs ui-tabs--icons" aria-label="View">
        <% [ [ "cards", "Grid", "grid" ], [ "table", "List", "menu" ] ].each do |key, view_label, icon| %>
          <%# herb:key key %>
          <% current = key == @view %>
          <%= link_to url_for(request.query_parameters.except("page").merge("view" => key)),
                class: "ui-tabs__trigger",
                title: view_label, aria: { current: ("page" if current) }, data: { keys: ("v" unless current) } do %>
            <%= icon_tag icon %>
            <span class="visually-hidden"><%= view_label %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  </div>

  <% if can_write && @query.blank? %>
    <%= render "file_manager/folder_actions", folder: @folder || "/", can_delete: can_delete %>
  <% end %>

  <% if @subfolders.any? %>
    <ul class="media-folders" role="list">
      <% @subfolders.each do |folder| %>
        <%# herb:key folder %>
        <li data-filter-target="item">
          <%= link_to file_manager_path(folder: folder, view: @view), class: "media-folder",
                data: { drop_folder: folder } do %>
            <%= icon_tag "folder" %>
            <span class="truncate"><%= AssetFolders.name(folder) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%# With nothing to show: an empty table in the list view, an empty state in
      the grid. %>
  <% empty = if @query.present? || @kind || @month then "No media items found."
             elsif @subfolders.any? then "No files in this folder."
             else "No media items yet." + (can_write ? " Upload files, or drop them anywhere here; a zip of images is unpacked." : "")
             end %>
  <% if @assets.any? && ticks %>
    <%= render "file_manager/bulk_actions", folders: @folders, can_write: can_write, can_delete: can_delete %>
  <% end %>

  <% if @view == "cards" %>
    <% if @assets.any? %>
      <div class="media-grid">
        <% @assets.each do |asset| %>
          <%# herb:key asset.id %>
          <%= render "file_manager/asset_tile", asset: asset, selectable: ticks %>
        <% end %>
      </div>
      <%# Under the grid, on its own row: inside it, it took a tile's cell. %>
      <%= pagination_nav @page %>
    <% else %>
      <div class="ui-empty">
        <div class="ui-empty__media"><%= icon_tag "image" %></div>
        <p class="ui-empty__description"><%= empty %></p>
      </div>
    <% end %>
  <% else %>
    <%= tag.div class: "ui-card ui-card--flush", data: { controller: ("select-all" if ticks && @assets.any?) } do %>
      <div class="ui-table-container">
        <table class="ui-table" data-controller="pagination" data-pagination-paginate-on-intersection-value="true" data-pagination-discard-frame-value="true">
          <thead>
            <tr>
              <% if ticks %>
                <th class="media-table__check">
                  <% if @assets.any? %>
                    <input class="ui-checkbox" type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle">
                  <% end %>
                </th>
              <% end %>
              <th>File</th>
              <th>Type</th>
              <th>Folder</th>
              <th class="ui-table__numeric">Size</th>
              <th>Added</th>
              <th><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody id="<%= pagination_frame_id_for(:assets_rows, @page.number) %>">
            <% @assets.each do |asset| %>
              <%# herb:key asset.id %>
              <%= render "file_manager/asset_row", asset: asset, selectable: ticks, can_delete: can_delete %>
            <% end %>
            <%= table_next_page_row :assets_rows, @page, columns: ticks ? 7 : 6 %>
            <%= table_empty_row(empty, columns: ticks ? 7 : 6) if @assets.none? %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
  <% if @assets.any? %>
    <p class="media-library__count"><%= pluralize(@total, "media item") %></p>
  <% end %>

  <dialog class="ui-sheet app-sheet--wide media-details-sheet" data-dialog-target="dialog" aria-labelledby="asset_details_title" closedby="any">
    <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm ui-dialog__close" data-action="dialog#close" aria-label="Close"><%= icon_tag "close" %></button>
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title" id="asset_details_title">Attachment details</h2>
      <p class="ui-dialog__description">What the file is, how the site describes it, and where it’s used.</p>
    </header>
    <turbo-frame id="asset_details">
      <p class="ui-dialog__description">Loading…</p>
    </turbo-frame>
  </dialog>
</div>
<% end %>
