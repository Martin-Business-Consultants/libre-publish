<%# locals: (asset:, selectable:, can_delete:) %>
<%# One file in the library's list: its thumbnail and name (opening its details in the
    library's sheet), what it is, where it is, its size and age, and its actions. %>
<tr id="<%= dom_id(asset) %>" data-filter-target="item">
  <% if selectable %>
    <%= ui_select_cell asset.id, label: "Select #{asset.title}", form: "assets_bulk" %>
  <% end %>
  <td>
    <div class="media-row">
      <span class="media-thumb media-thumb--row">
        <%= asset_thumbnail asset, size: 64 %>
      </span>
      <%= link_to asset.title, file_manager_asset_path(asset), class: "ui-table__row-link truncate",
            data: { turbo_frame: "asset_details", action: "dialog#open" } %>
    </div>
  </td>
  <td><span class="text-small text-muted"><%= asset.content_type %></span></td>
  <td><span class="text-mono text-small text-muted"><%= asset.folder %></span></td>
  <td class="ui-table__numeric"><span class="nowrap"><%= number_to_human_size(asset.byte_size) %></span></td>
  <td><span class="nowrap text-muted"><%= time_ago_tag asset.created_at %></span></td>
  <td class="ui-table__numeric">
    <%= render "ui/row_actions", id: dom_id(asset), name: asset.title, links: [ [ "Open its page", file_manager_asset_path(asset) ] ],
          delete_path: (file_manager_asset_path(asset) if can_delete), delete_label: "Move to trash",
          delete_message: "It goes to the trash, where it can be restored." %>
  </td>
</tr>
