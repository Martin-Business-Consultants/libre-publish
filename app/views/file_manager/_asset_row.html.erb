<%# locals: (asset:, selectable:, can_delete:) %>
<tr id="<%= dom_id(asset) %>" class="table-row hover:bg-muted" data-filter-target="item">
  <% if selectable %>
    <td class="table-cell data-table__check">
      <input type="checkbox" data-select-all-target="box" data-action="select-all#sync" name="ids[]" value="<%= asset.id %>" form="assets_bulk" aria-label="Select <%= asset.title %>">
    </td>
  <% end %>
  <td class="table-cell">
    <div class="flex items-center gap-3">
      <span class="media-thumb flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-muted text-muted-foreground">
        <%= asset_thumbnail asset, size: 64 %>
      </span>
      <div class="min-w-0">
        <%= link_to asset.title, file_manager_asset_path(asset), class: "block truncate font-medium text-foreground hover:underline",
              data: { turbo_frame: "asset_details", action: "dialog#open" } %>
        <%= render "layouts/shared/row_links", name: asset.title, edit_path: file_manager_asset_path(asset),
              delete_path: (file_manager_asset_path(asset) if can_delete), delete_message: "It goes to the trash, where it can be restored." %>
      </div>
    </div>
  </td>
  <td class="table-cell"><span class="text-xs text-muted-foreground"><%= asset.content_type %></span></td>
  <td class="table-cell"><span class="font-mono text-xs text-muted-foreground"><%= asset.folder %></span></td>
  <td class="table-cell text-right"><span class="whitespace-nowrap tabular-nums"><%= number_to_human_size(asset.byte_size) %></span></td>
  <td class="table-cell"><span class="whitespace-nowrap text-xs text-muted-foreground"><%= time_ago_tag asset.created_at %></span></td>
</tr>
