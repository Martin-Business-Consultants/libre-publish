<%# locals: (folder:) %>
<%# Uploading into the folder being looked at. Files go straight to storage
    (Active Storage direct uploads) and the form submits their signed ids;
    the direct-upload controller lists each file's progress under the button.
    The zip's form opens under its button (a <details>: a zip dropped on the
    library opens it, media--file-drop's zipBox). %>
<details class="media-upload" data-media--file-drop-target="zipBox">
  <summary class="ui-button ui-button--outline" title="Upload a zip of images">
    <%= icon_tag "package" %>
    <span>Upload a zip</span>
  </summary>
  <%= form_with url: file_manager_bulk_uploads_path, class: "media-upload__panel media-upload__panel--zip",
        data: { controller: "media--direct-upload" } do |form| %>
    <%= form.hidden_field :folder, value: folder, id: nil, data: { media__file_drop_target: "zipFolder" } %>
    <div class="ui-field">
      <%= form.label :archive, "A zip of images", class: "ui-label" %>
      <%= form.file_field :archive, accept: ".zip,application/zip", direct_upload: true, required: true, class: "ui-input",
            data: { media__direct_upload_target: "input", media__file_drop_target: "zipInput" } %>
      <p class="ui-field__description">Each image becomes a WebP in <strong><%= folder %></strong>. HEIC, AVIF, JPEG, PNG, GIF and TIFF all work.</p>
    </div>
    <ul class="upload-list" data-media--direct-upload-target="list" hidden></ul>
    <button type="submit" class="ui-button ui-button--sm">
      <span>Unpack into this folder</span>
      <%= icon_tag "arrow-right" %>
    </button>
  <% end %>
</details>

<%= form_with url: file_manager_assets_path, class: "media-upload", data: { controller: "form media--direct-upload" } do |form| %>
  <%= form.hidden_field :folder, value: folder, id: nil, data: { media__file_drop_target: "filesFolder" } %>
  <label class="ui-button" title="Upload files">
    <%= icon_tag "add" %>
    <span>Upload files</span>
    <%= form.file_field :files, multiple: true, direct_upload: true, hidden: true,
          data: { action: "change->form#submit", media__direct_upload_target: "input", media__file_drop_target: "filesInput" } %>
  </label>
  <ul class="media-upload__panel upload-list" data-media--direct-upload-target="list" hidden></ul>
<% end %>
