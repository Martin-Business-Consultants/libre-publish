<% @page_title = "Image Optimizer" %>
<%= parent_page "Media Library", file_manager_path %>

<%= render "layouts/shared/page_header", title: "Image Optimizer" %>

<%= tag.section class: ui(:panel, "flex max-w-2xl flex-col gap-4 p-6"),
      data: ({ controller: "refresh", refresh_interval_value: 2 } unless @optimization.finished?) do %>
  <p class="flex flex-wrap items-center gap-2 text-sm text-gray-700">
    <%= status_tag @optimization.status.humanize %>
    <span>
      <%= @optimization.processed %> of <%= @optimization.total.positive? ? @optimization.total : "…" %> images looked at ·
      <%= @optimization.optimized %> made lighter · <%= @optimization.skipped %> already small enough · <%= @optimization.failed %> failed
    </span>
  </p>
  <progress class="w-full" max="100" value="<%= @optimization.progress %>"><%= @optimization.progress %>%</progress>

  <% if @optimization.optimized.positive? %>
    <p class="text-sm text-gray-900">
      Saved <strong class="font-semibold"><%= number_to_human_size(@optimization.bytes_saved) %></strong>:
      <%= number_to_human_size(@optimization.bytes_before) %> down to <%= number_to_human_size(@optimization.bytes_after) %>.
    </p>
  <% end %>

  <% if @optimization.errors_log.present? %>
    <section class="flex flex-col gap-2 border-t border-gray-200 pt-4">
      <h2 class="<%= ui(:heading) %>">Couldn’t optimize</h2>
      <ul class="flex flex-col gap-1 text-sm text-gray-700">
        <% @optimization.errors_log.each_with_index do |failure, index| %>
          <%# herb:key index %>
          <li><span class="font-mono text-xs"><%= failure["filename"] %></span> — <%= failure["message"] %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @optimization.finished? %>
    <%= link_to file_manager_path, class: ui(:button, :primary, "self-start") do %>
      <span>Back to the library</span>
      <%= icon_tag "arrow-right", class: "size-4" %>
    <% end %>
  <% else %>
    <p class="<%= ui(:help) %>">This page updates itself. You can leave it; the optimizer carries on.</p>
  <% end %>
<% end %>
