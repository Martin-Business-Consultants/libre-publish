<%# locals: (folders:, can_write:, can_delete:) %>
<%# Moving or deleting the ticked files. The tiles' and rows' checkboxes join
    this form with form="assets_bulk". In the grid it shows only in Bulk
    select (.media-bulk-actions, file-manager.css, which sets its display). %>
<%= form_with url: can_write ? file_manager_moves_path : file_manager_bulk_deletions_path, id: "assets_bulk",
      class: "media-bulk-actions flex-wrap items-center gap-2 rounded-lg border border-border bg-muted px-3 py-2 text-sm" do %>
  <% if can_write %>
    <label class="flex flex-wrap items-center gap-2">
      <span class="text-muted-foreground">Move the ticked files to</span>
      <%= select_tag :to, options_for_select([["All files (top level)", "/"]] + folders.map { [it, it] }), id: nil %>
    </label>
    <button type="submit" class="btn" data-variant="outline" data-size="sm" formaction="<%= file_manager_moves_path %>">Move</button>
  <% end %>
  <% if can_delete %>
    <div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
      <button type="button" class="btn text-destructive ml-auto" data-variant="outline" data-size="sm" data-action="dialog#open">
        <%= icon_tag "trash", class: "size-4" %>
        <span>Delete ticked</span>
      </button>
      <dialog class="dialog gap-4 p-6 text-left" data-dialog-target="dialog">
        <h3 class="text-lg font-semibold text-foreground">Delete the ticked files?</h3>
        <p class="text-sm text-muted-foreground">They go to the trash, where they can be restored.</p>
        <div class="mt-2 flex justify-end gap-2">
          <button type="button" class="btn" data-variant="outline" data-action="dialog#close">Cancel</button>
          <button type="submit" class="btn" data-variant="destructive" formaction="<%= file_manager_bulk_deletions_path %>">
            <%= icon_tag "trash", class: "size-4" %>
            <span>Delete</span>
          </button>
        </div>
      </dialog>
    </div>
  <% end %>
<% end %>
