<%# locals: (folders:, can_write:, can_delete:) %>
<%# Moving or deleting the ticked files. The tiles' and rows' checkboxes join
    this form with form="assets_bulk". In the grid it shows only in Bulk
    select (.media-bulk-actions, admin/media.css, which sets its display). %>
<%= form_with url: can_write ? file_manager_moves_path : file_manager_bulk_deletions_path, id: "assets_bulk",
      class: "media-bulk-actions" do %>
  <% if can_write %>
    <label class="media-bulk-actions__move">
      <span>Move the ticked files to</span>
      <%= select_tag :to, options_for_select([["All files (top level)", "/"]] + folders.map { [it, it] }), id: nil %>
    </label>
    <button type="submit" class="btn btn--secondary btn--sm" formaction="<%= file_manager_moves_path %>">Move</button>
  <% end %>
  <% if can_delete %>
    <div class="dialog-wrap" data-controller="rune-dialog">
      <button type="button" class="btn btn--danger btn--sm media-bulk-actions__delete" data-action="rune-dialog#open">
        <%= icon_tag "trash" %>
        <span>Delete ticked</span>
      </button>
      <dialog class="dialog" aria-label="Delete the ticked files?" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop">
        <div class="dialog__box">
          <header class="dialog__header">
            <h2 class="dialog__title">Delete the ticked files?</h2>
            <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
          </header>
          <div class="dialog__body">
            <p class="muted">They go to the trash, where they can be restored.</p>
            <div class="dialog__actions">
              <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
              <button type="submit" class="btn btn--danger" formaction="<%= file_manager_bulk_deletions_path %>">
                <%= icon_tag "trash" %>
                <span>Delete</span>
              </button>
            </div>
          </div>
        </div>
      </dialog>
    </div>
  <% end %>
<% end %>
