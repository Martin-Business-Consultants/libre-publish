<%# The Image Optimizer's button (ImageOptimization), beside Upload: how many
    images it would make lighter, asked before it starts; while a run goes,
    a link to it instead. %>
<% running = ImageOptimization.current %>
<% if running %>
  <%= link_to file_manager_image_optimization_path(running), class: ui(:button) do %>
    <%= icon_tag "refresh", class: "size-4" %>
    <span>Optimizing images…</span>
  <% end %>
<% else %>
  <%= button_to file_manager_image_optimizations_path, class: ui(:button), title: "Make large images lighter WebPs",
        form: { data: { turbo_confirm: "Every JPEG, PNG or WebP over 500 KB or 2560 pixels across becomes a WebP, 2560 pixels at most, in the background. Each keeps its place on the site, and its original is kept, to restore from its details. Start?" } } do %>
    <%= icon_tag "bolt", class: "size-4" %>
    <span>Image Optimizer</span>
  <% end %>
<% end %>
