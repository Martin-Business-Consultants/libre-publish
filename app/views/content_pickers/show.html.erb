<turbo-frame id="<%= @frame %>">
  <% if @choices.any? %>
    <ul class="flex flex-col" role="listbox">
      <% @choices.each do |label, value, detail| %>
        <%# herb:key value %>
        <li role="option">
          <button type="button" class="dropdown-item picker__choice justify-between" data-value="<%= value %>" data-label="<%= label %>" data-action="picker#choose">
            <span class="truncate"><%= label %></span>
            <span class="shrink-0 font-mono text-xs text-muted-foreground"><%= detail %></span>
          </button>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-2.5 py-1.5 text-sm text-muted-foreground">Nothing matches.</p>
  <% end %>
</turbo-frame>
