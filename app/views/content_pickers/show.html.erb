<turbo-frame id="<%= @frame %>">
  <% if @choices.any? %>
    <ul class="picker__list" role="listbox">
      <% @choices.each do |label, value, detail| %>
        <%# herb:key value %>
        <li role="option">
          <button type="button" class="ui-menu__item picker__choice" data-value="<%= value %>" data-label="<%= label %>" data-action="picker#choose">
            <span class="picker__label"><%= label %></span>
            <span class="picker__detail"><%= detail %></span>
          </button>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="content-picker__empty">Nothing matches.</p>
  <% end %>
</turbo-frame>
