<%# locals: (assets:, more:, page:, query:, folder:) %>
<%# One page of the picker's grid, and, when there's more, the link the
    media--infinite-scroll controller follows as it comes into view. %>
<% assets.each do |asset| %>
  <%# herb:key asset.id %>
  <li class="min-w-0">
    <button type="button" class="media-tile flex w-full flex-col gap-1.5 rounded-lg text-left outline-none"
            data-action="media--asset-picker#pick" data-asset-id="<%= asset.id %>" data-asset-name="<%= asset.title %>"
            title="<%= asset.title %>">
      <span class="media-thumb flex aspect-square w-full items-center justify-center overflow-hidden rounded-lg border border-border bg-muted text-muted-foreground">
        <%= asset_thumbnail asset, size: 240 %>
      </span>
      <span class="flex min-w-0 flex-col px-0.5">
        <span class="truncate text-xs font-medium text-foreground"><%= asset.title %></span>
        <span class="truncate text-xs text-muted-foreground"><%= asset_meta(asset) %></span>
      </span>
    </button>
  </li>
<% end %>
<% if more %>
  <li class="col-span-full py-4 text-center text-sm text-muted-foreground" data-media--infinite-scroll-target="next">
    <%= link_to "More", asset_picker_path(q: query.presence, folder: folder, page: page + 1), data: { turbo: false, action: "media--infinite-scroll#load" } %>
  </li>
<% end %>
