<%# locals: (assets:, more:, page:, query:, folder:) %>
<%# One page of the picker's grid, and, when there's more, the link the
    media--infinite-scroll controller follows as it comes into view. %>
<% assets.each do |asset| %>
  <%# herb:key asset.id %>
  <li class="asset-picker__item">
    <button type="button" class="media-tile asset-picker__tile"
            data-action="media--asset-picker#pick" data-asset-id="<%= asset.id %>" data-asset-name="<%= asset.title %>"
            title="<%= asset.title %>">
      <span class="media-thumb asset-picker__thumb">
        <%= asset_thumbnail asset, size: 240 %>
      </span>
      <span class="asset-picker__caption">
        <span class="truncate text-small text-medium text-ink"><%= asset.title %></span>
        <span class="truncate text-small text-muted"><%= asset_meta(asset) %></span>
      </span>
    </button>
  </li>
<% end %>
<% if more %>
  <li class="asset-picker__more" data-media--infinite-scroll-target="next">
    <%= link_to "More", asset_picker_path(q: query.presence, folder: folder, page: page + 1), data: { turbo: false, action: "media--infinite-scroll#load" } %>
  </li>
<% end %>
