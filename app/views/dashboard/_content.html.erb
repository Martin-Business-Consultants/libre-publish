<%# locals: () %>
<%# What the CMS holds, as shadcn's dashboard draws its section cards: a stat card for pages,
    one per collection with its entries, and one for globals, each opening its list. Only what
    the role can read. %>
<% cards = [] %>
<% if Current.user.can?("pages:read") %>
  <% cards << [ "Pages", "document", pages_path, Page.count, "page" ] %>
<% end %>
<% if Current.user.can?("collections:read") %>
  <% collections = Collection.order(:name).to_a %>
  <% counts = CollectionEntry.where(collection_id: collections.map(&:id)).group(:collection_id).count %>
  <% collections.each { |collection| cards << [ collection.name, collection.admin_icon, collection_entries_path(collection.slug), counts.fetch(collection.id, 0), "entry" ] } %>
<% end %>
<% if Current.user.can?("globals:read") %>
  <% cards << [ "Globals", "world", globals_path, Global.count, "global" ] %>
<% end %>
<% if cards.any? %>
  <section aria-labelledby="dashboard_content">
    <h2 id="dashboard_content" class="visually-hidden">Content</h2>
    <div class="dashboard__stats">
      <% cards.each do |title, icon, path, count, noun| %>
        <%# herb:key path %>
        <%= link_to path, class: "ui-card stat-card" do %>
          <span class="ui-card__header">
            <span class="ui-card__description"><%= title %></span>
            <span class="stat-card__value"><%= number_with_delimiter(count) %></span>
            <span class="ui-card__action stat-card__icon"><%= icon_tag icon %></span>
          </span>
          <span class="ui-card__footer stat-card__footer">
            <span>View all <%= noun.pluralize %></span>
            <%= icon_tag "arrow-right" %>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
