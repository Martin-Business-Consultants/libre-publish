<%# locals: () %>
<%# What the CMS holds, as Payload's dashboard shows it: a card for pages, one
    per collection with its entries, and one for globals, each opening its
    list. Only what the role can read. %>
<% cards = [] %>
<% if Current.user.can?("pages:read") %>
  <% cards << [ "Pages", "document", pages_path, Page.count, "page" ] %>
<% end %>
<% if Current.user.can?("collections:read") %>
  <% collections = Collection.order(:name).to_a %>
  <% counts = CollectionEntry.where(collection_id: collections.map(&:id)).group(:collection_id).count %>
  <% collections.each { |collection| cards << [ collection.name, collection.admin_icon, collection_entries_path(collection.slug), counts.fetch(collection.id, 0), "entry" ] } %>
<% end %>
<% if Current.user.can?("globals:read") %>
  <% cards << [ "Globals", "world", globals_path, Global.count, "global" ] %>
<% end %>
<% if cards.any? %>
  <section class="space-y-3" aria-labelledby="dashboard_content">
    <h2 id="dashboard_content" class="<%= ui(:heading) %>">Content</h2>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-3 xl:grid-cols-4">
      <% cards.each do |title, icon, path, count, noun| %>
        <%# herb:key path %>
        <%= link_to path, class: ui(:panel, "flex min-w-0 items-center gap-3 p-4 hover:border-gray-300 hover:bg-gray-50") do %>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-600"><%= icon_tag icon, class: "size-4" %></span>
          <span class="flex min-w-0 flex-col">
            <span class="truncate text-sm font-medium text-gray-900"><%= title %></span>
            <span class="text-xs text-gray-500"><%= pluralize(number_with_delimiter(count), noun) %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
