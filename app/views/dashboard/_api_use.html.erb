<%# Who's working through the API: the tokens used this past week. This CMS
    is mostly driven by the CLI, MCP and the site's build; this admin is for
    doing things by hand. %>
<% uses = Frontend.recent_api_use %>
<section class="<%= ui(:panel, "flex flex-col gap-4 p-5") %>">
  <header class="flex items-center justify-between gap-4">
    <h2 class="<%= ui(:heading, "flex items-center gap-2") %>"><%= icon_tag "ai", class: "size-4 text-gray-400" %> Working through the API</h2>
    <%= link_to "Developers", developers_path, class: ui(:button, :small) %>
  </header>
  <% if uses.any? %>
    <ul class="divide-y divide-gray-100">
      <% uses.each do |use| %>
        <%# herb:key use[:kind] + use[:name] %>
        <li class="flex items-center justify-between gap-4 py-2 text-sm">
          <span class="flex min-w-0 items-center gap-2">
            <span class="truncate font-medium text-gray-900"><%= use[:name] %></span>
            <span class="text-xs text-gray-500"><%= use[:kind] == "service" ? "service token" : "CLI, MCP or API" %></span>
          </span>
          <span class="text-xs whitespace-nowrap text-gray-500"><%= time_ago_tag use[:last_used_at] %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-500">No token has used the API this week.</p>
  <% end %>
  <p class="text-xs leading-relaxed text-gray-500">
    Drive this CMS from an agent: <code class="rounded-sm bg-gray-100 px-1 py-0.5 font-mono text-gray-700">curl -fsSL <%= request.base_url %>/agent/install.sh | sh</code>, then <code class="rounded-sm bg-gray-100 px-1 py-0.5 font-mono text-gray-700">claude mcp add cms -- cms mcp</code>.
  </p>
</section>
