<%# locals: () %>
<%# The latest editorial actions (AuditLog), the audit log's head. %>
<% entries = AuditLog.recent.limit(8).to_a %>
<section class="card overflow-hidden" aria-labelledby="dashboard_activity">
  <header class="flex items-center justify-between gap-4 border-b border-border px-5 py-3">
    <h2 id="dashboard_activity" class="text-base font-semibold text-foreground">Recent activity</h2>
    <%= link_to "Audit log", audit_logs_path, class: "btn", data: {variant: "outline", size: "sm"} %>
  </header>
  <% if entries.any? %>
    <ul class="divide-y divide-border">
      <% entries.each do |entry| %>
        <%# herb:key entry.id %>
        <li class="flex items-center justify-between gap-4 px-5 py-2.5 text-sm">
          <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-medium text-foreground"><%= entry.actor_label.presence || "system" %></span>
            <span class="badge" data-variant="secondary"><%= entry.current_action %></span>
            <% if entry.target_label.present? %>
              <span class="truncate text-foreground"><%= audit_target_link(entry) %></span>
            <% end %>
          </span>
          <span class="shrink-0 text-xs whitespace-nowrap text-muted-foreground"><%= time_ago_tag entry.created_at %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="py-12 text-center text-sm text-muted-foreground">Nothing has happened yet.</p>
  <% end %>
</section>
