<%# locals: () %>
<%# The latest editorial actions (AuditLog), the audit log's head. %>
<% entries = AuditLog.recent.limit(8).to_a %>
<section class="<%= ui(:panel, "overflow-hidden") %>" aria-labelledby="dashboard_activity">
  <header class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-3">
    <h2 id="dashboard_activity" class="<%= ui(:heading) %>">Recent activity</h2>
    <%= link_to "Audit log", audit_logs_path, class: ui(:button, :small) %>
  </header>
  <% if entries.any? %>
    <ul class="divide-y divide-gray-100">
      <% entries.each do |entry| %>
        <%# herb:key entry.id %>
        <li class="flex items-center justify-between gap-4 px-5 py-2.5 text-sm">
          <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-medium text-gray-900"><%= entry.actor_label.presence || "system" %></span>
            <span class="<%= ui(:badge, :gray) %>"><%= entry.current_action %></span>
            <% if entry.target_label.present? %>
              <span class="truncate text-gray-700"><%= audit_target_link(entry) %></span>
            <% end %>
          </span>
          <span class="shrink-0 text-xs whitespace-nowrap text-gray-500"><%= time_ago_tag entry.created_at %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="py-12 text-center text-sm text-gray-500">Nothing has happened yet.</p>
  <% end %>
</section>
