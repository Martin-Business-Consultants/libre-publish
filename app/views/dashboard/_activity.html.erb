<%# locals: () %>
<%# The latest editorial actions (AuditLog), the audit log's head. %>
<% entries = AuditLog.recent.limit(8).to_a %>
<section class="card" aria-labelledby="dashboard_activity">
  <div class="card__header">
    <h2 id="dashboard_activity" class="card__title">Recent activity</h2>
    <%= link_to "Audit log", audit_logs_path, class: "btn btn--secondary btn--sm" %>
  </div>
  <% if entries.any? %>
    <ul class="divided">
      <% entries.each do |entry| %>
        <%# herb:key entry.id %>
        <li class="dashboard__row">
          <span class="dashboard__what">
            <span class="strong"><%= entry.actor_label.presence || "system" %></span>
            <span class="badge"><%= entry.current_action %></span>
            <% if entry.target_label.present? %>
              <span class="truncate"><%= audit_target_link(entry) %></span>
            <% end %>
          </span>
          <span class="nowrap small muted"><%= time_ago_tag entry.created_at %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty empty--compact">Nothing has happened yet.</p>
  <% end %>
</section>
