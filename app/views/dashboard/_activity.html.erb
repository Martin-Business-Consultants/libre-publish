<%# locals: () %>
<%# The latest editorial actions (AuditLog), the audit log's head. %>
<% entries = AuditLog.recent.limit(8).to_a %>
<section class="panel" aria-labelledby="dashboard_activity">
  <header class="panel__header dashboard__header">
    <h2 id="dashboard_activity" class="heading">Recent activity</h2>
    <%= link_to "Audit log", audit_logs_path, class: "btn btn--sm" %>
  </header>
  <% if entries.any? %>
    <ul class="divided">
      <% entries.each do |entry| %>
        <%# herb:key entry.id %>
        <li class="dashboard__row dashboard__row--inset">
          <span class="cluster grow">
            <span class="text-medium text-ink"><%= entry.actor_label.presence || "system" %></span>
            <span class="badge"><%= entry.current_action %></span>
            <% if entry.target_label.present? %>
              <span class="truncate text-body"><%= audit_target_link(entry) %></span>
            <% end %>
          </span>
          <span class="no-shrink nowrap text-small text-muted"><%= time_ago_tag entry.created_at %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">Nothing has happened yet.</p>
  <% end %>
</section>
