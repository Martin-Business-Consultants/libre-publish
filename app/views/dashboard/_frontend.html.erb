<%# The dashboard's reminder that this CMS is headless: the site it serves,
    and whether that site's build has reported in (Frontend). %>
<% build = Frontend.last_build %>
<section class="ui-card" aria-labelledby="dashboard_frontend">
  <header class="ui-card__header">
    <h2 id="dashboard_frontend" class="ui-card__title">Your frontend</h2>
    <p class="ui-card__description">This CMS is headless: it serves content as JSON, and your site renders it.</p>
    <div class="ui-card__action">
      <%= link_to "Developers", developers_path, class: "ui-button ui-button--outline ui-button--sm" %>
    </div>
  </header>
  <div class="ui-card__content">
    <dl class="fact-list">
      <dt>Site</dt>
      <dd>
        <% if Frontend.site_url %>
          <%= external_link Frontend.site_url, Frontend.site_url.sub(%r{\Ahttps?://}, ""), link_class: "link" %>
        <% else %>
          <span class="text-muted">Not set</span>
        <% end %>
      </dd>
      <dt>Last build</dt>
      <dd>
        <% if build %>
          <%= time_ago_tag build[:built_at] %><%= " (#{number_with_delimiter(build[:pages])} pages)" if build[:pages] %>
        <% else %>
          <span class="text-muted">No site build has reported yet — connect one with the Astro integration.</span>
        <% end %>
      </dd>
    </dl>
  </div>
</section>
