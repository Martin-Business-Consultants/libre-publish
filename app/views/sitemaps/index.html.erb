<% @page_title = "Sitemap" %>
<% xml_url = @base_url.chomp("/") + "/sitemap.xml" %>
<% can_write = Current.user.can?("pages:write") %>
<% included = @entries.count(&:included?) %>

<% content_for :page_actions do %>
  <%= link_to "View sitemap.xml", "/sitemap.xml", class: "btn", target: "_blank", rel: "noopener" %>
  <button type="button" class="btn" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= xml_url %>" data-copy-to-clipboard-success-class="btn--success" data-action="copy-to-clipboard#copy">Copy URL</button>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<%= render "layouts/shared/status_links", param: :show, current: @filter.to_s,
      options: [ [ "All", nil, @entries.size ], [ "Included", "included", included ], [ "Excluded", "excluded", @entries.size - included ] ] %>

<div class="cluster cluster--between cluster--md">
  <p class="text-small text-muted">
    Published at <span class="text-mono text-body"><%= xml_url %></span>, and to a build as <a href="/api/sitemap" class="link text-mono">/api/sitemap</a>.
  </p>
  <div class="push-end">
    <%= render "layouts/shared/list_search", placeholder: "Search the sitemap…" %>
  </div>
</div>

<section class="panel panel--scroll">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Type</th>
        <th>Status</th>
        <th class="data-table__num">Priority</th>
        <th>Change freq.</th>
        <th>Last modified</th>
      </tr>
    </thead>
    <tbody>
      <% @shown.each do |entry| %>
        <%# herb:key "#{entry.source}-#{entry.id}" %>
        <% record = @records.dig(entry.source, entry.id) %>
        <% edit_path = (admin_record_path(record) if record && can_write) %>
        <% live_url = @sitemap.absolute_url(entry.loc, @base_url) %>
        <tr id="sitemap_<%= entry.source %>_<%= entry.id %>" data-filter-target="item">
          <td>
            <% if edit_path %>
              <%= link_to entry.title, edit_path, class: "title-link" %>
            <% else %>
              <span class="text-medium text-ink"><%= entry.title %></span>
            <% end %>
            <div class="text-mono text-small text-muted"><%= entry.loc %></div>
            <div class="row-actions">
              <% if edit_path %>
                <span><%= link_to "Edit", edit_path, class: "quick-edit__link" %></span>
              <% end %>
              <% if external_url?(live_url) %>
                <span><%= external_link live_url, "View", link_class: "quick-edit__link" %></span>
              <% end %>
              <% if can_write %>
                <details class="quick-edit">
                  <summary class="quick-edit__link">Quick edit</summary>
                  <%= form_with url: sitemap_entry_path(entry.source, entry.id), method: :patch, namespace: "sitemap_#{entry.source}_#{entry.id}",
                        class: "quick-edit__form" do %>
                    <%= hidden_field_tag :show, @filter, id: nil %>
                    <% if Current.user.can?(Sitemap.publish_capability(entry.source)) %>
                      <label class="quick-edit__field">
                        <span class="quick-edit__label">Status</span>
                        <%= select_tag "entry[status]", options_for_select(Page::STATUSES, entry.status), id: nil %>
                      </label>
                    <% end %>
                    <label class="quick-edit__field">
                      <span class="quick-edit__label">Priority</span>
                      <%= number_field_tag "entry[sitemap_priority]", entry.priority, step: 0.1, min: 0, max: 1, class: "quick-edit__number", id: nil %>
                    </label>
                    <label class="quick-edit__field">
                      <span class="quick-edit__label">Change freq.</span>
                      <%= select_tag "entry[sitemap_changefreq]", options_for_select(Sitemap::CHANGEFREQS, entry.changefreq), id: nil %>
                    </label>
                    <label class="choice quick-edit__check">
                      <%= hidden_field_tag "entry[noindex]", "false", id: nil %>
                      <%= check_box_tag "entry[noindex]", "true", entry.noindex, id: nil %>
                      <span>noindex</span>
                    </label>
                    <label class="choice quick-edit__check">
                      <%= hidden_field_tag "entry[nofollow]", "false", id: nil %>
                      <%= check_box_tag "entry[nofollow]", "true", entry.nofollow, id: nil %>
                      <span>nofollow</span>
                    </label>
                    <button type="submit" class="btn btn--primary">Update</button>
                  <% end %>
                </details>
              <% end %>
            </div>
          </td>
          <td><%= entry.collection_slug ? entry.collection_slug.humanize : "Page" %></td>
          <td>
            <%= status_tag entry.status, highlight: entry.included? %>
            <% if entry.noindex %>
              <%= status_tag "noindex" %>
            <% end %>
          </td>
          <td class="data-table__num"><%= format("%.2f", entry.priority.to_f) %></td>
          <td><%= entry.changefreq %></td>
          <td class="text-small nowrap"><%= entry.lastmod.present? ? time_ago_tag(Time.zone.parse(entry.lastmod.to_s)) : "—" %></td>
        </tr>
      <% end %>
      <%= table_empty_row("Nothing to show.", columns: 6) if @shown.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
