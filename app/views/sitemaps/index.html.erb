<% @page_title = "Sitemap" %>
<% xml_url = @base_url.chomp("/") + "/sitemap.xml" %>
<% can_write = Current.user.can?("pages:write") %>
<% included = @entries.count(&:included?) %>

<% content_for :page_actions do %>
  <%= link_to "robots.txt", sitemap_robots_path, class: "ui-button ui-button--outline" %>
  <%= link_to "View sitemap.xml", "/sitemap.xml", class: "ui-button ui-button--outline", target: "_blank", rel: "noopener" %>
  <button type="button" class="ui-button ui-button--outline" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= xml_url %>" data-copy-to-clipboard-success-class="ui-button--secondary" data-action="copy-to-clipboard#copy">Copy URL</button>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<div class="list-filters">
  <%= render "layouts/shared/status_links", param: :show, current: @filter.to_s,
        options: [ [ "All", nil, @entries.size ], [ "Included", "included", included ], [ "Excluded", "excluded", @entries.size - included ] ] %>
</div>

<div class="list-toolbar">
  <div class="list-toolbar__search">
    <%= render "layouts/shared/list_search", placeholder: "Search the sitemap…" %>
  </div>
  <p class="sitemap-note">
    Published at <span class="text-mono"><%= xml_url %></span>, and to a build as <a href="/api/sitemap" class="link text-mono">/api/sitemap</a>.
    Crawlers find it through <%= link_to "robots.txt", sitemap_robots_path, class: "link" %><%= " (written by hand)" if SearchSettings.custom_robots? %>.
  </p>
</div>

<div class="ui-card ui-card--flush">
  <div class="ui-table-container">
    <table class="ui-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th class="ui-table__numeric">Priority</th>
          <th>Change freq.</th>
          <th>Last modified</th>
          <th><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @shown.each do |entry| %>
          <%# herb:key "#{entry.source}-#{entry.id}" %>
          <% record = @records.dig(entry.source, entry.id) %>
          <% edit_path = (admin_record_path(record) if record && can_write) %>
          <% live_url = @sitemap.absolute_url(entry.loc, @base_url) %>
          <% row_id = "sitemap_#{entry.source}_#{entry.id}" %>
          <tr id="<%= row_id %>" data-filter-target="item">
            <td>
              <div class="sitemap-title">
                <% if edit_path %>
                  <%= link_to entry.title, edit_path, class: "sitemap-title__name" %>
                <% else %>
                  <span class="sitemap-title__name"><%= entry.title %></span>
                <% end %>
                <span class="sitemap-title__loc"><%= entry.loc %></span>
              </div>
            </td>
            <td><%= entry.collection_slug ? entry.collection_slug.humanize : "Page" %></td>
            <td>
              <span class="sitemap-badges">
                <%= status_tag entry.status, highlight: entry.included? %>
                <% if entry.noindex %>
                  <%= status_tag "noindex" %>
                <% end %>
              </span>
            </td>
            <td class="ui-table__numeric"><%= format("%.2f", entry.priority.to_f) %></td>
            <td><%= entry.changefreq %></td>
            <td><span class="nowrap text-muted"><%= entry.lastmod.present? ? time_ago_tag(Time.zone.parse(entry.lastmod.to_s)) : "—" %></span></td>
            <td class="ui-table__numeric">
              <div class="sitemap-actions">
                <% if can_write %>
                  <%# Quick edit: the row's sitemap settings in a popover under its button. %>
                  <div data-controller="ui--popover" data-ui--popover-align-value="end">
                    <button type="button" class="ui-button ui-button--ghost ui-button--sm" popovertarget="<%= row_id %>_quick_edit">Quick edit</button>
                    <div class="ui-popover quick-edit" id="<%= row_id %>_quick_edit" popover data-ui--popover-target="popover">
                      <%= form_with url: sitemap_entry_path(entry.source, entry.id), method: :patch, namespace: row_id, class: "ui-fieldset quick-edit__form" do %>
                        <%= hidden_field_tag :show, @filter, id: nil %>
                        <div class="ui-dialog__header">
                          <h3 class="ui-card__title"><%= entry.title %></h3>
                          <p class="ui-dialog__description">How the sitemap lists it.</p>
                        </div>
                        <% if Current.user.can?(Sitemap.publish_capability(entry.source)) %>
                          <label class="ui-field">
                            <span class="ui-label">Status</span>
                            <%= select_tag "entry[status]", options_for_select(Page::STATUSES, entry.status), id: nil, class: "ui-select ui-select--sm" %>
                          </label>
                        <% end %>
                        <div class="ui-field-row">
                          <label class="ui-field">
                            <span class="ui-label">Priority</span>
                            <%= number_field_tag "entry[sitemap_priority]", entry.priority, step: 0.1, min: 0, max: 1, class: "ui-input ui-input--sm", id: nil %>
                          </label>
                          <label class="ui-field">
                            <span class="ui-label">Change freq.</span>
                            <%= select_tag "entry[sitemap_changefreq]", options_for_select(Sitemap::CHANGEFREQS, entry.changefreq), id: nil, class: "ui-select ui-select--sm" %>
                          </label>
                        </div>
                        <div class="quick-edit__checks">
                          <label class="ui-field ui-field--inline">
                            <%= hidden_field_tag "entry[noindex]", "false", id: nil %>
                            <%= check_box_tag "entry[noindex]", "true", entry.noindex, id: nil, class: "ui-checkbox" %>
                            <span class="ui-label">noindex</span>
                          </label>
                          <label class="ui-field ui-field--inline">
                            <%= hidden_field_tag "entry[nofollow]", "false", id: nil %>
                            <%= check_box_tag "entry[nofollow]", "true", entry.nofollow, id: nil, class: "ui-checkbox" %>
                            <span class="ui-label">nofollow</span>
                          </label>
                        </div>
                        <button type="submit" class="ui-button ui-button--sm">Update</button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= render "ui/row_actions", id: row_id, name: entry.title, edit_path: edit_path,
                      links: ([ [ "View", live_url ] ] if external_url?(live_url)) %>
              </div>
            </td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing to show.", columns: 7) if @shown.none? %>
      </tbody>
    </table>
  </div>
</div>
<%= pagination_nav @pagination %>
