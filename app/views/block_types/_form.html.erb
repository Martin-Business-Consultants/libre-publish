<%# locals: (block_type:) %>
<%# A block type: its label, slug, category, icon and description; its fields (the schema
    editor); what a new block starts with; and, folded away, the whole definition as JSON. %>
<% json = JSON.pretty_generate(block_type.slice("slug", "label", "description", "category", "icon", "fields", "defaults")) %>
<%= render "layouts/shared/errors", record: block_type %>

<%= form_with url: (block_type.persisted? ? block_type_path(block_type.slug) : block_types_path), method: (block_type.persisted? ? :patch : :post),
      id: "block_type_form", class: "stack stack--lg block-type-form",
      data: { controller: "slug", slug_separator_value: "_", slug_locked_value: block_type.persisted? } do %>
  <section class="ui-card">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Details</h2>
      <p class="ui-card__description">How the block picker names and groups it.</p>
    </header>
    <div class="ui-card__content">
      <div class="ui-fieldset">
        <div class="grid grid--2 block-type-form__basics">
          <label class="ui-field">
            <span class="ui-label">Label</span>
            <%= text_field_tag "block_type[label]", block_type.label, id: nil, placeholder: "Hero", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" }, class: "ui-input" %>
          </label>
          <label class="ui-field">
            <span class="ui-label">Slug</span>
            <%= text_field_tag "block_type[slug]", block_type.slug, id: nil, class: "ui-input text-mono", placeholder: "hero",
                  autocomplete: "off", spellcheck: false, disabled: block_type.persisted?, data: { slug_target: "slug", action: "slug#take" } %>
          </label>
          <label class="ui-field">
            <span class="ui-label">Category</span>
            <%= text_field_tag "block_type[category]", block_type.category, id: nil, placeholder: "layout", autocomplete: "off", class: "ui-input" %>
          </label>
          <label class="ui-field">
            <span class="ui-label">Icon</span>
            <%= text_field_tag "block_type[icon]", block_type.icon, id: nil, placeholder: "LayoutTemplate", autocomplete: "off", class: "ui-input" %>
          </label>
        </div>
        <label class="ui-field">
          <span class="ui-label">Description</span>
          <%= text_area_tag "block_type[description]", block_type.description, id: nil, rows: 2, class: "ui-textarea" %>
        </label>
        <label class="ui-field ui-field--inline ui-field--end ui-field--card">
          <%= hidden_field_tag "block_type[deprecated]", "0", id: nil %>
          <%= check_box_tag "block_type[deprecated]", "1", block_type.deprecated, id: nil, class: "ui-switch", role: "switch" %>
          <span class="ui-label">Deprecated</span>
          <span class="ui-field__description">Hidden when adding a block, kept on pages that have one.</span>
        </label>
      </div>
    </div>
  </section>

  <section class="ui-card">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Fields</h2>
      <p class="ui-card__description">What a block of this type holds, in the order the editor shows it.</p>
    </header>
    <div class="ui-card__content">
      <%= render "schemas/editor", fields: block_type.fields, scope: "block_type", field_types: BlockType::TYPES,
            collection_slugs: Collection.order(:slug).pluck(:slug), block_slugs: BlockType.where.not(id: block_type.id).order(:slug).pluck(:slug) %>
    </div>
  </section>

  <section class="ui-card">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Defaults</h2>
      <p class="ui-card__description">What a new block of this type starts with, keyed by field name, as JSON.</p>
    </header>
    <div class="ui-card__content">
      <label class="visually-hidden" for="block_type_defaults">Defaults (JSON)</label>
      <%= text_area_tag "block_type[defaults]", JSON.pretty_generate(block_type.defaults.presence || {}), id: "block_type_defaults", rows: 5,
            class: "ui-textarea text-mono text-small", spellcheck: false %>
    </div>
    <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
      <button type="submit" class="ui-button"><%= block_type.persisted? ? "Save block type" : "Create block type" %></button>
    </footer>
  </section>

  <%= postbox "block-type-json", "Paste or edit the whole definition as JSON", open: false do %>
    <div class="ui-field">
      <label class="visually-hidden" for="block_type_json">The whole definition, as JSON</label>
      <%= text_area_tag "block_type[json]", json, id: "block_type_json", rows: 16, class: "ui-textarea text-mono text-small", spellcheck: false %>
      <span class="ui-field__description">The shape the starter pack uses: slug, label, description, category, icon, fields and defaults. It replaces the form above.</span>
      <div>
        <button type="submit" class="ui-button ui-button--outline ui-button--sm" name="source" value="json">Use this JSON</button>
      </div>
    </div>
  <% end %>
<% end %>
<%= render "content_form/postbox_state" %>
