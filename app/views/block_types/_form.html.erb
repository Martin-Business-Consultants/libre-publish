<%# locals: (block_type:) %>
<% json = JSON.pretty_generate(block_type.slice("slug", "label", "description", "category", "icon", "fields", "defaults")) %>
<%= render "layouts/shared/errors", record: block_type %>

<%= form_with url: (block_type.persisted? ? block_type_path(block_type.slug) : block_types_path), method: (block_type.persisted? ? :patch : :post),
      id: "block_type_form", class: "stack stack--lg block-type-form",
      data: { controller: "slug", slug_separator_value: "_", slug_locked_value: block_type.persisted? } do %>
  <section class="card">
    <div class="grid-2 block-type-form__basics">
      <label class="field">
        <span class="field__label">Label</span>
        <%= text_field_tag "block_type[label]", block_type.label, id: nil, placeholder: "Hero", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
      </label>
      <label class="field">
        <span class="field__label">Slug</span>
        <%= text_field_tag "block_type[slug]", block_type.slug, id: nil, class: "mono", placeholder: "hero",
              autocomplete: "off", spellcheck: false, disabled: block_type.persisted?, data: { slug_target: "slug", action: "slug#take" } %>
      </label>
      <label class="field">
        <span class="field__label">Category</span>
        <%= text_field_tag "block_type[category]", block_type.category, id: nil, placeholder: "layout", autocomplete: "off" %>
      </label>
      <label class="field">
        <span class="field__label">Icon</span>
        <%= text_field_tag "block_type[icon]", block_type.icon, id: nil, placeholder: "LayoutTemplate", autocomplete: "off" %>
      </label>
    </div>
    <label class="field">
      <span class="field__label">Description</span>
      <%= text_area_tag "block_type[description]", block_type.description, id: nil, rows: 2 %>
    </label>
    <label class="checkbox">
      <%= hidden_field_tag "block_type[deprecated]", "0", id: nil %>
      <%= check_box_tag "block_type[deprecated]", "1", block_type.deprecated, id: nil %>
      <span>Deprecated — hidden when adding a block, kept on pages that have one</span>
    </label>
  </section>

  <section class="stack stack--md">
    <h2 class="card__title">Fields</h2>
    <%= render "schemas/editor", fields: block_type.fields, scope: "block_type", field_types: BlockType::TYPES,
          collection_slugs: Collection.order(:slug).pluck(:slug), block_slugs: BlockType.where.not(id: block_type.id).order(:slug).pluck(:slug) %>
  </section>

  <label class="field">
    <span class="field__label">Defaults (JSON)</span>
    <%= text_area_tag "block_type[defaults]", JSON.pretty_generate(block_type.defaults.presence || {}), id: nil, rows: 5,
          class: "mono small", spellcheck: false %>
    <span class="field__hint">What a new block of this type starts with, keyed by field name.</span>
  </label>

  <div>
    <button type="submit" class="btn btn--primary"><%= block_type.persisted? ? "Save block type" : "Create block type" %></button>
  </div>

  <details class="card card--fold">
    <summary class="card__fold-summary">Paste or edit the whole definition as JSON <%= icon_tag "chevron", class: "fold__chevron" %></summary>
    <div class="field">
      <%= text_area_tag "block_type[json]", json, id: nil, rows: 16, class: "mono small", spellcheck: false %>
      <span class="field__hint">The shape the starter pack uses: slug, label, description, category, icon, fields and defaults. It replaces the form above.</span>
      <div>
        <button type="submit" class="btn btn--secondary btn--sm" name="source" value="json">Use this JSON</button>
      </div>
    </div>
  </details>
<% end %>
