<%# locals: (block_type:) %>
<% json = JSON.pretty_generate(block_type.slice("slug", "label", "description", "category", "icon", "fields", "defaults")) %>
<% field_classes = "flex flex-col gap-1.5" %>
<%= render "layouts/shared/errors", record: block_type %>

<%= form_with url: (block_type.persisted? ? block_type_path(block_type.slug) : block_types_path), method: (block_type.persisted? ? :patch : :post),
      id: "block_type_form", class: "flex max-w-5xl flex-col gap-6",
      data: { controller: "slug", slug_separator_value: "_", slug_locked_value: block_type.persisted? } do %>
  <section class="<%= ui(:panel, "flex flex-col gap-5 p-6") %>">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="<%= field_classes %>">
        <span class="<%= ui(:label) %>">Label</span>
        <%= text_field_tag "block_type[label]", block_type.label, id: nil, class: "w-full", placeholder: "Hero", autocomplete: "off", data: { slug_target: "source", action: "slug#fill" } %>
      </label>
      <label class="<%= field_classes %>">
        <span class="<%= ui(:label) %>">Slug</span>
        <%= text_field_tag "block_type[slug]", block_type.slug, id: nil, class: "w-full font-mono", placeholder: "hero",
              autocomplete: "off", spellcheck: false, disabled: block_type.persisted?, data: { slug_target: "slug", action: "slug#take" } %>
      </label>
      <label class="<%= field_classes %>">
        <span class="<%= ui(:label) %>">Category</span>
        <%= text_field_tag "block_type[category]", block_type.category, id: nil, class: "w-full", placeholder: "layout", autocomplete: "off" %>
      </label>
      <label class="<%= field_classes %>">
        <span class="<%= ui(:label) %>">Icon</span>
        <%= text_field_tag "block_type[icon]", block_type.icon, id: nil, class: "w-full", placeholder: "LayoutTemplate", autocomplete: "off" %>
      </label>
    </div>
    <label class="<%= field_classes %>">
      <span class="<%= ui(:label) %>">Description</span>
      <%= text_area_tag "block_type[description]", block_type.description, id: nil, rows: 2, class: "w-full" %>
    </label>
    <label class="flex items-center gap-2 text-sm text-gray-700">
      <%= hidden_field_tag "block_type[deprecated]", "0", id: nil %>
      <%= check_box_tag "block_type[deprecated]", "1", block_type.deprecated, id: nil %>
      <span>Deprecated — hidden when adding a block, kept on pages that have one</span>
    </label>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="<%= ui(:heading) %>">Fields</h2>
    <%= render "schemas/editor", fields: block_type.fields, scope: "block_type", field_types: BlockType::TYPES,
          collection_slugs: Collection.order(:slug).pluck(:slug), block_slugs: BlockType.where.not(id: block_type.id).order(:slug).pluck(:slug) %>
  </section>

  <label class="<%= field_classes %>">
    <span class="<%= ui(:label) %>">Defaults (JSON)</span>
    <%= text_area_tag "block_type[defaults]", JSON.pretty_generate(block_type.defaults.presence || {}), id: nil, rows: 5,
          class: "w-full font-mono text-xs", spellcheck: false %>
    <span class="<%= ui(:help) %>">What a new block of this type starts with, keyed by field name.</span>
  </label>

  <div>
    <button type="submit" class="<%= ui(:button, :primary) %>"><%= block_type.persisted? ? "Save block type" : "Create block type" %></button>
  </div>

  <details class="<%= ui(:panel, "p-5") %>">
    <summary class="<%= ui(:label) %>">Paste or edit the whole definition as JSON</summary>
    <div class="mt-4 flex flex-col gap-2">
      <%= text_area_tag "block_type[json]", json, id: nil, rows: 16, class: "w-full font-mono text-xs", spellcheck: false %>
      <span class="<%= ui(:help) %>">The shape the starter pack uses: slug, label, description, category, icon, fields and defaults. It replaces the form above.</span>
      <div>
        <button type="submit" class="<%= ui(:button, :small) %>" name="source" value="json">Use this JSON</button>
      </div>
    </div>
  </details>
<% end %>
