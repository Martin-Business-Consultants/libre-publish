<% @page_title = "Block types" %>
<% can_write = Current.user.can?("block_types:write") %>
<% can_delete = Current.user.can?("block_types:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <% if BlockType.none? %>
      <%= button_to "Install the starter block types", block_types_seeding_path, class: "ui-button ui-button--outline", form_class: "contents" %>
    <% end %>
    <%= render "layouts/shared/new_link", text: "New block type", path: new_block_type_path %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% if @categories.many? %>
  <div class="list-filters">
    <%= render "layouts/shared/quick_filter", title: "Category", param: :category, current: @category.to_s,
          options: [ [ "Every category", "" ] ] + @categories.map { [ it.humanize, it ] } %>
  </div>
<% end %>

<% selectable = can_delete && @block_types.any? %>
<div class="stack stack--md" data-controller="<%= "select-all" if selectable %>">
  <%= render "layouts/shared/bulk_actions", id: "block_types_bulk", noun: "block type", deletion_path: (block_types_bulk_deletions_path if can_delete && @block_types.any?),
        delete_message: "Pages using them keep their blocks, which stop validating until the type is back. This can’t be undone." %>

  <%= render "ui/data_table", id: "block_types",
        columns: [ ui_column(:label, "Label", hideable: false), ui_column(:slug, "Slug"), ui_column(:category, "Category"),
                   ui_column(:fields, "Fields", align: :end), ui_column(:source, "Source") ],
        rows: @block_types, row: "block_types/row", as: :block_type, pagination: @pagination,
        selectable: selectable, actions: true, row_locals: { can_write: can_write, can_delete: can_delete },
        empty: @category ? "No block types in #{@category}." : "No block types yet. The starter pack covers a hero, text, media, calls to action and more.",
        empty_link: ([ "Show all", block_types_path ] if @category || search_term) %>
</div>
