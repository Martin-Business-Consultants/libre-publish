<% @page_title = "Block types" %>
<% can_write = Current.user.can?("block_types:write") %>
<% can_delete = Current.user.can?("block_types:delete") %>

<% content_for :page_actions do %>
  <% if can_write %>
    <%= render "layouts/shared/new_link", text: "New block type", path: new_block_type_path %>
    <% if BlockType.none? %>
      <%= button_to "Install the starter block types", block_types_seeding_path, class: ui(:button), form_class: "contents" %>
    <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title %>

<% if @categories.many? %>
  <div class="mb-4 flex flex-wrap gap-2">
    <%= render "layouts/shared/quick_filter", title: "Category", param: :category, current: @category.to_s,
          options: [ [ "Every category", "" ] ] + @categories.map { [ it.humanize, it ] } %>
  </div>
<% end %>

<% if can_delete && @block_types.any? %>
  <%= render "layouts/shared/bulk_actions", id: "block_types_bulk", noun: "block type", deletion_path: block_types_bulk_deletions_path,
        delete_message: "Pages using them keep their blocks, which stop validating until the type is back. This can’t be undone." %>
<% end %>

<section class="<%= ui(:panel, "overflow-x-auto") %>" data-controller="select-all">
  <table class="data-table <%= ui(:table) %>">
    <thead>
      <tr>
        <% if can_delete %>
          <th class="<%= ui(:th, "data-table__check") %>"><% if @block_types.any? %><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"><% end %></th>
        <% end %>
        <th class="<%= ui(:th) %>">Label</th>
        <th class="<%= ui(:th) %>">Slug</th>
        <th class="<%= ui(:th) %>">Category</th>
        <th class="<%= ui(:th, "text-right") %>">Fields</th>
        <th class="<%= ui(:th) %>">Source</th>
      </tr>
    </thead>
    <tbody>
      <% @block_types.each do |block_type| %>
        <%# herb:key block_type.id %>
        <tr id="<%= dom_id(block_type) %>" class="hover:bg-gray-50" data-filter-target="item">
          <% if can_delete %>
            <td class="<%= ui(:td, "data-table__check") %>"><input type="checkbox" data-select-all-target="box" data-action="select-all#sync" name="slugs[]" value="<%= block_type.slug %>" form="block_types_bulk" aria-label="Select <%= block_type.label %>"></td>
          <% end %>
          <td class="<%= ui(:td) %>">
            <% if can_write %>
              <%= link_to block_type.label, edit_block_type_path(block_type.slug), class: "font-medium text-gray-900 hover:underline" %>
            <% else %>
              <span class="font-medium text-gray-900"><%= block_type.label %></span>
            <% end %>
            <% if block_type.deprecated %>
              <span class="<%= ui(:badge, :gray) %>">Deprecated</span>
            <% end %>
<%= render "layouts/shared/row_links", name: block_type.label,
                edit_path: (edit_block_type_path(block_type.slug) if can_write),
                delete_path: (block_type_path(block_type.slug) if can_delete),
                delete_message: "Pages using it keep their blocks, which stop validating. This can’t be undone." %>
          </td>
          <td class="<%= ui(:td) %>"><span class="font-mono text-xs text-gray-500"><%= block_type.slug %></span></td>
          <td class="<%= ui(:td) %>"><span class="text-gray-500"><%= block_type.category.presence || "—" %></span></td>
          <td class="<%= ui(:td, "text-right tabular-nums") %>"><%= Array(block_type.fields).size %></td>
          <td class="<%= ui(:td) %>"><%= block_type.built_in ? "Built-in" : "Custom" %></td>
        </tr>
      <% end %>
      <%= table_empty_row(@category ? "No block types in #{@category}." : "No block types yet. The starter pack covers a hero, text, media, calls to action and more.", columns: can_delete ? 6 : 5, link: (["Show all", block_types_path] if @category)) if @block_types.none? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
