<% @page_title = "Search" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= form_with url: search_path, method: :get, class: "mb-6 flex max-w-2xl gap-2", role: "search" do |form| %>
  <%= form.search_field :q, value: @search.term, class: "min-w-0 flex-1", placeholder: "Search pages, entries, globals, users…",
        autofocus: true, autocomplete: "off", aria: { label: "Search everything" } %>
  <button type="submit" class="btn">Search</button>
<% end %>

<% if @search.term.present? && !@search.searchable? %>
  <p class="text-sm text-muted-foreground">Type at least <%= SearchIndexed::MIN_LENGTH %> characters.</p>
<% elsif @search.searchable? %>
  <section class="card overflow-x-auto">
    <table class="data-table table">
      <thead>
        <tr class="table-row">
          <th class="table-head">Found</th>
          <th class="table-head">Kind</th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |record| %>
          <%# herb:key "#{record.class.name}-#{record.id}" %>
          <% snippet = record.hit.highlight(:body) %>
          <tr class="table-row hover:bg-muted">
            <td class="table-cell">
              <%= link_to search_result_path(record), class: "font-medium text-foreground hover:underline" do %>
                <%= record.search_document[:title].presence || "Untitled" %>
              <% end %>
              <% if snippet.present? %>
                <p class="mt-0.5 text-xs text-muted-foreground"><%= sanitize snippet, tags: %w[mark] %></p>
              <% end %>
            </td>
            <td class="table-cell"><span class="badge" data-variant="secondary"><%= GlobalSearch.kind_label(record) %></span></td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing holds “" + @search.term + "”.", columns: 2) if @results.empty? %>
      </tbody>
    </table>
  </section>

  <%= pagination_nav @pagination %>
<% end %>
