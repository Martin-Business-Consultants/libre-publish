<% @page_title = "Search" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<div class="tools-page">
  <%= form_with url: search_path, method: :get, class: "search-page__form", role: "search" do |form| %>
    <div class="ui-input-group search-page__input">
      <span class="ui-input-group__addon"><%= icon_tag "search" %></span>
      <%= form.search_field :q, value: @search.term, class: "ui-input", placeholder: "Search pages, entries, globals, users…",
            autofocus: true, autocomplete: "off", aria: { label: "Search everything" } %>
    </div>
    <button type="submit" class="ui-button">Search</button>
  <% end %>

  <% if @search.term.present? && !@search.searchable? %>
    <p class="ui-field__description">Type at least <%= SearchIndexed::MIN_LENGTH %> characters.</p>
  <% elsif @search.searchable? %>
    <div class="ui-card ui-card--flush">
      <div class="ui-table-container">
        <table class="ui-table">
          <thead>
            <tr>
              <th>Found</th>
              <th>Kind</th>
            </tr>
          </thead>
          <tbody>
            <% @results.each do |record| %>
              <%# herb:key "#{record.class.name}-#{record.id}" %>
              <% snippet = record.hit.highlight(:body) %>
              <tr>
                <td>
                  <%= link_to search_result_path(record), class: "ui-table__row-link" do %>
                    <%= record.search_document[:title].presence || "Untitled" %>
                  <% end %>
                  <% if snippet.present? %>
                    <p class="search-page__snippet"><%= sanitize snippet, tags: %w[mark] %></p>
                  <% end %>
                </td>
                <td><span class="ui-badge ui-badge--secondary"><%= GlobalSearch.kind_label(record) %></span></td>
              </tr>
            <% end %>
            <%= table_empty_row("Nothing holds “" + @search.term + "”.", columns: 2) if @results.empty? %>
          </tbody>
        </table>
      </div>
    </div>

    <%= pagination_nav @pagination %>
  <% end %>
</div>
