<% @page_title = "Search" %>

<%= render "layouts/shared/page_header", title: @page_title %>

<%= form_with url: search_path, method: :get, class: "row measure--lg", role: "search" do |form| %>
  <%= form.search_field :q, value: @search.term, class: "grow", placeholder: "Search pages, entries, globals, users…",
        autofocus: true, autocomplete: "off", aria: { label: "Search everything" } %>
  <button type="submit" class="btn btn--primary">Search</button>
<% end %>

<% if @search.term.present? && !@search.searchable? %>
  <p class="text-muted">Type at least <%= SearchIndexed::MIN_LENGTH %> characters.</p>
<% elsif @search.searchable? %>
  <section class="panel panel--scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Found</th>
          <th>Kind</th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |record| %>
          <%# herb:key "#{record.class.name}-#{record.id}" %>
          <% snippet = record.hit.highlight(:body) %>
          <tr>
            <td>
              <%= link_to search_result_path(record), class: "title-link" do %>
                <%= record.search_document[:title].presence || "Untitled" %>
              <% end %>
              <% if snippet.present? %>
                <p class="search-results__snippet"><%= sanitize snippet, tags: %w[mark] %></p>
              <% end %>
            </td>
            <td><span class="badge"><%= GlobalSearch.kind_label(record) %></span></td>
          </tr>
        <% end %>
        <%= table_empty_row("Nothing holds “" + @search.term + "”.", columns: 2) if @results.empty? %>
      </tbody>
    </table>
  </section>

  <%= pagination_nav @pagination %>
<% end %>
