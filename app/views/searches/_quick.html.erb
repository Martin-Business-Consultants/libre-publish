<%# locals: (quick:) %>
<%# The search modal's results (global-search controller), as the term is
    typed: titles that match it fuzzily, then records whose text holds it,
    each a link the arrow keys walk. Drawn as rune_ui's palette items. %>
<% if quick.blank? then %>
  <p class="palette__empty"><%= tx("Type to find a page, entry, global, user…") %></p>
<% elsif !quick.any? then %>
  <p class="palette__empty">Nothing matches “<%= quick.term %>”.</p>
<% else %>
  <% [["Titles", quick.titles], ["In the text", quick.texts]].each do |heading, results| %>
    <% if results.any? then %>
      <p class="palette__heading"><%= heading %></p>
      <ul class="palette__group" role="listbox" aria-label="<%= heading %>">
        <% results.each do |result| %>
          <%# herb:key "#{result.record.class.name}-#{result.record.id}" %>
          <li>
            <%= link_to search_result_path(result.record), class: "palette__item palette__item--tall",
                  role: "option", data: { global_search_target: "result", action: "mouseenter->global-search#hover" } do %>
              <span class="palette__text">
                <span class="palette__label"><%= search_marked_title(result.title, result.marks) %></span>
                <% if result.snippet.present? then %>
                  <span class="palette__sub"><%= sanitize result.snippet, tags: %w[mark] %></span>
                <% end %>
              </span>
              <span class="palette__kind"><%= result.kind %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
<% unless quick.blank? %>
  <%= link_to "All results for “#{quick.term}”", search_path(q: quick.term), class: "palette__item",
        data: { global_search_target: "result", action: "mouseenter->global-search#hover" } %>
<% end %>
