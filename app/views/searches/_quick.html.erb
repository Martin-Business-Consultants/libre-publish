<%# locals: (quick:) %>
<%# The command dialog's results (global-search controller), as the term is typed: titles
    that match it fuzzily, then records whose text holds it, each a link the arrow keys walk. %>
<% if quick.blank? then %>
  <p class="app-command__empty"><%= tx("Type to find a page, entry, global, user…") %></p>
<% elsif !quick.any? then %>
  <p class="app-command__empty"><%= tx("Nothing matches") %> “<%= quick.term %>”.</p>
<% else %>
  <% [["Titles", quick.titles], ["In the text", quick.texts]].each do |heading, results| %>
    <% if results.any? then %>
      <p class="app-command__group"><%= tx(heading) %></p>
      <ul role="listbox" aria-label="<%= tx(heading) %>">
        <% results.each do |result| %>
          <%# herb:key "#{result.record.class.name}-#{result.record.id}" %>
          <li>
            <%= link_to search_result_path(result.record), class: "app-command__item",
                  role: "option", data: { global_search_target: "result", action: "mouseenter->global-search#hover" } do %>
              <span class="app-command__text">
                <span class="truncate"><%= search_marked_title(result.title, result.marks) %></span>
                <% if result.snippet.present? then %>
                  <span class="app-command__snippet truncate"><%= sanitize result.snippet, tags: %w[mark] %></span>
                <% end %>
              </span>
              <%= ui_badge result.kind, :secondary %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
<% unless quick.blank? %>
  <%= link_to search_path(q: quick.term), class: "app-command__item app-command__all",
        data: { global_search_target: "result", action: "mouseenter->global-search#hover" } do %>
    <%= icon_tag "search" %> <span><%= tx("All results for") %> “<%= quick.term %>”</span>
  <% end %>
<% end %>
