<%# The Settings sections, down the left of a settings page (shadcn's
    settings nav): each group under a small label, each section a ghost link,
    the current one marked. %>
<nav class="settings-nav" aria-label="<%= tx("Settings sections") %>">
  <% settings_sections.each do |group, links| %>
    <%# herb:key group %>
    <div class="settings-nav__group">
      <h2 class="settings-nav__heading"><%= tx(group) %></h2>
      <ul class="settings-nav__list">
        <% links.each do |label, url, _description| %>
          <%# herb:key label %>
          <% here = request.path == url || request.path.start_with?(url + "/") %>
          <li>
            <%= link_to tx(label), url, aria: { current: ("page" if here) }, class: "settings-nav__link" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</nav>
