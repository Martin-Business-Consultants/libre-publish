<%# The Settings sections, down a settings page's sidebar, the current one
    marked. %>
<%= postbox "settings-sections", "Settings" do %>
  <nav class="space-y-4" aria-label="<%= tx("Settings sections") %>">
    <% settings_sections.each do |group, links| %>
      <%# herb:key group %>
      <div class="space-y-1">
        <h3 class="px-2 text-xs font-medium text-muted-foreground"><%= tx(group) %></h3>
        <ul>
          <% links.each do |label, url, _description| %>
            <%# herb:key label %>
            <% here = request.path == url || request.path.start_with?(url + "/") %>
            <li>
              <%= link_to tx(label), url, aria: { current: ("page" if here) },
                    class: class_names("block rounded-md px-2 py-1 text-sm", here ? "bg-blue-50 font-medium text-primary" : "text-foreground hover:bg-accent hover:text-foreground") %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>
<% end %>
