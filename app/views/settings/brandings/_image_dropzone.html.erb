<%# locals: (form:, kind:, label:, hint:, asset:) %>
<%# A branding image (logo, favicon) as a drop zone: drop an image on it or
    click to choose one, and it's saved to the media library (folder
    /branding) with the form. <kind>_id keeps the current one; Remove clears
    it (image_dropzone_controller). settings.css colors the zone by state. %>
<div class="field">
  <span class="label"><%= label %></span>
  <div class="<%= class_names("image-dropzone", "image-dropzone--filled": asset) %>" data-controller="image-dropzone"
       data-action="dragover->image-dropzone#over dragleave->image-dropzone#leave drop->image-dropzone#dropped">
    <%= form.hidden_field "#{kind}_id", value: asset&.id, data: { image_dropzone_target: "id" } %>
    <div class="image-dropzone__preview" data-image-dropzone-target="preview">
      <% if asset %>
        <%= media_thumbnail asset, size: 320 %>
      <% end %>
    </div>
    <span class="image-dropzone__prompt">
      <%= icon_tag "image", class: "icon--sm" %>
      Drop an image here, or click to choose
    </span>
    <%= form.file_field "#{kind}_file", accept: "image/*", class: "image-dropzone__file", aria: { label: label },
          data: { image_dropzone_target: "file", action: "change->image-dropzone#chosen" } %>
  </div>
  <div class="row row--between">
    <span class="help"><%= hint %></span>
    <%= tag.button "Remove", type: "button", class: "btn btn--plain btn--sm", hidden: asset.nil?,
          data: { image_dropzone_target: "remove", action: "image-dropzone#remove" } %>
  </div>
</div>
