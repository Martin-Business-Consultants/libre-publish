<% @page_title = "Branding" %>
<%# How things look and sound, on one page (Settings::BrandingScreen): this
    browser's appearance, then — for a role with settings:read — the
    workspace's identity, color, type and brand context. Each form saves on
    its own; the side card links down the page. %>
<% writable = Current.user.can?("settings:write") %>
<% sections = [["Appearance", "appearance"]] %>
<% sections += [["Identity", "identity"], ["Color", "color"], ["Type and surface", "type"], ["Brand context", "brand-context"]] if @workspace %>

<%= render "layouts/shared/page_header", title: "Branding" %>
<% content_for :settings_aside do %>
  <section class="ui-card ui-card--sm">
    <header class="ui-card__header">
      <h2 class="ui-card__title">On this page</h2>
    </header>
    <nav class="ui-card__content" aria-label="On this page">
      <ul class="settings-nav__list">
        <% sections.each do |label, anchor| %>
          <%# herb:key anchor %>
          <li><a href="#<%= anchor %>" class="settings-nav__link"><%= label %></a></li>
        <% end %>
      </ul>
    </nav>
  </section>
<% end %>

<section id="appearance" class="ui-card settings-anchor">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Appearance</h2>
    <p class="ui-card__description">Light, dark, or follow the system. Applies to this browser only.</p>
  </header>
  <div class="ui-card__content">
    <fieldset class="settings-choices" data-controller="theme">
      <legend class="visually-hidden">Theme</legend>
      <label class="ui-field ui-field--inline ui-field--end ui-field--card">
        <input type="radio" name="theme" value="light" class="ui-radio" data-theme-target="lightButton" data-action="theme#setLight">
        <span class="ui-label"><%= icon_tag "sun" %> Light</span>
      </label>
      <label class="ui-field ui-field--inline ui-field--end ui-field--card">
        <input type="radio" name="theme" value="dark" class="ui-radio" data-theme-target="darkButton" data-action="theme#setDark">
        <span class="ui-label"><%= icon_tag "moon" %> Dark</span>
      </label>
      <label class="ui-field ui-field--inline ui-field--end ui-field--card">
        <input type="radio" name="theme" value="auto" class="ui-radio" data-theme-target="autoButton" data-action="theme#setAuto">
        <span class="ui-label"><%= icon_tag "monitor" %> System</span>
      </label>
    </fieldset>
  </div>
</section>

<% if @workspace %>
  <%= form_with url: settings_branding_path, method: :patch, scope: :branding do |form| %>
    <%= tag.fieldset class: "stack stack--lg", disabled: !writable do %>
      <section id="identity" class="ui-card settings-anchor">
        <header class="ui-card__header">
          <h2 class="ui-card__title">Identity</h2>
          <p class="ui-card__description">The logo, color and type flow into the public site. The admin uses the color and font too.</p>
        </header>
        <div class="ui-card__content">
          <% if MediaLibrary.available? %>
            <div class="ui-field-row">
              <%= render "settings/brandings/image_dropzone", form: form, kind: "logo", label: "Logo",
                    hint: "SVG or PNG, saved to the media library.", asset: MediaLibrary.find(@branding[:logo_id]) %>
              <%= render "settings/brandings/image_dropzone", form: form, kind: "favicon", label: "Favicon",
                    hint: "Square works best; resized for browsers.", asset: MediaLibrary.find(@branding[:favicon_id]) %>
            </div>
          <% else %>
            <div class="ui-empty">
              <p class="ui-empty__description">A logo and favicon need a media library to keep them in: install the Media plugin.</p>
            </div>
          <% end %>
        </div>
      </section>

      <section id="color" class="ui-card settings-anchor">
        <header class="ui-card__header">
          <h2 class="ui-card__title">Color</h2>
          <p class="ui-card__description">A hex color each, such as #b45309.</p>
        </header>
        <div class="ui-card__content">
          <div class="ui-fieldset">
            <div class="ui-field-row">
              <%= settings_field "Primary color", hint: "Buttons, links, focus and what’s current. Black when blank." do %>
                <%= form.text_field :primary_color, value: @branding[:primary_color], pattern: "#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", placeholder: "#b45309", class: "ui-input text-mono" %>
              <% end %>
              <%= settings_field "Secondary color", hint: "Tints the grays: surfaces, lines and text. Neutral when blank." do %>
                <%= form.text_field :secondary_color, value: @branding[:secondary_color], pattern: "#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", placeholder: "#1c1917", class: "ui-input text-mono" %>
              <% end %>
            </div>
            <%= settings_field "Top bar", hint: "Dark keeps the bar along the top dark in light mode too, for a logo drawn for a dark ground." do %>
              <%= form.select :top_bar, Branding::TOP_BARS.invert.to_a, { selected: @branding[:top_bar].presence || "match" }, { class: "ui-select" } %>
            <% end %>
          </div>
        </div>
      </section>

      <section id="type" class="ui-card settings-anchor">
        <header class="ui-card__header">
          <h2 class="ui-card__title">Type and surface</h2>
          <p class="ui-card__description">The admin’s font, and how round and raised its pieces are.</p>
        </header>
        <div class="ui-card__content">
          <div class="ui-fieldset">
            <%= settings_field "Font", hint: "Every word in the admin." do %>
              <%= form.select :font, Branding::FONTS.invert.to_a, { include_blank: "Default", selected: @branding[:font] }, { class: "ui-select" } %>
            <% end %>
            <fieldset class="ui-fieldset">
              <legend class="ui-label">Corners</legend>
              <p class="ui-field__description">Buttons, fields, panels and menus.</p>
              <div class="settings-choices">
                <% [["", "Default"], *Branding::RADII.map { |value| [value, value.humanize] }].each do |value, label| %>
                  <%# herb:key value %>
                  <label class="ui-field ui-field--inline ui-field--end ui-field--card">
                    <%= form.radio_button :border_radius, value, checked: @branding[:border_radius].to_s == value, class: "ui-radio" %>
                    <span class="ui-label"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
            <fieldset class="ui-fieldset">
              <legend class="ui-label">Shadow</legend>
              <p class="ui-field__description">Under panels, and under what floats: menus, dialogs.</p>
              <div class="settings-choices">
                <% [["", "Default"], *Branding::SHADOWS.map { |value| [value, value.humanize] }].each do |value, label| %>
                  <%# herb:key value %>
                  <label class="ui-field ui-field--inline ui-field--end ui-field--card">
                    <%= form.radio_button :box_shadow, value, checked: @branding[:box_shadow].to_s == value, class: "ui-radio" %>
                    <span class="ui-label"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          </div>
        </div>
        <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
          <button type="submit" class="ui-button">Save branding</button>
        </footer>
      </section>
    <% end %>
  <% end %>

  <section id="brand-context" class="ui-card settings-anchor">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Brand context</h2>
      <p class="ui-card__description">A short brief describing how this workspace writes. Nothing in the CMS renders it — it’s published in <code>/api/manifest</code> so an agent working through the API or the <code>cms</code> CLI writes in your voice instead of a generic one. Leave a field blank to omit it.</p>
    </header>
    <%= form_with url: settings_brand_path, method: :patch, scope: :settings, class: "contents" do |form| %>
      <div class="ui-card__content">
        <%= tag.fieldset class: "ui-fieldset", disabled: !writable do %>
          <% if @record %>
            <%= render "layouts/shared/errors", record: @record %>
          <% end %>
          <% Settings::BrandsController::LABELS.each do |field, (field_label, hint)| %>
            <%# herb:key field %>
            <%= settings_field field_label, hint: hint do %>
              <%= form.text_area field, value: @brand_context[field], rows: 4, class: "ui-textarea" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
        <%= tag.button "Save brand context", type: "submit", class: "ui-button ui-button--outline", disabled: !writable %>
      </footer>
    <% end %>
  </section>
<% end %>
