<% @page_title = "Branding" %>
<%# How things look and sound, on one page (Settings::BrandingScreen): this
    browser's appearance, then — for a role with settings:read — the
    workspace's identity, color, type and brand context. Each form saves on
    its own; the sidebar links down the page. %>
<% writable = Current.user.can?("settings:write") %>
<% sections = [["Appearance", "appearance"]] %>
<% sections += [["Identity", "identity"], ["Color", "color"], ["Type and surface", "type"], ["Brand context", "brand-context"]] if @workspace %>

<% section_classes = "settings-section panel panel--padded fields" %>

<%= render "layouts/shared/page_header", title: "Branding" %>
<% content_for :settings_aside do %>
  <%= postbox "branding-sections", "On this page" do %>
    <nav aria-label="On this page">
      <ul>
        <% sections.each do |label, anchor| %>
          <%# herb:key anchor %>
          <li><a href="#<%= anchor %>" class="on-page-nav__link"><%= label %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>

<section id="appearance" class="<%= section_classes %>">
  <div class="stack stack--xs">
    <h2 class="heading">Appearance</h2>
    <p class="text-muted">Light, dark, or follow the system. Applies to this browser only.</p>
  </div>
  <div class="theme-switcher" data-controller="theme">
    <label class="theme-switcher__btn">
      <%= icon_tag "sun", class: "icon--md" %>
      <span>Light</span>
      <input type="radio" name="theme" value="light" class="visually-hidden" data-theme-target="lightButton" data-action="theme#setLight">
    </label>
    <label class="theme-switcher__btn">
      <%= icon_tag "moon", class: "icon--md" %>
      <span>Dark</span>
      <input type="radio" name="theme" value="dark" class="visually-hidden" data-theme-target="darkButton" data-action="theme#setDark">
    </label>
    <label class="theme-switcher__btn">
      <%= icon_tag "monitor", class: "icon--md" %>
      <span>System</span>
      <input type="radio" name="theme" value="auto" class="visually-hidden" data-theme-target="autoButton" data-action="theme#setAuto">
    </label>
  </div>
</section>

<% if @workspace %>
  <%= form_with url: settings_branding_path, method: :patch, scope: :branding do |form| %>
    <%= tag.fieldset class: "stack stack--lg", disabled: !writable do %>
      <section id="identity" class="<%= section_classes %>">
        <div class="stack stack--xs">
          <h2 class="heading">Identity</h2>
          <p class="text-muted">The logo, color and type flow into the public site. The admin uses the color and font too.</p>
        </div>
        <% if MediaLibrary.available? %>
          <div class="grid grid--2 fields-grid">
            <%= render "settings/brandings/image_dropzone", form: form, kind: "logo", label: "Logo",
                  hint: "SVG or PNG, saved to the media library.", asset: MediaLibrary.find(@branding[:logo_id]) %>
            <%= render "settings/brandings/image_dropzone", form: form, kind: "favicon", label: "Favicon",
                  hint: "Square works best; resized for browsers.", asset: MediaLibrary.find(@branding[:favicon_id]) %>
          </div>
        <% else %>
          <p class="text-muted">A logo and favicon need a media library to keep them in: install the Media plugin.</p>
        <% end %>
      </section>

      <section id="color" class="<%= section_classes %>">
        <h2 class="heading">Color</h2>
        <div class="grid grid--2 fields-grid">
          <%= settings_field "Primary color", hint: "Buttons, links, focus and what’s current. Black when blank." do %>
            <%= form.text_field :primary_color, value: @branding[:primary_color], pattern: "#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", placeholder: "#b45309", class: "text-mono" %>
          <% end %>
          <%= settings_field "Secondary color", hint: "Tints the grays: surfaces, lines and text. Neutral when blank." do %>
            <%= form.text_field :secondary_color, value: @branding[:secondary_color], pattern: "#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", placeholder: "#1c1917", class: "text-mono" %>
          <% end %>
          <%= settings_field "Top bar", hint: "Dark keeps the bar along the top dark in light mode too, for a logo drawn for a dark ground." do %>
            <%= form.select :top_bar, Branding::TOP_BARS.invert.to_a, { selected: @branding[:top_bar].presence || "match" } %>
          <% end %>
        </div>
      </section>

      <section id="type" class="<%= section_classes %>">
        <h2 class="heading">Type and surface</h2>
        <div class="grid grid--3 fields-grid">
          <%= settings_field "Font", hint: "Every word in the admin." do %>
            <%= form.select :font, Branding::FONTS.invert.to_a, { include_blank: "Default", selected: @branding[:font] } %>
          <% end %>
          <%= settings_field "Corners", hint: "Buttons, fields, panels and menus." do %>
            <%= form.select :border_radius, Branding::RADII.map { |value| [value.humanize, value] }, { include_blank: "Default", selected: @branding[:border_radius] } %>
          <% end %>
          <%= settings_field "Shadow", hint: "Under panels, and under what floats: menus, dialogs." do %>
            <%= form.select :box_shadow, Branding::SHADOWS.map { |value| [value.humanize, value] }, { include_blank: "Default", selected: @branding[:box_shadow] } %>
          <% end %>
        </div>
        <div><button type="submit" class="btn btn--primary">Save branding</button></div>
      </section>
    <% end %>
  <% end %>

  <section id="brand-context" class="<%= section_classes %>">
    <div class="stack stack--xs">
      <h2 class="heading">Brand context</h2>
      <p class="text-muted">A short brief describing how this workspace writes. Nothing in the CMS renders it — it’s published in <code>/api/manifest</code> so an agent working through the API or the <code>cms</code> CLI writes in your voice instead of a generic one. Leave a field blank to omit it.</p>
    </div>
    <% if @record %>
      <%= render "layouts/shared/errors", record: @record %>
    <% end %>
    <%= form_with url: settings_brand_path, method: :patch, scope: :settings do |form| %>
      <%= tag.fieldset class: "fields", disabled: !writable do %>
        <% Settings::BrandsController::LABELS.each do |field, (field_label, hint)| %>
          <%# herb:key field %>
          <%= settings_field field_label, hint: hint do %>
            <%= form.text_area field, value: @brand_context[field], rows: 4 %>
          <% end %>
        <% end %>
        <div><button type="submit" class="btn">Save brand context</button></div>
      <% end %>
    <% end %>
  </section>
<% end %>
