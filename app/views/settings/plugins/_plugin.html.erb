<%# locals: (plugin:) %>
<% enabled = Cms::Plugins.enabled?(plugin.key) %>
<% switched_on = Cms::Plugins.switched_on?(plugin) %>
<% missing = Cms::Plugins.missing_dependencies(plugin.key) %>
<% settings_page = Cms::Plugins.settings_pages[plugin.key] %>
<% absorbed = InstalledPlugins::ABSORBED.key?(plugin.key.to_s) %>
<% source = InstalledPlugins.repo(plugin.key.to_s) unless absorbed %>
<% newer = UpdateCheck::Plugins.latest_version(plugin.key) %>
<% removable = InstalledPlugins.present.key?(plugin.key.to_s) %>
<li id="plugin_<%= plugin.key %>" class="settings-item">
  <div class="settings-item__row">
    <div class="settings-item__text">
      <span class="settings-item__name">
        <%= link_to plugin.name, settings_plugin_path(plugin.key) %>
        <span class="settings-item__meta"><%= plugin.version %> · <%= plugin.bundled ? "bundled" : (source || "installed") %></span>
        <% if newer %>
          <span class="settings-item__accent"><%= newer %> available</span>
        <% end %>
      </span>
      <span class="settings-item__description"><%= plugin.description %></span>
    </div>
    <div class="settings-item__actions">
      <%= status_tag enabled ? "Active" : (switched_on ? "Waiting" : "Off") %>
      <% if enabled && settings_page %>
        <%= icon_button "settings-outline", label: plugin.name + " settings", url: instance_exec(&settings_page.path) %>
      <% end %>
      <% if Current.user.can?("settings:write") %>
        <% if switched_on %>
          <%= button_to "Switch off", settings_plugin_activation_path(plugin.key), method: :delete, class: "btn btn--secondary btn--sm" %>
        <% elsif plugin.compatible? %>
          <%= button_to "Switch on", settings_plugin_activation_path(plugin.key), class: "btn btn--secondary btn--sm" %>
        <% end %>
      <% end %>
      <% if source && Current.user.admin? %>
        <%= button_to "Update", settings_plugin_upgrade_path(plugin.key), class: button_classes(variant: (newer ? :primary : :secondary), size: :sm),
              title: "Install " + source + "’s latest release in place of this one" %>
      <% end %>
      <% if removable && Current.user.admin? %>
        <%= render "settings/plugins/remove_dialog", plugin: plugin,
              tables: PluginChange.image_copy?(plugin.key) ? [] : Cms::Plugins.tables_of(plugin.key) %>
      <% end %>
    </div>
  </div>
  <% unless plugin.compatible? %>
    <p class="field__error">Needs CMS <%= plugin.requires %>; this is <%= cms_version %>.</p>
  <% end %>
  <% if missing.any? %>
    <p class="field__error">Needs <%= missing.map { |dependency| Cms::Plugins.manifests[dependency]&.name || dependency.to_s }.to_sentence %> switched on.</p>
  <% end %>
</li>
