<%# locals: (plugin:, tables:) %>
<%# The delete dialog (layouts/shared/delete_dialog), with a choice to take
    the plugin's data too: its tables, named here. %>
<% title = "Remove " + plugin.name + "?" %>
<div class="dialog-wrap" data-controller="rune-dialog">
  <button type="button" class="icon-button icon-button--danger" title="<%= title %>" aria-label="<%= title %>" data-action="rune-dialog#open">
    <%= icon_tag "trash" %>
  </button>
  <dialog class="dialog" aria-label="<%= title %>" data-rune-dialog-target="dialog" data-action="click->rune-dialog#backdrop">
    <div class="dialog__box">
      <header class="dialog__header">
        <h2 class="dialog__title"><%= title %></h2>
        <%= icon_button "close", label: "Close", data: { action: "rune-dialog#close" } %>
      </header>
      <%= form_with url: settings_plugin_path(plugin.key), method: :delete, class: "dialog__body", data: { turbo_frame: "_top" } do |form| %>
        <p class="muted">Its code comes off this server and the CMS restarts. Its tables and data stay, so installing it again brings them back.</p>
        <% if tables.any? %>
          <label class="checkbox checkbox--top">
            <%= form.check_box :purge_data %>
            <span>Delete its data too: <%= safe_join(tables.map { |table| tag.code(table) }, ", ") %>. This can’t be undone.</span>
          </label>
        <% end %>
        <div class="dialog__actions">
          <button type="button" class="btn btn--ghost" data-action="rune-dialog#close">Cancel</button>
          <button type="submit" class="btn btn--danger">
            <%= icon_tag "trash" %>
            <span>Remove</span>
          </button>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
