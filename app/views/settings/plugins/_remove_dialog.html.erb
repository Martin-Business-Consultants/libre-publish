<%# locals: (plugin:, tables:) %>
<%# The delete dialog (layouts/shared/delete_dialog), with a choice to take
    the plugin's data too: its tables, named here. %>
<% title = "Remove " + plugin.name + "?" %>
<div class="contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="btn btn--danger btn--icon" title="<%= title %>" data-action="dialog#open">
    <%= icon_tag "trash" %>
    <span class="visually-hidden"><%= title %></span>
  </button>
  <dialog class="dialog dialog--action" data-dialog-target="dialog">
    <h3 class="heading heading--lg"><%= title %></h3>
    <%= form_with url: settings_plugin_path(plugin.key), method: :delete, class: "stack stack--md", data: { turbo_frame: "_top" } do |form| %>
      <p class="text-body">Its code comes off this server and the CMS restarts. Its tables and data stay, so installing it again brings them back.</p>
      <% if tables.any? %>
        <label class="choice choice--top">
          <%= form.check_box :purge_data %>
          <span>Delete its data too: <%= safe_join(tables.map { |table| tag.code(table) }, ", ") %>. This can’t be undone.</span>
        </label>
      <% end %>
      <div class="dialog__actions">
        <button type="button" class="btn" data-action="dialog#close">Cancel</button>
        <button type="submit" class="btn btn--destructive">
          <%= icon_tag "trash" %>
          <span>Remove</span>
        </button>
      </div>
    <% end %>
  </dialog>
</div>
