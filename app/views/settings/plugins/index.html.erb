<% @page_title = "Plugins" %>

<%= render "layouts/shared/page_header", title: "Plugins" %>

<%# While a plugin is being installed, updated or removed the page reloads
    itself (refresh), and stops once the server leaves the controller off. %>
<%= tag.div class: "stack stack--lg", data: ({ controller: "refresh", refresh_interval_value: 5 } if @change) do %>
  <% if @change %>
    <div class="ui-alert" role="status">
      <%= icon_tag "refresh", class: "ui-alert__icon" %>
      <p class="ui-alert__title"><%= @change.summary %></p>
      <div class="ui-alert__description">
        Started <%= time_ago_tag @change.created_at %><% if @change.requested_by %> by <%= @change.requested_by.name.presence || @change.requested_by.email %><% end %>.
        The CMS restarts when it’s in place, which takes a few seconds. This page checks every few seconds.
      </div>
    </div>
  <% end %>

  <%= tag.section class: class_names("ui-card", "ui-card--flush": @plugins.any?) do %>
    <%= tag.header class: class_names("ui-card__header", "ui-card__header--bordered": @plugins.any?) do %>
      <h2 class="ui-card__title">Installed</h2>
      <p class="ui-card__description">
        What this install adds to the core. Bundled plugins ship with the CMS; installed ones were added below, or with
        <code>CMS_PLUGINS</code> or <code>bin/rails "plugins:install[…]"</code>. A plugin starts off: switch it on here.
        Switching one off hides it and keeps its data.
      </p>
    <% end %>

    <% if @plugins.any? %>
      <ul class="ui-item-group">
        <%= render partial: "settings/plugins/plugin", collection: @plugins, as: :plugin %>
      </ul>
    <% else %>
      <div class="ui-card__content">
        <div class="ui-empty">
          <p class="ui-empty__description">No plugins are installed.</p>
        </div>
      </div>
    <% end %>

    <% if InstalledPlugins.absorbed.any? || InstalledPlugins.failed.any? %>
      <footer class="ui-card__footer ui-card__footer--bordered plugin-notes">
        <% InstalledPlugins.absorbed.each_key do |name| %>
          <%# herb:key name %>
          <p class="ui-field__description"><strong><%= name %></strong> is part of the CMS since <%= InstalledPlugins::ABSORBED[name] %>, so its plugin isn’t loaded. It can be removed.</p>
        <% end %>
        <% InstalledPlugins.failed.each do |name, error| %>
          <%# herb:key name %>
          <div class="row row--between">
            <p class="ui-field__error"><strong><%= name %></strong> is installed but didn’t load: <%= error %></p>
            <% if Current.user.admin? && InstalledPlugins.present.key?(name) %>
              <%= render "settings/plugins/remove_dialog", plugin: InstalledPlugins::Unloaded.new(key: name, name: name), tables: [] %>
            <% end %>
          </div>
        <% end %>
      </footer>
    <% end %>
  <% end %>

  <% if Current.user.admin? %>
    <%= render "settings/plugins/directory", entries: @directory, kind: "plugin" %>

    <%= form_with url: settings_plugins_installations_path, class: "ui-card" do |form| %>
      <header class="ui-card__header">
        <h2 class="ui-card__title">Or any plugin, by its repository</h2>
        <p class="ui-card__description">
          Its GitHub repository: the CMS installs its latest release on this server, where it stays through deploys
          and updates, and restarts. One the directory doesn’t list hasn’t been reviewed: install only code you trust,
          since a plugin runs with the CMS’s full access.
        </p>
      </header>
      <div class="ui-card__content row">
        <%= form.text_field :repo, class: "ui-input grow", placeholder: "owner/cms-thing", autocomplete: "off", required: true,
              aria: { label: "GitHub repository" } %>
        <button type="submit" class="ui-button">Install</button>
      </div>
    <% end %>
  <% end %>

  <% if @changes.any? %>
    <section class="ui-card ui-card--flush">
      <header class="ui-card__header ui-card__header--bordered">
        <h2 class="ui-card__title">Recent changes</h2>
        <% if Current.user.admin? && @changes.any?(&:failed?) %>
          <div class="ui-card__action">
            <%= button_to "Clear failed updates", settings_plugins_failures_path, method: :delete, class: "ui-button ui-button--outline ui-button--sm",
                  form: { data: { turbo_confirm: "Clear the failed changes from this list?" } } %>
          </div>
        <% end %>
      </header>
      <ul class="ui-item-group">
        <% @changes.each do |change| %>
          <%# herb:key change.id %>
          <li class="ui-item ui-item--sm">
            <div class="ui-item__content">
              <p class="ui-item__title"><%= change.summary %> <%= status_tag change.status %></p>
              <p class="ui-item__description"><%= time_ago_tag change.created_at %><% if change.requested_by %> · <%= change.requested_by.email %><% end %></p>
              <% if change.message.present? %>
                <pre class="<%= settings_code_classes %>"><code><%= change.message %></code></pre>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>

<p class="text-small text-muted">CMS <%= cms_version %></p>
