<% @page_title = @plugin.name %>
<%= parent_page "Plugins", settings_plugins_path %>
<% additions = Cms::Plugins.additions(@plugin.key) %>

<%= render "layouts/shared/page_header", title: @plugin.name %>

<section class="panel panel--padded stack">
  <p class="text-body"><%= @plugin.description %></p>

  <dl class="fact-list">
    <div><dt>Version</dt><dd><%= @plugin.version %></dd></div>
    <div><dt>Source</dt><dd><%= plugin_source_label(@plugin) %></dd></div>
    <% if @plugin.author.present? %>
      <div><dt>Author</dt><dd><%= @plugin.author %></dd></div>
    <% end %>
    <% if @plugin.requires.present? %>
      <div><dt>Needs CMS</dt><dd><%= @plugin.requires %> (this is <%= cms_version %>)</dd></div>
    <% end %>
    <% if @plugin.depends_on.any? %>
      <div><dt>Needs plugins</dt><dd><%= @plugin.depends_on.map { |dependency| Cms::Plugins.manifests[dependency]&.name || dependency.to_s }.to_sentence %></dd></div>
    <% end %>
    <% tables = Cms::Plugins.tables_of(@plugin.key) %>
    <% if tables.any? %>
      <div><dt>Its data</dt><dd><%= tables.to_sentence %></dd></div>
    <% end %>
    <% if @plugin.homepage.present? %>
      <div><dt>Homepage</dt><dd><%= link_to @plugin.homepage, @plugin.homepage, class: "link", rel: "noopener" %></dd></div>
    <% end %>
  </dl>
</section>

<section class="panel panel--padded stack stack--md">
  <h2 class="heading">What it adds</h2>
  <% if additions.any? %>
    <ul class="bullets text-body">
      <% additions.each do |addition| %>
        <%# herb:key addition %>
        <li><%= addition %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">Nothing the core shows.</p>
  <% end %>
</section>
