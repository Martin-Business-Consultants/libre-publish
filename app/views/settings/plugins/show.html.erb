<% @page_title = @plugin.name %>
<%= parent_page "Plugins", settings_plugins_path %>
<% additions = Cms::Plugins.additions(@plugin.key) %>

<%= render "layouts/shared/page_header", title: @plugin.name %>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">About</h2>
    <p class="ui-card__description"><%= @plugin.description %></p>
  </header>
  <div class="ui-card__content">
    <dl class="fact-list fact-list--wide">
      <dt>Version</dt>
      <dd><%= @plugin.version %></dd>
      <dt>Source</dt>
      <dd><%= plugin_source_label(@plugin) %></dd>
      <% if @plugin.author.present? %>
        <dt>Author</dt>
        <dd><%= @plugin.author %></dd>
      <% end %>
      <% if @plugin.requires.present? %>
        <dt>Needs CMS</dt>
        <dd><%= @plugin.requires %> (this is <%= cms_version %>)</dd>
      <% end %>
      <% if @plugin.depends_on.any? %>
        <dt>Needs plugins</dt>
        <dd><%= @plugin.depends_on.map { |dependency| Cms::Plugins.manifests[dependency]&.name || dependency.to_s }.to_sentence %></dd>
      <% end %>
      <% tables = Cms::Plugins.tables_of(@plugin.key) %>
      <% if tables.any? %>
        <dt>Its data</dt>
        <dd><%= tables.to_sentence %></dd>
      <% end %>
      <% if @plugin.homepage.present? %>
        <dt>Homepage</dt>
        <dd><%= link_to @plugin.homepage, @plugin.homepage, class: "link", rel: "noopener" %></dd>
      <% end %>
    </dl>
  </div>
</section>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">What it adds</h2>
  </header>
  <div class="ui-card__content">
    <% if additions.any? %>
      <ul class="bullet-list">
        <% additions.each do |addition| %>
          <%# herb:key addition %>
          <li><%= addition %></li>
        <% end %>
      </ul>
    <% else %>
      <div class="ui-empty">
        <p class="ui-empty__description">Nothing the core shows.</p>
      </div>
    <% end %>
  </div>
</section>
