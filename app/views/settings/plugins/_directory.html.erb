<%# locals: (entries:, kind:, from: nil) %>
<%# The plugin directory's plugins (or themes): each pinned to a reviewed
    release, and installed at exactly that commit (PluginDirectory). %>
<%= tag.section class: class_names("ui-card", "ui-card--flush": entries.any?) do %>
  <%= tag.header class: class_names("ui-card__header", "ui-card__header--bordered": entries.any?) do %>
    <h2 class="ui-card__title">From the directory</h2>
    <p class="ui-card__description">
      <%= kind.capitalize.pluralize %> Libre Publish has reviewed. Each installs at the release that was checked, from a
      signed list, so what you get is what was reviewed.
      <% if PluginDirectory.checked_at %>Checked <%= time_ago_tag PluginDirectory.checked_at %>.<% end %>
    </p>
  <% end %>
  <% if entries.any? %>
    <ul class="ui-item-group">
      <% entries.each do |entry| %>
        <%# herb:key entry.key %>
        <li class="ui-item">
          <div class="ui-item__content">
            <p class="ui-item__title">
              <%= entry.name %>
              <span class="text-small text-muted"><%= entry.version %><% if entry.author.present? %> · <%= entry.author %><% end %></span>
            </p>
            <p class="ui-item__description"><%= entry.description %></p>
            <% unless entry.compatible? %>
              <p class="ui-field__error">Needs CMS <%= entry.requires %>; this is <%= cms_version %>.</p>
            <% end %>
          </div>
          <div class="ui-item__actions">
            <%= status_tag "Verified", highlight: true %>
            <% if entry.installed? %>
              <span class="text-small text-muted">Installed</span>
            <% elsif entry.compatible? %>
              <%= button_to "Install", settings_plugins_installations_path(from: from), params: { repo: entry.repo }, class: "ui-button ui-button--outline ui-button--sm" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="ui-card__content">
      <div class="ui-empty">
        <p class="ui-empty__description">The directory hasn’t been fetched yet; it is now, and shows here in a moment.</p>
      </div>
    </div>
  <% end %>
<% end %>
