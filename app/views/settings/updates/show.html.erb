<% @page_title = "Updates" %>
<% release_tag = UpdateCheck.latest_tag %>

<%= render "layouts/shared/page_header", title: "Updates" %>

<%# While an update runs the page reloads itself (refresh), and stops once
    it has settled and the server leaves the controller off. %>
<%= tag.div class: "stack stack--lg", data: ({ controller: "refresh", refresh_interval_value: 5 } if @upgrade) do %>
  <section class="panel panel--padded stack">
    <dl class="fact-list">
      <div><dt>Running</dt><dd>CMS <%= cms_version %></dd></div>
      <div>
        <dt>Newest release</dt>
        <dd>
          <% if UpdateCheck.latest_version %>
            <%= external_link UpdateCheck.release_url, "CMS #{UpdateCheck.latest_version}" %>
            <span class="text-muted"><%= UpdateCheck.update_available? ? "(newer)" : "(up to date)" %></span>
          <% else %>
            <span class="text-muted">Not checked yet</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt>Checked</dt>
        <dd>
          <% if UpdateCheck.checked_at %>
            <%= time_ago_tag UpdateCheck.checked_at %><% if UpdateCheck.checking? %>, and every day<% end %>
          <% else %>
            <span class="text-muted">Never<% unless UpdateCheck.checking? %> (CMS_UPDATE_CHECK=false)<% end %></span>
          <% end %>
        </dd>
      </div>
      <div><dt>Updates by</dt><dd><%= update_method_description %></dd></div>
    </dl>
    <div><%= button_to "Check now", settings_updates_check_path, class: "btn btn--sm" %></div>
  </section>

  <% if @upgrade %>
    <section class="panel panel--padded stack stack--md">
      <h2 class="heading">Updating to <%= @upgrade.to_version %></h2>
      <p class="text-body">
        Started <%= time_ago_tag @upgrade.created_at %> by <%= upgrade_requester @upgrade %>.
        The install backs up its data, migrates and restarts on <%= @upgrade.to_version %>; until then <%= cms_version %> keeps running.
        This page checks every few seconds.
      </p>
      <% if (note = @upgrade.runner.try(:note)) %>
        <p class="text-body"><%= note %></p>
      <% end %>
      <% if @upgrade.external_url %>
        <p><%= external_link @upgrade.external_url, upgrade_follow_text(@upgrade) %></p>
      <% end %>
      <% if Current.user.admin? %>
        <div>
          <%= render "layouts/shared/confirm_dialog", label: "Stop this update", title: "Stop the update to #{@upgrade.to_version}?",
                message: "#{cms_version} keeps running and nothing changes. Use it when the update has gone quiet; you can start it again afterwards.",
                path: settings_updates_stop_path, button: "Stop the update", negative: true %>
        </div>
      <% end %>
    </section>
  <% elsif UpdateCheck.update_available? %>
    <section class="panel panel--padded stack">
      <div class="stack stack--xs">
        <h2 class="heading">CMS <%= UpdateCheck.latest_version %></h2>
        <% if UpdateCheck.published_at %>
          <p class="text-muted">Released <%= l UpdateCheck.published_at.to_date, format: :long %>.</p>
        <% end %>
      </div>
      <% if UpdateCheck.notes %>
        <div class="release-notes"><%= simple_format UpdateCheck.notes %></div>
      <% end %>

      <% if !Upgrade.available? %>
        <p class="text-body"><%= Upgrade.unavailable_reason %> On the server:</p>
        <pre class="<%= settings_code_classes %>"><code><%= manual_update_command(release_tag) %></code></pre>
        <p class="help">
          To use a button instead, run from a checkout made by <code>bin/install</code>, or for a Docker install set
          <code>CMS_GITHUB_TOKEN</code> and <code>CMS_DEPLOY_DESTINATION</code>. See <code>docs/install.md</code>.
        </p>
      <% elsif Current.user.admin? %>
        <div>
          <%= render "layouts/shared/confirm_dialog", label: "Update to #{UpdateCheck.latest_version}", title: "Update to CMS #{UpdateCheck.latest_version}?",
                message: "The CMS backs up its data, updates and restarts. It’s unavailable for a minute or two; nobody is signed out. If anything fails, #{cms_version} keeps running and this page says why.",
                path: settings_updates_path, button: "Update now", primary: true %>
        </div>
      <% else %>
        <p class="text-muted">An admin can update to it from here.</p>
      <% end %>
    </section>
  <% end %>

  <% if @upgrades.any? %>
    <section class="panel panel--padded stack stack--md">
      <div class="cluster cluster--between">
        <h2 class="heading">Past updates</h2>
        <% if Current.user.admin? && @upgrades.any?(&:failed?) %>
          <%= button_to "Clear failed updates", settings_updates_failures_path, method: :delete, class: "btn btn--sm",
                form: { data: { turbo_confirm: "Clear the failed updates from this list?" } } %>
        <% end %>
      </div>
      <ul class="log-list">
        <% @upgrades.each do |upgrade| %>
          <%# herb:key upgrade.id %>
          <li>
            <span>
              <%= status_tag upgrade.status %>
              <strong class="text-semibold text-ink"><%= upgrade.from_version %> → <%= upgrade.to_version %></strong>
              <span class="text-muted"> · <%= upgrade_requester upgrade %> · <%= time_ago_tag upgrade.created_at %></span>
              <% if upgrade.external_url %>
                <span class="text-muted"> · </span><%= external_link upgrade.external_url, "Deploy log" %>
              <% end %>
            </span>
            <% if upgrade.message.present? %>
              <pre class="log-list__error"><%= upgrade.message %></pre>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
