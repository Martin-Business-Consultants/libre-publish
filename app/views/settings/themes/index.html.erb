<% @page_title = "Themes" %>

<%= render "layouts/shared/page_header", title: "Themes" %>

<%# While a theme is being installed or updated the page reloads itself
    (refresh), as Settings › Plugins does. %>
<%= tag.div class: "stack stack--lg", data: ({ controller: "refresh", refresh_interval_value: 5 } if @change) do %>
  <% if @change %>
    <div class="ui-alert" role="status">
      <%= icon_tag "refresh", class: "ui-alert__icon" %>
      <p class="ui-alert__title"><%= @change.summary %></p>
      <div class="ui-alert__description">The CMS restarts when it’s in place, which takes a few seconds. This page checks every few seconds.</div>
    </div>
  <% end %>

  <%= tag.section class: class_names("ui-card", "ui-card--flush": @themes.any?) do %>
    <%= tag.header class: class_names("ui-card__header", "ui-card__header--bordered": @themes.any?) do %>
      <h2 class="ui-card__title">Installed</h2>
      <p class="ui-card__description">
        A theme draws the website at “/” from this install’s content. It’s a plugin: it comes with the install
        (<code>CMS_THEME</code>) or is added below, and updates like one. Without one switched on, the CMS is headless.
      </p>
    <% end %>

    <% if @themes.any? %>
      <ul class="ui-item-group">
        <% @themes.each do |theme| %>
          <%# herb:key theme.key %>
          <% plugin = Cms::Plugins.manifests[theme.key.to_sym] %>
          <% drawing = Website.theme&.key == theme.key && Website.enabled? %>
          <% source = InstalledPlugins.repo(theme.key) %>
          <% newer = UpdateCheck::Plugins.latest_version(theme.key) %>
          <li class="ui-item">
            <div class="ui-item__content">
              <p class="ui-item__title">
                <% if plugin %>
                  <%= link_to theme.name, settings_plugin_path(plugin.key), class: "link" %>
                <% else %>
                  <%= theme.name %>
                <% end %>
                <span class="text-small text-muted"><%= theme.version %><% if source %> · <%= source %><% end %></span>
                <% if newer %>
                  <%= ui_badge "#{newer} available", :outline %>
                <% end %>
              </p>
              <% if plugin&.description.present? %>
                <p class="ui-item__description"><%= plugin.description %></p>
              <% end %>
            </div>
            <div class="ui-item__actions">
              <%= status_tag drawing ? "Active" : "Off" %>
              <% if drawing %>
                <%= link_to "View site", root_path, class: "ui-button ui-button--outline ui-button--sm", target: "_blank", rel: "noopener" %>
              <% end %>
              <% if theme.settings.any? %>
                <%= link_to "Customize", edit_settings_theme_design_path(theme.key), class: "ui-button ui-button--outline ui-button--sm" %>
              <% end %>
              <% if plugin && Current.user.can?("settings:write") %>
                <% if Cms::Plugins.switched_on?(plugin) %>
                  <%= button_to "Switch off", settings_plugin_activation_path(plugin.key, from: "themes"), method: :delete, class: "ui-button ui-button--outline ui-button--sm" %>
                <% elsif plugin.compatible? %>
                  <%= button_to "Switch on", settings_plugin_activation_path(plugin.key, from: "themes"), class: "ui-button ui-button--outline ui-button--sm" %>
                <% end %>
              <% end %>
              <% if plugin && source && Current.user.admin? %>
                <%= button_to "Update", settings_plugin_upgrade_path(plugin.key, from: "themes"), class: ui_button_classes(newer ? :default : :outline, size: :sm),
                      title: "Install " + source + "’s latest release in place of this one" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="ui-card__content">
        <div class="ui-empty">
          <p class="ui-empty__description">No theme is installed, so the CMS is headless.</p>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if Current.user.admin? %>
    <%= render "settings/plugins/directory", entries: @directory, kind: "theme", from: "themes" %>

    <%= form_with url: settings_plugins_installations_path(from: "themes"), class: "ui-card" do |form| %>
      <header class="ui-card__header">
        <h2 class="ui-card__title">Or any theme, by its repository</h2>
        <p class="ui-card__description">
          Its GitHub repository: the CMS installs its latest release on this server, where it stays through deploys
          and updates, and restarts. One the directory doesn’t list hasn’t been reviewed: install only code you trust,
          since a plugin runs with the CMS’s full access. Then switch it on here.
        </p>
      </header>
      <div class="ui-card__content row">
        <%= form.text_field :repo, class: "ui-input grow", placeholder: "owner/acme-theme", autocomplete: "off", required: true,
              aria: { label: "GitHub repository" } %>
        <button type="submit" class="ui-button">Install</button>
      </div>
    <% end %>
  <% end %>
<% end %>
