<% @page_title = "Themes" %>

<%= render "layouts/shared/page_header", title: "Themes" %>

<%# While a theme is being installed or updated the page reloads itself
    (refresh), as Settings › Plugins does. %>
<%= tag.div class: "space-y-6", data: ({ controller: "refresh", refresh_interval_value: 5 } if @change) do %>
  <% if @change %>
    <section class="card space-y-2 p-6">
      <h2 class="text-base font-semibold text-foreground"><%= @change.summary %></h2>
      <p class="text-sm text-foreground">The CMS restarts when it’s in place, which takes a few seconds. This page checks every few seconds.</p>
    </section>
  <% end %>

  <section class="card p-6">
    <p class="text-sm text-muted-foreground">
      A theme draws the website at “/” from this install’s content. It’s a plugin: it comes with the install
      (<code>CMS_THEME</code>) or is added below, and updates like one. Without one switched on, the CMS is headless.
    </p>

    <% if @themes.any? %>
      <ul class="mt-4 divide-y divide-border border-t border-border">
        <% @themes.each do |theme| %>
          <%# herb:key theme.key %>
          <% plugin = Cms::Plugins.manifests[theme.key.to_sym] %>
          <% drawing = Website.theme&.key == theme.key && Website.enabled? %>
          <% source = InstalledPlugins.repo(theme.key) %>
          <% newer = UpdateCheck::Plugins.latest_version(theme.key) %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-4">
            <div class="flex min-w-0 flex-col gap-0.5">
              <span class="text-sm font-semibold text-foreground">
                <% if plugin %>
                  <%= link_to theme.name, settings_plugin_path(plugin.key), class: "hover:underline" %>
                <% else %>
                  <%= theme.name %>
                <% end %>
                <span class="ml-1 text-xs font-normal text-muted-foreground"><%= theme.version %><% if source %> · <%= source %><% end %></span>
                <% if newer %>
                  <span class="ml-1 text-xs font-semibold text-primary"><%= newer %> available</span>
                <% end %>
              </span>
              <% if plugin&.description.present? %>
                <span class="text-sm text-muted-foreground"><%= plugin.description %></span>
              <% end %>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <%= status_tag drawing ? "Active" : "Off" %>
              <% if drawing %>
                <%= link_to "View site", root_path, class: "btn", data: {variant: "outline", size: "sm"}, target: "_blank", rel: "noopener" %>
              <% end %>
              <% if theme.settings.any? %>
                <%= link_to "Customize", edit_settings_theme_design_path(theme.key), class: "btn", data: {variant: "outline", size: "sm"} %>
              <% end %>
              <% if plugin && Current.user.can?("settings:write") %>
                <% if Cms::Plugins.switched_on?(plugin) %>
                  <%= button_to "Switch off", settings_plugin_activation_path(plugin.key, from: "themes"), method: :delete, class: "btn", data: {variant: "outline", size: "sm"} %>
                <% elsif plugin.compatible? %>
                  <%= button_to "Switch on", settings_plugin_activation_path(plugin.key, from: "themes"), class: "btn", data: {variant: "outline", size: "sm"} %>
                <% end %>
              <% end %>
              <% if plugin && source && Current.user.admin? %>
                <%= button_to "Update", settings_plugin_upgrade_path(plugin.key, from: "themes"), class: "btn", data: {variant: (newer ? "default" : "outline"), size: "sm"},
                      title: "Install " + source + "’s latest release in place of this one" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="py-12 text-center text-sm text-muted-foreground">No theme is installed, so the CMS is headless.</p>
    <% end %>
  </section>

  <% if Current.user.admin? %>
    <%= render "settings/plugins/directory", entries: @directory, kind: "theme", from: "themes" %>

    <section class="card space-y-3 p-6">
      <h2 class="text-base font-semibold text-foreground">Or any theme, by its repository</h2>
      <p class="text-sm text-muted-foreground">
        Its GitHub repository: the CMS installs its latest release on this server, where it stays through deploys
        and updates, and restarts. One the directory doesn’t list hasn’t been reviewed: install only code you trust,
        since a plugin runs with the CMS’s full access. Then switch it on here.
      </p>
      <%= form_with url: settings_plugins_installations_path(from: "themes"), class: "flex flex-wrap gap-2" do |form| %>
        <%= form.text_field :repo, class: "min-w-0 flex-1", placeholder: "owner/acme-theme", autocomplete: "off", required: true,
              aria: { label: "GitHub repository" } %>
        <button type="submit" class="btn">Install</button>
      <% end %>
    </section>
  <% end %>
<% end %>
