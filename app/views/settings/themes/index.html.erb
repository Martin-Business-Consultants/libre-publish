<% @page_title = "Themes" %>

<%= render "layouts/shared/page_header", title: "Themes" %>

<%# While a theme is being installed or updated the page reloads itself
    (refresh), as Settings › Plugins does. %>
<%= tag.div class: "stack stack--lg", data: ({ controller: "refresh", refresh_interval_value: 5 } if @change) do %>
  <% if @change %>
    <section class="card">
      <h2 class="card__title"><%= @change.summary %></h2>
      <p>The CMS restarts when it’s in place, which takes a few seconds. This page checks every few seconds.</p>
    </section>
  <% end %>

  <section class="card">
    <p class="muted">
      A theme draws the website at “/” from this install’s content. It’s a plugin: it comes with the install
      (<code>CMS_THEME</code>) or is added below, and updates like one. Without one switched on, the CMS is headless.
    </p>

    <% if @themes.any? %>
      <ul class="settings-items">
        <% @themes.each do |theme| %>
          <%# herb:key theme.key %>
          <% plugin = Cms::Plugins.manifests[theme.key.to_sym] %>
          <% drawing = Website.theme&.key == theme.key && Website.enabled? %>
          <% source = InstalledPlugins.repo(theme.key) %>
          <% newer = UpdateCheck::Plugins.latest_version(theme.key) %>
          <li class="settings-item">
            <div class="settings-item__row">
              <div class="settings-item__text">
                <span class="settings-item__name">
                  <% if plugin %>
                    <%= link_to theme.name, settings_plugin_path(plugin.key) %>
                  <% else %>
                    <%= theme.name %>
                  <% end %>
                  <span class="settings-item__meta"><%= theme.version %><% if source %> · <%= source %><% end %></span>
                  <% if newer %>
                    <span class="settings-item__accent"><%= newer %> available</span>
                  <% end %>
                </span>
                <% if plugin&.description.present? %>
                  <span class="settings-item__description"><%= plugin.description %></span>
                <% end %>
              </div>
              <div class="settings-item__actions">
                <%= status_tag drawing ? "Active" : "Off" %>
                <% if drawing %>
                  <%= link_to "View site", root_path, class: "btn btn--secondary btn--sm", target: "_blank", rel: "noopener" %>
                <% end %>
                <% if theme.settings.any? %>
                  <%= link_to "Customize", edit_settings_theme_design_path(theme.key), class: "btn btn--secondary btn--sm" %>
                <% end %>
                <% if plugin && Current.user.can?("settings:write") %>
                  <% if Cms::Plugins.switched_on?(plugin) %>
                    <%= button_to "Switch off", settings_plugin_activation_path(plugin.key, from: "themes"), method: :delete, class: "btn btn--secondary btn--sm" %>
                  <% elsif plugin.compatible? %>
                    <%= button_to "Switch on", settings_plugin_activation_path(plugin.key, from: "themes"), class: "btn btn--secondary btn--sm" %>
                  <% end %>
                <% end %>
                <% if plugin && source && Current.user.admin? %>
                  <%= button_to "Update", settings_plugin_upgrade_path(plugin.key, from: "themes"), class: button_classes(variant: (newer ? :primary : :secondary), size: :sm),
                        title: "Install " + source + "’s latest release in place of this one" %>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty empty--compact">No theme is installed, so the CMS is headless.</p>
    <% end %>
  </section>

  <% if Current.user.admin? %>
    <%= render "settings/plugins/directory", entries: @directory, kind: "theme", from: "themes" if PluginDirectory.enabled? %>

    <section class="card">
      <h2 class="card__title">From GitHub</h2>
      <p class="muted">
        A theme’s GitHub repository: the CMS installs its latest release on this server, where it stays through
        deploys and updates, and restarts. Install only code you trust, since a theme runs with the CMS’s full
        access. Then switch it on here.
      </p>
      <%= form_with url: settings_plugins_installations_path(from: "themes"), class: "settings-install" do |form| %>
        <%= form.text_field :repo, class: "grow", placeholder: "owner/acme-theme", autocomplete: "off", required: true,
              aria: { label: "GitHub repository" } %>
        <button type="submit" class="btn btn--primary">Install</button>
      <% end %>
    </section>
  <% end %>
<% end %>
