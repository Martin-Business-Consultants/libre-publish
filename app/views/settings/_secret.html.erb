<%# locals: (frame_id:, masked:, visible:, reveal_path:, plaintext: nil) %>
<%# A token's secret in a code block: masked until Reveal is clicked (which
    audits the look), then the plaintext with a copy button, swapped into this
    frame. %>
<turbo-frame id="<%= frame_id %>">
  <div class="stack stack--sm">
    <div class="row">
      <% if plaintext %>
        <code class="<%= settings_code_classes("grow") %>"><%= plaintext %></code>
        <%= copy_button plaintext %>
      <% else %>
        <code class="<%= settings_code_classes("grow") %>"><%= masked %></code>
        <% if visible %>
          <%= button_to "Reveal", reveal_path, class: "ui-button ui-button--outline ui-button--sm", form_class: "no-shrink" %>
        <% end %>
      <% end %>
    </div>
    <% if !plaintext && !visible %>
      <p class="ui-field__description">It works, but can't be shown (issued before secrets could be, or encrypted with another install's key) — rotate it to get one you can copy.</p>
    <% end %>
  </div>
</turbo-frame>
