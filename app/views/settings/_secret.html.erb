<%# locals: (frame_id:, masked:, visible:, reveal_path:, plaintext: nil) %>
<%# A token's secret: masked until Reveal is clicked (which audits the look),
    then the plaintext with a copy button, swapped into this frame. %>
<turbo-frame id="<%= frame_id %>">
  <div class="flex flex-wrap items-center gap-2">
    <% if plaintext %>
      <code class="<%= settings_code_classes("min-w-0 flex-1") %>"><%= plaintext %></code>
      <%= copy_button plaintext %>
    <% else %>
      <code class="<%= settings_code_classes("min-w-0 flex-1") %>"><%= masked %></code>
      <% if visible %>
        <%= button_to "Reveal", reveal_path, class: ui(:button, :small) %>
      <% else %>
        <span class="text-xs text-gray-500">It works, but can't be shown (issued before secrets could be, or encrypted with another install's key) — rotate it to get one you can copy.</span>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
