<% @page_title = "Account" %>
<%# Your account on one page (Settings::AccountScreen): where things stand on
    one line, then a section per form in pill tabs (Profile; Sign-in: email,
    password and two-factor; Sessions; Delete account), each section at its
    own anchor, which opens its tab. @failed names the section a failed save
    came from, so only it shows the errors, and its tab opens. %>
<% remaining = @totp.recovery_code_digests.is_a?(Array) ? @totp.recovery_code_digests.size : 0 %>
<% errors_for = ->(section) { render "layouts/shared/errors", record: @user if @failed == section } %>

<% section_classes = "settings-section card" %>

<%= render "layouts/shared/page_header", title: "Account" %>
<% failed_tab = %w[email password two_factor].include?(@failed.to_s) ? "sign-in" : @failed.to_s %>
<div class="stack" data-controller="tabs" data-tabs-initial-value="<%= failed_tab %>">
<p class="button-row small muted">
  <span>Email <%= status_tag(@user.verified? ? "Verified" : "Not verified") %></span>
  <span>Two-factor <%= status_tag(@totp.totp_enabled? ? "Enabled" : "Off") %></span>
  <span>Signed in on <strong><%= pluralize(@sessions.size, "device") %></strong></span>
</p>
<%= render "settings/tabs", tabs: [ [ "profile", "Profile" ], [ "sign-in", "Sign-in" ], [ "sessions", "Sessions" ], [ "delete", "Delete account" ] ] %>

<section id="profile" data-tabs-target="panel" data-tab="profile" class="<%= section_classes %>">
  <div class="card__head"><h2 class="card__title">Profile</h2></div>
  <%= errors_for.("profile") %>
  <%= form_with url: settings_profile_path, method: :patch do |form| %>
    <%= settings_field "Name" do %>
      <%= form.text_field :name, value: @user.name, required: true, autocomplete: "name", placeholder: "Full name" %>
    <% end %>
    <%= settings_field tx("Language"), hint: tx("The admin's own words, for you. Content keeps its own languages.") do %>
      <%= form.select :locale, AdminLocale::LANGUAGES.invert.to_a, { selected: @user.locale, include_blank: tx("The workspace's (%{language})", language: AdminLocale::LANGUAGES[AdminLocale.workspace]) } %>
    <% end %>
    <div><button type="submit" class="btn btn--secondary"><%= tx("Save") %></button></div>
  <% end %>
</section>

<section id="email" data-tabs-target="panel" data-tab="sign-in" class="<%= section_classes %>">
  <div class="card__head">
    <h2 class="card__title">Email</h2>
    <p class="card__hint">The address you sign in with. A new address has to be verified.</p>
  </div>
  <%= errors_for.("email") %>
  <%= form_with url: settings_email_path, method: :patch do |form| %>
    <%= settings_field "Email address" do %>
      <%= form.email_field :email, value: @user.email, required: true, autocomplete: "email" %>
    <% end %>
    <%= settings_field "Current password", hint: "To confirm it’s you." do %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password" %>
    <% end %>
    <div><button type="submit" class="btn btn--secondary">Save email</button></div>
  <% end %>
  <% unless @user.verified? %>
    <div class="button-row">
      <span class="muted">Your email address isn’t verified yet.</span>
      <%= button_to "Resend the verification email", identity_email_verification_path, class: "btn btn--ghost btn--sm" %>
    </div>
  <% end %>
</section>

<section id="password" data-tabs-target="panel" data-tab="sign-in" class="<%= section_classes %>">
  <div class="card__head">
    <h2 class="card__title">Password</h2>
    <p class="card__hint">Use a long, random password to keep your account secure.</p>
  </div>
  <%= errors_for.("password") %>
  <%= form_with url: settings_password_path, method: :patch do |form| %>
    <%= settings_field "Current password" do %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password" %>
    <% end %>
    <%= settings_field "New password", hint: "At least 8 characters." do %>
      <%= form.password_field :password, required: true, autocomplete: "new-password" %>
    <% end %>
    <%= settings_field "Confirm new password" do %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    <% end %>
    <div><button type="submit" class="btn btn--secondary">Save password</button></div>
  <% end %>
</section>

<section id="two-factor" data-tabs-target="panel" data-tab="sign-in" class="<%= section_classes %>">
  <div class="card__head">
    <h2 class="card__title">Two-factor authentication</h2>
    <p class="card__hint">Adds a second step at sign-in: a code from an authenticator app (1Password, Authy, Google Authenticator…).</p>
  </div>

  <% if @recovery_codes.present? %>
    <div class="alert alert--attention stack stack--sm">
      <strong class="alert__title">Save your recovery codes</strong>
      <p>Each code works once, in place of an authenticator code. Store them somewhere safe — this is the only time they’re shown.</p>
      <ul class="grid-2">
        <% @recovery_codes.each do |code| %>
          <%# herb:key code %>
          <li class="<%= settings_code_classes %>"><%= code %></li>
        <% end %>
      </ul>
      <div><%= copy_button @recovery_codes.join("\n"), label: "Copy all" %></div>
    </div>
  <% end %>

  <% if @totp.totp_enabled? %>
    <p class="button-row">
      <%= status_tag "Enabled" %>
      <% if @totp.totp_enabled_at %>
        <span class="muted">since <%= l(@totp.totp_enabled_at, format: :long) %></span>
      <% end %>
    </p>
    <p><%= pluralize(remaining, "recovery code") %> left.</p>

    <div class="row row--top">
      <details>
        <summary class="btn btn--secondary btn--sm">Regenerate recovery codes…</summary>
        <div class="settings-disclosure stack stack--sm">
          <p>Your old codes stop working immediately.</p>
          <%= form_with url: settings_two_factor_recovery_codes_path, class: "stack stack--sm", data: { turbo: false } do |form| %>
            <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", aria: { label: "Your password" } %>
            <div><button type="submit" class="btn btn--secondary btn--sm">Generate new codes</button></div>
          <% end %>
        </div>
      </details>
      <details>
        <summary class="btn btn--danger btn--sm">Disable two-factor…</summary>
        <%= form_with url: settings_two_factor_path, method: :delete, class: "settings-disclosure stack stack--sm" do |form| %>
          <p>Your account will be protected by its password alone.</p>
          <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", aria: { label: "Your password" } %>
          <div><button type="submit" class="btn btn--danger btn--sm">Disable</button></div>
        <% end %>
      </details>
    </div>
  <% elsif @totp.totp_secret.present? %>
    <ol class="bullet-list">
      <li class="stack stack--sm">
        <p>Add this account to your authenticator app — open the link on your phone, or enter the secret by hand.</p>
        <p class="field__label">Secret</p>
        <div class="row">
          <code class="<%= settings_code_classes("grow") %>"><%= @totp.totp_secret %></code>
          <%= copy_button @totp.totp_secret %>
        </div>
        <p class="field__label">otpauth link</p>
        <div class="row">
          <code class="<%= settings_code_classes("grow") %>"><%= @totp.totp_provisioning_uri %></code>
          <%= copy_button @totp.totp_provisioning_uri %>
        </div>
      </li>
      <li>
        <%= form_with url: settings_two_factor_activation_path, class: "stack stack--md", data: { turbo: false } do |form| %>
          <% if @code_error %>
            <p class="field__error"><%= @code_error %></p>
          <% end %>
          <%= settings_field "Enter the 6-digit code from the app" do %>
            <%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9 ]{6,7}", placeholder: "000000", class: "settings-otp" %>
          <% end %>
          <div><button type="submit" class="btn btn--primary">Verify and enable</button></div>
        <% end %>
      </li>
    </ol>
  <% end %>
</section>

<section id="sessions" data-tabs-target="panel" data-tab="sessions" class="settings-section card">
  <div class="card__head">
    <h2 class="card__title">Sessions</h2>
    <p class="card__hint">Everywhere you’re signed in. Signing a session out ends it on that device.</p>
  </div>
  <ul class="divided">
    <% @sessions.each do |session| %>
      <%# herb:key session.id %>
      <li id="<%= dom_id(session) %>" class="row row--between">
        <div class="stack stack--xs grow">
          <span class="truncate strong"><%= session.user_agent.presence || "Unknown device" %></span>
          <span class="muted">
            <%= session.ip_address.presence || "Unknown address" %> · signed in <%= time_ago_tag session.created_at %>
          </span>
        </div>
        <% if session == Current.session %>
          <%= status_tag "This device" %>
        <% else %>
          <%= button_to "Sign out", session_path(session), method: :delete, class: "btn btn--secondary btn--sm" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<section id="delete" data-tabs-target="panel" data-tab="delete" class="<%= section_classes %> card--danger">
  <div class="card__head">
    <h2 class="card__title">Delete account</h2>
    <p class="card__hint">Deletes your account and everything that belongs to it. This can’t be undone.</p>
  </div>
  <%= errors_for.("delete") %>
  <%= tag.details open: @failed == "delete" do %>
    <summary class="btn btn--danger btn--sm">Delete my account…</summary>
    <%= form_with url: settings_profile_path, method: :delete, class: "settings-disclosure" do |form| %>
      <%= settings_field "Your password", hint: "To confirm it’s you." do %>
        <%= form.password_field :password_challenge, required: true, autocomplete: "current-password" %>
      <% end %>
      <div><button type="submit" class="btn btn--danger">Delete account</button></div>
    <% end %>
  <% end %>
</section>
</div>
