<% @page_title = "Account" %>
<%# Your account on one page (Settings::AccountScreen): a card per form,
    each at its own anchor, and a side card with where things stand and links
    down the page. @failed names the section a failed save came from, so only
    it shows the errors. %>
<% remaining = @totp.recovery_code_digests.is_a?(Array) ? @totp.recovery_code_digests.size : 0 %>
<% errors_for = ->(section) { render "layouts/shared/errors", record: @user if @failed == section } %>

<%= render "layouts/shared/page_header", title: "Account" %>
<% content_for :settings_aside do %>
  <section class="ui-card ui-card--sm">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Your account</h2>
    </header>
    <div class="ui-card__content stack">
      <dl class="fact-list">
        <dt>Email</dt>
        <dd><%= status_tag(@user.verified? ? "Verified" : "Not verified") %></dd>
        <dt>Two-factor</dt>
        <dd><%= status_tag(@totp.totp_enabled? ? "Enabled" : "Off") %></dd>
        <dt>Signed in on</dt>
        <dd><%= pluralize(@sessions.size, "device") %></dd>
      </dl>
      <hr class="ui-separator">
      <nav aria-label="On this page">
        <ul class="settings-nav__list">
          <% [["Profile", "profile"], ["Email", "email"], ["Password", "password"], ["Two-factor", "two-factor"], ["Sessions", "sessions"], ["Delete account", "delete"]].each do |label, anchor| %>
            <%# herb:key anchor %>
            <li><a href="#<%= anchor %>" class="settings-nav__link"><%= label %></a></li>
          <% end %>
        </ul>
      </nav>
    </div>
  </section>
<% end %>

<%= form_with url: settings_profile_path, method: :patch, id: "profile", class: "ui-card settings-anchor" do |form| %>
  <header class="ui-card__header">
    <h2 class="ui-card__title">Profile</h2>
    <p class="ui-card__description">How you’re named across the admin, and the language it speaks to you in.</p>
  </header>
  <div class="ui-card__content">
    <div class="ui-fieldset">
      <%= errors_for.("profile") %>
      <%= settings_field "Name" do %>
        <%= form.text_field :name, value: @user.name, required: true, autocomplete: "name", placeholder: "Full name", class: "ui-input" %>
      <% end %>
      <%= settings_field tx("Language"), hint: tx("The admin's own words, for you. Content keeps its own languages.") do %>
        <%= form.select :locale, AdminLocale::LANGUAGES.invert.to_a, { selected: @user.locale, include_blank: tx("The workspace's (%{language})", language: AdminLocale::LANGUAGES[AdminLocale.workspace]) }, { class: "ui-select" } %>
      <% end %>
    </div>
  </div>
  <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
    <button type="submit" class="ui-button ui-button--outline"><%= tx("Save") %></button>
  </footer>
<% end %>

<section id="email" class="ui-card settings-anchor">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Email</h2>
    <p class="ui-card__description">The address you sign in with. A new address has to be verified.</p>
  </header>
  <% unless @user.verified? %>
    <div class="ui-card__content">
      <div class="ui-alert ui-alert--warning" role="status">
        <%= icon_tag "email", class: "ui-alert__icon" %>
        <p class="ui-alert__title">Your email address isn’t verified yet.</p>
        <div class="ui-alert__description">
          <%= button_to "Resend the verification email", identity_email_verification_path, class: "link" %>
        </div>
      </div>
    </div>
  <% end %>
  <%= form_with url: settings_email_path, method: :patch, class: "contents" do |form| %>
    <div class="ui-card__content">
      <div class="ui-fieldset">
        <%= errors_for.("email") %>
        <%= settings_field "Email address" do %>
          <%= form.email_field :email, value: @user.email, required: true, autocomplete: "email", class: "ui-input" %>
        <% end %>
        <%= settings_field "Current password", hint: "To confirm it’s you." do %>
          <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "ui-input" %>
        <% end %>
      </div>
    </div>
    <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
      <button type="submit" class="ui-button ui-button--outline">Save email</button>
    </footer>
  <% end %>
</section>

<%= form_with url: settings_password_path, method: :patch, id: "password", class: "ui-card settings-anchor" do |form| %>
  <header class="ui-card__header">
    <h2 class="ui-card__title">Password</h2>
    <p class="ui-card__description">Use a long, random password to keep your account secure.</p>
  </header>
  <div class="ui-card__content">
    <div class="ui-fieldset">
      <%= errors_for.("password") %>
      <%= settings_field "Current password" do %>
        <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "ui-input" %>
      <% end %>
      <%= settings_field "New password", hint: "At least 8 characters." do %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", class: "ui-input" %>
      <% end %>
      <%= settings_field "Confirm new password" do %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "ui-input" %>
      <% end %>
    </div>
  </div>
  <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
    <button type="submit" class="ui-button ui-button--outline">Save password</button>
  </footer>
<% end %>

<section id="two-factor" class="ui-card settings-anchor">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Two-factor authentication</h2>
    <p class="ui-card__description">Adds a second step at sign-in: a code from an authenticator app (1Password, Authy, Google Authenticator…).</p>
    <% if @totp.totp_enabled? %>
      <div class="ui-card__action"><%= status_tag "Enabled" %></div>
    <% end %>
  </header>
  <div class="ui-card__content stack">
    <% if @recovery_codes.present? %>
      <div class="ui-alert ui-alert--warning" role="status">
        <%= icon_tag "lock", class: "ui-alert__icon" %>
        <p class="ui-alert__title">Save your recovery codes</p>
        <div class="ui-alert__description stack stack--md">
          <p>Each code works once, in place of an authenticator code. Store them somewhere safe — this is the only time they’re shown.</p>
          <ul class="grid grid--2 grid--sm">
            <% @recovery_codes.each do |code| %>
              <%# herb:key code %>
              <li class="<%= settings_code_classes %>"><%= code %></li>
            <% end %>
          </ul>
          <div><%= copy_button @recovery_codes.join("\n"), label: "Copy all" %></div>
        </div>
      </div>
    <% end %>

    <% if @totp.totp_enabled? %>
      <p class="text-muted">
        <% if @totp.totp_enabled_at %>
          On since <%= l(@totp.totp_enabled_at, format: :long) %>.
        <% end %>
        <%= pluralize(remaining, "recovery code") %> left.
      </p>

      <div class="cluster cluster--top">
        <details class="settings-disclosure">
          <summary class="ui-button ui-button--outline ui-button--sm">Regenerate recovery codes…</summary>
          <%= form_with url: settings_two_factor_recovery_codes_path, class: "stack stack--sm stack--start", data: { turbo: false } do |form| %>
            <p class="ui-field__description">Your old codes stop working immediately.</p>
            <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", class: "ui-input", aria: { label: "Your password" } %>
            <button type="submit" class="ui-button ui-button--outline ui-button--sm">Generate new codes</button>
          <% end %>
        </details>
        <details class="settings-disclosure">
          <summary class="ui-button ui-button--destructive ui-button--sm">Disable two-factor…</summary>
          <%= form_with url: settings_two_factor_path, method: :delete, class: "stack stack--sm stack--start" do |form| %>
            <p class="ui-field__description">Your account will be protected by its password alone.</p>
            <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", class: "ui-input", aria: { label: "Your password" } %>
            <button type="submit" class="ui-button ui-button--destructive ui-button--sm">Disable</button>
          <% end %>
        </details>
      </div>
    <% elsif @totp.totp_secret.present? %>
      <ol class="settings-steps">
        <li class="stack stack--sm">
          <p>Add this account to your authenticator app — open the link on your phone, or enter the secret by hand.</p>
          <div class="ui-field">
            <p class="ui-label">Secret</p>
            <div class="row">
              <code class="<%= settings_code_classes("grow") %>"><%= @totp.totp_secret %></code>
              <%= copy_button @totp.totp_secret %>
            </div>
          </div>
          <div class="ui-field">
            <p class="ui-label">otpauth link</p>
            <div class="row">
              <code class="<%= settings_code_classes("grow") %>"><%= @totp.totp_provisioning_uri %></code>
              <%= copy_button @totp.totp_provisioning_uri %>
            </div>
          </div>
        </li>
        <li>
          <%= form_with url: settings_two_factor_activation_path, class: "stack stack--md stack--start", data: { turbo: false } do |form| %>
            <%= settings_field "Enter the 6-digit code from the app" do %>
              <%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9 ]{6,7}", placeholder: "000000", class: "ui-input otp-input", aria: { invalid: (true if @code_error) } %>
              <% if @code_error %>
                <span class="ui-field__error"><%= @code_error %></span>
              <% end %>
            <% end %>
            <button type="submit" class="ui-button">Verify and enable</button>
          <% end %>
        </li>
      </ol>
    <% end %>
  </div>
</section>

<section id="sessions" class="ui-card ui-card--flush settings-anchor">
  <header class="ui-card__header ui-card__header--bordered">
    <h2 class="ui-card__title">Sessions</h2>
    <p class="ui-card__description">Everywhere you’re signed in. Signing a session out ends it on that device.</p>
  </header>
  <ul class="ui-item-group">
    <% @sessions.each do |session| %>
      <%# herb:key session.id %>
      <li id="<%= dom_id(session) %>" class="ui-item">
        <div class="ui-item__content">
          <p class="ui-item__title truncate"><%= session.user_agent.presence || "Unknown device" %></p>
          <p class="ui-item__description">
            <%= session.ip_address.presence || "Unknown address" %> · signed in <%= time_ago_tag session.created_at %>
          </p>
        </div>
        <div class="ui-item__actions">
          <% if session == Current.session %>
            <%= status_tag "This device" %>
          <% else %>
            <%= button_to "Sign out", session_path(session), method: :delete, class: "ui-button ui-button--outline ui-button--sm" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</section>

<section id="delete" class="ui-card danger-card settings-anchor">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Delete account</h2>
    <p class="ui-card__description">Deletes your account and everything that belongs to it. This can’t be undone.</p>
  </header>
  <div class="ui-card__content stack">
    <%= errors_for.("delete") %>
    <%= tag.details class: "settings-disclosure", open: @failed == "delete" do %>
      <summary class="ui-button ui-button--destructive ui-button--sm">Delete my account…</summary>
      <%= form_with url: settings_profile_path, method: :delete, class: "ui-fieldset" do |form| %>
        <%= settings_field "Your password", hint: "To confirm it’s you." do %>
          <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "ui-input" %>
        <% end %>
        <div><button type="submit" class="ui-button ui-button--destructive">Delete account</button></div>
      <% end %>
    <% end %>
  </div>
</section>
