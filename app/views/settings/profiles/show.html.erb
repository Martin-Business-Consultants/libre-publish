<% @page_title = "Account" %>
<%# Your account on one page (Settings::AccountScreen): a section per form,
    each at its own anchor, and a sidebar with where things stand and links
    down the page. @failed names the section a failed save came from, so only
    it shows the errors. %>
<% remaining = @totp.recovery_code_digests.is_a?(Array) ? @totp.recovery_code_digests.size : 0 %>
<% errors_for = ->(section) { render "layouts/shared/errors", record: @user if @failed == section } %>

<% section_classes = "scroll-mt-20 space-y-5 p-6" %>
<% on_page_link_classes = "block rounded-md px-2 py-1 text-sm text-foreground hover:bg-accent hover:text-foreground" %>

<%= render "layouts/shared/page_header", title: "Account" %>
<% content_for :settings_aside do %>
  <%= postbox "account-summary", "Your account" do %>
    <ul class="space-y-2 text-sm">
      <li class="flex items-center justify-between gap-2"><span class="text-muted-foreground">Email</span> <%= status_tag(@user.verified? ? "Verified" : "Not verified") %></li>
      <li class="flex items-center justify-between gap-2"><span class="text-muted-foreground">Two-factor</span> <%= status_tag(@totp.totp_enabled? ? "Enabled" : "Off") %></li>
      <li class="flex items-center justify-between gap-2"><span class="text-muted-foreground">Signed in on</span> <strong class="font-medium text-foreground"><%= pluralize(@sessions.size, "device") %></strong></li>
    </ul>
    <nav aria-label="On this page">
      <ul>
        <% [["Profile", "profile"], ["Email", "email"], ["Password", "password"], ["Two-factor", "two-factor"], ["Sessions", "sessions"], ["Delete account", "delete"]].each do |label, anchor| %>
          <%# herb:key anchor %>
          <li><a href="#<%= anchor %>" class="<%= on_page_link_classes %>"><%= label %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>

<section id="profile" class="card <%= section_classes %>">
  <h2 class="text-base font-semibold text-foreground">Profile</h2>
  <%= errors_for.("profile") %>
  <%= form_with url: settings_profile_path, method: :patch, class: "space-y-5" do |form| %>
    <%= settings_field "Name" do %>
      <%= form.text_field :name, value: @user.name, required: true, autocomplete: "name", placeholder: "Full name", class: "w-full" %>
    <% end %>
    <%= settings_field tx("Language"), hint: tx("The admin's own words, for you. Content keeps its own languages.") do %>
      <%= form.select :locale, AdminLocale::LANGUAGES.invert.to_a, { selected: @user.locale, include_blank: tx("The workspace's (%{language})", language: AdminLocale::LANGUAGES[AdminLocale.workspace]) }, class: "w-full" %>
    <% end %>
    <div><button type="submit" class="btn" data-variant="outline"><%= tx("Save") %></button></div>
  <% end %>
</section>

<section id="email" class="card <%= section_classes %>">
  <div class="space-y-1">
    <h2 class="text-base font-semibold text-foreground">Email</h2>
    <p class="text-sm text-muted-foreground">The address you sign in with. A new address has to be verified.</p>
  </div>
  <%= errors_for.("email") %>
  <%= form_with url: settings_email_path, method: :patch, class: "space-y-5" do |form| %>
    <%= settings_field "Email address" do %>
      <%= form.email_field :email, value: @user.email, required: true, autocomplete: "email", class: "w-full" %>
    <% end %>
    <%= settings_field "Current password", hint: "To confirm it’s you." do %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "w-full" %>
    <% end %>
    <div><button type="submit" class="btn" data-variant="outline">Save email</button></div>
  <% end %>
  <% unless @user.verified? %>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class="text-muted-foreground">Your email address isn’t verified yet.</span>
      <%= button_to "Resend the verification email", identity_email_verification_path, class: "font-medium text-primary underline underline-offset-2 text-sm" %>
    </div>
  <% end %>
</section>

<section id="password" class="card <%= section_classes %>">
  <div class="space-y-1">
    <h2 class="text-base font-semibold text-foreground">Password</h2>
    <p class="text-sm text-muted-foreground">Use a long, random password to keep your account secure.</p>
  </div>
  <%= errors_for.("password") %>
  <%= form_with url: settings_password_path, method: :patch, class: "space-y-5" do |form| %>
    <%= settings_field "Current password" do %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "w-full" %>
    <% end %>
    <%= settings_field "New password", hint: "At least 8 characters." do %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "w-full" %>
    <% end %>
    <%= settings_field "Confirm new password" do %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full" %>
    <% end %>
    <div><button type="submit" class="btn" data-variant="outline">Save password</button></div>
  <% end %>
</section>

<section id="two-factor" class="card <%= section_classes %>">
  <div class="space-y-1">
    <h2 class="text-base font-semibold text-foreground">Two-factor authentication</h2>
    <p class="text-sm text-muted-foreground">Adds a second step at sign-in: a code from an authenticator app (1Password, Authy, Google Authenticator…).</p>
  </div>

  <% if @recovery_codes.present? %>
    <div class="space-y-3 rounded-lg border border-yellow-200 bg-yellow-50 p-4">
      <h3 class="text-sm font-semibold text-foreground">Save your recovery codes</h3>
      <p class="text-sm text-foreground">Each code works once, in place of an authenticator code. Store them somewhere safe — this is the only time they’re shown.</p>
      <ul class="grid grid-cols-2 gap-2">
        <% @recovery_codes.each do |code| %>
          <%# herb:key code %>
          <li class="<%= settings_code_classes %>"><%= code %></li>
        <% end %>
      </ul>
      <div><%= copy_button @recovery_codes.join("\n"), label: "Copy all" %></div>
    </div>
  <% end %>

  <% if @totp.totp_enabled? %>
    <p class="flex flex-wrap items-center gap-2 text-sm">
      <%= status_tag "Enabled" %>
      <% if @totp.totp_enabled_at %>
        <span class="text-muted-foreground">since <%= l(@totp.totp_enabled_at, format: :long) %></span>
      <% end %>
    </p>
    <p class="text-sm text-foreground"><%= pluralize(remaining, "recovery code") %> left.</p>

    <div class="flex flex-wrap items-start gap-2">
      <details>
        <summary class="btn" data-variant="outline" data-size="sm">Regenerate recovery codes…</summary>
        <div class="mt-3 space-y-2">
          <p class="text-sm text-foreground">Your old codes stop working immediately.</p>
          <%= form_with url: settings_two_factor_recovery_codes_path, class: "space-y-2", data: { turbo: false } do |form| %>
            <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", class: "w-full", aria: { label: "Your password" } %>
            <button type="submit" class="btn" data-variant="outline" data-size="sm">Generate new codes</button>
          <% end %>
        </div>
      </details>
      <details>
        <summary class="btn text-destructive" data-variant="outline" data-size="sm">Disable two-factor…</summary>
        <%= form_with url: settings_two_factor_path, method: :delete, class: "mt-3 space-y-2" do |form| %>
          <p class="text-sm text-foreground">Your account will be protected by its password alone.</p>
          <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", placeholder: "Your password", class: "w-full", aria: { label: "Your password" } %>
          <button type="submit" class="btn text-destructive" data-variant="outline" data-size="sm">Disable</button>
        <% end %>
      </details>
    </div>
  <% elsif @totp.totp_secret.present? %>
    <ol class="list-decimal space-y-5 pl-5 text-sm text-foreground">
      <li class="space-y-2">
        <p>Add this account to your authenticator app — open the link on your phone, or enter the secret by hand.</p>
        <p class="label">Secret</p>
        <div class="flex items-center gap-2">
          <code class="<%= settings_code_classes("min-w-0 flex-1") %>"><%= @totp.totp_secret %></code>
          <%= copy_button @totp.totp_secret %>
        </div>
        <p class="label">otpauth link</p>
        <div class="flex items-center gap-2">
          <code class="<%= settings_code_classes("min-w-0 flex-1") %>"><%= @totp.totp_provisioning_uri %></code>
          <%= copy_button @totp.totp_provisioning_uri %>
        </div>
      </li>
      <li>
        <%= form_with url: settings_two_factor_activation_path, class: "space-y-3", data: { turbo: false } do |form| %>
          <% if @code_error %>
            <p class="text-sm text-red-600"><%= @code_error %></p>
          <% end %>
          <%= settings_field "Enter the 6-digit code from the app" do %>
            <%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9 ]{6,7}", placeholder: "000000", class: "w-40 font-mono" %>
          <% end %>
          <div><button type="submit" class="btn">Verify and enable</button></div>
        <% end %>
      </li>
    </ol>
  <% end %>
</section>

<section id="sessions" class="card scroll-mt-20 space-y-2 p-6">
  <div class="space-y-1">
    <h2 class="text-base font-semibold text-foreground">Sessions</h2>
    <p class="text-sm text-muted-foreground">Everywhere you’re signed in. Signing a session out ends it on that device.</p>
  </div>
  <ul class="divide-y divide-border">
    <% @sessions.each do |session| %>
      <%# herb:key session.id %>
      <li id="<%= dom_id(session) %>" class="flex items-center justify-between gap-4 py-3">
        <div class="flex min-w-0 flex-col text-sm">
          <span class="truncate font-medium text-foreground"><%= session.user_agent.presence || "Unknown device" %></span>
          <span class="text-muted-foreground">
            <%= session.ip_address.presence || "Unknown address" %> · signed in <%= time_ago_tag session.created_at %>
          </span>
        </div>
        <% if session == Current.session %>
          <%= status_tag "This device" %>
        <% else %>
          <%= button_to "Sign out", session_path(session), method: :delete, class: "btn", data: {variant: "outline", size: "sm"} %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<section id="delete" class="scroll-mt-20 space-y-5 rounded-xl border border-red-200 bg-background p-6">
  <div class="space-y-1">
    <h2 class="text-base font-semibold text-red-700">Delete account</h2>
    <p class="text-sm text-muted-foreground">Deletes your account and everything that belongs to it. This can’t be undone.</p>
  </div>
  <%= errors_for.("delete") %>
  <%= tag.details open: @failed == "delete" do %>
    <summary class="btn text-destructive" data-variant="outline" data-size="sm">Delete my account…</summary>
    <%= form_with url: settings_profile_path, method: :delete, class: "mt-4 space-y-5" do |form| %>
      <%= settings_field "Your password", hint: "To confirm it’s you." do %>
        <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", class: "w-full" %>
      <% end %>
      <button type="submit" class="btn text-destructive" data-variant="outline">Delete account</button>
    <% end %>
  <% end %>
</section>
