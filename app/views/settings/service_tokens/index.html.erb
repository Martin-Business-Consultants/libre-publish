<% @page_title = "Service tokens" %>
<% can_manage = Current.user.can?("settings:write") %>

<%= render "layouts/shared/page_header", title: "Service tokens" %>

<section class="panel panel--padded stack">
  <p class="text-muted">Credentials for machines — a published site, a build, an agent. They belong to this workspace rather than to a person, so rotating your own token or changing your role can’t take production down.</p>

  <div class="stack stack--sm text-body">
    <strong class="text-semibold text-ink">Which token goes where</strong>
    <ul class="bullet-list">
      <li>The published site — its <code>CMS_API_TOKEN</code>. Issue it against <strong>Production site</strong> (read-only): the site renders, it never edits, so a leaked secret reads only what the site already shows the world.</li>
      <li><code>USER_AGENT_TOKEN</code> — agents and scripts. Issue it against <strong>Agent</strong> (writes drafts, never publishes): changing live content or publishing is refused, and with the Approvals plugin every change waits for a person.</li>
    </ul>
  </div>

  <% unless can_manage %>
    <p class="text-muted">Your role can see these tokens but not issue, reveal or change them (that needs settings:write).</p>
  <% end %>
</section>

<% if can_manage %>
  <section class="panel panel--padded fields">
    <h2 class="heading">Issue a token</h2>
    <%= form_with url: settings_service_tokens_path, class: "fields" do |form| %>
      <div class="grid grid--2 fields-grid">
        <%= settings_field "Name" do %>
          <%= form.text_field :name, required: true, placeholder: "Production site" %>
        <% end %>
        <%= settings_field "Role" do %>
          <%= form.select :role_id, @roles.map { |role| [role.name, role.id] }, { include_blank: "Pick a role" }, required: true %>
        <% end %>
      </div>
      <%= settings_field "What it’s for (optional)" do %>
        <%= form.text_field :description, placeholder: "Cloudflare — robinsonfirm.com" %>
      <% end %>
      <div><button type="submit" class="btn btn--primary">Issue token</button></div>
    <% end %>
  </section>
<% end %>

<section class="panel panel--padded stack stack--sm">
  <h2 class="heading">Live</h2>
  <% if @live.any? %>
    <ul class="divided">
      <% @live.each do |token| %>
        <%# herb:key token.id %>
        <%= render "settings/service_tokens/service_token", service_token: token, can_manage: can_manage %>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No service tokens yet.</p>
  <% end %>
</section>

<% if @revoked.any? %>
  <section class="panel panel--padded stack stack--sm">
    <h2 class="heading">Revoked</h2>
    <ul class="divided">
      <% @revoked.each do |token| %>
        <%# herb:key token.id %>
        <%= render "settings/service_tokens/service_token", service_token: token, can_manage: can_manage %>
      <% end %>
    </ul>
  </section>
<% end %>
