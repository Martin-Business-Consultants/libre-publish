<%# locals: (service_token:, can_manage:) %>
<%# One service token, as an item: its name, role and use, its Rotate and
    Revoke, and under them its secret (to reveal) and what it can do. %>
<li id="<%= dom_id(service_token) %>" class="ui-item">
  <div class="ui-item__content">
    <p class="ui-item__title">
      <%= service_token.name %>
      <% if service_token.role %>
        <%= status_tag service_token.role.name %>
      <% end %>
      <% if service_token.revoked? %>
        <%= status_tag "Revoked" %>
      <% end %>
    </p>
    <% if service_token.description.present? %>
      <p class="ui-item__description"><%= service_token.description %></p>
    <% end %>
    <p class="ui-item__description">
      <% if service_token.last_used_at %>
        Last used <%= time_ago_tag service_token.last_used_at %><% if service_token.last_used_ip.present? %> from <%= service_token.last_used_ip %><% end %>
      <% else %>
        Never used
      <% end %>
      · created <%= time_ago_tag service_token.created_at %><% if service_token.created_by %> by <%= service_token.created_by.email %><% end %>
    </p>
  </div>
  <% if can_manage && !service_token.revoked? %>
    <div class="ui-item__actions">
      <%= render "layouts/shared/confirm_dialog", label: "Rotate", title: "Rotate “" + service_token.name + "”?",
            message: "The current secret stops working immediately.", path: settings_service_token_rotation_path(service_token), button: "Rotate" %>
      <%= render "layouts/shared/confirm_dialog", label: "Revoke", title: "Revoke “" + service_token.name + "”?",
            message: "Anything using it stops working immediately.", path: settings_service_token_revocation_path(service_token),
            button: "Revoke", negative: true %>
    </div>
  <% end %>

  <div class="service-token__details">
    <% if can_manage && !service_token.revoked? %>
      <%= render "settings/secret", frame_id: dom_id(service_token, :secret), masked: service_token.masked,
            visible: service_token.visible?, reveal_path: settings_service_token_reveal_path(service_token) %>
    <% else %>
      <code class="<%= settings_code_classes %>"><%= service_token.masked %></code>
    <% end %>
    <% if service_token.capabilities.any? %>
      <p class="ui-item__description text-mono text-small"><%= service_token.capabilities.join(", ") %></p>
    <% end %>
  </div>
</li>
