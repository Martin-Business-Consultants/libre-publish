<% @page_title = "Settings" %>

<%= render "layouts/shared/page_header", title: "Settings" %>

<p class="text-muted">
  CMS <%= cms_version %>
  <% if UpdateCheck.update_available? %>
    · <strong class="text-semibold text-ink"><%= tx("Version %{version} is available.", version: UpdateCheck.latest_version) %></strong>
    <%= link_to tx("What’s new"), UpdateCheck.release_url || UpdateCheck.changelog_url, class: "link", rel: "noopener" %>
    <% if Current.user.can?("settings:read") %>
      · <%= link_to tx("Update in Settings › Updates"), settings_updates_path, class: "link" %>
    <% end %>
  <% end %>
</p>

<% settings_sections.each do |group, links| %>
  <%# herb:key group %>
  <section class="stack stack--md">
    <h2 class="heading"><%= tx(group) %></h2>
    <ul class="grid grid--2">
      <% links.each do |text, path, description| %>
        <%# herb:key path %>
        <li>
          <%= link_to path, class: "panel settings-card" do %>
            <span class="settings-card__name"><%= tx(text) %></span>
            <span class="settings-card__description"><%= tx(description.to_s) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
