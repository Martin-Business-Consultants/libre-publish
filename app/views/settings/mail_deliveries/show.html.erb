<% @page_title = "Email delivery" %>
<% can_write = Current.user.can?("settings:write") %>

<%= render "layouts/shared/page_header", title: "Email delivery" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "mail_delivery_form", capability: "settings:write" %>
<% end %>

<%= form_with url: settings_mail_delivery_path, id: "mail_delivery_form", method: :patch, scope: :mail_delivery do |form| %>
  <%= tag.fieldset class: "stack stack--lg", disabled: !can_write do %>
    <section class="ui-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">SMTP server</h2>
        <p class="ui-card__description">The server every email from the site goes through: form notifications and confirmations, password resets, collection notifications. Leave the host empty to use this install’s own. Who email comes from is set in Settings › Forms.</p>
      </header>
      <div class="ui-card__content">
        <div class="ui-fieldset">
          <div class="ui-field-row">
            <%= settings_field "Host" do %>
              <%= form.text_field :address, value: @settings["address"], class: "ui-input text-mono", placeholder: "smtp.example.com", autocomplete: "off" %>
            <% end %>
            <%= settings_field "Port", hint: "Blank uses the usual port for the encryption." do %>
              <%= form.number_field :port, value: @settings["port"], placeholder: "587", min: 1, max: 65535, class: "ui-input" %>
            <% end %>
          </div>
          <%= settings_field "Encryption" do %>
            <%= form.select :security, MailDelivery::SECURITY.invert.to_a, { selected: @settings["security"] }, { class: "ui-select" } %>
          <% end %>
          <div class="ui-field-row">
            <%= settings_field "Username" do %>
              <%= form.text_field :user_name, value: @settings["user_name"], autocomplete: "off", data: { "1p-ignore": true }, class: "ui-input" %>
            <% end %>
            <% password_placeholder = @password_set ? "Saved — leave blank to keep" : "" %>
            <%= settings_field "Password" do %>
              <%= form.password_field :password, autocomplete: "new-password", placeholder: password_placeholder, data: { "1p-ignore": true }, class: "ui-input" %>
            <% end %>
          </div>
          <%= settings_field "Sign-in method" do %>
            <%= form.select :authentication, MailDelivery::AUTHENTICATIONS.invert.to_a, { selected: @settings["authentication"].presence || "plain" }, { class: "ui-select" } %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
<% end %>

<% if can_write %>
  <section class="ui-card">
    <header class="ui-card__header">
      <h2 class="ui-card__title">Send a test email</h2>
      <p class="ui-card__description">To <%= Current.user.email %>, through the server saved above. Save your changes first.</p>
      <div class="ui-card__action">
        <%= button_to "Send test email", settings_mail_delivery_test_path, class: "ui-button ui-button--outline ui-button--sm" %>
      </div>
    </header>
  </section>
<% end %>
