<% @page_title = "Deploy" %>
<% log = Array(@settings["log"]) %>
<% build = Frontend.last_build %>
<% writable = Current.user.can?("settings:write") %>
<% scheduled = @settings["scheduled_at"].present? && @settings["last_status"] != "scheduled" && Time.zone.parse(@settings["scheduled_at"].to_s).to_i > 90.seconds.ago.to_i %>

<%= render "layouts/shared/page_header", title: "Deploy" %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "settings_form" %>
<% end %>


<section class="<%= ui(:panel, "space-y-5 p-6") %>">
  <p class="text-sm text-gray-500">When content is published or updated, the CMS asks the site to rebuild — or, for a site that renders on demand, to drop what changed from its cache. Edits are debounced for 60s so a burst of changes produces one deploy.</p>

  <%= form_with url: settings_deploy_path, id: "settings_form", method: :patch, scope: :settings do |form| %>
    <%= tag.fieldset class: "space-y-5", disabled: !Current.user.can?("settings:write") do %>
      <%= settings_field "Provider", hint: "GitHub sends a repository_dispatch (type “cms-publish”) to the repository in Settings › GitHub, using its token; the site’s workflow builds on it. A build hook is a URL the CMS POSTs to." do %>
        <%= form.select :provider, Deploys.providers.map { |key, provider| [provider.label, key] }, { selected: @provider.key }, class: "w-full" %>
      <% end %>
      <% if @provider.key == "github" %>
        <p class="text-sm text-gray-700">
          <% if @provider.configured? %>
            Builds go to <span class="font-mono"><%= @provider.target %></span>.
          <% else %>
            Set the repository and a token in <%= link_to "Settings › GitHub", settings_github_path, class: ui(:link) %> first.
          <% end %>
        </p>
      <% end %>
      <%= settings_field "Deploy hook URL", hint: "For Cloudflare: Pages › your project › Settings › Builds › Deploy hooks, or Workers › your worker › Settings › Build › Deploy hooks. For a build hook: the same idea on Vercel and Netlify." do %>
        <%= form.url_field :url, value: @settings["url"], autocomplete: "off", placeholder: "https://api.cloudflare.com/client/v4/pages/.../deploy_hooks/...", class: "w-full font-mono" %>
      <% end %>
      <%= settings_switch form, :paused, "Pause auto-deploys", checked: @settings["paused"] == true,
            hint: "Stop firing the hook on content changes. Useful while you’re doing a big edit-pass and don’t want every save to trigger a build." %>
    <% end %>
  <% end %>

  <% if Deploys.ready?(@settings) %>
    <% if writable %>
      <div><%= button_to "Deploy now", settings_deploy_trigger_path, class: ui(:button) %></div>
    <% end %>
  <% end %>
</section>

<section id="site" class="<%= ui(:panel, "scroll-mt-20 space-y-4 p-6") %>">
  <h2 class="<%= ui(:heading) %>">The site</h2>
  <% if build %>
    <p class="text-sm text-gray-700">
      <% case Frontend.render %>
      <% when "server" %>
        The site renders on demand, so publishing sends it a cache purge for what changed rather than rebuilding it.
      <% when "hybrid" %>
        The site prerenders some pages and renders the rest on demand: publishing rebuilds it and purges what changed.
      <% when "static" %>
        The site renders statically, so publishing rebuilds it.
      <% else %>
        The site hasn’t said how it renders, so publishing rebuilds it.
      <% end %>
    </p>
    <p class="text-sm text-gray-500">
      Last build <%= time_ago_tag build[:built_at] %>
      <% if build[:integration] %> · <%= build[:integration] %> <%= build[:integration_version] %><% end %>
      <% if build[:content_cursor] %> · built from content <span class="font-mono"><%= build[:content_cursor].first(16) %></span><% end %>
    </p>
    <% if (pending = Frontend.pending_delivery) %>
      <div class="space-y-2 rounded-lg border border-yellow-200 bg-yellow-50 p-4 text-sm">
        <p>
          The last build says the site renders <strong><%= pending["render"] || "without saying how" %></strong><% if pending["webhook_url"] %>
          and takes purges at <span class="font-mono"><%= pending["webhook_url"] %></span><% end %>.
          That changes how publishing reaches the site, so it waits for approval: a build’s token can’t change it on its own.
        </p>
        <% if writable %>
          <div><%= button_to "Approve", settings_deploy_delivery_approval_path, class: ui(:button, :small), form: { data: { turbo_confirm: "Publishing will follow what the site reported. Approve?" } } %></div>
        <% end %>
      </div>
    <% end %>
    <% if Frontend.purge_url %>
      <p class="text-sm text-gray-700">Purges go to <span class="font-mono"><%= Frontend.purge_url %></span>, signed with this secret — the site’s <code>CMS_WEBHOOK_SECRET</code>:</p>
      <% if writable %>
        <%= render "settings/secret", frame_id: "purge_secret", masked: "•" * 24, visible: true, reveal_path: settings_deploy_purge_secret_reveal_path %>
        <div><%= button_to "Rotate the secret", settings_deploy_purge_secret_rotation_path, class: ui(:button, :small), form: { data: { turbo_confirm: "The site needs the new secret before it accepts another purge. Rotate it?" } } %></div>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-500">No build has reported yet. The Astro integration reports each build, and with it whether the site renders statically or on demand.</p>
  <% end %>
</section>

<section class="<%= ui(:panel, "space-y-4 p-6") %>">
  <div class="space-y-1">
    <h2 class="<%= ui(:heading) %>">Recent activity</h2>
    <p class="text-sm text-gray-500">Last 20 deploy attempts. A scheduled entry means an edit just happened — the hook fires after the debounce window.</p>
  </div>
  <% if log.empty? && !scheduled %>
    <p class="py-6 text-center text-sm text-gray-500">Nothing yet.</p>
  <% else %>
    <ul class="divide-y divide-gray-100 text-sm">
      <% if scheduled %>
        <li class="py-2.5"><%= status_tag "scheduled" %><% if @settings["last_reason"].present? %> <span class="text-gray-500">· <%= @settings["last_reason"] %></span><% end %></li>
      <% end %>
      <% log.each_with_index do |entry, index| %>
        <%# herb:key index %>
        <li class="flex flex-col gap-1 py-2.5">
          <span>
            <%= status_tag entry["status"].to_s %>
            <% if entry["reason"].present? %><span class="text-gray-500"> · <%= entry["reason"] %></span><% end %>
            <% if entry["via"].present? %><span class="text-gray-500"> · <%= entry["via"] == "purge" ? "purge" : "build" %></span><% end %>
            <% if entry["changes"].to_i.positive? %><span class="text-gray-500"> · <%= pluralize(entry["changes"], "change") %></span><% end %>
            <% if entry["http_status"] %><span class="text-gray-500"> · HTTP <%= entry["http_status"] %></span><% end %>
            <% if entry["duration_ms"] %><span class="text-gray-500"> · <%= entry["duration_ms"] %>ms</span><% end %>
            <span class="text-gray-500"> · <%= entry["at"].present? ? time_ago_tag(Time.zone.parse(entry["at"].to_s)) : "—" %></span>
          </span>
          <% if entry["error"].present? %>
            <span class="truncate text-xs text-red-600"><%= entry["error"] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
