<% @page_title = "History" %>
<%= render "layouts/shared/page_header", title: "Settings history",
      description: "Every change to General, Branding, Search, Forms and Email delivery, newest first. Open one to compare it with now and restore it. Secrets are never kept." %>

<nav class="mb-4 flex flex-wrap gap-1.5" aria-label="Setting">
  <%= link_to "All", settings_histories_path, class: "btn", data: {variant: "outline", size: "sm"}, aria: { current: (@key.nil? ? "page" : nil) } %>
  <% SettingVersion::VERSIONED.each do |key, label| %>
    <%# herb:key key %>
    <%= link_to label, settings_histories_path(key: key), class: "btn", data: {variant: "outline", size: "sm"}, aria: { current: (@key == key ? "page" : nil) } %>
  <% end %>
</nav>

<section class="card overflow-x-auto">
  <table class="data-table table">
    <thead>
      <tr class="table-row">
        <th class="table-head">Saved</th>
        <th class="table-head">Setting</th>
        <th class="table-head">By</th>
      </tr>
    </thead>
    <tbody>
      <% @versions.each do |version| %>
        <%# herb:key version.id %>
        <tr class="table-row hover:bg-muted">
          <td class="table-cell"><%= link_to site_time_tag(version.created_at), settings_history_path(version), class: "font-medium text-foreground hover:underline" %></td>
          <td class="table-cell"><%= version.label %></td>
          <td class="table-cell"><span class="text-muted-foreground"><%= version.author&.name.presence || version.author&.email || "—" %></span></td>
        </tr>
      <% end %>
      <%= table_empty_row("No changes kept yet.", columns: 3) if @versions.empty? %>
    </tbody>
  </table>
</section>
<%= pagination_nav @pagination %>
