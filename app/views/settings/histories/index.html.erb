<% @page_title = "History" %>
<%= render "layouts/shared/page_header", title: "Settings history",
      description: "Every change to General, Branding, Search, Forms and Email delivery, newest first. Open one to compare it with now and restore it. Secrets are never kept." %>

<nav class="ui-tabs" aria-label="Setting">
  <%= link_to "All", settings_histories_path, class: "ui-tabs__trigger", aria: { current: (@key.nil? ? "page" : nil) } %>
  <% SettingVersion::VERSIONED.each do |key, label| %>
    <%# herb:key key %>
    <%= link_to label, settings_histories_path(key: key), class: "ui-tabs__trigger", aria: { current: (@key == key ? "page" : nil) } %>
  <% end %>
</nav>

<%= render "ui/data_table", id: "setting_versions",
      columns: [ ui_column(:saved, "Saved", hideable: false), ui_column(:setting, "Setting"), ui_column(:author, "By") ],
      rows: @versions, row: "settings/histories/version", as: :version, pagination: @pagination,
      empty: "No changes kept yet." %>
