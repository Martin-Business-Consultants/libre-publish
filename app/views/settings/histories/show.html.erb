<% @page_title = "History" %>
<%= parent_page "History", settings_histories_path %>
<%= render "layouts/shared/page_header", title: "Compare a version of " + @version.label %>
<section class="ui-card">
  <div class="ui-card__content">
    <%= render "versions/comparison", version: @version, restore_path: restore_settings_history_path(@version),
          can_restore: Current.user.can?("settings:write") %>
  </div>
</section>
