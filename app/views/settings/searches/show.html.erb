<% @page_title = "Search" %>

<%= render "layouts/shared/page_header", title: "Search",
      description: "How search engines and AI answer engines find, read and describe this site." %>

<div class="measure--lg stack stack--lg">
  <section class="panel panel--padded stack stack--md">
    <h2 class="heading">What the site already does</h2>
    <ul class="bullet-list">
      <li>Every page has a canonical address, its title and description, Open Graph and Twitter tags, and its translations (hreflang).</li>
      <li>Structured data (schema.org) is made from the content: who you are, the site, each page or article, and its breadcrumbs.</li>
      <li><%= link_to "/sitemap.xml", "#{@base_url}/sitemap.xml", class: "link" %> lists every published page and entry, with their translations.</li>
      <li><%= link_to "/llms.txt", "#{@base_url}/llms.txt", class: "link" %> and a Markdown copy of each page (add <code>.md</code> to its address) give AI readers the content without the design.</li>
      <li><%= link_to "/robots.txt", "#{@base_url}/robots.txt", class: "link" %> keeps the admin and the API out, and points to the sitemap.</li>
    </ul>
  </section>

  <%= form_with url: settings_search_path, method: :patch, scope: :search, class: "stack stack--lg" do |form| %>
    <section class="panel panel--padded fields">
      <div class="stack stack--xs">
        <h2 class="heading">AI crawlers</h2>
        <p class="help">
          Search engines (Google, Bing) always crawl the site. These choose which AI services may read it, by what they do.
        </p>
      </div>
      <%= settings_field "AI answer engines", hint: "ChatGPT search, Perplexity, Claude and others that answer questions by citing and linking to sites: " + SearchSettings::AI_SEARCH_BOTS.join(", ") + ". Blocking them keeps the site out of their answers." do %>
        <%= form.select :ai_search, [["Allow (recommended)", "allow"], ["Block", "block"]], { selected: @search["ai_search"] } %>
      <% end %>
      <%= settings_field "AI model training", hint: "Crawlers that gather text to train AI models: " + SearchSettings::AI_TRAINING_BOTS.join(", ") + ". Blocking them doesn't affect search or answer engines." do %>
        <%= form.select :ai_training, [["Allow", "allow"], ["Block", "block"]], { selected: @search["ai_training"] } %>
      <% end %>
    </section>

    <section class="panel panel--padded fields">
      <div class="stack stack--xs">
        <h2 class="heading">Who the site is</h2>
        <p class="help">
          Search engines and AI tie what they say about you to this. The name, description and contact details come from
          Settings › General, the logo from Branding.
        </p>
      </div>
      <%= settings_field "The site is", hint: "A local business shows its address from Settings › General." do %>
        <%= form.select :organization, [["An organization", "Organization"], ["A local business", "LocalBusiness"], ["A person", "Person"]], { selected: @search["organization"] } %>
      <% end %>
      <%= settings_field "Profiles elsewhere", hint: "One address a line: LinkedIn, Instagram, Facebook, Google Business, Wikipedia…" do %>
        <%= form.text_area :same_as, value: @search["same_as"].join("\n"), rows: 4, placeholder: "https://www.linkedin.com/company/…" %>
      <% end %>
    </section>

    <section class="panel panel--padded fields">
      <label class="choice choice--top text-ink">
        <%= form.check_box :indexnow, { checked: @search["indexnow"] != false }, "1", "0" %>
        <span>
          Tell search engines the moment a page is published, changed or taken down (IndexNow: Bing, which ChatGPT
          search draws on, Yandex and others), instead of waiting to be crawled.
        </span>
      </label>
      <%= settings_field "More for robots.txt", hint: "Added as written, for a crawler or a path the choices above don’t cover." do %>
        <%= form.text_area :robots_extra, value: @search["robots_extra"], rows: 4, class: "text-mono text-small", placeholder: "User-agent: SomeBot\nDisallow: /" %>
      <% end %>
      <div><button type="submit" class="btn btn--primary">Save</button></div>
    </section>
  <% end %>
</div>
