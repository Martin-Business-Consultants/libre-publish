<% @page_title = "Security policy" %>
<% can_write = Current.user.can?("settings:write") %>
<% presets = SecurityPolicy::PRESETS %>
<% suggested = @suggestions[:presets].any? || @suggestions[:hosts].any? %>

<%= render "layouts/shared/page_header", title: "Security policy" %>
<div class="stack" data-controller="tabs">
<%= render "settings/tabs", tabs: [ [ "website", "The website" ], [ "admin", "The admin" ], [ "reports", "Reports" ], [ "sent", "As sent" ] ] %>
<% content_for :settings_aside do %>
  <%= render "settings/save_box", form: "security_policy_form", capability: "settings:write" %>
<% end %>

<% if suggested %>
  <section class="card">
    <h2 class="card__title">Your scripts need these</h2>
    <p class="small muted">What the Scripts global loads that the website's policy doesn't allow yet. Without them, an enforced policy would stop those scripts.</p>
    <ul class="stack stack--xs small">
      <% @suggestions[:presets].each do |key| %>
        <%# herb:key key %>
        <li><%= presets.dig(key, :label) %></li>
      <% end %>
      <% @suggestions[:hosts].each do |directive, list| %>
        <%# herb:key directive %>
        <li><span class="mono"><%= directive %></span>: <span class="mono"><%= list.join(" ") %></span></li>
      <% end %>
    </ul>
    <% if can_write %>
      <%= button_to "Allow them", settings_security_policy_path, method: :patch, class: "btn btn--secondary btn--sm", form_class: "contents",
            params: {security_policy: {presets: @policy["presets"] | @suggestions[:presets],
                                       sources: SecurityPolicy::DIRECTIVES.to_h { |directive| [directive, (Array(@policy["sources"][directive]) | Array(@suggestions[:hosts][directive])).join("\n")] }}} %>
    <% end %>
  </section>
<% end %>

<%= form_with url: settings_security_policy_path, id: "security_policy_form", method: :patch, scope: :security_policy do |form| %>
  <%= tag.fieldset class: "stack stack--lg", disabled: !can_write do %>
    <section data-tabs-target="panel" data-tab="website" class="card">
      <div class="card__head">
        <h2 class="card__title">The website's policy</h2>
        <p class="card__hint">A Content-Security-Policy tells visitors' browsers what the site may load and run, so a script slipped into a page can't. Test it with <strong>Report only</strong>: nothing is blocked, and what it would block shows below. Enforce it once that list is clean.</p>
      </div>
      <%= settings_field "Policy", hint: "Off sends none (as before)." do %>
        <%= form.select :mode, SecurityPolicy::MODES.invert.to_a, selected: @policy["mode"] %>
      <% end %>
      <label class="checkbox">
        <%= form.check_box :strict, {checked: @policy["strict"]}, "1", "0" %>
        <span>Strict inline scripts <span class="small muted">Only inline scripts the CMS prints (the theme's, the Scripts global's, plugins') run, each carrying a fresh nonce. A script added any other way is stopped. Test with Report only first.</span></span>
      </label>
    </section>

    <section data-tabs-target="panel" data-tab="website" class="card">
      <div class="card__head">
        <h2 class="card__title">Services the site uses</h2>
        <p class="card__hint">Each allows what that service loads.</p>
      </div>
      <%= hidden_field_tag "security_policy[presets_sent]", "1", id: nil %>
      <%= hidden_field_tag "security_policy[presets][]", "", id: nil %>
      <% presets.each do |key, preset| %>
        <%# herb:key key %>
        <label class="checkbox">
          <%= check_box_tag "security_policy[presets][]", key, @policy["presets"].include?(key), id: "security_policy_preset_#{key}" %>
          <span><%= preset[:label] %><%= tag.span(" · found in your scripts", class: "small muted") if @suggestions[:presets].include?(key) %></span>
        </label>
      <% end %>
    </section>

    <section data-tabs-target="panel" data-tab="website" class="card">
      <div class="card__head">
        <h2 class="card__title">More sources</h2>
        <p class="card__hint">Anything else, one a line, by directive: <span class="mono">https://example.com</span>, <span class="mono">https://*.example.com</span>. The site itself is always allowed.</p>
      </div>
      <div class="field-row">
        <% SecurityPolicy::DIRECTIVES.each do |directive| %>
          <%# herb:key directive %>
          <%= settings_field directive do %>
            <%= text_area_tag "security_policy[sources][#{directive}]", Array(@policy["sources"][directive]).join("\n"), rows: 3, class: "mono small", id: "security_policy_sources_#{directive}", spellcheck: false %>
          <% end %>
        <% end %>
      </div>
    </section>

    <section data-tabs-target="panel" data-tab="admin" class="card">
      <div class="card__head">
        <h2 class="card__title">The admin's policy</h2>
        <p class="card__hint">The admin's is always on, and strict: it guards everyone signed in. Add a source only for something an admin page needs, such as a sign-in a form goes on to (<span class="mono">form-action</span>).</p>
      </div>
      <div class="field-row">
        <% SecurityPolicy::ADMIN_DIRECTIVES.each do |directive| %>
          <%# herb:key directive %>
          <%= settings_field directive do %>
            <%= text_area_tag "security_policy[admin_sources][#{directive}]", Array(@policy["admin_sources"][directive]).join("\n"), rows: 2, class: "mono small", id: "security_policy_admin_#{directive}", spellcheck: false %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<section data-tabs-target="panel" data-tab="reports" class="card" id="reports">
  <div class="row row--between">
    <h2 class="card__title">What browsers reported</h2>
    <span class="small muted">The last 30 days</span>
  </div>
  <% if @reports.any? %>
    <div class="table-wrap">
      <table class="table data-table">
        <thead><tr><th>Blocked</th><th>Where</th><th class="data-table__num">Times</th><th>Last</th><th></th></tr></thead>
        <tbody>
          <% @reports.each do |report| %>
            <%# herb:key report.id %>
            <tr>
              <td>
                <span class="mono small"><%= report.blocked %></span>
                <div class="small muted"><span class="mono"><%= report.directive %></span><%= " · on #{report.page}" if report.page.present? %></div>
              </td>
              <td class="small"><%= report.surface.capitalize %></td>
              <td class="data-table__num"><%= number_with_delimiter report.count %></td>
              <td class="small nowrap"><%= time_ago_tag report.last_seen_at %></td>
              <td class="nowrap">
                <% if can_write %>
                  <%= button_to "Allow", allow_settings_security_policy_path(report), class: "btn btn--secondary btn--sm", form_class: "contents" %>
                  <%= button_to "Dismiss", dismiss_settings_security_policy_path(report), method: :delete, class: "btn btn--ghost btn--sm", form_class: "contents" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="small muted">Nothing blocked. With the website's policy on Report only, what it would block shows here.</p>
  <% end %>
</section>

<section data-tabs-target="panel" data-tab="sent" class="card">
  <h2 class="card__title">As sent</h2>
  <p class="small muted">The website's <%= (@policy["mode"] == "off") ? "(off: not sent)" : ((@policy["mode"] == "report") ? "(report only)" : "(enforced)") %></p>
  <pre class="code-block"><%= @website_header %></pre>
  <p class="small muted">The admin's</p>
  <pre class="code-block"><%= @admin_header %></pre>
</section>
</div>
