<% @page_title = "API token" %>
<% install_command = "curl -fsSL " + request.base_url + "/agent/install.sh | sh" %>

<%= render "layouts/shared/page_header", title: "API token" %>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Your token</h2>
    <p class="ui-card__description">Your personal token for the API and the <code>cms</code> CLI. It can do exactly what your role allows — no more — and changes with your role.</p>
  </header>
  <div class="ui-card__content stack stack--md">
    <%= render "settings/secret", frame_id: "api_token_secret", masked: @token.masked, visible: @token.visible?,
          reveal_path: settings_api_token_reveal_path %>
    <p class="ui-field__description">
      Created <%= time_ago_tag @token.created_at %> ·
      <% if @token.last_used_at %>
        last used <%= time_ago_tag @token.last_used_at %><% if @token.last_used_ip.present? %> from <%= @token.last_used_ip %><% end %>
      <% else %>
        never used
      <% end %>
    </p>
  </div>
  <footer class="ui-card__footer ui-card__footer--bordered">
    <%= render "layouts/shared/confirm_dialog", label: "Rotate token", title: "Rotate this token?",
          message: "The current one stops working immediately, and anything using it will start getting 401s.",
          path: settings_api_token_rotation_path, button: "Rotate", negative: true %>
  </footer>
</section>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Using it</h2>
    <p class="ui-card__description">Send it as a bearer token. In an Astro site this is the <code>USER_AGENT_TOKEN</code> value. A published site should use a read-only service token instead — see <%= link_to "Service tokens", settings_service_tokens_path, class: "link" %>.</p>
  </header>
  <div class="ui-card__content">
    <pre class="<%= settings_code_classes %>">curl -H "Authorization: Bearer <%= @token.prefix %>…" \
  <%= request.base_url %>/api/pages</pre>
  </div>
</section>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Using it from an agent</h2>
    <p class="ui-card__description">Run this on your own machine to set up Claude Code, opencode or Codex against this workspace. It installs the <code>cms</code> CLI, saves your token, and writes an <code>AGENTS.md</code> the agent reads — including a slot for the Astro repo it should clone.</p>
  </header>
  <div class="ui-card__content row">
    <code class="<%= settings_code_classes("grow") %>"><%= install_command %></code>
    <%= copy_button install_command %>
  </div>
</section>

<section class="ui-card">
  <header class="ui-card__header">
    <h2 class="ui-card__title">What it can do</h2>
    <p class="ui-card__description">The capabilities your role grants, by area.</p>
  </header>
  <div class="ui-card__content">
    <% if @capabilities.empty? %>
      <div class="ui-empty">
        <p class="ui-empty__description">Nothing yet — your role grants no capabilities.</p>
      </div>
    <% else %>
      <ul class="settings-grid">
        <% @capabilities.each do |group, caps| %>
          <%# herb:key group %>
          <li class="ui-item ui-item--outline ui-item--sm">
            <div class="ui-item__content">
              <p class="ui-item__title"><%= group %></p>
              <p class="ui-item__description text-mono text-small"><%= caps.join(", ") %></p>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
