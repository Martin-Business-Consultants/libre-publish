<% @page_title = "API token" %>
<% install_command = "curl -fsSL " + request.base_url + "/agent/install.sh | sh" %>

<%= render "layouts/shared/page_header", title: "API token" %>

<section class="<%= ui(:panel, "space-y-4 p-6") %>">
  <p class="text-sm text-gray-500">Your personal token for the API and the <code>cms</code> CLI. It can do exactly what your role allows — no more — and changes with your role.</p>

  <%= render "settings/secret", frame_id: "api_token_secret", masked: @token.masked, visible: @token.visible?,
        reveal_path: settings_api_token_reveal_path %>

  <p class="text-xs text-gray-500">
    Created <%= time_ago_tag @token.created_at %> ·
    <% if @token.last_used_at %>
      last used <%= time_ago_tag @token.last_used_at %><% if @token.last_used_ip.present? %> from <%= @token.last_used_ip %><% end %>
    <% else %>
      never used
    <% end %>
  </p>

  <div>
    <%= render "layouts/shared/confirm_dialog", label: "Rotate token", title: "Rotate this token?",
          message: "The current one stops working immediately, and anything using it will start getting 401s.",
          path: settings_api_token_rotation_path, button: "Rotate", negative: true %>
  </div>
</section>

<section class="<%= ui(:panel, "space-y-4 p-6") %>">
  <div class="space-y-1">
    <h2 class="<%= ui(:heading) %>">Using it</h2>
    <p class="text-sm text-gray-500">Send it as a bearer token. In an Astro site this is the <code>USER_AGENT_TOKEN</code> value. A published site should use a read-only service token instead — see <%= link_to "Service tokens", settings_service_tokens_path, class: ui(:link) %>.</p>
  </div>
  <pre class="<%= settings_code_classes %>">curl -H "Authorization: Bearer <%= @token.prefix %>…" \
  <%= request.base_url %>/api/pages</pre>
</section>

<section class="<%= ui(:panel, "space-y-4 p-6") %>">
  <div class="space-y-1">
    <h2 class="<%= ui(:heading) %>">Using it from an agent</h2>
    <p class="text-sm text-gray-500">Run this on your own machine to set up Claude Code, opencode or Codex against this workspace. It installs the <code>cms</code> CLI, saves your token, and writes an <code>AGENTS.md</code> the agent reads — including a slot for the Astro repo it should clone.</p>
  </div>
  <div class="flex items-center gap-2">
    <code class="<%= settings_code_classes("min-w-0 flex-1") %>"><%= install_command %></code>
    <%= copy_button install_command %>
  </div>
</section>

<section class="<%= ui(:panel, "space-y-4 p-6") %>">
  <h2 class="<%= ui(:heading) %>">What it can do</h2>
  <% if @capabilities.empty? %>
    <p class="text-sm text-gray-500">Nothing yet — your role grants no capabilities.</p>
  <% else %>
    <dl class="settings-cards grid grid-cols-1 gap-3 sm:grid-cols-2">
      <% @capabilities.each do |group, caps| %>
        <%# herb:key group %>
        <div class="settings-cards__card space-y-1 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
          <dt class="text-sm font-medium text-gray-900"><%= group %></dt>
          <dd class="font-mono text-xs text-gray-500"><%= caps.join(", ") %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
