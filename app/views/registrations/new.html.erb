<% @page_title = "Set up this CMS" %>

<div class="measure--sm measure--centered stack stack--lg">
  <div class="panel panel--padded stack stack--lg">
    <div class="stack stack--xs">
      <h1 class="title">Create the owner account</h1>
      <p class="text-muted">The first account runs this CMS. Everyone after it is added from Access › Users.</p>
    </div>

    <%= render "layouts/shared/errors", record: @user %>

    <%= form_with url: sign_up_path, class: "fields", data: { controller: "form" } do |form| %>
      <label class="field">
        <span class="label">Name</span>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", placeholder: "Full name", value: @user.name %>
      </label>

      <label class="field">
        <span class="label">Email address</span>
        <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "email@example.com", value: @user.email %>
      </label>

      <label class="field">
        <span class="label">Password</span>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Password" %>
      </label>

      <label class="field">
        <span class="label">Confirm password</span>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm password" %>
      </label>

      <button type="submit" class="btn btn--primary btn--block" data-form-target="submit">
        <span>Create account</span>
        <%= icon_tag "arrow-right", class: "icon--sm" %>
      </button>
    <% end %>
  </div>

  <p class="text-center text-muted">
    Already have an account? <%= link_to "Log in", sign_in_path, class: "link" %>
  </p>
</div>
